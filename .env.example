# All optional. These are public PUBLIC_* vars (inlined into the client bundle at
# build time), kept out of the repo so clones/forks don't inherit them. In CI each
# is set as a GitHub Actions variable. Every one degrades gracefully when unset, so
# a fresh clone runs fine without any of them.
#
# For local dev, copy this file to `.env` and fill in what you need. To test the
# production build instead, use `.env.production` (loaded only by `astro build`,
# not `astro dev`).

# Hosted basemap .pmtiles. Unset → falls back to public/stl.pmtiles (not committed).
PUBLIC_PMTILES_URL=https://<example_url>/stl.pmtiles

# Feedback form endpoint (Formspree). Unset → the /feedback form is hidden.
PUBLIC_FORMSPREE_URL=https://formspree.io/f/<form_id>

# Analytics base URL (GoatCounter); the /count path is appended automatically.
# Unset → no analytics script is emitted. Only loads in production builds.
PUBLIC_ANALYTICS_URL=https://<your_code>.goatcounter.com

# Newsletter URL (Substack). Unset → the signup block + footer link are hidden.
PUBLIC_NEWSLETTER_URL=https://<your_publication>.substack.com
