# Production basemap location (object storage), read at build time and inlined
# into the client bundle. Leave unset locally — `astro dev` falls back to
# public/stl.pmtiles. In CI it's set as a GitHub Actions variable so the real URL
# stays out of the repo.
#
# To test the production fetch locally, copy this file to `.env.production`
# (gitignored, loaded only for `astro build`) and fill in the real URL, then run
# `npm run build && npm run preview`. Use `.env.production`, not `.env` — `.env`
# loads in dev too and would make `astro dev` hit the remote host.
PUBLIC_PMTILES_URL=https://<example_url>/stl.pmtiles
