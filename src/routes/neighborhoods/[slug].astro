---
import { CITY, STREETS_TOPIC_ID, REGION_CODE, SUPABASE_ENABLED } from '../../lib/site'
import { placeSchema } from '../../lib/schema'
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AsideHeading from '../../components/AsideHeading.astro'
import Heading from '../../components/Heading.astro'
import Backlinks from '../../components/Backlinks.astro'
import Comments from '../../components/Comments.astro'
import ShareCard from '../../components/ShareCard.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import MapPane from '../../components/MapPane.astro'
import BackLink from '../../components/BackLink.astro'
import CardList from '../../components/CardList.astro'
import Card from '../../components/Card.astro'
import NotExplored from '../../components/NotExplored.astro'
import PaneKicker from '../../components/PaneKicker.astro'
import CategoryChip from '../../components/CategoryChip.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { resolveVerdict } from '../../lib/verdict'
import { cuisineLabel } from '../../lib/cuisine'
import { googleMapsHref } from '../../lib/maps'
import {
  spotsIn,
  spotCategories,
  groupSpots,
  categoryCountLabel,
  categoryCounts,
  type SpotCategoryKey,
} from '../../lib/spots'
import { toMapSpots, spotPageHref, spotWebsiteHref, spotDirectionsHref } from '../../lib/map-spots'
import { published, excerpt, hasBody, META_DESCRIPTION_CHARS } from '../../lib/content'
import { isoDate } from '../../lib/dates'
import { getBacklinks } from '../../lib/backlinks'
import {
  districtForStreet,
  districtNeighborhoods,
  districtsWithin,
  districtStreets,
  foodByNeighborhood,
  neighborBearing,
  neighborhoodInfo,
  neighborhoodGeneratedSummary,
  neighborhoodMetaDescription,
  neighborhoodSummary,
  neighborsOf,
  festivalsIn,
  streetsIn,
  neighborhoodHasContent,
  neighborhoodResourceLinks,
  officialNames,
  officialNamesLine,
  regionOf,
  regionTokenBySlug,
  type Street,
} from '../../lib/neighborhoods'
import { districtBoundary, districtParts, districtPlaces } from '../../lib/districts'
import neighborhoods from '../../data/neighborhoods.json'
import Button from '../../components/Button.astro'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'

export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))
  const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

  return neighborhoods
    .filter((neighborhood) => !('ignored' in neighborhood))
    .map((neighborhood) => ({
      params: { slug: neighborhood.slug },
      props: { entry: entryBySlug.get(neighborhood.slug) ?? null },
    }))
}

const { slug = '' } = Astro.params
const { entry } = Astro.props
const info = neighborhoodInfo(slug)
const title = info?.name ?? slug

const rendered = entry ? await render(entry) : null
const Content = rendered?.Content

const sharePhoto = entry?.data.photo
  ? await getImage({ src: entry.data.photo, width: 1200, format: 'jpeg' })
  : undefined
const hasWriteup = Boolean(entry?.body && entry.body.trim())
const backlinks = entry ? await getBacklinks(entry.id) : []

const districtLines = districtStreets(slug)
const districtAreas = districtNeighborhoods(slug)
const isDistrict = districtLines.length > 0
const innerDistricts = isDistrict ? [] : districtsWithin(slug)
const districtMembers = isDistrict ? await districtPlaces(slug) : undefined
const districtShape = await districtBoundary(slug)

const spots = districtMembers?.spots ?? spotsIn(slug)

const listedNeighbors = isDistrict ? districtAreas : (entry?.data.neighbors ?? [])
const neighbors =
  listedNeighbors.length > 0
    ? listedNeighbors.flatMap((neighborSlug) => {
        const neighbor = neighborhoodInfo(neighborSlug)
        return neighbor ? [neighbor] : []
      })
    : neighborsOf(slug)
const festivals = festivalsIn(slug)

const walkableStLouisLive = published(await getCollection('topics')).some(
  (topic) => topic.id === STREETS_TOPIC_ID,
)
const streets = walkableStLouisLive ? (isDistrict ? districtLines : streetsIn(slug)) : []
const streetHref = (street: Street) => {
  const streetDistrict = districtForStreet(street.id)

  return streetDistrict && streetDistrict.slug !== slug
    ? href(`/neighborhoods/${streetDistrict.slug}/`)
    : href(`/${STREETS_TOPIC_ID}/#${street.anchor}`)
}

const placesByNeighborhood = await foodByNeighborhood()
const places = districtMembers?.places ?? placesByNeighborhood.get(slug) ?? []
const categories = categoryCounts(spots, places.length)
const hasContent = neighborhoodHasContent(slug, hasWriteup, places.length)

const writtenBySlug = new Map(
  published(await getCollection('neighborhoods')).map((neighborhoodEntry) => [
    neighborhoodEntry.id,
    Boolean(neighborhoodEntry.body && neighborhoodEntry.body.trim()),
  ]),
)

const exploredNeighbors = neighbors.filter((neighbor) => writtenBySlug.get(neighbor.slug))
const notYetVisitedNeighbors = neighbors.filter((neighbor) => !writtenBySlug.get(neighbor.slug))
const nearbyNeighbors = [...exploredNeighbors, ...notYetVisitedNeighbors].slice(0, 5)
const writtenNearby = exploredNeighbors.slice(0, 3)

const resourceLinks = neighborhoodResourceLinks(slug, title, entry?.data.url, entry?.data.wikipedia)

const generated = neighborhoodGeneratedSummary(slug)
const officialLine = officialNamesLine(slug)

const tagline = entry?.data.description
const summary = tagline ?? (hasWriteup ? generated : undefined)
const spotNoun = places.length > 0 ? 'other spot' : 'spot'
const mappedParts = [
  places.length > 0
    ? `${places.length} ${places.length === 1 ? 'place' : 'places'} to eat and drink`
    : '',
  spots.length > 0 ? `${spots.length} ${spotNoun}${spots.length === 1 ? '' : 's'}` : '',
].filter(Boolean)
const stubSummary = [
  neighborhoodSummary(slug, neighbors),
  mappedParts.length > 0 ? `So far I've mapped ${mappedParts.join(' and ')} here.` : '',
]
  .filter(Boolean)
  .join(' ')

const lastUpdated = entry ? (entry.data.updated ?? entry.data.created) : undefined

const generatedBudget = META_DESCRIPTION_CHARS - (tagline ? tagline.length + 2 : 0)
const metaDescription = hasWriteup
  ? excerpt(entry?.body, META_DESCRIPTION_CHARS)
  : [tagline, neighborhoodMetaDescription(slug, neighbors, places.length, generatedBudget)]
      .filter(Boolean)
      .join('. ')

const isTown = info?.type === 'city' || info?.type === 'community'
const isPark = info?.type === 'park'
const placeName = isTown
  ? `${title}, ${REGION_CODE}`
  : isPark || isDistrict
    ? `${title}, ${CITY}`
    : `${title}, ${CITY} Neighborhood`
const guideParts = [
  ...(places.length > 0 ? ['Restaurants'] : []),
  ...(spots.length > 0 || streets.length > 0 || festivals.length > 0 ? ['Things to Do'] : []),
]
const guideLabel = guideParts.length > 0 ? `${guideParts.join(', ')} and Map` : 'Guide and Map'
const seoTitle = info ? `${placeName}: ${guideLabel}` : undefined

const region = info ? regionOf(info) : undefined

const isCafe = (place: (typeof places)[number]) => place.data.cuisine.includes('cafe')
const cafes = places.filter(isCafe)
const eateries = places.filter((place) => !isCafe(place))
const placeHref = (place: (typeof places)[number]) =>
  hasBody(place) ? href(`/food/${place.id}/`) : undefined
const spotGroups = groupSpots(spots)
const sectionId = (key: SpotCategoryKey) => {
  if (key !== 'food') {
    return key
  }

  return eateries.length > 0 ? 'food' : 'coffee'
}

const mapSpots = await toMapSpots(spots, places)

const boundaryToken = regionTokenBySlug[region?.slug ?? ''] ?? '--color-map-accent'

const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const pageUrl = new URL(`/neighborhoods/${slug}/`, siteOrigin).href
const center =
  mapSpots.length > 0
    ? ([
        mapSpots.reduce((sum, spot) => sum + spot.coords[0], 0) / mapSpots.length,
        mapSpots.reduce((sum, spot) => sum + spot.coords[1], 0) / mapSpots.length,
      ] as [number, number])
    : undefined
const schema = placeSchema(
  {
    name: title,
    alternateNames: officialNames(slug),
    url: pageUrl,
    description: metaDescription,
    image: sharePhoto ? new URL(sharePhoto.src, siteOrigin).href : undefined,
    center,
    contains: mapSpots.map((spot) => ({
      name: spot.title,
      category: spot.category,
      url: spot.url ? new URL(spot.url, siteOrigin).href : spot.websiteHref,
      address: spot.addressLines,
    })),
  },
  siteOrigin,
)
---

<BaseLayout
  crumb={title}
  title={seoTitle}
  description={metaDescription}
  noindex={!hasContent}
  ogType="article"
  publishedTime={hasWriteup && entry?.data.created ? isoDate(entry.data.created) : undefined}
  modifiedTime={hasWriteup && lastUpdated ? isoDate(lastUpdated) : undefined}
  ogImage={sharePhoto ? rootRelative(sharePhoto.src) : undefined}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}
  jsonLd={schema}>
  <div class="map-split detail-split" data-map-split data-view="map">
    <div class="results">
      <article class="content-pane detail-pane">
        <div class="detail-pane-inner">
          <BackLink to="/neighborhoods/" label="St. Louis neighborhood map" />

          <header class="detail-pane-header">
            <h1 class="detail-pane-title title-page">{title}</h1>
            {summary && <p class="description description--lg detail-pane-tagline">{summary}</p>}
            {
              (officialLine || isDistrict || innerDistricts.length > 0 || resourceLinks.length > 0) && (
                <div class="detail-pane-facts">
                  {officialLine && (
                    <PaneKicker label={officialLine.label} muted>
                      {officialLine.names.map((name) => (
                        <span>{name}</span>
                      ))}
                    </PaneKicker>
                  )}
                  {isDistrict && (
                    <PaneKicker
                      label={neighbors.length === 1 ? 'Neighborhood' : 'Neighborhoods'}
                      muted>
                      {neighbors.map((neighbor) => (
                        <a href={href(`/neighborhoods/${neighbor.slug}/`)}>{neighbor.name}</a>
                      ))}
                    </PaneKicker>
                  )}
                  {innerDistricts.length > 0 && (
                    <PaneKicker
                      label={
                        innerDistricts.length === 1 ? 'Business district' : 'Business districts'
                      }
                      muted>
                      {innerDistricts.map((district) => (
                        <a href={href(`/neighborhoods/${district.slug}/`)}>{district.name}</a>
                      ))}
                    </PaneKicker>
                  )}
                  {resourceLinks.length > 0 && (
                    <PaneKicker label="Links" muted>
                      {resourceLinks.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener">
                          {link.label === 'Website' ? displayUrl(link.href) : link.label}
                          <IconExternalLink />
                        </a>
                      ))}
                    </PaneKicker>
                  )}
                </div>
              )
            }
            {
              categories.length > 0 && (
                <div class="pane-tally">
                  <span class="eyebrow eyebrow--muted">Points of interest</span>
                  <ul class="category-chips" aria-label="Points of interest">
                    {categories.map((category) => (
                      <li>
                        <CategoryChip
                          size="lg"
                          href={`#${sectionId(category.key)}`}
                          category={category.key}
                          label={categoryCountLabel(category)}
                          count={category.count}
                        />
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            {
              SUPABASE_ENABLED && (
                <div class="action-buttons pane-actions">
                  <Button href="#comments" variant="dark" data-comments-link hidden>
                    <span data-comments-cell-value>Leave a comment</span>
                  </Button>
                </div>
              )
            }
          </header>

          <div class="body">
            {
              entry?.data.photo && (
                <Image
                  class="detail-photo photo-frame"
                  src={entry.data.photo}
                  alt={`Photo of ${title}`}
                  widths={[400, 800]}
                  sizes="(min-width: 900px) 600px, 100vw"
                />
              )
            }
            {
              hasWriteup && Content ? (
                <Content />
              ) : (
                <NotExplored note={`I haven't filled out the ${title} page yet.`}>
                  {stubSummary}
                  <Fragment slot="links">
                    {writtenNearby.length > 0 && (
                      <p>
                        Nearby, I've written about:{' '}
                        {writtenNearby.map((neighbor, index) => (
                          <Fragment>
                            {index > 0 && ', '}
                            <a href={href(`/neighborhoods/${neighbor.slug}/`)}>{neighbor.name}</a>
                          </Fragment>
                        ))}
                      </p>
                    )}
                  </Fragment>
                </NotExplored>
              )
            }
          </div>

          <Comments kind="neighborhood" slug={slug} title={title} />

          {
            hasWriteup && lastUpdated && (
              <Byline>
                <Fragment slot="footer-meta">
                  <EntryDates created={entry?.data.created} updated={entry?.data.updated} />
                </Fragment>
              </Byline>
            )
          }

          {
            eateries.length > 0 && (
              <CardList title="Food & Drink" id="food">
                {eateries.map((place) => (
                  <Card
                    href={placeHref(place)}
                    title={place.data.title}
                    meta={cuisineLabel(place.data.cuisine[0])}
                    description={place.data.description}
                    verdict={resolveVerdict(place.data)}
                    websiteHref={place.data.url}
                    directionsHref={googleMapsHref(place.data)}
                    mapSpot={place.data.title}
                  />
                ))}
              </CardList>
            )
          }

          {
            cafes.length > 0 && (
              <CardList title="Coffee" id="coffee">
                {cafes.map((place) => (
                  <Card
                    href={placeHref(place)}
                    title={place.data.title}
                    meta={cuisineLabel(place.data.cuisine[0])}
                    description={place.data.description}
                    verdict={resolveVerdict(place.data)}
                    websiteHref={place.data.url}
                    directionsHref={googleMapsHref(place.data)}
                    mapSpot={place.data.title}
                  />
                ))}
              </CardList>
            )
          }

          {
            spotGroups.map((group) => (
              <CardList title={spotCategories[group.category].label} id={group.category}>
                {group.spots.map((spot) => (
                  <Card
                    href={spotPageHref(spot)}
                    title={spot.name}
                    meta={spot.address ?? spotCategories[spot.category].meta}
                    description={spot.description}
                    websiteHref={spotWebsiteHref(spot)}
                    directionsHref={spotDirectionsHref(spot)}
                    mapSpot={spot.name}
                  />
                ))}
              </CardList>
            ))
          }

          {
            streets.length > 0 && (
              <CardList title="Walkable streets">
                {streets.map((street) => (
                  <Card
                    href={streetHref(street)}
                    title={street.name}
                    meta={street.road}
                    description={`${street.from} to ${street.to}`}
                  />
                ))}
              </CardList>
            )
          }

          {
            festivals.length > 0 && (
              <CardList title="Annual events">
                {festivals.map((festival) => (
                  <Card title={festival.name} meta={festival.when} description={festival.blurb} />
                ))}
              </CardList>
            )
          }

          {
            nearbyNeighbors.length > 0 && (
              <section class="pane-more">
                <Heading>More</Heading>
                <nav class="pane-aside" aria-label="Nearby neighborhoods">
                  <AsideHeading title="Nearby Neighborhoods" />
                  <div class="detail-links">
                    {nearbyNeighbors.map((neighbor) => {
                      const bearing = neighborBearing(slug, neighbor.slug)
                      const rotation = bearing === undefined ? undefined : (bearing + 270) % 360

                      return (
                        <Button
                          href={href(`/neighborhoods/${neighbor.slug}/`)}
                          variant="quiet"
                          compact={false}
                          class="btn-inline">
                          {rotation !== undefined && (
                            <span
                              class="bearing-arrow"
                              style={`--rotation: ${rotation}deg`}
                              aria-hidden="true">
                              <IconArrowRight />
                            </span>
                          )}
                          {neighbor.name}
                        </Button>
                      )
                    })}
                  </div>
                </nav>
              </section>
            )
          }

          <ShareCard shareTitle={title} />

          <footer>
            <Backlinks links={backlinks} />
          </footer>
        </div>
      </article>

      <MapPane
        slug={slug}
        name={title}
        boundaryToken={boundaryToken}
        coords={info?.coords}
        spots={mapSpots}
        boundary={districtShape}
        districtParts={isDistrict ? districtParts(slug) : undefined}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .detail-pane-inner {
    max-width: calc(var(--measure-reading) + 2 * var(--spacing-lg));
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
  }

  .detail-pane-facts {
    display: grid;
    gap: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px solid var(--color-line);
  }

  .detail-pane-facts :global(.detail-pane-kicker) {
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--spacing-xs);
    margin: 0;
  }

  .detail-pane-facts :global(.detail-pane-kicker-value) {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
  }

  .detail-pane-facts a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  .detail-pane-facts :global(.icon) {
    width: 0.85em;
    height: 0.85em;
    color: inherit;
  }

  .pane-tally {
    display: grid;
    gap: var(--spacing-sm);
    margin-block-start: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px solid var(--color-line);
  }

  .pane-tally :global(.category-chips) {
    gap: var(--spacing-sm);
    margin: 0;
  }

  .pane-actions {
    margin-block-start: var(--spacing-md);
  }

  .pane-actions:has(> [hidden]) {
    display: none;
  }

  .pane-actions :global(.btn) {
    flex-grow: 1;
  }

  @container (min-width: 641px) {
    .detail-pane-facts {
      grid-template-columns: max-content minmax(0, 1fr);
      row-gap: var(--spacing-sm);
    }

    .detail-pane-facts :global(.detail-pane-kicker) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: baseline;
      column-gap: var(--spacing-lg);
    }

    .pane-actions :global(.btn) {
      flex-grow: 0;
    }
  }

  .pane-more :global(.heading) {
    margin-block: var(--spacing-xxl) var(--spacing-xl);
  }

  .pane-aside {
    margin-block: 0 var(--spacing-xl);
  }

  .bearing-arrow {
    display: inline-flex;
    color: var(--color-muted);
  }

  .bearing-arrow :global(.icon) {
    width: 14px;
    height: 14px;
    transform: rotate(var(--rotation));
  }
</style>
