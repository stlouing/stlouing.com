---
import { CITY } from '../lib/site'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import FilterMapPage from '../components/FilterMapPage.astro'
import ListPaneHeader from '../components/ListPaneHeader.astro'
import MapRow from '../components/MapRow.astro'
import PaneSearch from '../components/PaneSearch.astro'
import CityMap from '../components/CityMap.astro'
import neighborhoods from '../data/neighborhoods.json'
import { published, excerpt, hasBody, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import {
  foodByNeighborhood,
  neighborhoodHasContent,
  neighborhoodPopups,
  officialNames,
} from '../lib/neighborhoods'
import { districtPlaces, type DistrictPlaces } from '../lib/districts'
import {
  allSpots,
  categoryCountLabel,
  categoryCounts,
  categoryLegendItems,
  spotsIn,
  spotCategories,
  type SpotCategoryKey,
} from '../lib/spots'
import CategoryChip from '../components/CategoryChip.astro'
import { toMapSpots } from '../lib/map-spots'
import { href } from '../lib/url'
import IconArrowRight from '../assets/IconArrowRight.astro'

const entries = published(await getCollection('neighborhoods'))
const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

const areas = await neighborhoodPopups()
const isWritten = (slug: string) => hasBody(entryBySlug.get(slug) ?? {})
const mapSpots = await toMapSpots(allSpots(), published(await getCollection('food')))
const placesByNeighborhood = await foodByNeighborhood()
const districtMembers = new Map<string, DistrictPlaces>()
for (const neighborhood of neighborhoods) {
  if (neighborhood.type === 'district') {
    districtMembers.set(neighborhood.slug, await districtPlaces(neighborhood.slug))
  }
}
const foodCount = (slug: string) =>
  (districtMembers.get(slug)?.places ?? placesByNeighborhood.get(slug) ?? []).length
const categoryKeys = Object.keys(spotCategories) as SpotCategoryKey[]
const legendKeys = categoryKeys.filter((key) => mapSpots.some((spot) => spot.category === key))

const countPills = (slug: string) =>
  categoryCounts(districtMembers.get(slug)?.spots ?? spotsIn(slug), foodCount(slug))

const placeTotal = (neighborhood: { slug: string }) =>
  countPills(neighborhood.slug).reduce((sum, pill) => sum + pill.count, 0)

const featuredRank = (slug: string) => entryBySlug.get(slug)?.data.featured ?? Infinity

const listed = neighborhoods
  .filter((neighborhood) => !('ignored' in neighborhood))
  .sort((left, right) => {
    const writtenOrder = Number(isWritten(right.slug)) - Number(isWritten(left.slug))
    if (writtenOrder !== 0 || !isWritten(left.slug)) {
      return writtenOrder
    }
    const featuredOrder = featuredRank(left.slug) - featuredRank(right.slug)
    if (featuredOrder !== 0 && Number.isFinite(featuredOrder)) {
      return featuredOrder
    }
    if (Number.isFinite(featuredRank(left.slug)) !== Number.isFinite(featuredRank(right.slug))) {
      return Number.isFinite(featuredRank(left.slug)) ? -1 : 1
    }

    return placeTotal(right) - placeTotal(left) || left.name.localeCompare(right.name)
  })
const count = listed.length
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const neighborhoodList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${CITY} neighborhoods`,
  itemListElement: listed
    .filter((neighborhood) =>
      neighborhoodHasContent(
        neighborhood.slug,
        isWritten(neighborhood.slug),
        foodCount(neighborhood.slug),
      ),
    )
    .map((neighborhood, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: neighborhood.name,
    url: new URL(`/neighborhoods/${neighborhood.slug}/`, siteOrigin).href,
  })),
}
const writtenCount = listed.filter((neighborhood) => isWritten(neighborhood.slug)).length
const restCount = listed.length - writtenCount

---

<BaseLayout
  crumb="Neighborhoods"
  title={`${CITY} Neighborhood Map: Restaurants, Bars, Museums, Landmarks, Parks, and Markets`}
  description={`A map and field guide to the neighborhoods and parks of ${CITY}, with landmarks, museums, parks, markets, places to eat, and neighborhood write-ups.`}
  jsonLd={neighborhoodList}>
  <FilterMapPage emptyText="No neighborhoods match.">
      <article class="content-pane map-list">
        <ListPaneHeader title="Neighborhoods" titlePrefix={`${CITY} `} count={count} live>
          <PaneSearch label="Search neighborhoods" placeholder="search by name, area..." />
        </ListPaneHeader>
        <ul class="list">
          {
            listed.map((neighborhood, index) => {
              const written = isWritten(neighborhood.slug)
              const area = areas[neighborhood.slug]
              const isPark = area?.park ?? false
              const isDistrict = neighborhood.type === 'district'
              const entry = entryBySlug.get(neighborhood.slug)
              const pills = countPills(neighborhood.slug)

              const previous = listed[index - 1]
              const showHeader = index === 0 || written !== isWritten(previous.slug)

              return (
                <Fragment>
                  {showHeader && (
                    <li class="section-head">
                      <span>{written ? 'Explored' : 'Not Explored'}</span>
                      <span class="count">{written ? writtenCount : restCount}</span>
                    </li>
                  )}
                  <MapRow
                    id={neighborhood.slug}
                    title={neighborhood.name}
                    detailHref={`/neighborhoods/${neighborhood.slug}/`}
                    readMore={false}
                    search={[
                      neighborhood.name,
                      ...officialNames(neighborhood.slug),
                      isPark ? 'Park' : '',
                      isDistrict ? 'District' : '',
                      neighborhood.group ?? '',
                      area?.tagline ?? '',
                    ]
                      .filter(Boolean)
                      .join(' ')}>
                    {area?.tagline && (
                      <span class="description" slot="sub">
                        {area.tagline}
                      </span>
                    )}
                    {area?.photo && (
                      <div
                        class="list-photo"
                        slot="photo"
                        style={`background-image: url(${area.photo})`}
                        aria-hidden="true"
                      />
                    )}
                    {written && entry && (
                      <div class="map-preview excerpt">
                        {excerpt(entry.body, PREVIEW_EXCERPT_CHARS)}
                      </div>
                    )}
                    {pills.length > 0 && (
                      <ul class="category-chips" aria-label="Places on the map">
                        {pills.map((pill) => (
                          <CategoryChip
                            as="li"
                            category={pill.key}
                            label={categoryCountLabel(pill)}
                            labelHidden
                            count={pill.count}
                          />
                        ))}
                      </ul>
                    )}
                    {written && (
                      <a class="continue-link" href={href(`/neighborhoods/${neighborhood.slug}/`)}>
                        Continue reading <IconArrowRight />
                      </a>
                    )}
                  </MapRow>
                </Fragment>
              )
            })
          }
        </ul>
      </article>
      <CityMap
        spots={mapSpots}
        areas={areas}
        legend={categoryLegendItems(legendKeys)}
        rowTarget="area"
        label={`Map of ${CITY} neighborhoods`}
      />
  </FilterMapPage>
</BaseLayout>
