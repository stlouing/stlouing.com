---
import '../styles/global.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '@fontsource/ibm-plex-mono/700.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/JsonLd.astro'
import { href } from '../lib/url'
import { sections } from '../lib/sections'
import { SITE_DESCRIPTION, SOCIALS } from '../lib/site'

interface Props {
  crumb?: string
  description?: string
  // 'website' (default) or 'article' for notes, which also emit published-time
  // and tag metadata.
  ogType?: string
  publishedTime?: string
  tags?: string[]
  // Page-specific schema.org JSON-LD (a BreadcrumbList is added automatically).
  jsonLd?: object | object[]
}

const SITE_NAME = 'St. Louing'
const { crumb, description, ogType = 'website', publishedTime, tags = [], jsonLd } = Astro.props

const base = import.meta.env.BASE_URL
let path = Astro.url.pathname
if (base !== '/' && path.startsWith(base)) {
  path = '/' + path.slice(base.length)
}
const segments = path.split('/').filter(Boolean)

interface Crumb {
  label: string
  href?: string
}

const trail: Crumb[] = [{ label: SITE_NAME, href: '/' }]
if (segments.length >= 1) {
  const sectionPath = `/${segments[0]}`
  const sectionLabel =
    sections.find((section) => section.path === sectionPath)?.label ?? segments[0]
  if (segments.length === 1) {
    trail.push({ label: crumb ?? sectionLabel })
  } else {
    trail.push({ label: sectionLabel, href: sectionPath })
    trail.push({ label: crumb ?? segments[segments.length - 1] })
  }
}

const leaf = trail.length > 1 ? trail[trail.length - 1].label : undefined
const pageTitle = leaf ? `${leaf} | ${SITE_NAME}` : `${SITE_NAME} | Maps, Guides, and Observations`

const metaDescription = description ?? SITE_DESCRIPTION
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
// Social-share image. Absolute URL (required by OG); falls back to the site icon
// until a dedicated share card is added at /og.png.
const socialImage = new URL(href('/favicon.png'), Astro.site ?? Astro.url.origin).href

// Structured data: an automatic BreadcrumbList from the trail, plus any
// page-specific schema passed in.
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const breadcrumbSchema =
  trail.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: trail.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href ? new URL(item.href, siteOrigin).href : undefined,
        })),
      }
    : null
const structuredData = [
  breadcrumbSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
].filter((schema): schema is object => Boolean(schema))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Set the theme before paint: stored choice wins, else follow the OS. -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme')
      const theme =
        storedTheme ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.dataset.theme = theme
    </script>

    <link rel="icon" type="image/png" href={href('/favicon.png')} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={href('/rss.xml')} />

    {/* rel=me identity links for Mastodon/Bluesky/IndieAuth verification. */}
    {SOCIALS.map((social) => <link rel="me" href={social.url} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={socialImage} />

    <meta name="generator" content={Astro.generator} />

    {structuredData.map((schema) => <JsonLd data={schema} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header trail={trail} />

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
