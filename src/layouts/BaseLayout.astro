---
import '../styles/global.css'

import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '@fontsource/ibm-plex-mono/700.css'

// Display serif for the homepage wordmark (only ships a 400 weight).
import '@fontsource/instrument-serif/400.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/JsonLd.astro'
import { href } from '../lib/url'
import { sections } from '../lib/sections'
import { SITE_DESCRIPTION, SOCIALS } from '../lib/site'

interface Props {
  crumb?: string
  // An SEO-tuned <title> leaf, used when it should differ from the (shorter)
  // breadcrumb `crumb` — e.g. a food page adds its cuisine + "St. Louis".
  title?: string
  description?: string
  // 'website' (default) or 'article' for notes, which also emit published-time
  // and tag metadata.
  ogType?: string
  publishedTime?: string
  tags?: string[]
  // Page-specific schema.org JSON-LD (a BreadcrumbList is added automatically).
  jsonLd?: object | object[]
  // A per-page social-share image (root-relative path to a 1200x630 file in
  // public/, e.g. "/og/st-louis-style-pizza.png"). Falls back to the site flag.
  ogImage?: string
}

const SITE_NAME = 'St. Louing'
const {
  crumb,
  title,
  description,
  ogType = 'website',
  publishedTime,
  tags = [],
  jsonLd,
  ogImage,
} = Astro.props

const base = import.meta.env.BASE_URL
let path = Astro.url.pathname
if (base !== '/' && path.startsWith(base)) {
  path = '/' + path.slice(base.length)
}
const segments = path.split('/').filter(Boolean)

interface Crumb {
  label: string
  href?: string
}

const trail: Crumb[] = [{ label: SITE_NAME, href: '/' }]
if (segments.length >= 1) {
  // Match the section by its slug, tolerant of the trailing slash on sections.ts
  // paths (`/food/`), and reuse the matched section's own path for the crumb href
  // so it carries the correct trailing slash rather than a redirecting `/food`.
  const sectionKey = `/${segments[0]}`
  const section = sections.find((entry) => entry.path.replace(/\/$/, '') === sectionKey)
  const sectionLabel = section?.label ?? segments[0]
  const sectionHref = section?.path ?? `${sectionKey}/`
  if (segments.length === 1) {
    trail.push({ label: crumb ?? sectionLabel })
  } else {
    trail.push({ label: sectionLabel, href: sectionHref })
    trail.push({ label: crumb ?? segments[segments.length - 1] })
  }
}

const leaf = trail.length > 1 ? trail[trail.length - 1].label : undefined
const titleLeaf = title ?? leaf
const pageTitle = titleLeaf
  ? `${titleLeaf} - ${SITE_NAME}`
  : `${SITE_NAME} - Food, Neighborhoods, and Culture of St. Louis`

const metaDescription = description ?? SITE_DESCRIPTION
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
// Social-share image. Absolute URL (required by OG). A dedicated 1200x630 card
const socialImage = new URL(href(ogImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href
// A custom share image gets the page title as alt; the default flag keeps its own.
const socialImageAlt = ogImage ? (crumb ?? SITE_NAME) : `${SITE_NAME} - the St. Louis flag`

// Structured data: an automatic BreadcrumbList from the trail, plus any
// page-specific schema passed in.
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const breadcrumbSchema =
  trail.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: trail.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href ? new URL(item.href, siteOrigin).href : undefined,
        })),
      }
    : null
const structuredData = [
  breadcrumbSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
].filter((schema): schema is object => Boolean(schema))

// Open the basemap CDN connection early so the first map tiles don't wait on a
// cold DNS/TLS handshake. Prod only — local dev serves the pmtiles same-origin.
let pmtilesOrigin: string | undefined
try {
  pmtilesOrigin = import.meta.env.PUBLIC_PMTILES_URL
    ? new URL(import.meta.env.PUBLIC_PMTILES_URL).origin
    : undefined
} catch {
  pmtilesOrigin = undefined
}

// Analytics endpoint (GoatCounter), env-driven so a fork's deploy doesn't report
// into this dashboard. Normalized to the /count endpoint the script expects.
const analyticsBase = (import.meta.env.PUBLIC_ANALYTICS_URL ?? '').replace(/\/+$/, '')
const analyticsUrl = analyticsBase
  ? analyticsBase.endsWith('/count')
    ? analyticsBase
    : `${analyticsBase}/count`
  : ''
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* Body serif is Georgia, a system font (with Times New Roman / generic
       serif fallbacks), so no webfont is loaded for body copy. */
    }

    {pmtilesOrigin && <link rel="preconnect" href={pmtilesOrigin} crossorigin />}

    <!-- Set the theme before paint: stored choice wins, else follow the OS. -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme')
      const theme =
        storedTheme ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.dataset.theme = theme
    </script>

    <link rel="icon" type="image/png" href={href('/pixel-flag-2.png')} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={href('/rss.xml')} />

    {/* rel=me identity links for Mastodon/Bluesky/IndieAuth verification. */}
    {SOCIALS.map((social) => <link rel="me" href={social.url} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />

    <meta name="generator" content={Astro.generator} />

    {structuredData.map((schema) => <JsonLd data={schema} />)}

    {
      /* Cookieless, no-consent-banner analytics (GoatCounter). Production builds
        only (local dev + previews don't count) AND only when PUBLIC_ANALYTICS_URL
        is set, so a fork without that var sends nothing here. */
    }
    {
      import.meta.env.PROD && analyticsUrl && (
        <script is:inline data-goatcounter={analyticsUrl} async src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header trail={trail} />

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import { initWikilinkPreviews } from '../scripts/wikilink-preview'
      import { initShare } from '../scripts/share'
      initWikilinkPreviews()
      initShare()
    </script>
  </body>
</html>
