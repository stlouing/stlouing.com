---
import '../styles/global.css'

import '@fontsource/instrument-serif/400.css'

import '@fontsource/archivo/500.css'
import '@fontsource/archivo/600.css'
import '@fontsource/archivo/700.css'
import '@fontsource/archivo/800.css'
import '@fontsource/archivo/900.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/JsonLd.astro'
import { href } from '../lib/url'
import { sections } from '../lib/sections'
import { SITE_DESCRIPTION, SOCIALS } from '../lib/site'

interface Props {
  home?: boolean
  article?: boolean
  crumb?: string
  title?: string
  description?: string
  ogType?: string
  publishedTime?: string
  tags?: string[]
  jsonLd?: object | object[]
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  noindex?: boolean
}

const SITE_NAME = 'St. Louing'
const {
  home = false,
  article = false,
  crumb,
  title,
  description,
  ogType = 'website',
  publishedTime,
  tags = [],
  jsonLd,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
} = Astro.props

const base = import.meta.env.BASE_URL
let path = Astro.url.pathname
if (base !== '/' && path.startsWith(base)) {
  path = '/' + path.slice(base.length)
}
const segments = path.split('/').filter(Boolean)

interface Crumb {
  label: string
  href?: string
}

const trail: Crumb[] = [{ label: SITE_NAME, href: '/' }]
if (segments.length >= 1) {
  const sectionKey = `/${segments[0]}`
  const section = sections.find((entry) => entry.path.replace(/\/$/, '') === sectionKey)
  const sectionLabel = section?.label ?? segments[0]
  const sectionHref = section?.path ?? `${sectionKey}/`
  if (segments.length === 1) {
    trail.push({ label: crumb ?? sectionLabel })
  } else {
    trail.push({ label: sectionLabel, href: sectionHref })
    trail.push({ label: crumb ?? segments[segments.length - 1] })
  }
}

const leaf = trail.length > 1 ? trail[trail.length - 1].label : undefined
const titleLeaf = title ?? leaf
const pageTitle = titleLeaf ?? `${SITE_NAME}: Food, Neighborhoods, and Culture of St. Louis`

const metaDescription = description ?? SITE_DESCRIPTION
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
const socialImage = new URL(href(ogImage ?? '/og.png?v=2'), Astro.site ?? Astro.url.origin).href
const socialImageAlt = ogImage ? (crumb ?? SITE_NAME) : `${SITE_NAME} - the St. Louis flag`

const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const breadcrumbSchema =
  trail.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: trail.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href ? new URL(item.href, siteOrigin).href : undefined,
        })),
      }
    : null
const structuredData = [
  breadcrumbSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
].filter((schema): schema is object => Boolean(schema))

let pmtilesOrigin: string | undefined
try {
  pmtilesOrigin = import.meta.env.PUBLIC_PMTILES_URL
    ? new URL(import.meta.env.PUBLIC_PMTILES_URL).origin
    : undefined
} catch {
  pmtilesOrigin = undefined
}

const analyticsBase = (import.meta.env.PUBLIC_ANALYTICS_URL ?? '').replace(/\/+$/, '')
const analyticsUrl = analyticsBase
  ? analyticsBase.endsWith('/count')
    ? analyticsBase
    : `${analyticsBase}/count`
  : ''
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {pmtilesOrigin && <link rel="preconnect" href={pmtilesOrigin} crossorigin />}

    <script is:inline>
      const storedTheme = localStorage.getItem('theme')
      document.documentElement.dataset.theme = storedTheme ?? 'light'
    </script>

    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={href('/favicon.png')} sizes="144x144" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={href('/rss.xml')} />

    {SOCIALS.map((social) => <link rel="me" href={social.url} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta name="generator" content={Astro.generator} />

    {structuredData.map((schema) => <JsonLd data={schema} />)}

    {
      import.meta.env.PROD && analyticsUrl && (
        <script is:inline data-goatcounter={analyticsUrl} async src="https://gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header trail={trail} variant={home ? 'home' : 'compact'} />

    <main id="main">
      <div class:list={['wrap', 'wrap-wide', { 'wrap-article': article }]}>
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import { initWikilinkPreviews } from '../scripts/wikilink-preview'
      import { initShare } from '../scripts/share'
      initWikilinkPreviews()
      initShare()
    </script>
  </body>
</html>
