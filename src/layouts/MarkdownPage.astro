---
import PageMasthead from '../components/PageMasthead.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: { title?: string; seoTitle?: string; tagline?: string; description?: string }
}

const { frontmatter } = Astro.props
---

<BaseLayout
  article
  crumb={frontmatter.title}
  title={frontmatter.seoTitle}
  description={frontmatter.description}>
  <article class="page">
    <PageMasthead title={frontmatter.title}>
      {frontmatter.tagline && <p slot="lede">{frontmatter.tagline}</p>}
    </PageMasthead>
    <div class="body reading-col">
      <slot />
    </div>
  </article>
</BaseLayout>
