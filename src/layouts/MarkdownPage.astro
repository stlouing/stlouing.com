---
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: { title?: string; tagline?: string; description?: string }
}

const { frontmatter } = Astro.props
---

<BaseLayout crumb={frontmatter.title} description={frontmatter.description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        {frontmatter.title && <h1>{frontmatter.title}</h1>}
      </div>
      {/* One-line tagline under the title, in accent — mirrors the topic detail
          pages' description lede. */}
      {frontmatter.tagline && <p class="entry-summary">{frontmatter.tagline}</p>}
    </header>
    <div class="body">
      <slot />
    </div>
  </article>
</BaseLayout>
