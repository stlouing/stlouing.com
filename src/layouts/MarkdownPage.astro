---
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: { title?: string; seoTitle?: string; tagline?: string; description?: string }
}

const { frontmatter } = Astro.props
---

<BaseLayout
  article
  crumb={frontmatter.title}
  title={frontmatter.seoTitle}
  description={frontmatter.description}>
  <article class="page">
    <header class="entry-header entry-header-with-flag reading-col">
      <div class="entry-bar">
        {frontmatter.title && <h1>{frontmatter.title}</h1>}
      </div>
      {frontmatter.tagline && <p class="description description--lg">{frontmatter.tagline}</p>}
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>
    <div class="body reading-col">
      <slot />
    </div>
  </article>
</BaseLayout>
