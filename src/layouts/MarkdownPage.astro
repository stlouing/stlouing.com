---
import BaseLayout from './BaseLayout.astro'

interface Props {
  // `title` is the visible H1 + breadcrumb; `seoTitle` overrides just the <title>
  // tag when it should read differently (e.g. About's SEO title differs from "About").
  frontmatter: { title?: string; seoTitle?: string; tagline?: string; description?: string }
}

const { frontmatter } = Astro.props
---

<BaseLayout
  crumb={frontmatter.title}
  title={frontmatter.seoTitle}
  description={frontmatter.description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        {frontmatter.title && <h1>{frontmatter.title}</h1>}
      </div>
      {/* One-line tagline under the title, in accent — mirrors the topic detail
          pages' description lede. */}
      {frontmatter.tagline && <p class="entry-summary">{frontmatter.tagline}</p>}
    </header>
    <div class="body">
      <slot />
    </div>
  </article>
</BaseLayout>
