---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import List from '../../components/List.astro'
import ListItem from '../../components/ListItem.astro'
import { href } from '../../lib/url'
import { published, excerpt, PREVIEW_EXCERPT_CHARS } from '../../lib/content'
import { formatDateShort } from '../../lib/dates'

const notes = published(await getCollection('notes')).sort(
  (left, right) => right.data.created.valueOf() - left.data.created.valueOf(),
)
---

<BaseLayout>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Notes</h1>
      </div>
    </header>
    <List>
      {
        notes.map((note) => (
          <ListItem
            title={note.data.title}
            href={href(`/notes/${note.id}/`)}
            description={note.data.description ?? excerpt(note.body, PREVIEW_EXCERPT_CHARS)}>
            <time slot="meta" class="list-meta" datetime={note.data.created.toISOString()}>
              {formatDateShort(note.data.created)}
            </time>
          </ListItem>
        ))
      }
    </List>
  </article>
</BaseLayout>
