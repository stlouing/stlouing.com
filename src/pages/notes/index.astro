---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { href } from '../../lib/url'
import { published } from '../../lib/content'

const notes = published(await getCollection('notes')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf(),
)

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<BaseLayout>
  <h1>Notes</h1>
  <ul class="list">
    {
      notes.map((note) => (
        <li>
          <a class="list-title" href={href(`/notes/${note.id}`)}>
            {note.data.title}
          </a>
          <time class="list-meta" datetime={note.data.date.toISOString()}>
            {formatDate(note.data.date)}
          </time>
          {note.data.description && <p class="list-description">{note.data.description}</p>}
        </li>
      ))
    }
  </ul>
</BaseLayout>
