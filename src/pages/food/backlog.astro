---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import rip from '../../data/rip.json'
import { published } from '../../lib/content'
import { cuisineEmoji, cuisineLabel } from '../../lib/emoji'
import { href } from '../../lib/url'

// The wishlist + tried lists are now first-class food entries carrying a `status`
// (each has its own /food/<slug> page + map pin); this page just reads them back
// out by status. RIP stays a plain data file — a closed place needs no page.
interface FoodNote {
  name: string
  cuisine?: string[]
  neighborhood?: string
  note?: string
}

// The card shape shared by a food entry's data and a plain RIP note.
type CardData = { cuisine?: string[]; neighborhood?: string }

const allFood = published(await getCollection('food'))
const byTitle = (left: { data: { title: string } }, right: { data: { title: string } }) =>
  left.data.title.localeCompare(right.data.title)
const wishlist = allFood.filter((place) => place.data.status === 'want-to-try').sort(byTitle)
const triedList = allFood.filter((place) => place.data.status === 'tried').sort(byTitle)

const byName = (left: FoodNote, right: FoodNote) => left.name.localeCompare(right.name)
const inMemoriam = (rip as FoodNote[]).slice().sort(byName)

// The leading cuisine emoji for a row, when the item has a cuisine.
const cardEmoji = (item: CardData) => {
  if (item.cuisine && item.cuisine.length > 0) {
    return cuisineEmoji(item.cuisine)
  }

  return undefined
}

// The kicker line: the cuisine label and neighborhood, whichever are present.
const cardMeta = (item: CardData) => {
  const parts = [
    item.cuisine && item.cuisine.length > 0 ? cuisineLabel(item.cuisine[0]) : null,
    item.neighborhood ?? null,
  ].filter(Boolean)

  return parts.length > 0 ? parts.join(' · ') : undefined
}

const description =
  "Places in St. Louis I haven't been to yet, plus a few that I haven't gotten around to writing about yet."
---

<BaseLayout
  crumb="The Backlog"
  title="The Backlog - St. Louis Restaurants To Try"
  description={description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>The Backlog</h1>
      </div>
      <p class="entry-summary">The running list of places I still need to get to.</p>
    </header>

    {
      wishlist.length > 0 ? (
        <section>
          <h2>
            Haven't tried yet <span class="section-count">{wishlist.length}</span>
          </h2>
          <p class="description">
            Here's a list of places I'm interested in trying but haven't gotten to visit yet.
          </p>
          <div class="card-list">
            {wishlist.map((place) => (
              <RelatedCard
                href={href(`/food/${place.id}/`)}
                title={place.data.title}
                emoji={cardEmoji(place.data)}
                meta={cardMeta(place.data)}
                metaType="neighborhood"
                description={place.data.description}
              />
            ))}
          </div>
        </section>
      ) : (
        <p class="empty">Nothing on the list right now.</p>
      )
    }

    {
      triedList.length > 0 && (
        <section>
          <h2>
            Tried, not yet rated <span class="section-count">{triedList.length}</span>
          </h2>
          <p class="description">
            Places I've tried but haven't had time to make a write-up for them yet.
          </p>
          <div class="card-list">
            {triedList.map((place) => (
              <RelatedCard
                href={href(`/food/${place.id}/`)}
                title={place.data.title}
                emoji={cardEmoji(place.data)}
                meta={cardMeta(place.data)}
                metaType="neighborhood"
                description={place.data.description}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      inMemoriam.length > 0 && (
        <section>
          <h2>
            RIP <span class="section-count">{inMemoriam.length}</span>
          </h2>
          <p class="description">
            Restaurants I've visited that have closed down and no longer exist.
          </p>
          <div class="card-list">
            {inMemoriam.map((item) => (
              <RelatedCard
                title={item.name}
                emoji={cardEmoji(item)}
                meta={cardMeta(item)}
                metaType="neighborhood"
                description={item.note}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  /* A muted count beside each section heading. */
  .section-count {
    margin-inline-start: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-md);
    font-weight: 400;
    color: var(--color-muted);
  }

  /* Each section: a normal h2 + a line of description, then the list of cards. */
  section {
    margin-block-start: var(--spacing-xl);
  }

  /* These lists run long, so split them into two columns on desktop. The rows
     keep their own hairline dividers; the column gap separates the two stacks. */
  .card-list {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 700px) {
    .card-list {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }

    /* Two columns: keep every row's divider, including the last card, so the two
       stacks end on an even line instead of one column dropping its border. */
    .card-list :global(.related-card:last-child) {
      border-block-end: 1px solid var(--color-line);
    }
  }

  /* Pull the description up close under its heading, and quiet it down. */
  section h2 {
    margin-bottom: var(--spacing-xs);
  }

  .description {
    margin-block-start: 0;
    margin-block-end: var(--spacing-lg);
    color: var(--color-muted-2);
  }
</style>
