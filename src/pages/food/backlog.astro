---
import PageMasthead from '../../components/PageMasthead.astro'
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import Card from '../../components/Card.astro'
import rip from '../../data/rip.json'
import { published } from '../../lib/content'
import { cuisineLabel } from '../../lib/cuisine'
import { href } from '../../lib/url'

interface FoodNote {
  name: string
  cuisine?: string[]
  neighborhood?: string
  note?: string
}

type CardData = { cuisine?: string[]; neighborhood?: string }

const allFood = published(await getCollection('food'))
const byTitle = (left: { data: { title: string } }, right: { data: { title: string } }) =>
  left.data.title.localeCompare(right.data.title)
const wishlist = allFood.filter((place) => place.data.status === 'want-to-try').sort(byTitle)
const triedList = allFood.filter((place) => place.data.status === 'tried').sort(byTitle)

const byName = (left: FoodNote, right: FoodNote) => left.name.localeCompare(right.name)
const inMemoriam = (rip as FoodNote[]).slice().sort(byName)

const cardMeta = (item: CardData): string[] =>
  [
    item.cuisine && item.cuisine.length > 0 ? cuisineLabel(item.cuisine[0]) : null,
    item.neighborhood ?? null,
  ].filter(Boolean) as string[]

const description =
  "Places in St. Louis I haven't been to yet, plus a few that I haven't gotten around to writing about yet."
---

<BaseLayout
  crumb="The Backlog"
  title="The Backlog - St. Louis Restaurants To Try"
  description={description}>
  <article class="page">
    <PageMasthead title="The Backlog" wide>
      <p slot="lede">The running list of places I still need to get to.</p>
    </PageMasthead>

    {
      wishlist.length > 0 ? (
        <section>
          <Heading>
            Haven't tried yet
            <span slot="aside" class="count">{wishlist.length}</span>
          </Heading>
          <p class="description">
            Here's a list of places I'm interested in trying but haven't gotten to visit yet.
          </p>
          <div class="card-grid card-rows">
            {wishlist.map((place) => (
              <Card
                href={href(`/food/${place.id}/`)}
                title={place.data.title}
                meta={cardMeta(place.data)}
                description={place.data.description}
              />
            ))}
          </div>
        </section>
      ) : (
        <p class="empty">Nothing on the list right now.</p>
      )
    }

    {
      triedList.length > 0 && (
        <section>
          <Heading>
            Tried, not yet rated
            <span slot="aside" class="count">{triedList.length}</span>
          </Heading>
          <p class="description">
            Places I've tried but haven't had time to make a write-up for them yet.
          </p>
          <div class="card-grid card-rows">
            {triedList.map((place) => (
              <Card
                href={href(`/food/${place.id}/`)}
                title={place.data.title}
                meta={cardMeta(place.data)}
                description={place.data.description}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      inMemoriam.length > 0 && (
        <section>
          <Heading>
            RIP
            <span slot="aside" class="count">{inMemoriam.length}</span>
          </Heading>
          <p class="description">
            Restaurants I've visited that have closed down and no longer exist.
          </p>
          <div class="card-grid card-rows">
            {inMemoriam.map((item) => (
              <Card
                title={item.name}
                meta={cardMeta(item)}
                description={item.note}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>

  section {
    margin-block-start: var(--spacing-xl);
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 700px) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }

    .card-grid :global(.card:last-child) {
      border-block-end: 1px solid var(--color-line);
    }
  }

  @media screen and (min-width: 1000px) {
    .card-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  section h2 {
    margin: 0 0 var(--spacing-xs);
  }

  .description {
    margin-block-start: 0;
    margin-block-end: var(--spacing-lg);
  }
</style>
