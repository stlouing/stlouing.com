---
import BaseLayout from '../../layouts/BaseLayout.astro'
import wantToTry from '../../data/want-to-try.json'
import tried from '../../data/tried.json'
import rip from '../../data/rip.json'

// All three lists are plain data (src/data/*.json), not collection entries — so a
// place can sit here with zero ceremony and get promoted to a real /food entry
// (with a verdict + writeup) one at a time, only when it's earned it.
interface FoodNote {
  name: string
  cuisine?: string[]
  neighborhood?: string
  note?: string
}

const byName = (left: FoodNote, right: FoodNote) => left.name.localeCompare(right.name)
const wishlist = (wantToTry as FoodNote[]).slice().sort(byName)
const beenTried = (tried as FoodNote[]).slice().sort(byName)
const inMemoriam = (rip as FoodNote[]).slice().sort(byName)

const description =
  "Places in St. Louis I haven't been to yet, plus a few that didn't leave a mark."
---

<BaseLayout crumb="Want to try" description={description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Want to Try</h1>
        <span class="count">{wishlist.length}</span>
      </div>
      <p class="entry-summary">The running list of places I still need to get to.</p>
    </header>

    {
      wishlist.length > 0 ? (
        <section>
          <h2>Haven't tried yet</h2>
          <p class="description">
            Here's a list of places I'm interested in trying but haven't gotten to visit yet.
          </p>
          <nav class="backlinks grid">
            <ul>
              {wishlist.map((item) => (
                <li>
                  <span class="list-title-item">{item.name}</span>
                  {item.cuisine && item.cuisine.length > 0 && (
                    <span class="collection">{item.cuisine.join(', ')}</span>
                  )}
                  {item.neighborhood && <span class="collection">{item.neighborhood}</span>}
                </li>
              ))}
            </ul>
          </nav>
        </section>
      ) : (
        <p class="empty">Nothing on the list right now.</p>
      )
    }

    <hr />

    {
      beenTried.length > 0 && (
        <section>
          <h2>Tried, not yet rated</h2>
          <p class="description">
            Places I've tried but haven't had time to make a write-up for them yet.
          </p>
          <nav class="backlinks grid">
            <ul>
              {beenTried.map((item) => (
                <li>
                  <span class="list-title-item">{item.name}</span>
                  {item.cuisine && item.cuisine.length > 0 && (
                    <span class="collection">{item.cuisine.join(', ')}</span>
                  )}
                  {item.neighborhood && <span class="collection">{item.neighborhood}</span>}
                </li>
              ))}
            </ul>
          </nav>
        </section>
      )
    }

    <hr />

    {
      inMemoriam.length > 0 && (
        <section>
          <h2>RIP</h2>
          <p class="description">
            Restaurants I've visited that have closed down and no longer exist.
          </p>
          <nav class="backlinks grid">
            <ul>
              {inMemoriam.map((item) => (
                <li>
                  <span class="list-title-item">{item.name}</span>
                  {item.cuisine && item.cuisine.length > 0 && (
                    <span class="collection">{item.cuisine.join(', ')}</span>
                  )}
                  {item.neighborhood && <span class="collection">{item.neighborhood}</span>}
                </li>
              ))}
            </ul>
          </nav>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .count {
    font-family: var(--font-mono);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  /* Each section: a normal h2 + a line of description, then the compact list.
     (The h2 sits outside .backlinks so it keeps the default heading style.) */
  section {
    margin-block-start: var(--spacing-lg);
  }

  section .backlinks {
    margin-block-start: 0;
  }

  /* Pull the description up close under its heading, and quiet it down. */
  section h2 {
    margin-bottom: var(--spacing-xs);
  }

  .description {
    margin-block-start: 0;
    margin-block-end: var(--spacing-lg);
    color: var(--color-text-muted-2);
  }
</style>
