---
import { getCollection, render } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterBar from '../../components/FilterBar.astro'
import ViewToggle from '../../components/ViewToggle.astro'
import List from '../../components/List.astro'
import Chip from '../../components/Chip.astro'
import Rating from '../../components/Rating.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'
import { cuisineEmoji } from '../../lib/emoji'
import IconMapPin from '../../assets/IconMapPin.astro'

const places = published(await getCollection('food')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)
const rendered = await Promise.all(
  places.map(async (place) => ({ place, Content: (await render(place)).Content })),
)
const cuisines = [...new Set(places.flatMap((place) => place.data.cuisine))].sort()
const neighborhoods = [
  ...new Set(places.map((place) => place.data.neighborhood).filter(Boolean)),
].sort() as string[]
const hasCoords = places.some((place) => place.data.coords)
---

<BaseLayout>
  <div class="food" data-filter-root data-view="list">
    <header class="secondary-header">
      <div class="wrap">
        {hasCoords && <ViewToggle />}
        <FilterBar
          label="places"
          count={places.length}
          searchPlaceholder="name, neighborhood..."
          facets={[
            { label: 'Cuisine', facet: 'cuisine', options: cuisines },
            { label: 'Neighborhood', facet: 'neighborhood', options: neighborhoods },
          ]}
          sorts={[
            { label: 'Name (A-Z)', value: 'title:asc' },
            { label: 'Rating (high→low)', value: 'rating:desc' },
            { label: 'Rating (low→high)', value: 'rating:asc' },
          ]}
        />
      </div>
    </header>

    <div class="results">
      <List title="Food" class="list-with-map">
        {
          rendered.map(({ place, Content }) => (
            <li
              id={place.id}
              data-filter-item
              data-cuisine={place.data.cuisine.join('|')}
              data-neighborhood={place.data.neighborhood ?? ''}
              data-coords={place.data.coords?.join(',') ?? ''}
              data-title={place.data.title}
              data-address={(place.data.address ?? []).join('\n')}
              data-marker={cuisineEmoji(place.data.cuisine)}
              data-sort-title={place.data.title}
              data-sort-rating={place.data.rating ?? ''}
              data-search={[
                place.data.title,
                place.data.neighborhood,
                ...(place.data.address ?? []),
                ...place.data.cuisine,
                ...place.data.tags,
                place.body,
              ]
                .filter(Boolean)
                .join(' ')}>
              <div class="list-details">
                {hasBody(place) ? (
                  <a class="list-title" href={href(`/food/${place.id}`)}>
                    {place.data.title}
                  </a>
                ) : (
                  <span class="list-title">{place.data.title}</span>
                )}
                {place.data.rating && <Rating value={place.data.rating} />}

                {place.data.neighborhood && (
                  <span class="list-meta">{place.data.neighborhood}</span>
                )}
                {place.data.cuisine && (
                  <div class="chips">
                    {place.data.cuisine.map((cuisine) => (
                      <Chip href={href(`/tags/${cuisine}`)}>{cuisine}</Chip>
                    ))}
                  </div>
                )}
              </div>
              {place.data.address && place.data.address.length > 0 && (
                <p class="list-address">
                  <IconMapPin /> {place.data.address.join(', ')}
                </p>
              )}
              <Content />
            </li>
          ))
        }
      </List>
      {hasCoords && <div class="map" data-map aria-label="Map of food spots" />}
      <p class="empty" data-filter-empty hidden>No places match those filters.</p>
    </div>
  </div>

  <script>
    import { initFilterableMapPage } from '../../scripts/views'
    initFilterableMapPage()
  </script>
</BaseLayout>
