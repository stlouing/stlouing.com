---
import { getCollection, render } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import List from '../../components/List.astro'
import FilterListItem from '../../components/FilterListItem.astro'
import RatingBadge from '../../components/RatingBadge.astro'
import SourceLink from '../../components/SourceLink.astro'
import { published, hasBody } from '../../lib/content'
import { cuisineEmoji } from '../../lib/emoji'
import { googleMapsHref } from '../../lib/maps'

const places = published(await getCollection('food')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)
const rendered = await Promise.all(
  places.map(async (place) => ({ place, Content: (await render(place)).Content })),
)
const cuisines = [...new Set(places.flatMap((place) => place.data.cuisine))].sort()
const neighborhoods = [
  ...new Set(places.map((place) => place.data.neighborhood).filter(Boolean)),
].sort() as string[]
const hasCoords = places.some((place) => place.data.coords)
---

<BaseLayout>
  <FilterMapPage
    class="food"
    label="places"
    count={places.length}
    searchPlaceholder="name, cuisine..."
    facets={[
      { label: 'Cuisine', facet: 'cuisine', options: cuisines },
      { label: 'Neighborhood', facet: 'neighborhood', options: neighborhoods },
    ]}
    sorts={[
      { label: 'Name (A-Z)', value: 'title:asc' },
      { label: 'Rating (high→low)', value: 'rating:desc' },
      { label: 'Rating (low→high)', value: 'rating:asc' },
    ]}
    hasCoords={hasCoords}
    mapLabel="Map of food spots"
    emptyText="No places match those filters.">
    <List class="list-with-map">
      {
        rendered.map(({ place, Content }) => (
          <FilterListItem
            id={place.id}
            title={place.data.title}
            detailHref={`/food/${place.id}`}
            expandable={true}
            readMore={hasBody(place)}
            marker={cuisineEmoji(place.data.cuisine)}
            coords={place.data.coords?.join(',') ?? ''}
            url={place.data.url ?? ''}
            search={[
              place.data.title,
              place.data.neighborhood,
              ...(place.data.address ?? []),
              ...place.data.cuisine,
              ...place.data.tags,
              place.body,
            ]
              .filter(Boolean)
              .join(' ')}
            attrs={{
              'data-cuisine': place.data.cuisine.join('|'),
              'data-neighborhood': place.data.neighborhood ?? '',
              'data-address': (place.data.address ?? []).join('\n'),
              'data-sort-title': place.data.title,
              'data-sort-rating': String(place.data.rating ?? ''),
              'data-google': googleMapsHref(place.data),
            }}>
            {place.data.rating && <RatingBadge slot="lead" value={place.data.rating} />}
            {place.data.neighborhood && (
              <Fragment slot="title-after">
                <button
                  type="button"
                  class="list-meta list-meta-filter"
                  data-filter-set="neighborhood"
                  data-filter-value={place.data.neighborhood}>
                  {place.data.neighborhood}
                </button>
              </Fragment>
            )}
            {place.data.cuisine.length > 0 && (
              <div class="chips" slot="row-end">
                {place.data.cuisine.map((cuisine) => (
                  <button
                    type="button"
                    class="chip"
                    data-filter-set="cuisine"
                    data-filter-value={cuisine}>
                    {cuisine}
                  </button>
                ))}
              </div>
            )}
            {place.data.address && place.data.address.length > 0 && (
              <span class="place-address" slot="sub">
                {place.data.address[0]}
              </span>
            )}
            <div class="place-links">
              <SourceLink href={place.data.url} />
              <SourceLink href={googleMapsHref(place.data)} label="Google Maps" />
            </div>
            <div class="food-preview">
              <Content />
            </div>
          </FilterListItem>
        ))
      }
    </List>
  </FilterMapPage>
</BaseLayout>

<style>
  .food-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }
</style>
