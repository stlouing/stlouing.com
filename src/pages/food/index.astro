---
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'

import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import MapRow from '../../components/MapRow.astro'
import Rating from '../../components/Rating.astro'
import IconSearch from '../../assets/IconSearch.astro'
import SourceLink from '../../components/SourceLink.astro'
import { published, hasBody, excerpt, PREVIEW_EXCERPT_CHARS } from '../../lib/content'
import { cuisineLabel } from '../../lib/cuisine'
import { googleMapsHref } from '../../lib/maps'
import { href } from '../../lib/url'
import { resolveVerdict, verdictLabels, isExplored, type Verdict } from '../../lib/verdict'
import IconArrowRight from '../../assets/IconArrowRight.astro'

// The list groups by verdict (Loved → Liked → Neutral) by default, or
// alphabetically (A / B / C) via the sort control — the grouping itself is built
// client-side by food-groups.ts. Every place appears now: rated spots keep their
// verdict group + color; un-rated spots (tried / want-to-try / suggested) group
// under their status below the rated ones and read grayed on the map.
const verdictRankLetter: Record<Verdict, string> = {
  loved: 'a',
  liked: 'b',
  neutral: 'c',
  'not-for-me': 'd',
}
// Un-rated groups sort after every rated verdict, in pipeline order.
const statusRankLetter: Record<'tried' | 'want-to-try' | 'suggested', string> = {
  tried: 'e',
  'want-to-try': 'f',
  suggested: 'g',
}

const all = published(await getCollection('food'))

// Default DOM order is group-ordered then alphabetical (so the no-JS view reads
// sensibly); filter.ts re-sorts on the client from the data-sort-* keys. Cards
// render a plain-text excerpt (not the full writeup) so the route stays light —
// the full prose lives on each /food/<slug> page.
const rows = (
  await Promise.all(
    all.map(async (place) => {
      const verdict = resolveVerdict(place.data)
      // The grouping/sort key: the verdict for a rated place, else its status.
      const groupKey = verdict ?? place.data.status
      const rankLetter = verdict
        ? verdictRankLetter[verdict]
        : (statusRankLetter[place.data.status as keyof typeof statusRankLetter] ?? 'h')
      // A list-row thumbnail when the place has a photo (480px wide covers the
      // ~33%-of-pane box on 2x displays).
      const thumb = place.data.photo
        ? await getImage({ src: place.data.photo, width: 480, format: 'webp' })
        : undefined

      return { place, verdict, groupKey, rankLetter, thumb, explored: isExplored(place.data.status) }
    }),
  )
)
  .sort(
    (left, right) =>
      left.rankLetter.localeCompare(right.rankLetter) ||
      left.place.data.title.localeCompare(right.place.data.title),
  )

const count = rows.length
const cuisines = [...new Set(rows.flatMap((entry) => entry.place.data.cuisine))].sort()
const neighborhoods = [
  ...new Set(rows.map((entry) => entry.place.data.neighborhood).filter(Boolean)),
].sort() as string[]
const hasCoords = rows.some((entry) => entry.place.data.coords)

// Verdict facet options (matched against each row's data-verdict), best-first and
// only the verdicts actually present; labels come from verdictLabels ("Loved", …).
const verdictOptions = (['loved', 'liked', 'neutral', 'not-for-me'] as Verdict[])
  .filter((value) => rows.some((entry) => entry.verdict === value))
  .map((value) => ({ value, label: verdictLabels[value] }))

---

<BaseLayout
  title="St. Louis Food Map - Restaurants & Cafes"
  description="An interactive map of St. Louis restaurants and cafes, filterable by cuisine and neighborhood. Each place is rated by me and reviewed by the community.">
  <FilterMapPage
    class="food"
    floating
    cluster
    label="places"
    count={count}
    search={false}
    facets={[
      { label: 'Cuisine', facet: 'cuisine', options: cuisines },
      { label: 'Neighborhood', facet: 'neighborhood', options: neighborhoods },
      { label: 'Rating', facet: 'verdict', options: verdictOptions },
    ]}
    sorts={[
      { label: 'Rating', value: 'verdict:asc' },
      { label: 'Alphabetical', value: 'name:asc' },
    ]}
    hasCoords={hasCoords}
    mapLabel="Map of food spots"
    emptyText="No places match those filters.">
    <div class="map-list food-grouped">
      <div class="list-pane-header">
        <span class="pane-left">
          <h1 class="pane-title">Food</h1>
          <span class="pane-count"><span data-filter-count>{count}</span></span>
        </span>
        <div class="pane-links">
          <label class="pane-search-wrap">
            <IconSearch />
            <input
              class="pane-search"
              type="search"
              placeholder="name, cuisine"
              autocomplete="off"
              aria-label="Search places"
              data-filter-search
            />
          </label>
        </div>
      </div>
      <ul class="list" data-food-rows>
        {
          rows.map(({ place, verdict, groupKey, rankLetter, thumb, explored }) => (
            <MapRow
              id={place.id}
              title={place.data.title}
              detailHref={`/food/${place.id}/`}
              readMore={false}
              coords={place.data.coords?.join(',') ?? ''}
              url={place.data.url ?? ''}
              search={[
                place.data.title,
                place.data.neighborhood,
                ...(place.data.address ?? []),
                ...place.data.cuisine,
                ...place.data.tags,
                // The excerpt (writeup opening), not the full body — keeps the
                // route's payload light while still searching the prose lead-in.
                hasBody(place) ? excerpt(place.body, 120) : '',
              ]
                .filter(Boolean)
                .join(' ')}
              attrs={{
                'data-cuisine': place.data.cuisine[0],
                'data-neighborhood': place.data.neighborhood ?? '',
                'data-address': (place.data.address ?? []).join('\n'),
                // data-verdict drives the Rating facet + group color, so it's set
                // only for rated places; data-group is the grouping key for all.
                ...(verdict ? { 'data-verdict': verdict } : {}),
                // Far-flung spots opt out of the map's default framing (still pinned).
                ...(place.data.excludeFromMapFit ? { 'data-exclude-fit': '' } : {}),
                'data-group': groupKey,
                // Grayed marker on the map for places I haven't visited yet.
                'data-explored': String(explored),
                'data-sort-name': place.data.title.toLowerCase(),
                'data-sort-verdict': `${rankLetter}|${place.data.title.toLowerCase()}`,
                'data-google': googleMapsHref(place.data),
                'data-photo': thumb?.src ?? '',
                'data-instagram': place.data.instagram ?? '',
                'data-tagline': place.data.description ?? '',
                'data-excerpt': hasBody(place) ? excerpt(place.body, PREVIEW_EXCERPT_CHARS) : '',
              }}>
              {(place.data.cuisine.length > 0 || place.data.neighborhood) && (
                <span class="list-meta" slot="eyebrow">
                  {[...place.data.cuisine.map((cuisine) => cuisineLabel(cuisine)), place.data.neighborhood]
                    .filter(Boolean)
                    .map((part, partIndex) => (
                      <>
                        {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
                        {part}
                      </>
                    ))}
                </span>
              )}
              {thumb && (
                <div
                  class="list-photo"
                  style={`background-image: url(${thumb.src})`}
                  aria-hidden="true"
                />
              )}
              {hasBody(place) && (
                <div class="map-preview">{excerpt(place.body, PREVIEW_EXCERPT_CHARS)}</div>
              )}
            </MapRow>
          ))
        }
      </ul>
      {
        /* Hidden fleur ratings, one per verdict, cloned into each verdict group
          header by food-groups.ts (which builds the headers client-side). */
      }
      <div class="fleur-templates" hidden>
        <span data-fleur="loved"><Rating verdict="loved" /></span>
        <span data-fleur="liked"><Rating verdict="liked" /></span>
        <span data-fleur="neutral"><Rating verdict="neutral" /></span>
        <span data-fleur="not-for-me"><Rating verdict="not-for-me" /></span>
      </div>
    </div>
  </FilterMapPage>
</BaseLayout>

<script>
  import { initFoodGroups } from '../../scripts/food-groups'

  initFoodGroups()
</script>

<style>
  /* The search fills whatever width the title row leaves over. */
  .pane-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex: 1;
    margin-inline-start: var(--spacing-lg);
  }

  /* The header search field, standing in for the old Favorites button: a
     pixel magnifier inset on the left, the input stretching the rest. */
  .pane-search-wrap {
    position: relative;
    display: flex;
    flex: 1;
  }

  .pane-search-wrap :global(.icon) {
    position: absolute;
    inset-inline-start: var(--spacing-sm);
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    pointer-events: none;
  }

  .pane-links .pane-search {
    width: 100%;
    padding-inline-start: calc(var(--spacing-sm) + 16px + var(--spacing-sm));
  }
</style>
