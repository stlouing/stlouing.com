---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import MapRow from '../../components/MapRow.astro'
import SourceLink from '../../components/SourceLink.astro'
import { published, hasBody, excerpt } from '../../lib/content'
import { cuisineEmoji } from '../../lib/emoji'
import { googleMapsHref } from '../../lib/maps'
import { href } from '../../lib/url'
import { resolveVerdict, verdictLabels, type Verdict } from '../../lib/verdict'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconAward from '../../assets/IconAward.astro'
import IconMapPin from '../../assets/IconMapPin.astro'

// The list groups by verdict (Loved → Liked → Neutral) by default, or
// alphabetically (A / B / C) via the sort control — the grouping itself is built
// client-side by food-groups.ts. Only places with a verdict appear; unrated spots
// stay off the list + map until they earn one.
const verdictRank: Record<Verdict, number> = { loved: 0, liked: 1, neutral: 2, 'not-for-me': 3 }
const verdictRankLetter: Record<Verdict, string> = {
  loved: 'a',
  liked: 'b',
  neutral: 'c',
  'not-for-me': 'd',
}

const all = published(await getCollection('food'))

// Default DOM order is verdict-grouped then alphabetical (so the no-JS view reads
// sensibly); filter.ts re-sorts on the client from the data-sort-* keys. Cards
// render a plain-text excerpt (not the full writeup) so the route stays light —
// the full prose lives on each /food/<slug> page.
const rated = all
  .map((place) => ({ place, verdict: resolveVerdict(place.data) }))
  .filter((entry) => entry.verdict)
  .sort(
    (left, right) =>
      verdictRank[left.verdict as Verdict] - verdictRank[right.verdict as Verdict] ||
      left.place.data.title.localeCompare(right.place.data.title),
  )

const count = rated.length
const cuisines = [...new Set(rated.flatMap((entry) => entry.place.data.cuisine))].sort()
const neighborhoods = [
  ...new Set(rated.map((entry) => entry.place.data.neighborhood).filter(Boolean)),
].sort() as string[]
const hasCoords = rated.some((entry) => entry.place.data.coords)

// Verdict facet options (matched against each row's data-verdict), best-first and
// only the verdicts actually present; labels come from verdictLabels ("Loved", …).
const verdictOptions = (['loved', 'liked', 'neutral', 'not-for-me'] as Verdict[])
  .filter((value) => rated.some((entry) => entry.verdict === value))
  .map((value) => ({ value, label: verdictLabels[value] }))
---

<BaseLayout
  description="An interactive map of the St. Louis restaurants, filterable by cuisine and neighborhood. Every rating is my own.">
  <FilterMapPage
    class="food"
    floating
    label="places"
    count={count}
    searchPlaceholder="name, cuisine..."
    facets={[
      { label: 'Rating', facet: 'verdict', options: verdictOptions },
      { label: 'Cuisine', facet: 'cuisine', options: cuisines },
      { label: 'Neighborhood', facet: 'neighborhood', options: neighborhoods },
    ]}
    sorts={[
      { label: 'Rating', value: 'verdict:asc' },
      { label: 'Alphabetical', value: 'name:asc' },
    ]}
    hasCoords={hasCoords}
    mapLabel="Map of food spots"
    emptyText="No places match those filters.">
    <div class="map-list food-grouped">
      <div class="list-pane-header">
        <span class="pane-left">
          <h1 class="pane-title">Food</h1>
          <span class="pane-count"><span data-filter-count>{count}</span></span>
        </span>
        <div class="pane-links">
          <a class="btn btn-outline btn-compact" href={href('/best/')}><IconAward />Favorites</a>
          <a class="btn btn-outline btn-compact" href={href('/food/on-the-list/')}>
            On the List <IconArrowRight />
          </a>
        </div>
      </div>
      <ul class="list" data-food-rows>
        {
          rated.map(({ place, verdict }) => (
            <MapRow
              id={place.id}
              title={place.data.title}
              detailHref={`/food/${place.id}/`}
              readMore={false}
              marker={cuisineEmoji(place.data.cuisine)}
              coords={place.data.coords?.join(',') ?? ''}
              url={place.data.url ?? ''}
              search={[
                place.data.title,
                place.data.neighborhood,
                ...(place.data.address ?? []),
                ...place.data.cuisine,
                ...place.data.tags,
                // The excerpt (writeup opening), not the full body — keeps the
                // route's payload light while still searching the prose lead-in.
                hasBody(place) ? excerpt(place.body, 160) : '',
              ]
                .filter(Boolean)
                .join(' ')}
              attrs={{
                'data-cuisine': place.data.cuisine[0],
                'data-neighborhood': place.data.neighborhood ?? '',
                'data-address': (place.data.address ?? []).join('\n'),
                'data-verdict': verdict as Verdict,
                'data-sort-name': place.data.title.toLowerCase(),
                'data-sort-verdict': `${verdictRankLetter[verdict as Verdict]}|${place.data.title.toLowerCase()}`,
                'data-google': googleMapsHref(place.data),
                'data-instagram': place.data.instagram ?? '',
                'data-tagline': place.data.description ?? '',
                'data-excerpt': hasBody(place) ? excerpt(place.body, 150) : '',
              }}>
              {(place.data.cuisine.length > 0 || place.data.neighborhood) && (
                <div class="chips" slot="sub">
                  {place.data.cuisine.map((cuisine) => (
                    <button
                      type="button"
                      class="chip"
                      data-filter-set="cuisine"
                      data-filter-value={cuisine}>
                      <span>{cuisineEmoji(place.data.cuisine)}</span>
                      <span>{cuisine}</span>
                    </button>
                  ))}
                  {place.data.neighborhood && (
                    <button
                      type="button"
                      class="chip"
                      data-filter-set="neighborhood"
                      data-filter-value={place.data.neighborhood}>
                      <IconMapPin />
                      <span>{place.data.neighborhood}</span>
                    </button>
                  )}
                </div>
              )}
              {place.data.description && <div class="list-tagline">{place.data.description}</div>}
              {hasBody(place) && <div class="food-preview">{excerpt(place.body, 200)}</div>}
            </MapRow>
          ))
        }
      </ul>
    </div>
  </FilterMapPage>
</BaseLayout>

<script>
  import { initFoodGroups } from '../../scripts/food-groups'

  initFoodGroups()
</script>

<style>
  .food-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    line-height: 1.4;
  }

  .pane-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }
</style>
