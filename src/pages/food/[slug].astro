---
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AsideHeading from '../../components/AsideHeading.astro'
import Backlinks from '../../components/Backlinks.astro'
import Comments from '../../components/Comments.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import TagList from '../../components/TagList.astro'
import ReadersVerdict from '../../components/ReadersVerdict.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import SourceLink from '../../components/SourceLink.astro'
import Locator from '../../components/Locator.astro'
import MyPick from '../../components/MyPick.astro'
import Rating from '../../components/Rating.astro'
import CardList from '../../components/CardList.astro'
import Card from '../../components/Card.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { published, excerpt, hasBody, META_DESCRIPTION_CHARS } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { neighborhoodHref } from '../../lib/neighborhoods'
import { resolveVerdict, resolveWriterState, verdictLabels } from '../../lib/verdict'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineLabel } from '../../lib/cuisine'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconInstagram from '../../assets/IconInstagram.astro'

export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const writerState = resolveWriterState(data)
const stubNote =
  writerState.kind === 'pending'
    ? `I've been to ${data.title}, but I haven't written up a review yet.`
    : `I haven't made it to ${data.title} yet, but it's on my list to try.`
const lastUpdated = data.updated ?? data.created
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)

const sharePhoto = data.photo
  ? await getImage({ src: data.photo, width: 1200, format: 'jpeg' })
  : undefined
const shareImage = sharePhoto ? rootRelative(sharePhoto.src) : data.ogImage

const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  image: new URL(href(shareImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
})

const trail = [
  { label: 'Food', href: '/food/' },
  ...(data.neighborhood ? [{ label: data.neighborhood, href: neighborhoodLink ?? undefined }] : []),
  ...(data.cuisine[0]
    ? [{ label: cuisineLabel(data.cuisine[0]), href: `/food/?cuisine=${data.cuisine[0]}` }]
    : []),
]

const allFood = published(await getCollection('food'))
const topRelated = (places: typeof allFood) =>
  [...places]
    .sort((left, right) => (right.data.rating ?? 0) - (left.data.rating ?? 0))
    .slice(0, 2)
    .map((place) => ({ place, verdict: resolveVerdict(place.data) }))

const relatedNeighborhood = data.neighborhood
  ? topRelated(
      allFood.filter(
        (place) => place.id !== entry.id && place.data.neighborhood === data.neighborhood,
      ),
    )
  : []
const primaryCuisine = data.cuisine[0]
const relatedCuisine = primaryCuisine
  ? topRelated(
      allFood.filter(
        (place) =>
          place.id !== entry.id &&
          place.data.cuisine.includes(primaryCuisine) &&
          place.data.neighborhood !== data.neighborhood,
      ),
    )
  : []

const relatedIds = new Set([...relatedNeighborhood, ...relatedCuisine].map((item) => item.place.id))
const mentionedIn = backlinks.filter(
  (backlink) => !(backlink.collection === 'food' && relatedIds.has(backlink.id)),
)

const seoTitle = primaryCuisine
  ? `${data.title} - ${cuisineLabel(primaryCuisine)} in St. Louis`
  : `${data.title} in St. Louis`
const locality = data.neighborhood ? `${data.neighborhood}, St. Louis` : 'St. Louis'
const stubDescription = [
  data.description,
  primaryCuisine
    ? `${cuisineLabel(primaryCuisine)} in ${locality}`
    : `${data.title} in ${locality}`,
  writerState.statement,
]
  .filter(Boolean)
  .join(' — ')
const seoDescription = hasBody(entry)
  ? excerpt(entry.body, META_DESCRIPTION_CHARS)
  : stubDescription
---

<BaseLayout
  article
  crumb={data.title}
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  ogImage={shareImage}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}
  jsonLd={schema}>
  <article class="page detail-page">
    <Breadcrumbs trail={trail} />

    <header class="detail-pane-header">
      <h1 class="detail-pane-title">{data.title}</h1>
      {data.description && <p class="description description--lg detail-pane-tagline">{data.description}</p>}
      <TagList tags={data.tags} />
      <div class="pane-stats">
        <div class="pane-stat">
          <span class="pane-stat-label eyebrow eyebrow--muted">My rating</span>
          <span class="pane-stat-value my-rating-line">
            <Rating verdict={writerState.verdict} />
            <span class:list={[writerState.verdict ? ['my-rating-word', 'eyebrow'] : 'description']}>
              {writerState.verdict ? verdictLabels[writerState.verdict] : writerState.statement}
            </span>
          </span>
        </div>
        <ReadersVerdict slug={entry.id} title={data.title} />
                <a class="pane-stat pane-stat-link" href="#comments" data-comments-link hidden>
          <span class="pane-stat-label eyebrow eyebrow--muted">Comments</span>
          <span class="pane-stat-value continue-link">
            <span data-comments-cell-value>Leave a comment</span>
          </span>
        </a>
      </div>
    </header>

    <div class="body">
      <div class="detail-layout">
        <div class="detail-main">
          {
            data.photo && (
              <Image
                class="detail-photo"
                src={data.photo}
                alt={`Photo of ${data.title}`}
                widths={[400, 800]}
                sizes="(min-width: 900px) 600px, 100vw"
              />
            )
          }

          <Content />
          {
            !hasBody(entry) && (
              <div class="not-explored">
                <p>{stubNote}</p>
              </div>
            )
          }

          {
            hasBody(entry) && lastUpdated && (
              <Byline>
                <Fragment slot="footer-meta">
                  <EntryDates created={data.created} updated={data.updated} />
                </Fragment>
              </Byline>
            )
          }

          <Comments kind="food" slug={entry.id} title={data.title} />

          <section class="more-food">
            {
              relatedNeighborhood.length > 0 && (
                <CardList
                  title={`More in ${data.neighborhood}`}
                  class="card-cells"
                  moreHref={href(`/food/?neighborhood=${encodeURIComponent(data.neighborhood)}`)}>
                  {relatedNeighborhood.map(({ place, verdict }) => (
                    <Card
                      href={href(`/food/${place.id}/`)}
                      title={place.data.title}
                      meta={cuisineLabel(place.data.cuisine[0])}
                      description={place.data.description}
                      verdict={verdict}
                    />
                  ))}
                </CardList>
              )
            }
            {
              relatedCuisine.length > 0 && (
                <CardList
                  title={`More ${cuisineLabel(primaryCuisine)}`}
                  class="card-cells"
                  moreHref={href(`/food/?cuisine=${primaryCuisine}`)}>
                  {relatedCuisine.map(({ place, verdict }) => (
                    <Card
                      href={href(`/food/${place.id}/`)}
                      title={place.data.title}
                      meta={place.data.neighborhood}
                      description={place.data.description}
                      verdict={verdict}
                    />
                  ))}
                </CardList>
              )
            }
          </section>

          <footer>
            <Backlinks links={mentionedIn} />
          </footer>
        </div>
        <aside class="detail-aside">
          <div>
            <Locator coords={data.coords} label={data.neighborhood} />
            <a class="continue-link aside-more-link" href={href('/food/')}>
              Back to food map <IconArrowRight />
            </a>
          </div>
          {
            data.address && data.address.length > 0 && (
              <div>
                <AsideHeading title="Address" />
                <address class="address">
                  {data.address.map((line) => (
                    <span>{line}</span>
                  ))}
                </address>
                {googleMapsHref(data) && (
                  <a
                    class="continue-link aside-more-link"
                    href={googleMapsHref(data)}
                    target="_blank"
                    rel="noopener">
                    View directions <IconArrowRight />
                  </a>
                )}
              </div>
            )
          }
          {
            (data.url || data.instagram || googleMapsHref(data)) && (
              <>
                <div>
                  <AsideHeading title="Links" />
                  <div class="detail-links">
                    <SourceLink
                      href={data.url}
                      label={data.url ? displayUrl(data.url) : ''}
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <IconExternalLink slot="icon" />
                    </SourceLink>
                    <SourceLink
                      href={data.instagram}
                      label="Instagram"
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <IconInstagram slot="icon" />
                    </SourceLink>
                    <SourceLink
                      href={googleMapsHref(data)}
                      label="Google Maps"
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <IconMapPin slot="icon" />
                    </SourceLink>
                  </div>
                </div>
              </>
            )
          }
          {
            data.pick && (
              <>
                <MyPick pick={data.pick} />
              </>
            )
          }
        </aside>
      </div>
    </div>

  </article>
</BaseLayout>

<script>
  import { initReadersVerdict } from '../../scripts/readers-verdict'
  initReadersVerdict()
</script>

<style>
  .detail-page {
    margin-block-end: var(--spacing-xl);
  }

  .detail-page :global(.breadcrumbs) {
    justify-content: flex-start;
    margin-block-start: var(--spacing-xl);
  }

  .detail-pane-header .pane-stats :global(.verdict-bar) {
    flex: 1 1 0;
  }

  .my-rating-line {
    display: flex;
    align-items: flex-end;
    gap: var(--spacing-sm);
  }

  .my-rating-word {
    font-weight: 700;
    color: var(--color-accent-gold);
  }

  .my-rating-line :global(.rating .rating-fleur) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .detail-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin-block-end: var(--spacing-lg);
  }

  .address {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-muted-2);
    text-align: start;
    font-weight: 400;
    line-height: 1.4;
  }
</style>
