---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EditThisPage from '../../components/EditThisPage.astro'
import BackLink from '../../components/BackLink.astro'
import TagList from '../../components/TagList.astro'
import Backlinks from '../../components/Backlinks.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'

export async function getStaticPaths() {
  const places = published(await getCollection('food')).filter(hasBody)
  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
---

<BaseLayout crumb={data.title} description={data.description}>
  <BackLink to="/food" label="Food" />

  <article class="entry">
    <h1>{data.title}</h1>

    <p class="meta">
      {data.rating != null && <span class="rating">★ {data.rating}/10</span>}
      {data.neighborhood && <span class="where">{data.neighborhood}</span>}
      {
        data.cuisine.map((cuisine) => (
          <a class="chip" href={href(`/tags/${cuisine}`)}>
            {cuisine}
          </a>
        ))
      }
    </p>

    {data.description && <p class="lead">{data.description}</p>}

    {data.address && <p class="address">{data.address}</p>}
    {
      data.url && (
        <p class="link">
          <a href={data.url} rel="noopener">
            Website ↗
          </a>
        </p>
      )
    }

    <div class="body">
      <Content />
    </div>

    <TagList tags={data.tags} />
    <Backlinks links={backlinks} />
    <EditThisPage path={entry.filePath} />
  </article>
</BaseLayout>
