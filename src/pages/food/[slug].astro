---
import { SUPABASE_ENABLED } from '../../lib/site'
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AsideHeading from '../../components/AsideHeading.astro'
import Comments from '../../components/Comments.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ReaderVote from '../../components/ReaderVote.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import SourceLink from '../../components/SourceLink.astro'
import Locator from '../../components/Locator.astro'
import MyPick from '../../components/MyPick.astro'
import Rating from '../../components/Rating.astro'
import CardList from '../../components/CardList.astro'
import Card from '../../components/Card.astro'
import NotExplored from '../../components/NotExplored.astro'
import PaneKicker from '../../components/PaneKicker.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { published, excerpt, hasBody, foodStatus, META_DESCRIPTION_CHARS } from '../../lib/content'
import { isoDate } from '../../lib/dates'
import { neighborhoodHref, neighborhoodName, placeLocality } from '../../lib/neighborhoods'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineLabel, cuisinePlacePhrase } from '../../lib/cuisine'
import Icon from '../../components/Icon.astro'

export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const stubNote =
  foodStatus(entry) === 'tried'
    ? `I've been to ${data.title}, but I haven't written up a review yet.`
    : `I haven't made it to ${data.title} yet, but it's on my list to try.`
const lastUpdated = data.updated ?? data.created
const { Content } = await render(entry)
const isStub = !hasBody(entry)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)
const districtLink = await neighborhoodHref(data.district)

const sharePhoto = data.photo
  ? await getImage({ src: data.photo, width: 1200, format: 'jpeg' })
  : undefined
const shareImage = sharePhoto ? rootRelative(sharePhoto.src) : data.ogImage

const publishedDate = hasBody(entry) && data.created ? isoDate(data.created) : undefined
const modifiedDate = hasBody(entry) && lastUpdated ? isoDate(lastUpdated) : undefined

const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  image: new URL(href(shareImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
  published: publishedDate,
  updated: modifiedDate,
})

const allFood = published(await getCollection('food'))
const cuisineHref = (cuisine: string): string =>
  href(`/food/?cuisine=${encodeURIComponent(cuisine)}`)

const trail = [
  { label: 'Food', href: '/food/' },
  ...(data.neighborhood
    ? [{ label: neighborhoodName(data.neighborhood), href: neighborhoodLink ?? undefined }]
    : []),
  ...(data.cuisine[0]
    ? [{ label: cuisineLabel(data.cuisine[0]), href: cuisineHref(data.cuisine[0]) }]
    : []),
]

const relatedPool = allFood.filter((place) => hasBody(place))
const relatedLimit = 3
const withRating = (place: (typeof allFood)[number]) => ({
  place,
  rating: place.data.rating,
})
const topRelated = (places: typeof allFood) =>
  [...places]
    .sort((left, right) => (right.data.rating ?? 0) - (left.data.rating ?? 0))
    .slice(0, relatedLimit)
    .map(withRating)

const relatedNeighborhood =
  isStub && data.neighborhood
    ? topRelated(
        relatedPool.filter(
          (place) => place.id !== entry.id && place.data.neighborhood === data.neighborhood,
        ),
      )
    : []
const primaryCuisine = data.cuisine[0]

const distanceBetween = (from: [number, number], to: [number, number]) => {
  const toRadians = (degrees: number) => (degrees * Math.PI) / 180
  const latitudeDelta = toRadians(to[0] - from[0])
  const longitudeDelta = toRadians(to[1] - from[1]) * Math.cos(toRadians((from[0] + to[0]) / 2))

  return Math.sqrt(latitudeDelta ** 2 + longitudeDelta ** 2)
}
const alreadyRelated = new Set(relatedNeighborhood.map((item) => item.place.id))
const nearbyWritten =
  isStub && data.coords && relatedNeighborhood.length < relatedLimit
    ? relatedPool
        .filter(
          (place) => place.id !== entry.id && place.data.coords && !alreadyRelated.has(place.id),
        )
        .sort(
          (left, right) =>
            distanceBetween(data.coords as [number, number], left.data.coords as [number, number]) -
            distanceBetween(data.coords as [number, number], right.data.coords as [number, number]),
        )
        .slice(0, relatedLimit - relatedNeighborhood.length)
        .map(withRating)
    : []

const nearby = [...relatedNeighborhood, ...nearbyWritten]

const locality = placeLocality(data.neighborhood, data.address)
const districtName = data.district ? neighborhoodName(data.district) : undefined
const streetAddress = data.address?.[0]
const stubSummary = [
  `${data.title} is ${cuisinePlacePhrase(primaryCuisine)} in ${locality}.`,
  streetAddress
    ? `It's located at ${streetAddress}${districtName ? `, in the ${districtName} district` : ''}.`
    : '',
]
  .filter(Boolean)
  .join(' ')
const titleLead = hasBody(entry) ? `${data.title} Review` : data.title
const seoTitle = primaryCuisine
  ? `${titleLead}: ${cuisineLabel(primaryCuisine)} in ${locality}`
  : `${titleLead} in ${locality}`
const stubDescription = [
  data.description,
  primaryCuisine
    ? `${cuisineLabel(primaryCuisine)} in ${locality}`
    : `${data.title} in ${locality}`,
]
  .filter(Boolean)
  .join(' — ')
const seoDescription = hasBody(entry)
  ? excerpt(entry.body, META_DESCRIPTION_CHARS)
  : stubDescription
---

<BaseLayout
  crumb={data.title}
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
  ogImage={shareImage}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}
  noindex={isStub}
  jsonLd={schema}>
  <article class="detail-page">
    <Breadcrumbs trail={trail} />

    <header class="detail-pane-header">
      <h1 class="detail-pane-title title-page">{data.title}</h1>
      {data.description && <p class="description description--lg detail-pane-tagline">{data.description}</p>}
      {
        districtLink && districtName && (
          <PaneKicker label="District:">
            <a href={href(districtLink)}>{districtName}</a>
          </PaneKicker>
        )
      }
      <div class="pane-stats">
        <div class="pane-stat">
          <span class="pane-stat-label eyebrow eyebrow--muted">My rating</span>
          <span class="pane-stat-value my-rating-line">
            <Rating rating={data.rating} />
          </span>
        </div>
        <ReaderVote slug={entry.id} title={data.title} />
        {
          SUPABASE_ENABLED && (
            <a class="pane-stat pane-stat-link" href="#comments" data-comments-link hidden>
              <span class="pane-stat-label eyebrow eyebrow--muted">Comments</span>
              <span class="pane-stat-value continue-link">
                <span data-comments-cell-value>Leave a comment</span>
              </span>
            </a>
          )
        }
      </div>
    </header>

    <div class="body">
      <div class="detail-layout">
        <div class="detail-main">
          {
            data.photo && (
              <Image
                class="detail-photo photo-frame"
                src={data.photo}
                alt={`Photo of ${data.title}`}
                widths={[400, 800]}
                sizes="(min-width: 900px) 600px, 100vw"
              />
            )
          }

          <Content />
          {
            !hasBody(entry) && (
              <NotExplored note={stubNote}>
                {stubSummary}
                {(data.url || data.instagram) && (
                  <Fragment>
                    You can {data.url && (
                      <Fragment>check out their website at <a href={data.url} target="_blank" rel="noopener">{displayUrl(data.url)}</a></Fragment>
                    )}{data.url && data.instagram && ' or '}{data.instagram && (
                      <a href={data.instagram} target="_blank" rel="noopener">follow them on Instagram</a>
                    )}.
                  </Fragment>
                )}
              </NotExplored>
            )
          }

          {
            hasBody(entry) && lastUpdated && (
              <Byline>
                <Fragment slot="footer-meta">
                  <EntryDates created={data.created} updated={data.updated} />
                </Fragment>
              </Byline>
            )
          }

          <Comments kind="food" slug={entry.id} title={data.title} />

          {
            nearby.length > 0 && (
              <CardList title="Nearby" class="card-cells" moreHref={href('/food/')}>
                {nearby.map(({ place, rating }) => (
                  <Card
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={neighborhoodName(place.data.neighborhood)}
                    description={place.data.description}
                    rating={rating}
                  />
                ))}
              </CardList>
            )
          }
        </div>
        <aside class="detail-aside">
          <div>
            <Locator coords={data.coords} label={neighborhoodName(data.neighborhood)} />
            <a class="continue-link aside-more-link" href={href('/food/')}>
              Restaurant & cafe map <Icon name="arrow-right" />
            </a>
          </div>
          {
            data.address && data.address.length > 0 && (
              <div>
                <AsideHeading title="Address" />
                <address class="address">
                  {data.address.map((line) => (
                    <span>{line}</span>
                  ))}
                </address>
                {googleMapsHref(data) && (
                  <a
                    class="continue-link aside-more-link"
                    href={googleMapsHref(data)}
                    target="_blank"
                    rel="noopener">
                    View directions <Icon name="arrow-right" />
                  </a>
                )}
              </div>
            )
          }
          {
            (data.url || data.instagram || googleMapsHref(data)) && (
              <>
                <div>
                  <AsideHeading title="Links" />
                  <div class="detail-links">
                    <SourceLink
                      href={data.url}
                      label={data.url ? displayUrl(data.url) : ''}
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <Icon name="external-link" slot="icon" />
                    </SourceLink>
                    <SourceLink
                      href={data.instagram}
                      label="Instagram"
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <Icon name="instagram" slot="icon" />
                    </SourceLink>
                    <SourceLink
                      href={googleMapsHref(data)}
                      label="Google Maps"
                      variant="quiet"
                      compact={false}
                      class="btn-inline">
                      <Icon name="map-pin" slot="icon" />
                    </SourceLink>
                  </div>
                </div>
              </>
            )
          }
          {
            data.pick && (
              <>
                <MyPick pick={data.pick} />
              </>
            )
          }
        </aside>
      </div>
    </div>

  </article>
</BaseLayout>

<script>
  import { initReaderVotes } from '../../scripts/reader-votes'
  initReaderVotes()
</script>

<style>
  .review-disclaimer {
    margin-block: var(--spacing-md) 0;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .detail-page {
    margin-block-end: var(--spacing-lg);
  }

  @media (max-width: 899px) {
    .detail-aside {
      order: -1;
      border-block-end: 1px solid var(--color-line);
    }
  }

  .my-rating-line {
    display: flex;
  }

  .my-rating-line :global(.rating .rating-fleur) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .address {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-md);
    font-style: normal;
    color: var(--color-muted-2);
    text-align: start;
    font-weight: 400;
    line-height: 1.4;
  }
</style>
