---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Chip from '../../components/Chip.astro'
import Verdict from '../../components/Verdict.astro'
import SourceLink from '../../components/SourceLink.astro'
import FoodLocator from '../../components/FoodLocator.astro'
import MyPick from '../../components/MyPick.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import { href } from '../../lib/url'
import { published, excerpt, hasBody } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { neighborhoodHref } from '../../lib/neighborhoods'
import { resolveVerdict } from '../../lib/verdict'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineEmoji } from '../../lib/emoji'
import IconMap from '../../assets/IconMap.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconInstagram from '../../assets/IconInstagram.astro'

// Every food entry gets a page (metadata only when there's no writeup yet).
export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const verdict = resolveVerdict(data)
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)
const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  image: new URL(href(data.ogImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
})

// Breadcrumb: Food / <neighborhood> (the neighborhood links to its page when one
// exists, otherwise it's a plain crumb).
const trail = [
  { label: 'Food', href: '/food' },
  ...(data.neighborhood ? [{ label: data.neighborhood, href: neighborhoodLink ?? undefined }] : []),
]

// Related places for the "more food" footer: others in the same neighborhood, and
// others sharing this place's primary cuisine (best-rated first, capped, and
// de-duped so a place shows in at most one group).
const allFood = published(await getCollection('food'))
// Top related places, each paired with its verdict for display.
const topRelated = (places: typeof allFood) =>
  [...places]
    .sort((left, right) => (right.data.rating ?? 0) - (left.data.rating ?? 0))
    .slice(0, 6)
    .map((place) => ({ place, verdict: resolveVerdict(place.data) }))

const relatedNeighborhood = data.neighborhood
  ? topRelated(
      allFood.filter(
        (place) => place.id !== entry.id && place.data.neighborhood === data.neighborhood,
      ),
    )
  : []
const primaryCuisine = data.cuisine[0]
const relatedCuisine = primaryCuisine
  ? topRelated(
      allFood.filter(
        (place) =>
          place.id !== entry.id &&
          place.data.cuisine.includes(primaryCuisine) &&
          place.data.neighborhood !== data.neighborhood,
      ),
    )
  : []

// "Mentioned in" should only surface links not already shown in the related-food
// groups above, so a place doesn't appear twice on the same page.
const relatedIds = new Set([...relatedNeighborhood, ...relatedCuisine].map((item) => item.place.id))
const mentionedIn = backlinks.filter(
  (backlink) => !(backlink.collection === 'food' && relatedIds.has(backlink.id)),
)

// SEO: a richer <title> (name + cuisine + city) than the bare breadcrumb name,
// plus a per-page meta description pulled from the writeup so pages don't all
// share the generic site description.
const seoTitle = primaryCuisine
  ? `${data.title} - ${primaryCuisine} in St. Louis`
  : `${data.title} in St. Louis`
const seoDescription = hasBody(entry) ? excerpt(entry.body, 155) : undefined
---

<BaseLayout
  crumb={data.title}
  title={seoTitle}
  description={seoDescription}
  ogImage={data.ogImage}
  jsonLd={schema}>
  <Breadcrumbs trail={trail} />
  <Entry title={data.title} tags={data.tags} editPath={entry.filePath} backlinks={mentionedIn}>
    <Fragment slot="meta">
      <div class="food-meta">
        {
          data.address && data.address.length > 0 && (
            <>
              <div class="address">
                <IconMapPin /> {data.address.join(', ')}
              </div>
            </>
          )
        }
        <div class="food-sub-meta">
          <div class="food-sub-meta-section">
            {verdict && <Verdict verdict={verdict} icon filled />}
            {
              data.cuisine.map((cuisine) => (
                <Chip href={href(`/tags/${cuisine}`)}>
                  <span>{cuisineEmoji(data.cuisine)}</span>
                  <span>{cuisine}</span>
                </Chip>
              ))
            }
          </div>
          <div class="food-sub-meta-section food-links">
            <SourceLink href={data.url} label="Website">
              <IconExternalLink slot="icon" />
            </SourceLink>
            <SourceLink href={data.instagram} label="Instagram">
              <IconInstagram slot="icon" />
            </SourceLink>
            <SourceLink href={googleMapsHref(data)} label="Directions">
              <IconMapPin slot="icon" />
            </SourceLink>
          </div>
        </div>
      </div>
    </Fragment>

    <div class="food-layout">
      <aside class="food-aside">
        <FoodLocator coords={data.coords} label={data.neighborhood} />
        <a class="btn btn-outline food-map-link" href={href('/food')}>
          <IconMap /> Back to the Food Map
        </a>
        {data.pick && <MyPick pick={data.pick} cuisine={data.cuisine} />}
      </aside>
      <div class="food-main">
        <Content />
        <section class="more-food">
          {
            relatedNeighborhood.length > 0 && (
              <RelatedList title={`More in ${data.neighborhood}`}>
                {relatedNeighborhood.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}`)}
                    title={place.data.title}
                    meta={place.data.cuisine[0]}
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
          {
            relatedCuisine.length > 0 && (
              <RelatedList title={`More ${primaryCuisine}`}>
                {relatedCuisine.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}`)}
                    title={place.data.title}
                    meta={place.data.neighborhood}
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
        </section>
      </div>
    </div>
  </Entry>
</BaseLayout>

<style>
  .address {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
  }

  .food-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
  }

  .food-sub-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .food-sub-meta-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  /* The source links sit to the right of the verdict + cuisine, and wrap toward
     the right edge when the row is tight. */
  .food-links {
    justify-content: flex-end;
  }

  /* A full-width "back to the map" link under the sidebar locator. */
  .food-map-link {
    justify-content: center;
    width: 100%;
  }

  /* Writeup + sidebar. One column until there's room for the aside alongside. */
  .food-layout {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-lg);
  }

  .food-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    /* Contain the map's high Leaflet z-indexes in their own stacking context so
       the sticky sidebar scrolls behind the site header (z-index 100), not over
       it. */
    isolation: isolate;
  }

  @media screen and (min-width: 900px) {
    .food-layout {
      grid-template-columns: minmax(0, 1fr) 290px;
      align-items: start;
      gap: 2.5rem;
    }

    /* DOM order is aside-then-main so the map + pick lead on mobile; on desktop
       they're placed back into the right column. */
    .food-main {
      grid-column: 1;
      grid-row: 1;
    }

    .food-aside {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--spacing-md));
      gap: var(--spacing-sm);
    }
  }

  /* "More food" footer — related places + a link back to the full list, so a
     page ends on a path forward instead of just cutting off. */
  .more-food {
    margin-block-start: var(--spacing-lg);
    border-block-start: 1px solid var(--color-line);
  }

  @media screen and (max-width: 700px) {
    /* Stack the two meta groups, each filling the row: verdict + cuisine on top,
       the source links spread across their own row below. */
    .food-sub-meta {
      align-items: stretch;
      flex-direction: column;
      row-gap: var(--spacing-sm);

      .chip {
        width: fit-content;
      }
    }

    .food-links {
      justify-content: flex-start;
    }
  }
</style>
