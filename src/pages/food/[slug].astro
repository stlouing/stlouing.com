---
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ReadersVerdict from '../../components/ReadersVerdict.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import SourceLink from '../../components/SourceLink.astro'
import FoodLocator from '../../components/FoodLocator.astro'
import MyPick from '../../components/MyPick.astro'
import Rating from '../../components/Rating.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { published, excerpt, hasBody, META_DESCRIPTION_CHARS } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { neighborhoodHref } from '../../lib/neighborhoods'
import { resolveVerdict, resolveWriterState, verdictLabels } from '../../lib/verdict'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineLabel } from '../../lib/cuisine'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconInstagram from '../../assets/IconInstagram.astro'

// Every food entry gets a page (metadata only when there's no writeup yet).
export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
// The "My Review" stance: the verdict when rated, else a status-driven placeholder
// ("Haven't reviewed yet" for a tried spot, "Haven't visited yet" otherwise). Drives
// the "My Review" half of the top-of-page review bar.
const writerState = resolveWriterState(data)
// A friendly one-liner shown in a dashed note in place of the (empty) writeup on a
// body-less stub — mirroring the "not explored yet" treatment on neighborhood pages.
// Tried-but-unrated reads differently from never-visited.
const stubNote =
  writerState.kind === 'pending'
    ? `I've been to ${data.title}, but I haven't written up a review yet.`
    : `I haven't made it to ${data.title} yet, but it's on my list to try.`
// The footer timestamp: the last revision when set, otherwise the created date.
const lastUpdated = data.updated ?? data.created
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)

// Social-share image: the place photo when there is one (resized to the
// ~1200px social-card width, as JPEG since share crawlers don't all take
// webp), else the per-entry ogImage override, else the site flag.
const sharePhoto = data.photo
  ? await getImage({ src: data.photo, width: 1200, format: 'jpeg' })
  : undefined
const shareImage = sharePhoto ? rootRelative(sharePhoto.src) : data.ogImage

const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  image: new URL(href(shareImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
})

// Breadcrumb: Food / <neighborhood> / <cuisine>. The neighborhood links to its
// page when one exists; the cuisine links to the filtered food list.
const trail = [
  { label: 'Food', href: '/food/' },
  ...(data.neighborhood ? [{ label: data.neighborhood, href: neighborhoodLink ?? undefined }] : []),
  ...(data.cuisine[0]
    ? [{ label: cuisineLabel(data.cuisine[0]), href: `/food/?cuisine=${data.cuisine[0]}` }]
    : []),
]

// Related places for the "more food" footer: others in the same neighborhood, and
// others sharing this place's primary cuisine (best-rated first, capped, and
// de-duped so a place shows in at most one group).
const allFood = published(await getCollection('food'))
// Top related places, each paired with its verdict for display.
const topRelated = (places: typeof allFood) =>
  [...places]
    .sort((left, right) => (right.data.rating ?? 0) - (left.data.rating ?? 0))
    .slice(0, 5)
    .map((place) => ({ place, verdict: resolveVerdict(place.data) }))

const relatedNeighborhood = data.neighborhood
  ? topRelated(
      allFood.filter(
        (place) => place.id !== entry.id && place.data.neighborhood === data.neighborhood,
      ),
    )
  : []
const primaryCuisine = data.cuisine[0]
const relatedCuisine = primaryCuisine
  ? topRelated(
      allFood.filter(
        (place) =>
          place.id !== entry.id &&
          place.data.cuisine.includes(primaryCuisine) &&
          place.data.neighborhood !== data.neighborhood,
      ),
    )
  : []

// "Mentioned in" should only surface links not already shown in the related-food
// groups above, so a place doesn't appear twice on the same page.
const relatedIds = new Set([...relatedNeighborhood, ...relatedCuisine].map((item) => item.place.id))
const mentionedIn = backlinks.filter(
  (backlink) => !(backlink.collection === 'food' && relatedIds.has(backlink.id)),
)

// SEO: a richer <title> (name + cuisine + city) than the bare breadcrumb name,
// plus a per-page meta description — the writeup excerpt when there is one (a fuller
// sentence than the short tagline), else the authored tagline, else the site default.
const seoTitle = primaryCuisine
  ? `${data.title} - ${cuisineLabel(primaryCuisine)} in St. Louis`
  : `${data.title} in St. Louis`
// For a body-less stub, the authored tagline alone ("Coffee bar") is too thin a
// search snippet, so it's padded out with the cuisine + neighborhood.
const locality = data.neighborhood ? `${data.neighborhood}, St. Louis` : 'St. Louis'
const stubDescription = [
  data.description,
  primaryCuisine
    ? `${cuisineLabel(primaryCuisine)} in ${locality}`
    : `${data.title} in ${locality}`,
]
  .filter(Boolean)
  .join(' — ')
const seoDescription = hasBody(entry)
  ? excerpt(entry.body, META_DESCRIPTION_CHARS)
  : stubDescription
---

<BaseLayout
  article
  crumb={data.title}
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  ogImage={shareImage}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}
  jsonLd={schema}>
  <Breadcrumbs trail={trail} />
  <Entry title={data.title} tags={data.tags} backlinks={mentionedIn} share={false}>
    {
      data.description && (
        <p class="entry-summary" slot="lede">
          {data.description}
        </p>
      )
    }
    <div class="detail-layout">
      <div class="detail-main">
        {
          data.photo && (
            <Image
              class="food-photo"
              src={data.photo}
              alt={`Photo of ${data.title}`}
              widths={[400, 800]}
              sizes="(min-width: 900px) 600px, 100vw"
            />
          )
        }

        <Content />
        {
          !hasBody(entry) && (
            <div class="not-explored">
              <p>{stubNote}</p>
            </div>
          )
        }

        {
          lastUpdated && (
            <Byline>
              <Fragment slot="footer-meta">
                <EntryDates created={data.created} updated={data.updated} />
              </Fragment>
            </Byline>
          )
        }

        <ReadersVerdict slug={entry.id} title={data.title} />

        <section class="more-food">
          {
            relatedNeighborhood.length > 0 && (
              <RelatedList title={`More in ${data.neighborhood}`}>
                {relatedNeighborhood.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={place.data.cuisine[0]}
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
          {
            relatedCuisine.length > 0 && (
              <RelatedList title={`More ${cuisineLabel(primaryCuisine)}`}>
                {relatedCuisine.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={place.data.neighborhood}
                    metaType="neighborhood"
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
        </section>
      </div>
      <aside class="detail-aside">
        {
          writerState.verdict && (
            <div class="my-rating">
              <h2 class="section-label detail-section-label">My rating</h2>
              <div class="my-rating-row">
                <span class="my-rating-value">{verdictLabels[writerState.verdict]}</span>
                <Rating verdict={writerState.verdict} />
              </div>
            </div>
          )
        }
        <div class="food-map-block">
          <h2 class="section-label detail-section-label">Map</h2>
          <FoodLocator coords={data.coords} label={data.neighborhood} />
          <a class="continue-link aside-more-link" href={href('/food/')}>
            Back to food map <IconArrowRight />
          </a>
        </div>
        {
          data.address && data.address.length > 0 && (
            <div class="food-address-block">
              <h2 class="section-label detail-section-label">Address</h2>
              <address class="food-address">
                {data.address.map((line) => (
                  <span>{line}</span>
                ))}
              </address>
              {googleMapsHref(data) && (
                <a
                  class="continue-link aside-more-link"
                  href={googleMapsHref(data)}
                  target="_blank"
                  rel="noopener">
                  View directions <IconArrowRight />
                </a>
              )}
            </div>
          )
        }
        {
          (data.url || data.instagram || googleMapsHref(data)) && (
            <>
              <div class="detail-links-section">
                <h2 class="section-label detail-section-label">Links</h2>
                <div class="detail-links">
                  <SourceLink
                    href={data.url}
                    label={data.url ? displayUrl(data.url) : ''}
                    variant="quiet"
                    compact={false}
                    class="btn-inline">
                    <IconExternalLink slot="icon" />
                  </SourceLink>
                  <SourceLink
                    href={data.instagram}
                    label="Instagram"
                    variant="quiet"
                    compact={false}
                    class="btn-inline">
                    <IconInstagram slot="icon" />
                  </SourceLink>
                  <SourceLink
                    href={googleMapsHref(data)}
                    label="Google Maps"
                    variant="quiet"
                    compact={false}
                    class="btn-inline">
                    <IconMapPin slot="icon" />
                  </SourceLink>
                </div>
              </div>
            </>
          )
        }
        {
          data.pick && (
            <>
              <MyPick pick={data.pick} />
            </>
          )
        }
      </aside>
    </div>
  </Entry>
</BaseLayout>

<script>
  import { initReadersVerdict } from '../../scripts/readers-verdict'
  initReadersVerdict()
</script>

<style>
  /* The word in the serif title voice beside the sized-up fleurs, under the
     sidebar's standard ruled label. */
  .my-rating-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    font-weight: 500;
    color: var(--color-text-heading);
  }

  .my-rating-row :global(.rating .rating-fleur) {
    width: 1.25rem;
    height: 1.25rem;
  }


  /* A photo of the place, leading the writeup: full-width, rounded, hairline
     border. Astro's <Image> emits width/height so it never causes layout shift. */
  .food-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin-block-end: var(--spacing-lg);
  }

  /* The postal address under the map (a quiet mono block, one line per address
     line), left-aligned in the sidebar. */
  .food-address {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-muted-2);
    text-align: start;
    font-weight: 400;
    line-height: 1.4;
  }
</style>
