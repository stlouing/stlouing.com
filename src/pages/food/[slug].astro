---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EditThisPage from '../../components/EditThisPage.astro'
import TagList from '../../components/TagList.astro'
import Backlinks from '../../components/Backlinks.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import IconStar from '../../assets/IconStar.astro'

export async function getStaticPaths() {
  const places = published(await getCollection('food')).filter(hasBody)

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
---

<BaseLayout crumb={data.title}>
  <article class="entry">
    <header class="entry-header">
      <h1>{data.title}</h1>
      <div class="entry-bar">
        <p class="meta">
          {
            data.rating && (
              <span class="rating">
                <IconStar /> {data.rating}
              </span>
            )
          }
          {data.neighborhood && <span>{data.neighborhood}</span>}
          {
            data.cuisine.map((cuisine) => (
              <a class="chip" href={href(`/tags/${cuisine}`)}>
                {cuisine}
              </a>
            ))
          }
        </p>
        <EditThisPage path={entry.filePath} inline />
      </div>
      {data.address && <p class="address">{data.address}</p>}
      <TagList tags={data.tags} />
    </header>

    <div class="body">
      <Content />
    </div>

    <footer class="entry-footer">
      <Backlinks links={backlinks} />
    </footer>
  </article>
</BaseLayout>
