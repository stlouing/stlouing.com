---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import { formatDate } from '../../lib/dates'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Chip from '../../components/Chip.astro'
import ReadersVerdict from '../../components/ReadersVerdict.astro'
import SourceLink from '../../components/SourceLink.astro'
import FoodLocator from '../../components/FoodLocator.astro'
import MyPick from '../../components/MyPick.astro'
import Rating from '../../components/Rating.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import { href } from '../../lib/url'
import { published, excerpt, hasBody } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { neighborhoodHref } from '../../lib/neighborhoods'
import { resolveVerdict, verdictStatements } from '../../lib/verdict'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineEmoji, cuisineLabel } from '../../lib/emoji'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconArrowDown from '../../assets/IconArrowDown.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconInstagram from '../../assets/IconInstagram.astro'
import IconAward from '../../assets/IconAward.astro'
import IconListChecks from '../../assets/IconListChecks.astro'

// Every food entry gets a page (metadata only when there's no writeup yet).
export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const verdict = resolveVerdict(data)
// The readers' poll only renders when Supabase is configured; the top-of-page teaser that
// points down to it should appear on the same condition.
const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)
// The footer timestamp: the last revision when set, otherwise the created date.
const lastUpdated = data.updated ?? data.created
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)
const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  image: new URL(href(data.ogImage ?? '/og.png'), Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
})

// Breadcrumb: Food / <neighborhood> (the neighborhood links to its page when one
// exists, otherwise it's a plain crumb).
const trail = [
  { label: 'Food', href: '/food/' },
  ...(data.neighborhood ? [{ label: data.neighborhood, href: neighborhoodLink ?? undefined }] : []),
]

// Related places for the "more food" footer: others in the same neighborhood, and
// others sharing this place's primary cuisine (best-rated first, capped, and
// de-duped so a place shows in at most one group).
const allFood = published(await getCollection('food'))
// Top related places, each paired with its verdict for display.
const topRelated = (places: typeof allFood) =>
  [...places]
    .sort((left, right) => (right.data.rating ?? 0) - (left.data.rating ?? 0))
    .slice(0, 5)
    .map((place) => ({ place, verdict: resolveVerdict(place.data) }))

const relatedNeighborhood = data.neighborhood
  ? topRelated(
      allFood.filter(
        (place) => place.id !== entry.id && place.data.neighborhood === data.neighborhood,
      ),
    )
  : []
const primaryCuisine = data.cuisine[0]
const relatedCuisine = primaryCuisine
  ? topRelated(
      allFood.filter(
        (place) =>
          place.id !== entry.id &&
          place.data.cuisine.includes(primaryCuisine) &&
          place.data.neighborhood !== data.neighborhood,
      ),
    )
  : []

// "Mentioned in" should only surface links not already shown in the related-food
// groups above, so a place doesn't appear twice on the same page.
const relatedIds = new Set([...relatedNeighborhood, ...relatedCuisine].map((item) => item.place.id))
const mentionedIn = backlinks.filter(
  (backlink) => !(backlink.collection === 'food' && relatedIds.has(backlink.id)),
)

// SEO: a richer <title> (name + cuisine + city) than the bare breadcrumb name,
// plus a per-page meta description — the writeup excerpt when there is one (a fuller
// sentence than the short tagline), else the authored tagline, else the site default.
const seoTitle = primaryCuisine
  ? `${data.title} - ${cuisineLabel(primaryCuisine)} in St. Louis`
  : `${data.title} in St. Louis`
const seoDescription = hasBody(entry) ? excerpt(entry.body, 155) : data.description
---

<BaseLayout
  crumb={data.title}
  title={seoTitle}
  description={seoDescription}
  ogImage={data.ogImage}
  jsonLd={schema}>
  <Breadcrumbs trail={trail} />
  <Entry title={data.title} tags={data.tags} backlinks={mentionedIn}>
    {
      lastUpdated && (
        <Fragment slot="footer-meta">
          Last updated on{' '}
          <time class="dt-updated" datetime={lastUpdated.toISOString()}>
            {formatDate(lastUpdated)}
          </time>
        </Fragment>
      )
    }
    {
      data.description && (
        <p class="entry-summary" slot="lede">
          {data.description}
        </p>
      )
    }
    <Fragment slot="meta">
      <div class="food-meta">
        <div class="food-sub-meta">
          <div class="food-sub-meta-section">
            {
              verdict && (
                <span class="food-meta-rating">
                  <Rating verdict={verdict} />
                </span>
              )
            }
            {
              data.cuisine.map((cuisine) => (
                <Chip href={href(`/food/?cuisine=${cuisine}`)}>
                  <span>{cuisineEmoji(data.cuisine)}</span>
                  <span>{cuisineLabel(cuisine)}</span>
                </Chip>
              ))
            }
          </div>
          <div class="food-sub-meta-section food-links">
            <SourceLink href={data.url} label="Website" variant="outline">
              <IconExternalLink slot="icon" />
            </SourceLink>
            <SourceLink href={data.instagram} label="Instagram" variant="outline">
              <IconInstagram slot="icon" />
            </SourceLink>
            <SourceLink href={googleMapsHref(data)} label="Google Maps" variant="outline">
              <IconMapPin slot="icon" />
            </SourceLink>
          </div>
        </div>
      </div>
    </Fragment>

    <div class="food-layout">
      <div class="food-main">
        {
          verdict && readersEnabled && (
            <a class:list={['verdict-teaser', `verdict-${verdict}`]} href="#readers-verdict">
              <span>
                My review: <strong>{verdictStatements[verdict]}.</strong>
              </span>
              <span class="verdict-teaser-cta">
                <span data-teaser-cta data-voted-text="See the results">Been here? Vote below</span>
                <IconArrowDown />
              </span>
            </a>
          )
        }
        {
          data.photo && (
            <Image
              class="food-photo"
              src={data.photo}
              alt={`Photo of ${data.title}`}
              widths={[400, 800]}
              sizes="(min-width: 900px) 600px, 100vw"
            />
          )
        }
        <Content />
        <ReadersVerdict slug={entry.id} title={data.title} verdict={verdict} />
        <!-- <nav class="food-more-cta" aria-label="More food from St. Louing">
          <a class="food-cta-card" href={href('/best/')}>
            <span class="food-cta-lead"><IconAward /></span>
            <span class="food-cta-title">Best food of St. Louis</span>
            <span class="food-cta-arrow"><IconArrowRight /></span>
          </a>
          <a class="food-cta-card" href={href('/food/on-the-list/')}>
            <span class="food-cta-lead"><IconListChecks /></span>
            <span class="food-cta-title">Restaurants I want to try</span>
            <span class="food-cta-arrow"><IconArrowRight /></span>
          </a>
        </nav> -->
        <section class="more-food">
          {
            relatedNeighborhood.length > 0 && (
              <RelatedList title={`More in ${data.neighborhood}`}>
                {relatedNeighborhood.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={place.data.cuisine[0]}
                    emoji={cuisineEmoji([place.data.cuisine[0]])}
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
          {
            relatedCuisine.length > 0 && (
              <RelatedList title={`More ${cuisineLabel(primaryCuisine)}`}>
                {relatedCuisine.map(({ place, verdict }) => (
                  <RelatedCard
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={place.data.neighborhood}
                    metaType="neighborhood"
                    emoji={cuisineEmoji([primaryCuisine])}
                    verdict={verdict}
                  />
                ))}
              </RelatedList>
            )
          }
        </section>
      </div>
      <aside class="food-aside">
        <h2 class="food-aside-title section-label">Location</h2>
        <div class="food-card">
          <FoodLocator coords={data.coords} label={data.neighborhood} />
          <div class="food-card-body">
            {
              data.address && data.address.length > 0 && (
                <div class="food-address-block">
                  <h2 class="section-label food-address-label">Address</h2>
                  <address class="food-address">
                    {data.address.map((line) => (
                      <span>{line}</span>
                    ))}
                  </address>
                  <a href={googleMapsHref(data)} class="btn-directions btn-muted">
                    <span>View Directions</span> <IconExternalLink />
                  </a>
                </div>
              )
            }
            <hr class="food-card-divider" />
            <a class="btn btn-quiet food-back-link" href={href('/food/')}>
              Back to the Food Map <IconArrowRight />
            </a>
            {
              data.pick && (
                <>
                  <hr class="food-card-divider" />
                  <MyPick pick={data.pick} cuisine={data.cuisine} />
                </>
              )
            }
          </div>
        </div>
      </aside>
    </div>
  </Entry>
</BaseLayout>

<script>
  import { initReadersVerdict } from '../../scripts/readers-verdict'
  initReadersVerdict()
</script>

<style>
  /* A one-line lead-in at the top of the writeup (so mobile readers see the verdict and
     that voting exists without scrolling to the block below). Jumps to #readers-verdict.
     The verdict word takes its color; the CTA is the accent. */
  .verdict-teaser {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-xs) var(--spacing-sm);
    margin-block-end: var(--spacing-lg);
    padding-block-end: var(--spacing-md);
    border-block-end: 1px solid var(--color-line);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.4;
  }

  .verdict-teaser.verdict-loved {
    --teaser-color: var(--color-verdict-loved);
  }
  .verdict-teaser.verdict-liked {
    --teaser-color: var(--color-verdict-liked);
  }
  .verdict-teaser.verdict-neutral {
    --teaser-color: var(--color-verdict-neutral);
  }
  .verdict-teaser.verdict-not-for-me {
    --teaser-color: var(--color-verdict-notforme);
  }

  .verdict-teaser strong {
    color: var(--teaser-color);
    font-weight: 700;
  }

  .verdict-teaser-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* The arrow follows the CTA's accent color (override the global muted .icon) and scales
     with the text. */
  .verdict-teaser-cta :global(.icon) {
    color: inherit;
    width: 1em;
    height: 1em;
  }

  .verdict-teaser:hover .verdict-teaser-cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* A photo of the place, leading the writeup: full-width, rounded, hairline
     border. Astro's <Image> emits width/height so it never causes layout shift. */
  .food-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin-block-end: var(--spacing-lg);
  }

  /* The sidebar map, address, "back to the map" link, and the pick all live in one
     bordered card: the map sits flush at the top (its own corners clipped by the
     card), and the rest is a left-aligned, padded body below it. */
  .food-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }

  .food-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
  }

  /* "Address" label tucked tight above the lines (mirrors the "My pick" label:
     shared `.section-label` font, small bottom margin). */
  .food-address-label {
    margin: 0 0 var(--spacing-xs);
  }

  /* The postal address under the map (a quiet mono block, one line per address
     line), left-aligned in the card body. */
  .food-address {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-muted-2);
    text-align: start;
    font-weight: 500;
    line-height: 1.4;
  }

  /* A content-width "back to the map" link (the rest of the body stretches full
     width so its text wraps). */
  .food-back-link {
    text-decoration-style: solid;
    align-self: flex-start;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .btn-directions {
    margin-top: var(--spacing-xs);
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    gap: var(--spacing-sm);

    svg {
      height: 12px;
      width: 12px;
    }
  }

  /* "Keep exploring" cards at the foot of the writeup: two engaging links out to
     the Best-of list and the On-the-List backlog. Two-up on desktop, stacked on
     mobile; an accent lead icon, the label, and a trailing arrow that lights up
     on hover. */
  .food-more-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
    row-gap: var(--spacing-sm);
    margin-block-start: var(--spacing-xl);
  }

  @media (max-width: 40rem) {
    .food-more-cta {
      grid-template-columns: 1fr;
    }
  }

  .food-cta-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .food-cta-card:hover {
    border-color: var(--color-accent);
    background: var(--color-background);
  }

  .food-cta-lead {
    display: inline-flex;
    flex-shrink: 0;
  }

  .food-cta-lead :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--color-accent);
  }

  .food-cta-title {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-heading);
  }

  .food-cta-card:hover .food-cta-title {
    color: var(--color-accent);
  }

  .food-cta-arrow {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .food-cta-card:hover .food-cta-arrow :global(.icon) {
    color: var(--color-accent);
  }

  /* Hairline between the back link and the pick; the body's gap spaces it. */
  .food-card-divider {
    margin: 0;
    border: 0;
    border-block-start: 1px solid var(--color-line);
  }

  .food-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
  }

  .food-sub-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .food-sub-meta-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  /* The header row now holds the fleur rating + cuisine chips — center them. */
  .food-sub-meta-section:not(.food-links) {
    align-items: center;
  }

  .food-sub-meta-section:not(.food-links) :global(.chip) {
    font-size: var(--font-size-sm);
  }

  /* The fleur rating in the header meta row: larger than the in-list glyphs (its
     em-based size scales with this font-size). */
  .food-meta-rating {
    display: inline-flex;
    align-items: center;
    font-size: var(--font-size-lg);
  }

  /* The source links sit to the right of the verdict + cuisine, and wrap toward
     the right edge when the row is tight. */
  .food-links {
    justify-content: flex-end;
  }

  /* Writeup + sidebar. One column until there's room for the aside alongside. */
  .food-layout {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-lg);
  }

  .food-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    isolation: isolate;
  }

  /* On mobile the aside stacks under the writeup, so the map gets a heading
     (the shared global `.section-label`) instead of appearing out of nowhere.
     Hidden on desktop, where the sticky sidebar already reads as its own column. */
  .food-aside-title {
    margin: 0;
  }

  @media screen and (min-width: 900px) {
    .food-layout {
      grid-template-columns: minmax(0, 1fr) 290px;
      align-items: start;
      gap: 2.5rem;
    }

    .food-aside-title {
      display: none;
    }

    /* DOM order is main-then-aside so the writeup leads on mobile (the map + pick
       follow it); on desktop the aside is placed back into the right column. */
    .food-main {
      grid-column: 1;
      grid-row: 1;
    }

    .food-aside {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--spacing-md));
      gap: var(--spacing-sm);
    }
  }

  /* "More food" footer — related places + a link back to the full list, so a
     page ends on a path forward instead of just cutting off. */
  /* .more-food {
    padding-block-start: var(--spacing-xs);
    margin-block-start: var(--spacing-lg);
  } */

  @media screen and (max-width: 700px) {
    /* Stack the two meta groups, each filling the row: verdict + cuisine on top,
       the source links spread across their own row below. */
    .food-sub-meta {
      align-items: stretch;
      flex-direction: column;
      row-gap: var(--spacing-md);

      .chip {
        width: fit-content;
      }
    }

    .food-links {
      justify-content: flex-start;
    }
  }
</style>
