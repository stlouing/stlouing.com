---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Chip from '../../components/Chip.astro'
import Rating from '../../components/Rating.astro'
import SourceLink from '../../components/SourceLink.astro'
import { href } from '../../lib/url'
import { published } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { neighborhoodHref } from '../../lib/neighborhoods'
import { googleMapsHref } from '../../lib/maps'
import { restaurantSchema } from '../../lib/schema'
import { cuisineEmoji } from '../../lib/emoji'

// Every food entry gets a page (metadata only when there's no writeup yet).
export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const neighborhoodLink = await neighborhoodHref(data.neighborhood)
const schema = restaurantSchema({
  name: data.title,
  url: new URL(`/food/${entry.id}/`, Astro.site ?? Astro.url.origin).href,
  address: data.address,
  coords: data.coords,
  cuisine: data.cuisine,
  rating: data.rating,
})

// Breadcrumb: Food / <neighborhood> (the neighborhood links to its page when one
// exists, otherwise it's a plain crumb).
const trail = [
  { label: 'Food', href: '/food' },
  ...(data.neighborhood ? [{ label: data.neighborhood, href: neighborhoodLink ?? undefined }] : []),
]
---

<BaseLayout crumb={data.title} jsonLd={schema}>
  <Breadcrumbs trail={trail} />
  <Entry title={data.title} tags={data.tags} editPath={entry.filePath} backlinks={backlinks}>
    <Fragment slot="meta">
      <div class="food-meta">
        {
          data.address && data.address.length > 0 && (
            <span class="address">{data.address.join(', ')}</span>
          )
        }
        <div class="food-sub-meta">
          <div class="food-sub-meta-section">
            {data.rating && <Rating value={data.rating} />}
            {
              data.cuisine.map((cuisine) => (
                <Chip href={href(`/tags/${cuisine}`)}>
                  {cuisineEmoji(data.cuisine)}
                  {cuisine}{' '}
                </Chip>
              ))
            }
          </div>
          <div class="food-sub-meta-section">
            <SourceLink href={data.url} />
            <SourceLink href={googleMapsHref(data)} label="Google Maps" />
          </div>
        </div>
      </div>
    </Fragment>
    <Content />
  </Entry>
</BaseLayout>

<style>
  .food-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .food-sub-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .food-sub-meta-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  @media screen and (max-width: 700px) {
    .food-sub-meta {
      align-items: flex-start;
      flex-direction: column;
      row-gap: var(--spacing-sm);

      .chip {
        width: fit-content;
      }
    }
  }
</style>
