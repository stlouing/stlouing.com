---
import PageMasthead from '../components/PageMasthead.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { render } from 'astro:content'
import { getChangelog } from '../lib/changelog'
import { formatDate } from '../lib/dates'

const description = "What's new on St. Louing — the running log of updates, newest first."

const entries = await getChangelog()
const updates = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)
---

<BaseLayout crumb="Updates" title="What's New in St. Louing" description={description}>
  <article>
    <PageMasthead title="What's New">
      <p slot="lede">A running log of what I've added and changed</p>
    </PageMasthead>

    <div class="reading-col">
      <ol class="updates divided-list">
        {
          updates.map(({ date, Content }) => (
            <li class="update">
              <time class="update-date eyebrow nowrap" datetime={date.toISOString()}>
                {formatDate(date)}
              </time>
              <div class="changelog-body">
                <Content />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </article>
</BaseLayout>

<style>
  .updates {
    display: grid;
    grid-template-columns: max-content 1fr;
  }

  .update {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    column-gap: var(--spacing-lg);
    padding-block: var(--spacing-lg);
  }

  .update:first-child {
    padding-block-start: 0;
  }

  .update-date {
    padding-block-start: 2px;
  }

  @media (max-width: 700px) {
    .updates {
      grid-template-columns: 1fr;
    }

    .update {
      row-gap: var(--spacing-sm);
      padding-block: var(--spacing-md);
    }
  }
</style>
