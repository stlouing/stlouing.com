---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import { published } from '../lib/content'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'

const tagline = 'Maps, guides, and observations from around St. Louis'

const intro =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.'

// Latest few notes for the homepage Notes column.
const latestNotes = published(await getCollection('notes'))
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf())
  .slice(0, 3)

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<BaseLayout>
  <h1 class="page-title">St. Louing <span>since 2023</span></h1>
  <p class="tagline">{tagline}</p>
  <p class="introduction">{intro}</p>
  <p class="last-updated"><strong>Last Updated:</strong> <span>May 31, 2026</span></p>

  <div class="directory">
    {
      groups.map((group) => {
        if (group.id === 'notes') {
          return (
            <section class="group">
              <h2 class="group-label">{group.label}</h2>
              <List>
                {latestNotes.map((note) => (
                  <ListItem
                    title={note.data.title}
                    href={href(`/notes/${note.id}`)}
                    description={formatDate(note.data.date)}
                  />
                ))}
                <li>
                  <a class="more" href={href('/notes')}>
                    All notes →
                  </a>
                </li>
              </List>
            </section>
          )
        }

        const items = sections.filter((section) => section.group === group.id)

        if (items.length === 0) {
          return null
        }

        return (
          <section class="group">
            {group.label && <h2 class="group-label">{group.label}</h2>}

            <List>
              {items.map((section) => (
                <ListItem
                  title={section.label}
                  href={href(section.path)}
                  description={section.description}
                />
              ))}
            </List>
          </section>
        )
      })
    }
  </div>
</BaseLayout>

<style>
  .tagline {
    margin-block: var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-accent);
  }

  .introduction {
    max-width: 62ch;
    font-size: var(--font-size-lg);
    margin-block: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .last-updated {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    font-style: italic;
    margin-bottom: var(--spacing-lg);

    strong {
      font-weight: 500;
    }

    span {
      color: var(--color-text-muted);
    }
  }

  .directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 34rem) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
</style>
