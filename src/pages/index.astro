---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import { published } from '../lib/content'
import { formatDateShort } from '../lib/dates'
import { websiteSchema } from '../lib/schema'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'

const tagline = 'Discovering the food, neighborhoods, and culture of St. Louis'
const intro = `St. Louing is a personal project I created to document my experience living in St. Louis and learning to love it.`

const allNotes = published(await getCollection('notes')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf(),
)
const allTopics = published(await getCollection('topics')).sort(
  (left, right) => right.data.updated.valueOf() - left.data.updated.valueOf(),
)

// Latest few of each for the homepage columns.
const latestNotes = allNotes.slice(0, 5)
const latestTopics = allTopics.slice(0, 5)

// Item counts shown next to the guide sections in the directory.
const foodCount = published(await getCollection('food')).length
const neighborhoodCount = published(await getCollection('neighborhoods')).length
const countByPath: Record<string, string> = {
  '/food': String(foodCount),
  '/neighborhoods': String(neighborhoodCount),
}

const lastUpdated = new Date('2026-06-03')

const website = websiteSchema(Astro.site ?? new URL(Astro.url.origin))
---

<BaseLayout jsonLd={website}>
  <header class="h-card index-header">
    <h1 class="page-title">St. Louing <span>since 2023</span></h1>
    <p class="tagline p-note">{tagline}</p>
    <p class="introduction">
      {intro}
      <a class="more inline" href={href('/about')}>Read more <IconArrowRight /></a>
    </p>
    <!-- <p class="last-updated">
      <strong>Last Updated:</strong>
      <span>{formatDateShort(lastUpdated)}</span>
    </p> -->
    {/* Author identity for feeds/IndieWeb parsers; data only, not shown. */}
    <span class="p-name" hidden>St. Louing</span>
    <a class="u-url" href={href('/')} hidden>stlouing.com</a>
    <img class="u-photo" src={href('/favicon.png')} alt="" hidden />
  </header>

  <div class="directory">
    {
      groups.map((group) => {
        if (group.id === 'notes') {
          return (
            <section class="group">
              <div class="group-header">
                <h2 class="group-label">{group.label}</h2>
                <a class="all" href={href('/notes')}>
                  All <IconArrowRight />
                </a>
              </div>
              <List>
                {latestNotes.map((note) => (
                  <ListItem
                    title={note.data.title}
                    href={href(`/notes/${note.id}`)}
                    meta={formatDateShort(note.data.date)}
                  />
                ))}
              </List>
            </section>
          )
        }

        if (group.id === 'topics') {
          return (
            <section class="group">
              <div class="group-header">
                <h2 class="group-label">{group.label}</h2>
                <a class="all" href={href('/topics')}>
                  All <IconArrowRight />
                </a>
              </div>
              <List>
                {latestTopics.map((topic) => (
                  <ListItem
                    title={topic.data.title}
                    href={href(`/${topic.id}`)}
                    description={topic.data.description || formatDateShort(topic.data.updated)}
                  />
                ))}
              </List>
            </section>
          )
        }

        const items = sections.filter((section) => section.group === group.id)

        if (items.length === 0) {
          return null
        }

        return (
          <section class="group">
            <div class="group-header">
              <h2 class="group-label">{group.label}</h2>
            </div>

            <List>
              {items.map((section) => (
                <ListItem
                  title={section.label}
                  href={href(section.path)}
                  description={section.description}
                  meta={countByPath[section.path]}
                />
              ))}
            </List>
          </section>
        )
      })
    }
  </div>
</BaseLayout>

<style>
  h1.page-title {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    margin-bottom: 0;

    span {
      font-size: var(--font-size-xs);
      color: var(--color-text-muted);
      font-weight: 400;
      font-family: var(--font-mono);
    }
  }

  .index-header {
    margin-bottom: 3rem;
  }

  .tagline {
    margin-block: var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-accent);
  }

  .introduction {
    max-width: 62ch;
    font-size: var(--font-size-md);
    margin-block: var(--spacing-md) var(--spacing-lg);
    color: var(--color-text);
  }

  .last-updated {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    font-style: italic;
    margin-bottom: var(--spacing-lg);

    strong {
      font-weight: 500;
    }

    span {
      color: var(--color-text-muted);
    }
  }

  /* Section header: label on the left, optional "all →" on the right, with a
     dotted rule under both (matches the list-item separators below it). */
  .group-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    border-block-end: 1px solid var(--color-text-muted);
    padding-block-end: var(--spacing-xs);
    margin-block-end: var(--spacing-xs);
    min-height: 24px;
  }

  .group-header .group-label {
    margin: 0;
  }

  .group-header .all {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-shrink: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .group-header .all:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-style: solid;
    text-decoration-color: var(--color-accent);
  }

  /* Keep the arrow the same accent color as the link text. */
  .group-header .all :global(.icon) {
    color: inherit;
  }

  .directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-block-end: 3rem;
  }

  @media (max-width: 34rem) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
</style>
