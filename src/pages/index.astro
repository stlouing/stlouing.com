---
import { getCollection, render } from 'astro:content'
import neighborhoodsData from '../data/neighborhoods.json'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import {
  published,
  sortTopics,
  excerpt,
  PINNED_TOPIC_ID,
  PREVIEW_EXCERPT_CHARS,
} from '../lib/content'
import { isExplored } from '../lib/verdict'
import { getChangelog } from '../lib/changelog'
import { formatDate } from '../lib/dates'
import { websiteSchema } from '../lib/schema'
import { TAGLINE, SOCIALS } from '../lib/site'
import Button from '../components/Button.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import Icon from '../components/Icon.astro'
import GuestbookBadge from '../components/GuestbookBadge.astro'
import FoodCard from '../components/FoodCard.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import IconInstagram from '../assets/IconInstagram.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'

const intro = `Welcome to St. Louing, my ongoing project to document living in St. Louis and learning to love it!`

const allTopics = sortTopics(published(await getCollection('topics')))

// The lead story: the most recently updated topic, skipping the pinned Field
// Notes entry (a living index, not an article). The teaser is derived from the
// topic's own prose, the same way /topics builds its excerpts.
const leadTopic = allTopics.find((topic) => topic.id !== PINNED_TOPIC_ID)
const leadTeaser = leadTopic ? excerpt(leadTopic.body, 420) : ''

// The Topics rail skips the lead story — it's already the featured article.
const railTopics = allTopics.filter((topic) => topic.id !== leadTopic?.id)

// The most recent updates, shown in the What's New window so a returning
// visitor can see the site is alive at a glance. The full log lives at
// /updates. The Markdown body is rendered (same as /updates) so links +
// emphasis in a change show here too.
const latestUpdates = await Promise.all(
  (await getChangelog()).slice(0, 2).map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)

// Progress report tallies for the intro sentence: restaurants actually
// visited (written-up or tried, not the want-to-try backlog); neighborhoods
// wandered mirrors the "explored" count.
const allFood = published(await getCollection('food'))
const allNeighborhoods = published(await getCollection('neighborhoods'))
const visitedCount = allFood.filter((place) => isExplored(place.data.status)).length
const wanderedCount = allNeighborhoods.length

const exploreGroup = groups.find((group) => group.id === 'explore')
const exploreSections = sections.filter((section) => section.group === 'explore')

// Dot-leader counts on the map rows: every listed place, and every listed
// neighborhood — the same tallies the two pane headers show.
const exploreCounts: Record<string, number> = {
  '/food/': allFood.length,
  '/neighborhoods/': neighborhoodsData.filter((neighborhood) => !('ignored' in neighborhood))
    .length,
}

// The food cards: a hand-picked four, shown in this order. Each id is a file
// in src/content/food/ — edit the list to change the front page.
const FEATURED_FOOD_IDS = [
  'pizzeria-da-gloria',
  'kishimoto-mendo',
  'nicky-slices',
  'dalies-smokehouse',
]
const featuredFood = FEATURED_FOOD_IDS.flatMap((foodId) =>
  allFood.filter((place) => place.id === foodId),
).map((place) => ({ place, teaser: excerpt(place.body, PREVIEW_EXCERPT_CHARS) }))

// The left rail: the article index (all published topics, straight from the
// collection so it grows as pieces publish), then a compact "More" section —
// the list pages plus the non-primary site pages (About and Feedback already
// live in the nav).
const moreSections = [
  ...sections.filter((section) => section.group === 'lists'),
  ...sections.filter((section) => section.group === 'site' && !section.primary),
]

const instagram = SOCIALS.find((social) => social.label === 'Instagram')

const website = websiteSchema(Astro.site ?? new URL(Astro.url.origin))
---

<BaseLayout home jsonLd={website}>
  <div class="front-page">
    <aside class="front-index" aria-label="Site index">
      <section class="front-index-topics">
        <h2 class="rail-header head-black head-rule">Topics</h2>
        <ul class="rail-articles">
          {
            railTopics.map((topic) => (
              <li>
                <a class="hover-wash" href={href(`/${topic.id}/`)}>
                  <span class="rail-article-title title-serif title-link">{topic.data.title}</span>
                  {topic.data.description && (
                    <span class="rail-article-description desc-muted">
                      {topic.data.description}
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="front-index-guestbook">
        <GuestbookBadge />
      </section>
      <section class="front-index-more">
        <h2 class="rail-header head-black head-rule">More</h2>
        <ul class="front-index-list">
          {
            moreSections.map((section) => (
              <li>
                <a class="hover-wash" href={href(section.path)}>
                  <span class="front-index-label title-link">{section.label}</span>
                </a>
              </li>
            ))
          }
          {
            instagram && (
              <li>
                <a
                  class="hover-wash front-index-instagram"
                  href={instagram.url}
                  target="_blank"
                  rel="noopener">
                  <span class="instagram-tile" aria-hidden="true">
                    <IconInstagram />
                  </span>
                  <span class="front-index-label title-link">st.louing</span>
                </a>
              </li>
            )
          }
        </ul>
      </section>
    </aside>

    <header class="h-card front-intro">
      <p class="front-eyebrow eyebrow">About</p>
      <h2 class="front-tagline p-note">{TAGLINE}</h2>
      <p class="introduction">
        {intro}
        <br /><br />
        <strong>Explored</strong>: <span class="stat">{wanderedCount}</span> neighborhoods and
        <span class="stat">{visitedCount}</span> restaurants so far! <a
          class="continue-link"
          href={href('/about/')}
          aria-label="Read more about St. Louing">
          Continue reading <IconArrowRight />
        </a>
      </p>
      <span class="p-name" hidden>St. Louing</span>
      <a class="u-url" href={href('/')} hidden>stlouing.com</a>
      <img class="u-photo" src={href('/og.png')} alt="" hidden />
    </header>

    <div class="front-center">
      {
        leadTopic && (
          <section class="front-lead">
            {leadTopic.data.leadImage && (
              <a
                class="lead-figure"
                href={href(`/${leadTopic.id}/`)}
                aria-hidden="true"
                tabindex="-1">
                <img src={href(leadTopic.data.leadImage)} alt="" width="1200" height="800" />
              </a>
            )}
            <p class="section-label lead-kicker">Featured</p>
            <p class="lead-dateline eyebrow">{formatDate(leadTopic.data.updated)}</p>
            <h2 class="lead-headline">
              <a href={href(`/${leadTopic.id}/`)}>{leadTopic.data.title}</a>
            </h2>
            {leadTopic.data.description && (
              <p class="lead-deck desc-muted desc-muted--lg">{leadTopic.data.description}</p>
            )}
            {leadTeaser && <p class="lead-teaser">{leadTeaser}</p>}
            <p class="lead-meta">
              <Button href={href(`/${leadTopic.id}/`)} variant="dark" compact>
                Read more <IconArrowRight />
              </Button>
            </p>
          </section>
        )
      }

      <section class="front-food">
        <div class="group-header head-rule">
          <h2 class="group-label head-black">Food</h2>
          <a class="group-all continue-link" href={href('/food/')}>
            All restaurants & cafes <IconArrowRight />
          </a>
        </div>
        <div class="food-cards">
          {featuredFood.map(({ place, teaser }) => <FoodCard place={place} teaser={teaser} />)}
        </div>
      </section>
    </div>

    <div class="front-rail">
      <section class="front-explore">
        <div class="group-header head-rule">
          <h2 class="group-label head-black">{exploreGroup?.label}</h2>
          {
            exploreGroup?.kicker && (
              <span class="group-kicker eyebrow eyebrow--muted">{exploreGroup.kicker}</span>
            )
          }
        </div>
        <List>
          {
            exploreSections.map((section) => (
              <ListItem
                title={section.label}
                href={href(section.path)}
                description={section.description}
                meta={exploreCounts[section.path]?.toString()}
                leader={section.path in exploreCounts}>
                {section.icon && <Icon name={section.icon} slot="icon" />}
              </ListItem>
            ))
          }
        </List>
      </section>

      <section class="front-whatsnew whats-new panel">
        <h2 class="whats-new-title">What's New</h2>
        <div class="whats-new-fleurs" aria-hidden="true">
          <FleurGlyph />
          <FleurGlyph />
          <FleurGlyph />
        </div>
        <ul class="recent-list">
          {
            latestUpdates.map(({ date, Content }) => (
              <li class="recent-item">
                <time class="recent-date" datetime={date.toISOString()}>
                  {formatDate(date)}
                </time>
                <div class="recent-changes">
                  <Content />
                </div>
              </li>
            ))
          }
        </ul>
        <a class="whats-new-all continue-link" href={href('/updates/')}>
          All updates <IconArrowRight />
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .front-page {
    --front-rail-left: 250px;
    --front-rail-right: 300px;
    --front-gap: var(--spacing-xl);
    position: relative;
    display: grid;
    grid-template-columns: var(--front-rail-left) minmax(0, 1fr) var(--front-rail-right);
    grid-template-areas:
      'intro center rail'
      'index center rail';
    grid-template-rows: auto 1fr;
    column-gap: var(--front-gap);
    row-gap: var(--spacing-lg);
    align-items: start;
    margin-block: var(--spacing-lg);
  }

  .front-center,
  .front-rail {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    min-width: 0;
  }

  .front-center {
    grid-area: center;
  }

  .front-rail {
    grid-area: rail;
  }

  .front-page::before,
  .front-page::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 1px;
    background: var(--color-line);
  }

  .front-page::before {
    left: calc(var(--front-rail-left) + var(--front-gap) / 2);
  }

  .front-page::after {
    right: calc(var(--front-rail-right) + var(--front-gap) / 2);
  }

  .front-index {
    grid-area: index;
    min-width: 0;
  }

  .front-intro {
    grid-area: intro;
    min-width: 0;
  }

  .front-lead {
    grid-area: lead;
    min-width: 0;
  }

  .front-food {
    grid-area: food;
    min-width: 0;
  }

  .front-explore {
    grid-area: explore;
    min-width: 0;
  }

  .front-whatsnew {
    grid-area: whatsnew;
    min-width: 0;
  }

  /* The badge itself lives in GuestbookBadge.astro; the rail section just
     spaces it between Topics and More. */
  .front-index-guestbook {
    margin-block: var(--spacing-md);
  }

  .rail-header {
    margin: 0 0 var(--spacing-xs);
  }

  .rail-articles {
    margin: 0 0 var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .rail-articles li {
    margin: 0;
  }

  .rail-articles li + li {
    border-block-start: 1px dotted var(--color-line-input);
  }

  .rail-articles a {
    display: block;
    padding: var(--spacing-shmedium) var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .rail-article-description {
    display: block;
    margin-block-start: var(--spacing-xs);
  }

  .front-index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .front-index-list li {
    margin: 0;
  }

  .front-index-list li + li {
    border-block-start: 1px dotted var(--color-line-input);
  }

  .front-index-list a {
    display: block;
    min-width: 0;
    padding: var(--spacing-xs) var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
  }

  .front-index-list a.front-index-instagram {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .instagram-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: radial-gradient(
      circle at 30% 107%,
      #fdf497 0%,
      #fdf497 5%,
      #fd5949 45%,
      #d6249f 60%,
      #285aeb 90%
    );
  }

  .instagram-tile :global(.icon) {
    width: 12px;
    height: 12px;
    color: #ffffff;
  }

  .front-eyebrow {
    margin-block: 0 var(--spacing-xs);
  }

  .front-tagline {
    margin-block: 0 var(--spacing-sm);
    font-family: var(--font-display-black);
    font-weight: 400;
    line-height: 1.25;
    font-size: var(--font-size-xl);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .introduction {
    max-width: 65ch;
    font-size: var(--font-size-md);
    margin-block: 0;
    color: var(--color-text);
  }

  .stat {
    color: var(--color-accent-blue);
  }

  .front-food {
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--spacing-md);
  }

  .front-lead {
    text-align: center;
  }

  .lead-figure {
    display: block;
    margin-block-end: var(--spacing-md);
  }

  .lead-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
  }

  .lead-kicker {
    margin-block: 0 var(--spacing-sm);
    color: var(--color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .lead-dateline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    margin-block: 0 var(--spacing-sm);
  }

  .lead-dateline :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--color-accent);
  }

  .lead-headline {
    margin-block: 0 var(--spacing-xs);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    text-wrap: balance;
  }

  .lead-headline a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .lead-headline a:hover {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .lead-deck {
    margin-block: 0 var(--spacing-md);
    text-wrap: balance;
  }

  .lead-teaser {
    margin-block: 0 var(--spacing-sm);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);
    text-align: start;
    font-size: var(--font-size-md);
    color: var(--color-text-article);
    columns: 2;
    column-gap: var(--spacing-xl);
    column-rule: 1px dotted var(--color-line-input);
  }

  .lead-teaser::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 4.4em;
    line-height: 0.75;
    padding-inline-end: var(--spacing-sm);
    padding-block-start: 0.04em;
    color: var(--color-text-heading);
  }

  .lead-meta {
    display: flex;
    justify-content: flex-end;
    margin-block: 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
  }

  .group-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-block-end: var(--spacing-xs);
  }

  .group-header .group-label {
    margin: 0;
  }

  .front-explore {
    --list-icon-color: var(--color-accent-blue);
    --list-hover-color: var(--color-accent-blue);
  }

  .front-explore :global(.list-title) {
    text-decoration-line: none;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-muted);
    text-underline-offset: 3px;
  }

  .front-explore :global(a.list-item:hover .list-title) {
    text-underline-offset: 3px;
  }

  .front-explore :global(.list-item .list-description) {
    font-size: var(--font-size-md);
    line-height: 1.55;
  }

  .front-explore :global(.list-item .list-title) {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-lg);
  }

  .front-explore :global(.list-meta) {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    letter-spacing: var(--letter-spacing);
    color: var(--color-accent);
  }

  .group-kicker {
    flex-shrink: 0;
  }

  .group-all {
    flex-shrink: 0;
  }

  .food-cards {
    margin-block-start: var(--spacing-sm);
  }

  .whats-new {
    min-width: 0;
  }

  .whats-new-title {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.05;
    font-size: 2rem;
    color: var(--color-text-heading);
  }

  .whats-new-fleurs {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-block: var(--spacing-sm);
    color: var(--color-accent-gold);
  }

  .whats-new-fleurs :global(svg) {
    width: 0.6rem;
    height: auto;
  }

  .whats-new .recent-date {
    font-weight: 500;
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    color: var(--color-accent);
    font-size: var(--font-size-xxs);
    text-align: center;
  }

  .whats-new .recent-changes :global(a) {
    color: var(--color-text-heading);
    font-weight: 600;
    text-decoration-line: none;
  }

  .whats-new .recent-changes :global(a:hover) {
    color: var(--color-accent-blue);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent-blue);
  }

  .whats-new .recent-list {
    grid-template-columns: 1fr;
  }

  .whats-new .recent-item {
    row-gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);
  }

  .whats-new .recent-item:first-child {
    border-block-start: 0;
    padding-block-start: var(--spacing-sm);
  }

  .whats-new .recent-item:last-child {
    padding-block-end: 0;
  }

  .whats-new-all {
    display: block;
    text-align: end;
    margin-block-start: var(--spacing-sm);
  }

  .recent-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    column-gap: var(--spacing-lg);
    padding-block: var(--spacing-lg);
    border-block-start: 1px solid var(--color-line);
  }

  .recent-item:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .recent-date {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-muted);
    text-wrap: nowrap;
    padding-block-start: 2px;
  }

  .recent-changes {
    color: var(--color-text);
    line-height: 1.55;
    font-size: var(--font-size-md);
  }

  .recent-changes :global(ul) {
    margin: 0;
    padding-inline-start: var(--spacing-lg);
  }

  .recent-changes :global(li) {
    margin-block: 0;
  }

  .recent-changes :global(p) {
    margin-block: 0;
  }

  .recent-changes :global(p + p) {
    margin-block-start: var(--spacing-sm);
  }

  .recent-changes :global(a:hover) {
    text-decoration-line: underline;
  }

  @media (max-width: 1000px) {
    .front-page {
      grid-template-columns: minmax(0, 1fr) var(--front-rail-right);
      grid-template-areas:
        'intro  intro'
        'center rail'
        'index  index';
      grid-template-rows: auto;
    }

    .front-page::before,
    .front-page::after {
      display: none;
    }

    .front-rail {
      border-inline-start: 1px solid var(--color-line);
      margin-inline-start: calc(-1 * var(--front-gap) / 2);
      padding-inline-start: calc(var(--front-gap) / 2);
    }

    .front-index {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      column-gap: var(--spacing-xl);
      align-items: start;
    }
  }

  @media (max-width: 700px) {
    .front-page {
      grid-template-columns: 1fr;
      grid-template-areas:
        'intro'
        'whatsnew'
        'lead'
        'index'
        'explore'
        'food';
      grid-template-rows: auto;
    }

    .front-center,
    .front-rail {
      display: contents;
    }

    .front-page::before,
    .front-page::after {
      display: none;
    }

    .lead-teaser {
      columns: 1;
    }
  }
</style>
