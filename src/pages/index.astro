---
import { getCollection, render } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import { published, sortTopics } from '../lib/content'
import { isExplored } from '../lib/verdict'
import { getChangelog } from '../lib/changelog'
import { formatDateShort, formatDate } from '../lib/dates'
import { websiteSchema } from '../lib/schema'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import Icon from '../components/Icon.astro'
import FleurDeLis from '../assets/FleurDeLis.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import IconUtensils from '../assets/IconUtensils.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import IconAward from '../assets/IconAward.astro'
import IconListChecks from '../assets/IconListChecks.astro'
import IconFolderTree from '../assets/IconFolderTree.astro'
import IconInfo from '../assets/IconInfo.astro'
import IconTags from '../assets/IconTags.astro'
import IconMessageCircleHeart from '../assets/IconMessageCircleHeart.astro'
import IconCalendar from '../assets/IconCalendar.astro'

// A Lucide icon per directory section, keyed by path. Topic icons come from the
// shared <Icon> component, resolved from each topic's `icon:` frontmatter (so
// the homepage + /topics stay in sync).
const iconByPath: Record<string, typeof IconInfo> = {
  '/food/': IconUtensils,
  '/neighborhoods/': IconMapPin,
  '/best/': IconAward,
  '/food/backlog/': IconListChecks,
  '/events/': IconCalendar,
  '/sitemap/': IconFolderTree,
  '/about/': IconInfo,
  '/tags/': IconTags,
  '/feedback/': IconMessageCircleHeart,
}

const tagline = 'Mapping the food, neighborhoods, and culture of St. Louis.'
const intro = `St. Louing is a personal project I created to document my experience living in St. Louis and learning to love it.`

const allNotes = published(await getCollection('notes')).sort(
  (left, right) => right.data.created.valueOf() - left.data.created.valueOf(),
)
const allTopics = sortTopics(published(await getCollection('topics')))

// Latest few of each for the homepage columns.
const latestNotes = allNotes.slice(0, 5)
const latestTopics = allTopics.slice(0, 4)

// The three most recent updates, shown at the top so a returning visitor can see
// the site is alive at a glance. The full log lives at /updates. The Markdown
// body is rendered (same as /updates) so links + emphasis in a change show here too.
const latestUpdates = await Promise.all(
  (await getChangelog()).slice(0, 1).map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)

// Item counts shown next to the guide sections in the directory.
const allFood = published(await getCollection('food'))
const allNeighborhoods = published(await getCollection('neighborhoods'))
const foodCount = allFood.length
const neighborhoodCount = allNeighborhoods.length
// Progress report tallies: restaurants actually visited (written-up or tried, not
// the want-to-try backlog); neighborhoods wandered mirrors the "explored" count.
const visitedCount = allFood.filter((place) => isExplored(place.data.status)).length
const wanderedCount = neighborhoodCount
const countByPath: Record<string, string> = {
  '/food/': `${foodCount} spots`,
  '/neighborhoods/': `${neighborhoodCount} explored`,
}

const website = websiteSchema(Astro.site ?? new URL(Astro.url.origin))
---

<BaseLayout jsonLd={website}>
  <header class="h-card index-header">
    <div class="index-body">
      <div class="index-intro">
        <h1 class="page-title">St. Louing</h1>
        <p class="tagline p-note">{tagline}</p>

        <p class="introduction">
          {intro}
          So far, I've explored <span class="stat">{wanderedCount}</span> neighborhoods and visited{
            ' '
          }
          <span class="stat">{visitedCount}</span> restaurants!
          <a class="more inline" href={href('/about/')} aria-label="Read more about St. Louing">
            Read more <IconArrowRight />
          </a>
        </p>
      </div>
      <!-- <div class="index-crest">
        <FleurDeLis class="index-crest-img" />
      </div> -->
      <section class="group recently">
        <div class="group-header">
          <h2 class="group-label">What's New</h2>
          <a class="all" href={href('/updates/')}>
            All <IconArrowRight />
          </a>
        </div>
        <ul class="recent-list">
          {
            latestUpdates.map(({ date, Content }) => (
              <li class="recent-item">
                <time class="recent-date" datetime={date.toISOString()}>
                  {formatDate(date)}
                </time>
                <div class="recent-changes">
                  <Content />
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    {/* Author identity for feeds/IndieWeb parsers; data only, not shown. */}
    <span class="p-name" hidden>St. Louing</span>
    <a class="u-url" href={href('/')} hidden>stlouing.com</a>
    <img class="u-photo" src={href('/og.png')} alt="" hidden />
  </header>

  <div class="directory">
    {
      groups.map((group) => {
        if (group.id === 'notes') {
          return (
            <section class="group">
              <div class="group-header">
                <h2 class="group-label">{group.label}</h2>
                <a class="all" href={href('/notes/')}>
                  All <IconArrowRight />
                </a>
              </div>
              <List>
                {latestNotes.map((note) => (
                  <ListItem
                    title={note.data.title}
                    href={href(`/notes/${note.id}/`)}
                    meta={formatDateShort(note.data.created)}
                  />
                ))}
              </List>
            </section>
          )
        }

        if (group.id === 'topics') {
          return (
            <section class="group">
              <div class="group-header">
                <h2 class="group-label">
                  {/* <span class="group-numeral">{group.numeral}.</span>  */}
                  {group.label}
                </h2>
                {group.kicker && <span class="group-kicker">{group.kicker}</span>}
              </div>
              <List>
                {latestTopics.map((topic) => (
                  <ListItem
                    title={topic.data.title}
                    href={href(`/${topic.id}/`)}
                    description={
                      topic.data.description
                        ? `${topic.data.description}.`
                        : formatDateShort(topic.data.updated)
                    }>
                    <Icon name={topic.data.icon} slot="icon" />
                  </ListItem>
                ))}
              </List>
            </section>
          )
        }

        const items = sections.filter((section) => section.group === group.id)

        if (items.length === 0) {
          return null
        }

        return (
          <section class="group">
            <div class="group-header">
              <h2 class="group-label">
                {/* <span class="group-numeral">{group.numeral}.</span>  */}
                {group.label}
              </h2>
              {group.kicker && <span class="group-kicker">{group.kicker}</span>}
            </div>

            <List>
              {items.map((section) => {
                const Icon = iconByPath[section.path]
                return (
                  <ListItem
                    title={section.label}
                    href={href(section.path)}
                    description={section.description}
                    meta={countByPath[section.path]}>
                    {Icon && <Icon slot="icon" />}
                  </ListItem>
                )
              })}
            </List>
          </section>
        )
      })
    }
  </div>

  <div class="newsletter-section">
    <NewsletterSignup compact />
  </div>
</BaseLayout>

<style>
  h1.page-title {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
    margin-bottom: 0;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.1;
    font-size: clamp(3rem, 2rem + 8vw, 6rem);

    span {
      font-size: var(--font-size-xs);
      color: var(--color-muted);
      font-weight: 500;
      font-family: var(--font-mono);
    }
  }

  .index-header {
    margin-bottom: var(--spacing-xl);
  }

  /* The title spans the full width on top; below it, the tagline + intro copy on
     the left and the crest on the right, with the crest vertically centered
     against that below-the-title block (not the title itself). */
  .index-body {
    display: grid;
    align-items: center;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
  }

  .index-intro {
    flex: 1;
    min-width: 0;
  }

  /* A right-hand column wider than the crest so the crest sits centered within
     it rather than hugging the edge. The flag's yellow and blue are fixed brand
     colors, so the crest stays as-is in dark mode. */
  .index-crest {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    justify-self: center;
    width: clamp(80px, 12vw, 100px);
    margin: 0 var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }

  /* :global() because Astro's scope doesn't reach the child component's root
     <svg>; without it the reset (svg { max-width: 100% }) lets the fleur grow to
     fill the container instead of holding this fixed size. */
  .index-crest :global(.index-crest-img) {
    width: clamp(48px, 12vw, 90px);
    height: auto;
  }

  /* Desktop only: turn the crest column into a larger red disc behind the SVG.
     A container background always paints behind its children, so the SVG (its
     own disc + fleur) sits on top; sharing the accent color, the container disc
     and the SVG disc read as one bigger circle while the fleur keeps its size. */
  @media (min-width: 700px) {
    .index-crest {
      width: clamp(104px, 18vw, 150px);
      aspect-ratio: 1;
      background: #c70f2e;
      border-radius: 50%;
    }
  }

  /* Hidden on narrow screens — there's no right-hand column to sit in. Collapse
     the grid to one column too, so the intro spans the full width instead of
     staying pinned to the 2fr track with an empty column beside it. */
  @media (max-width: 700px) {
    .index-body {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .index-crest {
      display: none;
    }
  }

  .tagline {
    margin-block: var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    font-weight: 500;
    line-height: 1.2;
  }

  /* A running tally under the tagline; the counts ride in accent, the label quiet. */
  .progress-report {
    margin-block: var(--spacing-sm) 0;
    /* font-family: var(--font-mono); */
    font-size: var(--font-size-lg);
    color: var(--color-muted);
    font-weight: 400;
    line-height: 1.2;
  }

  .stat {
    color: var(--color-accent);
    font-weight: 700;
  }

  .stat-title {
    color: var(--color-text);
  }

  .introduction {
    max-width: 65ch;
    font-size: var(--font-size-md);
    margin-block: var(--spacing-md);
    color: var(--color-text);
  }

  /* Section header: label on the left, optional "all →" on the right, with a
     dotted rule under both (matches the list-item separators below it). */
  .group-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-sm);
    border-block-end: 2px solid var(--color-line-contrast);
    padding-block-end: var(--spacing-xs);
    margin-block-end: var(--spacing-xs);
  }

  .group-header .group-label {
    margin: 0;
  }

  /* Roman numeral prefix (I. II. …) set apart from the section label. */
  .group-numeral {
    color: var(--color-accent);
  }

  /* Right-justified section caption (Maps / Reading / …). */
  .group-kicker {
    display: none;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
  }

  .group-header .all {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-shrink: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    font-weight: 500;
  }

  .group-header .all:hover {
    text-decoration-color: var(--color-accent);
  }

  /* Keep the arrow the same accent color as the link text. */
  .group-header .all :global(.icon) {
    color: inherit;
  }

  /* The "Recently updated" block sits above the directory so a returning visitor
     sees the site is alive right away. Each row: a mono date in a left rail, the
     update's title + one-line summary beside it. */
  /* What's New rides the header grid's right column as a boxed card, top-aligned
     with the title. The grid's 700px collapse stacks it under the intro. */
  .recently {
    margin-block-start: var(--spacing-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: var(--spacing-md) var(--spacing-lg);
    min-width: 0;
  }

  /* The box's column is too narrow for the /updates two-track date rail; stack
     the date over its changes instead — the same collapse /updates uses on
     phones — and tighten the row rhythm to fit the card. */
  .recently .recent-list {
    grid-template-columns: 1fr;
  }

  .recently .recent-item {
    row-gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .recently .recent-item:first-child {
    padding-block-start: 0;
  }

  .recently .recent-item:last-child {
    padding-block-end: 0;
  }

  /* Same layout as the What's New page (/updates): the list owns two tracks — a
     date rail sized to the widest date, then the changes — and each row is a
     subgrid spanning both, which also carries the per-row hairline. */
  .recent-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    column-gap: var(--spacing-lg);
    padding-block: var(--spacing-lg);
    border-block-start: 1px solid var(--color-line);
  }

  .recent-item:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .recent-date {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-muted);
    text-wrap: nowrap;
    /* Nudge onto the first line of the changes list beside it. */
    padding-block-start: 2px;
  }

  /* The rendered Markdown list. Keep the bullets, just reset spacing. */
  .recent-changes {
    color: var(--color-text);
    line-height: 1.45;
    font-size: var(--font-size-sm);
  }

  .recent-changes :global(ul) {
    margin: 0;
    padding-inline-start: var(--spacing-lg);
  }

  .recent-changes :global(li) {
    margin-block: 0;
  }

  .recent-changes :global(p) {
    margin-block: 0;
  }

  .recent-changes :global(p + p) {
    margin-block-start: var(--spacing-sm);
  }

  /* Match the prose convention: links gain a solid underline on hover. */
  .recent-changes :global(a:hover) {
    text-decoration-line: underline;
  }

  /* Stack the date over its changes on phones, like /updates does. The box
     also drops its top offset there — stacked under the intro, the grid row
     provides the separation. */
  @media (max-width: 700px) {
    .recently {
      margin-block-start: 0;
    }

    .recent-list {
      grid-template-columns: 1fr;
    }

    .recent-item {
      row-gap: var(--spacing-sm);
      padding-block: var(--spacing-md);
    }
  }

  .directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-block-end: var(--spacing-lg);
  }

  @media (max-width: 700px) {
    .directory {
      grid-template-columns: 1fr;
    }
  }

  /* Break the newsletter out of the centered .wrap so its river runs edge to edge,
     like the entry pages; the signup inside re-constrains to the measure. */
  .newsletter-section {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block-start: var(--spacing-xl);
  }
</style>
