---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import { published } from '../lib/content'
import IconSquareArrowRightEnter from '../assets/IconSquareArrowRightEnter.astro'

const tagline = "A transplant's guide to St. Louis"

const intro =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.'

// Latest few notes for the homepage Notes column.
const latestNotes = published(await getCollection('notes'))
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf())
  .slice(0, 3)

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<BaseLayout>
  <h1 class="page-title">St. Louing <span>since 2023</span></h1>
  <p class="tagline">{tagline}</p>
  <p class="introduction">{intro}</p>

  <div class="directory">
    {
      groups.map((group) => {
        if (group.id === 'notes') {
          return (
            <section class="group">
              <h2 class="group-label">{group.label}</h2>
              <ul class="list">
                {latestNotes.map((note) => (
                  <li>
                    <a class="list-title" href={href(`/notes/${note.id}`)}>
                      {note.data.title}
                    </a>
                    <p class="list-description">{formatDate(note.data.date)}</p>
                  </li>
                ))}
                <li>
                  <a class="more" href={href('/notes')}>
                    All notes
                  </a>
                </li>
              </ul>
            </section>
          )
        }

        const items = sections.filter((section) => section.group === group.id)

        if (items.length === 0) {
          return null
        }

        return (
          <section class="group">
            {group.label && <h2 class="group-label">{group.label}</h2>}

            <ul class="list">
              {items.map((section) => (
                <li>
                  <a class="list-title" href={href(section.path)}>
                    {section.label}
                  </a>
                  {section.description && <p class="list-description">{section.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        )
      })
    }
  </div>
</BaseLayout>

<style>
  .tagline {
    margin-block: var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-accent);
  }

  .introduction {
    max-width: 62ch;
    margin-block: var(--spacing-sm) var(--spacing-lg);
    color: var(--color-text-muted);
  }

  .directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 34rem) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
</style>
