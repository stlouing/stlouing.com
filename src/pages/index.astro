---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import { published } from '../lib/content'
import { formatDateShort } from '../lib/dates'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'

const tagline = 'Maps, guides, and observations from around St. Louis'

const intro =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.'

const allNotes = published(await getCollection('notes')).sort(
  (left, right) => right.data.date.valueOf() - left.data.date.valueOf(),
)
const allTopics = published(await getCollection('topics')).sort(
  (left, right) => right.data.updated.valueOf() - left.data.updated.valueOf(),
)

// Latest few of each for the homepage columns.
const latestNotes = allNotes.slice(0, 3)
const latestTopics = allTopics.slice(0, 3)

// Most recent change anywhere in the garden, for the "Last Updated" line.
const lastUpdated = new Date(
  Math.max(
    ...allNotes.map((note) => note.data.date.valueOf()),
    ...allTopics.map((topic) => topic.data.updated.valueOf()),
  ),
)
---

<BaseLayout>
  <header class="h-card">
    <h1 class="page-title">St. Louing <span>since 2023</span></h1>
    <p class="tagline p-note">{tagline}</p>
    <p class="introduction">{intro}</p>
    <p class="last-updated">
      <strong>Last Updated:</strong>
      <span>{formatDateShort(lastUpdated)}</span>
    </p>
    {/* Author identity for feeds/IndieWeb parsers; data only, not shown. */}
    <span class="p-name" hidden>St. Louing</span>
    <a class="u-url" href={href('/')} hidden>stlouing.com</a>
    <img class="u-photo" src={href('/favicon.png')} alt="" hidden />
  </header>

  <div class="directory">
    {
      groups.map((group) => {
        if (group.id === 'notes') {
          return (
            <section class="group">
              <h2 class="group-label">{group.label}</h2>
              <List>
                {latestNotes.map((note) => (
                  <ListItem
                    title={note.data.title}
                    href={href(`/notes/${note.id}`)}
                    description={formatDateShort(note.data.date)}
                  />
                ))}
                <li>
                  <a class="more" href={href('/notes')}>
                    All notes <IconArrowRight />
                  </a>
                </li>
              </List>
            </section>
          )
        }

        if (group.id === 'topics') {
          return (
            <section class="group">
              <h2 class="group-label">{group.label}</h2>
              <List>
                {latestTopics.map((topic) => (
                  <ListItem
                    title={topic.data.title}
                    href={href(`/${topic.id}`)}
                    description={topic.data.description || formatDateShort(topic.data.updated)}
                  />
                ))}
                <li>
                  <a class="more" href={href('/topics')}>
                    All topics <IconArrowRight />
                  </a>
                </li>
              </List>
            </section>
          )
        }

        const items = sections.filter((section) => section.group === group.id)

        if (items.length === 0) {
          return null
        }

        return (
          <section class="group">
            {group.label && <h2 class="group-label">{group.label}</h2>}

            <List>
              {items.map((section) => (
                <ListItem
                  title={section.label}
                  href={href(section.path)}
                  description={section.description}
                />
              ))}
            </List>
          </section>
        )
      })
    }
  </div>
</BaseLayout>

<style>
  .tagline {
    margin-block: var(--spacing-xs) 0;
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-accent);
  }

  .introduction {
    max-width: 62ch;
    font-size: var(--font-size-lg);
    margin-block: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .last-updated {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    font-style: italic;
    margin-bottom: var(--spacing-lg);

    strong {
      font-weight: 500;
    }

    span {
      color: var(--color-text-muted);
    }
  }

  .directory {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 34rem) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
</style>
