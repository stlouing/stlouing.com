---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import {
  published,
  sortTopics,
  excerpt,
  PINNED_TOPIC_ID,
  PREVIEW_EXCERPT_CHARS,
} from '../lib/content'
import { isExplored } from '../lib/verdict'
import { getChangelog } from '../lib/changelog'
import { formatDate } from '../lib/dates'
import { websiteSchema } from '../lib/schema'
import { TAGLINE } from '../lib/site'
import Button from '../components/Button.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import Icon from '../components/Icon.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'

const intro = `Welcome to St. Louing, a website I created to document living in St. Louis and learning to love it.`

const allTopics = sortTopics(published(await getCollection('topics')))

// The lead story: the most recently updated topic, skipping the pinned Field
// Notes entry (a living index, not an article). The teaser is derived from the
// topic's own prose, the same way /topics builds its excerpts.
const leadTopic = allTopics.find((topic) => topic.id !== PINNED_TOPIC_ID)
const leadTeaser = leadTopic ? excerpt(leadTopic.body, 420) : ''

// The most recent updates, shown in the What's New window so a returning
// visitor can see the site is alive at a glance. The full log lives at
// /updates. The Markdown body is rendered (same as /updates) so links +
// emphasis in a change show here too.
const latestUpdates = await Promise.all(
  (await getChangelog()).slice(0, 2).map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)

// Progress report tallies for the intro sentence: restaurants actually
// visited (written-up or tried, not the want-to-try backlog); neighborhoods
// wandered mirrors the "explored" count.
const allFood = published(await getCollection('food'))
const allNeighborhoods = published(await getCollection('neighborhoods'))
const visitedCount = allFood.filter((place) => isExplored(place.data.status)).length
const wanderedCount = allNeighborhoods.length

// The Explore rail: the map sections.
const exploreGroup = groups.find((group) => group.id === 'explore')
const exploreSections = sections.filter((section) => section.group === 'explore')

// The food cards: a hand-picked four, shown in this order. Each id is a file
// in src/content/food/ — edit the list to change the front page.
const FEATURED_FOOD_IDS = [
  'pizzeria-da-gloria',
  'kishimoto-mendo',
  'nicky-slices',
  'dalies-smokehouse',
]
const featuredFood = FEATURED_FOOD_IDS.flatMap((foodId) =>
  allFood.filter((place) => place.id === foodId),
).map((place) => ({ place, teaser: excerpt(place.body, PREVIEW_EXCERPT_CHARS) }))

// The left rail: the article index (all published topics, straight from the
// collection so it grows as pieces publish), then a compact "More" section —
// the list pages plus the non-primary site pages (About and Feedback already
// live in the nav).
const moreSections = [
  ...sections.filter((section) => section.group === 'lists'),
  ...sections.filter((section) => section.group === 'site' && !section.primary),
]

const website = websiteSchema(Astro.site ?? new URL(Astro.url.origin))
---

<BaseLayout home jsonLd={website}>
  <div class="front-page">
    {
      /* Column 1: the article rail — serif titles with date bylines, then a
       compact More section for everything else. */
    }
    <aside class="front-index" aria-label="Site index">
      <section class="front-index-topics">
        <h2 class="rail-header">Topics</h2>
        <ul class="rail-articles">
          {
            allTopics.map((topic) => (
              <li>
                <a href={href(`/${topic.id}/`)}>
                  <span class="rail-article-title">{topic.data.title}</span>
                  {topic.data.description && (
                    <span class="rail-article-description">{topic.data.description}</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="front-index-more">
        <h2 class="rail-header">More</h2>
        <ul class="front-index-list">
          {
            moreSections.map((section) => (
              <li>
                <a href={href(section.path)}>
                  <span class="front-index-label">{section.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>

    {
      /* The site intro, topping the left column on desktop. Its own grid item
       (not inside a column wrapper) so the phone layout can keep it first. */
    }
    <header class="h-card front-intro">
      {
        /* The tagline leads the block as its main header; the p-note class
         doubles it as the h-card's note for mf2 parsers. */
      }
      <p class="front-eyebrow">About</p>
      <h2 class="front-tagline p-note">{TAGLINE}</h2>
      <p class="introduction">
        {intro}
        <br /><br />
        <strong>So far</strong>: <span class="stat">{wanderedCount}</span> neighborhoods and
        <span class="stat">{visitedCount}</span> restaurants! <a
          class="continue-link"
          href={href('/about/')}
          aria-label="Read more about St. Louing">
          Continue reading <IconArrowRight />
        </a>
      </p>
      {/* Author identity for feeds/IndieWeb parsers; data only, not shown. */}
      <span class="p-name" hidden>St. Louing</span>
      <a class="u-url" href={href('/')} hidden>stlouing.com</a>
      <img class="u-photo" src={href('/og.png')} alt="" hidden />
    </header>

    {
      /* Column 2: the lead story and food cards. The wrapper lets the column
       flow at its own height (no row coupling with the rails); on phones it
       dissolves (display: contents) so the grid can interleave the areas. */
    }
    <div class="front-center">
      {
        leadTopic && (
          <section class="front-lead">
            {/* The curated blurb-free banner (never the OG card — its baked-in
             title would double the headline). Duplicate of the headline link,
             so it's hidden from the accessibility tree. */}
            {leadTopic.data.leadImage && (
              <a
                class="lead-figure"
                href={href(`/${leadTopic.id}/`)}
                aria-hidden="true"
                tabindex="-1">
                <img src={href(leadTopic.data.leadImage)} alt="" width="1200" height="800" />
              </a>
            )}
            <p class="section-label lead-kicker">Featured</p>
            <p class="lead-dateline">{formatDate(leadTopic.data.updated)}</p>
            <h2 class="lead-headline">
              <a href={href(`/${leadTopic.id}/`)}>{leadTopic.data.title}</a>
            </h2>
            {leadTopic.data.description && <p class="lead-deck">{leadTopic.data.description}</p>}
            {leadTeaser && <p class="lead-teaser">{leadTeaser}</p>}
            <p class="lead-meta">
              <Button href={href(`/${leadTopic.id}/`)} variant="dark" compact>
                Read more <IconArrowRight />
              </Button>
            </p>
          </section>
        )
      }

      <section class="front-food">
        <div class="group-header">
          <h2 class="group-label">Food</h2>
          <a class="group-all continue-link" href={href('/best/')}>
            All restaurants & cafes <IconArrowRight />
          </a>
        </div>
        <div class="food-cards">
          {
            featuredFood.map(({ place, teaser }) => (
              <article class="food-card">
                <a class="food-card-link" href={href(`/food/${place.id}/`)}>
                  {place.data.photo && (
                    <Image
                      class="food-card-photo"
                      src={place.data.photo}
                      alt={place.data.title}
                      width={520}
                    />
                  )}
                  <span class="food-card-title">{place.data.title}</span>
                  {place.data.description && (
                    <span class="food-card-description">{place.data.description}</span>
                  )}
                  {teaser && <span class="food-card-excerpt">{teaser}</span>}
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </div>

    {
      /* Column 3: the Explore rail — the maps, then the What's New window. Same
       independent-flow wrapper as the center column. */
    }
    <div class="front-rail">
      <section class="front-explore">
        <div class="group-header">
          <h2 class="group-label">{exploreGroup?.label}</h2>
          {exploreGroup?.kicker && <span class="group-kicker">{exploreGroup.kicker}</span>}
        </div>
        <List>
          {
            exploreSections.map((section) => (
              <ListItem
                title={section.label}
                href={href(section.path)}
                description={section.description}>
                {section.icon && <Icon name={section.icon} slot="icon" />}
              </ListItem>
            ))
          }
        </List>
      </section>

      <section class="front-whatsnew whats-new">
        <h2 class="whats-new-title">What's New</h2>
        {/* The classic column's asterisk separator, in fleurs. */}
        <div class="whats-new-fleurs" aria-hidden="true">
          <FleurGlyph />
          <FleurGlyph />
          <FleurGlyph />
        </div>
        <ul class="recent-list">
          {
            latestUpdates.map(({ date, Content }) => (
              <li class="recent-item">
                <time class="recent-date" datetime={date.toISOString()}>
                  {formatDate(date)}
                </time>
                <div class="recent-changes">
                  <Content />
                </div>
              </li>
            ))
          }
        </ul>
        <a class="whats-new-all continue-link" href={href('/updates/')}>
          All updates <IconArrowRight />
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* The holy-grail front page: index rail | center | explore rail, as one flat
     grid so the responsive collapses can reorder freely. The column rules are
     drawn by the container (below), so they run the full column height no
     matter how tall each item is. */
  .front-page {
    --front-rail-left: 250px;
    --front-rail-right: 300px;
    --front-gap: var(--spacing-xl);
    position: relative;
    display: grid;
    grid-template-columns: var(--front-rail-left) minmax(0, 1fr) var(--front-rail-right);
    grid-template-areas:
      'intro center rail'
      'index center rail';
    /* Row 1 hugs the intro; without this, the tall row-spanning center column
       distributes its height into row 1 and opens a hole above the index. */
    grid-template-rows: auto 1fr;
    column-gap: var(--front-gap);
    row-gap: var(--spacing-lg);
    align-items: start;
    margin-block: var(--spacing-lg);
  }

  /* Each column is its own flow, so a tall item in one column never opens a
     hole in another (grid rows would otherwise couple their heights). */
  .front-center,
  .front-rail {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    min-width: 0;
  }

  .front-center {
    grid-area: center;
  }

  .front-rail {
    grid-area: rail;
  }

  /* Newspaper column rules, centered in each gap. */
  .front-page::before,
  .front-page::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 1px;
    background: var(--color-line);
  }

  .front-page::before {
    left: calc(var(--front-rail-left) + var(--front-gap) / 2);
  }

  .front-page::after {
    right: calc(var(--front-rail-right) + var(--front-gap) / 2);
  }

  .front-index {
    grid-area: index;
    min-width: 0;
  }

  .front-intro {
    grid-area: intro;
    min-width: 0;
  }

  .front-lead {
    grid-area: lead;
    min-width: 0;
  }

  .front-food {
    grid-area: food;
    min-width: 0;
  }

  .front-explore {
    grid-area: explore;
    min-width: 0;
  }

  .front-whatsnew {
    grid-area: whatsnew;
    min-width: 0;
  }

  /* ----- The article rail ----- */

  /* Rail section headers in the same heavy black voice as Lists/Explore,
     scaled down for the narrow column. */
  .rail-header {
    margin: 0 0 var(--spacing-xs);
    padding-block-end: var(--spacing-xs);
    border-block-end: 2px solid var(--color-line-contrast);
    font-family: var(--font-display-black);
    font-weight: 400;
    /* Same size as the Explore/Lists group labels. */
    font-size: var(--font-size-xxl);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  /* Article rows: serif title over a red date byline, dotted rules between —
     the magazine-rail treatment. */
  .rail-articles {
    margin: 0 0 var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .rail-articles li {
    margin: 0;
  }

  .rail-articles li + li {
    border-block-start: 1px dotted var(--color-line-input);
  }

  /* The whole-row hover wash, with the ListItem padding/negative-margin bleed
     so the tint extends past the text while alignment holds. */
  .rail-articles a {
    display: block;
    padding: var(--spacing-shmedium) var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    color: var(--color-text-heading);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  .rail-articles a:hover {
    background: color-mix(in srgb, var(--color-text) 5%, var(--color-background));
  }

  .rail-article-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--font-size-lg);
    line-height: 1.25;
  }

  .rail-article-description {
    display: block;
    margin-block-start: var(--spacing-xs);
    font-family: var(--font-serif);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: var(--color-muted);
  }

  .rail-articles a:hover .rail-article-title {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .front-index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .front-index-list li {
    margin: 0;
  }

  /* Fine dotted rules between rows, under the solid-ruled section header. */
  .front-index-list li + li {
    border-block-start: 1px dotted var(--color-line-input);
  }

  /* Dense mono rows for the More section. */
  .front-index-list a {
    display: block;
    min-width: 0;
    padding: var(--spacing-xs) var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  .front-index-list a:hover {
    background: color-mix(in srgb, var(--color-text) 5%, var(--color-background));
  }

  .front-index-list a:hover .front-index-label {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  /* ----- The center column ----- */

  /* The heavy grotesque (not the serif) so the column opener doesn't clash
     with the lead story's serif headline below it. */
  /* The red eyebrow over the intro — same voice as the datelines. */
  .front-eyebrow {
    margin-block: 0 var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-accent);
  }

  /* Sized for the narrow left column it now tops (full-width on tablet and
     phone, where it still reads fine at this scale). */
  .front-tagline {
    margin-block: 0 var(--spacing-sm);
    font-family: var(--font-display-black);
    font-weight: 400;
    line-height: 1.25;
    font-size: var(--font-size-xl);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .introduction {
    max-width: 65ch;
    font-size: var(--font-size-md);
    margin-block: 0;
    color: var(--color-text);
  }

  .stat {
    color: var(--color-accent-blue);
    /* font-weight: 700; */
  }

  /* The lead now opens the center column, so only the food band below it
     carries a seam rule. */
  .front-food {
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--spacing-md);
  }

  /* The lead story reads like a magazine feature: centered kicker + dateline +
     headline + deck, then a dotted rule into a drop-capped two-column teaser. */
  .front-lead {
    text-align: center;
  }

  .lead-figure {
    display: block;
    margin-block-end: var(--spacing-md);
  }

  .lead-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
  }

  .lead-kicker {
    margin-block: 0 var(--spacing-sm);
    color: var(--color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .lead-dateline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    margin-block: 0 var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-accent);
  }

  .lead-dateline :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--color-accent);
  }

  .lead-headline {
    margin-block: 0 var(--spacing-xs);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    text-wrap: balance;
  }

  .lead-headline a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .lead-headline a:hover {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .lead-deck {
    margin-block: 0 var(--spacing-md);
    font-size: var(--font-size-lg);
    color: var(--color-muted);
    font-weight: 400;
    line-height: 1.35;
    text-wrap: balance;
  }

  .lead-teaser {
    margin-block: 0 var(--spacing-sm);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);
    text-align: start;
    font-size: var(--font-size-md);
    color: var(--color-text-article);
    columns: 2;
    column-gap: var(--spacing-xl);
    column-rule: 1px dotted var(--color-line-input);
  }

  /* The big plain drop cap opens the teaser, magazine-style. */
  .lead-teaser::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 4.4em;
    line-height: 0.75;
    padding-inline-end: var(--spacing-sm);
    padding-block-start: 0.04em;
    color: var(--color-text-heading);
  }

  .lead-meta {
    display: flex;
    justify-content: flex-end;
    margin-block: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  /* ----- Shared section headers (Explore, Lists) ----- */

  .group-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-sm);
    border-block-end: 2px solid var(--color-line-contrast);
    padding-block-end: var(--spacing-xs);
    margin-block-end: var(--spacing-xs);
  }

  /* Dramatic black section headers, magazine-style — heavy uppercase grotesque
     over the thick rule, with the quiet mono kicker riding flush right. */
  .group-header .group-label {
    margin: 0;
    font-family: var(--font-display-black);
    font-weight: 400;
    font-size: var(--font-size-xxl);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  /* The rail's list rows pick up the flag blue via the ListItem hooks. */
  .front-explore {
    --list-icon-color: var(--color-accent-blue);
    --list-hover-color: var(--color-accent-blue);
  }

  /* The two map links read as links: underlined like body-copy anchors. The
     hover override pins the same offset so the underline holds its position
     (ListItem's own hover rule uses 2px) and only the color changes. */
  .front-explore :global(.list-title) {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-muted);
    text-underline-offset: 3px;
  }

  .front-explore :global(a.list-item:hover .list-title) {
    text-underline-offset: 3px;
  }

  /* The map descriptions read at the intro paragraph's measure. The extra
     .list-item class outranks List.astro's scoped rule (a bare descendant
     selector only ties it, and cascade order is unreliable across files). */
  .front-explore :global(.list-item .list-description) {
    font-size: var(--font-size-md);
    line-height: 1.55;
  }

  /* The map link titles step up to the large size. */
  .front-explore :global(.list-item .list-title) {
    font-size: var(--font-size-lg);
  }

  /* Right-justified section caption (Maps / Reading / …). */
  .group-kicker {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
  }

  /* ----- The food cards ----- */

  /* Placement only — the look comes from .continue-link. */
  .group-all {
    flex-shrink: 0;
  }

  /* A 2x2 of equal-height cards: 1fr auto-rows stretch every card to the
     tallest row. */
  .food-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-sm);
  }

  .food-card {
    margin: 0;
    min-width: 0;
  }

  /* Padding pulled back out by a matching negative margin (the ListItem
     idiom), so the hover wash bleeds past the content while everything stays
     aligned with the column. */
  .food-card-link {
    display: flex;
    flex-direction: column;
    /* Tight title-to-description rhythm; the photo opens its own gap below. */
    gap: var(--spacing-xs);
    height: 100%;
    padding: var(--spacing-sm);
    margin: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  .food-card-link:hover {
    background: color-mix(in srgb, var(--color-text) 5%, var(--color-background));
  }

  .food-card-link :global(.food-card-photo) {
    width: 100%;
    height: var(--card-photo-height);
    object-fit: cover;
    /* The photo keeps a fuller gap than the tightened title/description one. */
    margin-block-end: var(--spacing-xs);
  }

  .food-card-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--font-size-lg);
    line-height: 1.25;
    color: var(--color-text-heading);
  }

  .food-card-description {
    font-family: var(--font-serif);
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--color-muted);
    margin-bottom: var(--spacing-xs);
