---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import neighborhoodsData from '../data/neighborhoods.json'

import BaseLayout from '../layouts/BaseLayout.astro'
import { sections, groups } from '../lib/sections'
import { href } from '../lib/url'
import {
  published,
  sortTopics,
  excerpt,
  PINNED_TOPIC_ID,
  PREVIEW_EXCERPT_CHARS,
} from '../lib/content'
import { isExplored } from '../lib/verdict'
import { formatDate } from '../lib/dates'
import { websiteSchema } from '../lib/schema'
import { TAGLINE, SOCIALS } from '../lib/site'
import Button from '../components/Button.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import Heading from '../components/Heading.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Card from '../components/Card.astro'
import PromoCard from '../components/PromoCard.astro'
import bestPromoPhoto from '../content/images/food/kishimoto/kishi3.jpg'
import WhatsNew from '../components/WhatsNew.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import IconInstagram from '../assets/IconInstagram.astro'
import FleurRow from '../components/FleurRow.astro'

const intro = `Welcome to St. Louing, my ongoing project to document living in St. Louis and learning to love it!`

const allTopics = sortTopics(published(await getCollection('topics')))

const leadTopic = allTopics.find((topic) => topic.id !== PINNED_TOPIC_ID)
const leadTeaser = leadTopic ? excerpt(leadTopic.body, 420) : ''

const railTopics = allTopics.filter((topic) => topic.id !== leadTopic?.id)
const promotedTopic = allTopics.find((topic) => topic.id === 'walkable-st-louis')
const TOPIC_PROMO_EXCERPT_CHARS = 250

const allFood = published(await getCollection('food'))
const allNeighborhoods = published(await getCollection('neighborhoods'))
const visitedCount = allFood.filter((place) => isExplored(place.data.status)).length
const wanderedCount = allNeighborhoods.length

const exploreGroup = groups.find((group) => group.id === 'explore')
const exploreSections = sections.filter((section) => section.group === 'explore')

const exploreCounts: Record<string, number> = {
  '/food/': allFood.length,
  '/neighborhoods/': neighborhoodsData.filter((neighborhood) => !('ignored' in neighborhood))
    .length,
}

const FEATURED_FOOD_IDS = [
  'teerak-thai',
  'grand-pied',
  'kishimoto-mendo',
  'dalies-smokehouse',
  'nicky-slices',
  'pizzeria-da-gloria',
  'woofies-hot-dogs',
  'sultan',
]
const featuredFood = FEATURED_FOOD_IDS.flatMap((foodId) =>
  allFood.filter((place) => place.id === foodId),
).map((place) => ({ place, teaser: excerpt(place.body, PREVIEW_EXCERPT_CHARS) }))

const bestSection = sections.find((section) => section.path === '/best/')

const moreSections = [
  ...sections.filter((section) => section.group === 'lists' && section !== bestSection),
  ...sections.filter((section) => section.group === 'site' && !section.primary),
]

const instagram = SOCIALS.find((social) => social.label === 'Instagram')

const website = websiteSchema(Astro.site ?? new URL(Astro.url.origin))
---

<BaseLayout home jsonLd={website}>
  <div class="front-page">
    <aside class="front-index" aria-label="Site index">
      <section class="front-index-topics">
        <Heading>Topics</Heading>
        <div class="rail-articles card-rows">
          {
            railTopics.map((topic) => (
              <Card
                href={href(`/${topic.id}/`)}
                title={topic.data.title}
                description={topic.data.description}
              />
            ))
          }
        </div>
      </section>
      {
        bestSection && (
          <section class="front-index-best">
            <PromoCard
              href={href(bestSection.path)}
              title={bestSection.label}
              meta={groups.find((group) => group.id === bestSection.group)?.label}
              description={bestSection.description}
              photo={bestPromoPhoto}
              photoAlt="Inside Kishimoto Mendo"
              linkLabel="View all"
            />
          </section>
        )
      }
      <section class="front-index-more">
        <Heading>More</Heading>
        <ul class="front-index-list divided-list">
          {
            moreSections.map((section) => (
              <li>
                <a class="hover-wash" href={href(section.path)}>
                  <span class="title-link">{section.label}</span>
                </a>
              </li>
            ))
          }
          {
            instagram && (
              <li>
                <a
                  class="hover-wash front-index-instagram"
                  href={instagram.url}
                  target="_blank"
                  rel="noopener">
                  <span class="instagram-tile" aria-hidden="true">
                    <IconInstagram />
                  </span>
                  <span class="title-link">st.louing</span>
                </a>
              </li>
            )
          }
        </ul>
      </section>
    </aside>

    <header class="h-card front-intro">
      <p class="front-eyebrow eyebrow">About</p>
      <h2 class="front-tagline p-note">{TAGLINE}</h2>
      <p class="introduction">
        {intro}
        <br /><br />
        <strong>Explored</strong>: <span class="stat">{wanderedCount}</span> neighborhoods and
        <span class="stat">{visitedCount}</span> restaurants so far! <a
          class="continue-link"
          href={href('/about/')}
          aria-label="Read more about St. Louing">
          Continue reading <IconArrowRight />
        </a>
      </p>
      <span class="p-name" hidden>St. Louing</span>
      <a class="u-url" href={href('/')} hidden>stlouing.com</a>
      <img class="u-photo" src={href('/og.png')} alt="" hidden />
    </header>

    <div class="front-center">
      {
        leadTopic && (
          <section class="front-lead">
            {leadTopic.data.photo && (
              <a
                class="lead-figure"
                href={href(`/${leadTopic.id}/`)}
                aria-hidden="true"
                tabindex="-1">
                <Image
                  class="photo-frame"
                  src={leadTopic.data.photo}
                  alt=""
                  widths={[600, 1200]}
                  loading="eager"
                  sizes="(min-width: 1000px) 600px, 100vw"
                />
              </a>
            )}
            <p class="lead-kicker eyebrow">Featured</p>
            <p class="lead-dateline eyebrow">{formatDate(leadTopic.data.updated)}</p>
            <h2 class="lead-headline">
              <a class="title-display title-link" href={href(`/${leadTopic.id}/`)}>
                {leadTopic.data.title}
              </a>
            </h2>
            {leadTopic.data.description && (
              <p class="lead-deck description description--lg">{leadTopic.data.description}</p>
            )}
            {leadTeaser && <p class="lead-teaser drop-cap">{leadTeaser}</p>}
            <p class="lead-meta">
              <Button href={href(`/${leadTopic.id}/`)} variant="dark" compact>
                Read more <IconArrowRight />
              </Button>
            </p>
          </section>
        )
      }

      <section class="front-food">
        <SectionHeading
          title="Food"
          moreHref={href('/food/')}
          moreLabel="All restaurants & cafes"
        />
        <div class="photo-cards">
          {
            featuredFood.map(({ place, teaser }) => (
              <Card
                class="card--lg card--tall-photo"
                href={href(`/food/${place.id}/`)}
                title={place.data.title}
                description={place.data.description}
                excerpt={teaser}
                photo={place.data.photo}
              />
            ))
          }
        </div>
      </section>
    </div>

    <div class="front-rail">
      <section class="front-explore">
        <Heading>
          {exploreGroup?.label ?? ''}
          {
            exploreGroup?.kicker && (
              <span slot="aside" class="eyebrow eyebrow--muted">
                {exploreGroup.kicker}
              </span>
            )
          }
        </Heading>
        <List>
          {
            exploreSections.map((section) => (
              <ListItem
                title={section.label}
                href={href(section.path)}
                description={section.description}
                meta={exploreCounts[section.path]?.toString()}
                leader={section.path in exploreCounts}
              />
            ))
          }
        </List>
      </section>

      <div class="front-whatsnew">
        <WhatsNew />
        <div class="ad-box no-ads">
          <FleurRow class="ad-box-header" />
          <div class="ad-box-content">
            <p>This site has</p>
            <p class="no-ads-copy">No ads</p>
            <p>Enjoy your interruption-free browsing experience!</p>
          </div>
        </div>
        {
          promotedTopic && (
            <PromoCard
              href={href(`/${promotedTopic.id}/`)}
              title={promotedTopic.data.title}
              meta={promotedTopic.data.category}
              description={promotedTopic.data.description}
              excerpt={excerpt(promotedTopic.body, TOPIC_PROMO_EXCERPT_CHARS)}
              photo={promotedTopic.data.photo}
              photoAlt={promotedTopic.data.photoCaption}
              linkLabel="Continue reading"
            />
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .front-page {
    --front-rail-left: 250px;
    --front-rail-right: 260px;
    --front-gap: var(--spacing-xl);
    position: relative;
    display: grid;
    grid-template-columns: var(--front-rail-left) minmax(0, 1fr) var(--front-rail-right);
    grid-template-areas:
      'intro center rail'
      'index center rail';
    grid-template-rows: auto 1fr;
    column-gap: var(--front-gap);
    row-gap: var(--spacing-lg);
    align-items: start;
    margin-block: var(--spacing-lg);
  }

  .front-center,
  .front-rail {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    min-width: 0;
  }

  .front-center {
    grid-area: center;
  }

  .front-rail {
    grid-area: rail;
  }

  .front-page::before,
  .front-page::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 1px;
    background: var(--color-line);
  }

  .front-page::before {
    left: calc(var(--front-rail-left) + var(--front-gap) / 2);
  }

  .front-page::after {
    right: calc(var(--front-rail-right) + var(--front-gap) / 2);
  }

  .front-index {
    grid-area: index;
  }

  .front-intro {
    grid-area: intro;
  }

  .front-index,
  .front-intro,
  .front-lead,
  .front-food,
  .front-explore,
  .front-whatsnew {
    min-width: 0;
  }

  .front-whatsnew {
    display: grid;
    gap: var(--spacing-lg);
    align-content: start;
  }

  .ad-box {
    display: grid;
    border: 2px solid var(--color-line-contrast);
  }

  .ad-box-content {
    padding: var(--spacing-md);
  }

  .ad-box :global(.ad-box-header) {
    --fleur-color: var(--color-panel);
    padding-block: var(--spacing-sm);
    background: var(--color-text-heading);
  }

  .no-ads {
    text-align: center;

    p {
      margin-bottom: 0;
    }
  }

  .no-ads-copy {
    margin: 0;
    font-family: var(--font-sans-serif);
    font-weight: 900;
    font-size: 2rem;
    line-height: 2;
    transform: scaleY(2);
    text-transform: uppercase;
  }

  .rail-articles,
  .front-index-best {
    margin-block-end: var(--spacing-lg);
  }

  .rail-articles :global(.card-description) {
    font-style: normal;
  }

  .front-index-list a {
    display: block;
    min-width: 0;
    padding: var(--spacing-xs) var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
  }

  .front-index-list a.front-index-instagram {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .instagram-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: radial-gradient(
      circle at 30% 107%,
      #fdf497 0%,
      #fdf497 5%,
      #fd5949 45%,
      #d6249f 60%,
      #285aeb 90%
    );
  }

  .instagram-tile :global(.icon) {
    width: 12px;
    height: 12px;
    color: #ffffff;
  }

  .front-eyebrow {
    margin-block: 0 var(--spacing-xs);
  }

  .front-tagline {
    margin-block: 0 var(--spacing-sm);
    font-family: var(--font-sans-serif);
    font-weight: 900;
    line-height: 1.25;
    font-size: var(--font-size-xl);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
    text-wrap: balance;
  }

  .introduction {
    max-width: 65ch;
    margin-block: 0;
  }

  .stat {
    color: var(--color-accent-blue);
  }

  .front-food {
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--spacing-md);
  }

  .front-lead {
    text-align: center;
  }

  .lead-figure {
    display: block;
    margin-block-end: var(--spacing-md);
  }

  .lead-figure img {
    width: 100%;
  }

  .lead-kicker {
    margin-block: 0 var(--spacing-sm);
    color: var(--color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .lead-dateline {
    margin-block: 0 var(--spacing-sm);
  }

  .lead-headline {
    margin-block: 0 var(--spacing-xs);
    line-height: 1.05;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
  }

  .lead-deck {
    margin-block: 0 var(--spacing-md);
    text-wrap: balance;
  }

  .lead-teaser {
    margin-block: 0 var(--spacing-sm);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);
    text-align: start;
    font-size: var(--font-size-md);
    color: var(--color-text-article);
    columns: 2;
    column-gap: var(--spacing-xl);
    column-rule: 1px dotted var(--color-line-input);
    --drop-cap-size: 4.4em;
    --drop-cap-line-height: 0.75;
    --drop-cap-gap: var(--spacing-sm);
  }

  .lead-meta {
    display: flex;
    justify-content: flex-end;
    margin-block: 0;
  }

  .front-explore :global(.list-item .list-description) {
    font-size: var(--font-size-md);
    line-height: 1.55;
  }

  .front-explore :global(.list-item .list-title) {
    font-size: var(--font-size-lg);
  }

  .front-explore :global(.list-meta) {
    letter-spacing: var(--letter-spacing);
  }

  .photo-cards {
    margin-block-start: var(--spacing-sm);
  }

  @media (max-width: 1000px) {
    .front-page {
      grid-template-columns: minmax(0, 1fr) var(--front-rail-right);
      grid-template-areas:
        'intro  intro'
        'center rail'
        'index  index';
      grid-template-rows: auto;
    }

    .front-page::before,
    .front-page::after {
      display: none;
    }

    .front-rail {
      border-inline-start: 1px solid var(--color-line);
      margin-inline-start: calc(-1 * var(--front-gap) / 2);
      padding-inline-start: calc(var(--front-gap) / 2);
    }

    .front-index {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      column-gap: var(--spacing-xl);
      align-items: start;
    }
  }

  @media (max-width: 700px) {
    .front-page {
      grid-template-columns: 1fr;
      grid-template-areas:
        'lead'
        'intro'
        'whatsnew'
        'index'
        'explore'
        'food';
      grid-template-rows: auto;
    }

    .front-center,
    .front-rail {
      display: contents;
    }

    .front-lead {
      grid-area: lead;
    }

    .front-food {
      grid-area: food;
    }

    .front-explore {
      grid-area: explore;
    }

    .front-whatsnew {
      grid-area: whatsnew;
    }

    .lead-teaser {
      columns: 1;
    }
  }
</style>
