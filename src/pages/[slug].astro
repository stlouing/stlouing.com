---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Entry from '../components/Entry.astro'
import { published } from '../lib/content'
import { getBacklinks } from '../lib/backlinks'
import { formatDate } from '../lib/dates'
import { articleSchema } from '../lib/schema'

// Evergreen "Topics" entries live at flat top-level URLs (/overview, ...). Their
// slugs never collide with the standalone .md pages (about, changelog), which are
// static routes and take precedence.
export async function getStaticPaths() {
  const topics = published(await getCollection('topics'))

  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const permalink = new URL(`/${entry.id}/`, siteOrigin).href
const schema = articleSchema(
  {
    title: data.title,
    url: permalink,
    description: data.description,
    published: (data.created ?? data.updated).toISOString(),
    updated: data.updated.toISOString(),
    tags: data.tags,
  },
  siteOrigin,
)
---

<BaseLayout
  crumb={data.title}
  description={data.description}
  ogType="article"
  publishedTime={(data.created ?? data.updated).toISOString()}
  tags={data.tags}
  jsonLd={schema}>
  <Entry
    title={data.title}
    tags={data.tags}
    editPath={entry.filePath}
    backlinks={backlinks}
    permalink={permalink}>
    {data.description && (
      <p class="entry-summary p-summary" slot="lede">
        {data.description}
      </p>
    )}
    <Fragment slot="meta">
      <span>
        Last updated on
        <time class="dt-updated" datetime={data.updated.toISOString()}>
          {formatDate(data.updated)}
        </time>
      </span>
      {
        data.created && (
          <time class="dt-published" datetime={data.created.toISOString()} hidden>
            {formatDate(data.created)}
          </time>
        )
      }
    </Fragment>
    <div class:list={{ 'topic-list': data.display === 'list' }}>
      <Content />
    </div>
  </Entry>
</BaseLayout>
