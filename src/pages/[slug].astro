---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Entry from '../components/Entry.astro'
import { published } from '../lib/content'
import { getBacklinks } from '../lib/backlinks'
import { formatDate } from '../lib/dates'
import { articleSchema } from '../lib/schema'
import { href } from '../lib/url'

// Evergreen "Topics" entries live at flat top-level URLs. Their
// slugs never collide with the standalone .md pages (about, changelog), which are
// static routes and take precedence.
export async function getStaticPaths() {
  const topics = published(await getCollection('topics'))

  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content, headings } = await render(entry)
const backlinks = await getBacklinks(entry.id)

// Table of contents, built from the post's own headings (rehype-slug gives each a
// stable id that the `#slug` links resolve to). Sections are the `##` headings with
// their `###` sub-headings nested underneath. Shown on every topic that has at least
// one section; a topic with no headings falls back to the full-width layout (there'd
// be nothing to list).
interface TocSection {
  slug: string
  text: string
  children: { slug: string; text: string }[]
}
// rehype-autolink-headings appends a `#` permalink inside each heading, which
// Astro's `headings[].text` picks up — strip that trailing marker for clean labels.
const headingText = (text: string) => text.replace(/#$/, '').trimEnd()
const tocSections: TocSection[] = []
for (const heading of headings) {
  if (heading.depth === 2) {
    tocSections.push({ slug: heading.slug, text: headingText(heading.text), children: [] })
  } else if (heading.depth === 3 && tocSections.length > 0) {
    tocSections[tocSections.length - 1].children.push({
      slug: heading.slug,
      text: headingText(heading.text),
    })
  }
}
const showToc = tocSections.length > 0
const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const permalink = new URL(`/${entry.id}/`, siteOrigin).href
const schema = articleSchema(
  {
    title: data.title,
    url: permalink,
    description: data.description,
    image: new URL(href(data.ogImage ?? '/og.png'), siteOrigin).href,
    published: (data.created ?? data.updated).toISOString(),
    updated: data.updated.toISOString(),
    tags: data.tags,
  },
  siteOrigin,
)
---

<BaseLayout
  crumb={data.title}
  description={data.description}
  ogImage={data.ogImage}
  ogType="article"
  publishedTime={(data.created ?? data.updated).toISOString()}
  tags={data.tags}
  jsonLd={schema}>
  <Entry title={data.title} tags={data.tags} backlinks={backlinks} permalink={permalink}>
    {
      data.description && (
        <p class="entry-summary p-summary" slot="lede">
          {data.description}
        </p>
      )
    }
    <Fragment slot="footer-meta">
      Last updated
      <time class="dt-updated" datetime={data.updated.toISOString()}>
        {formatDate(data.updated)}
      </time>
      {
        data.created && (
          <time class="dt-published" datetime={data.created.toISOString()} hidden>
            {formatDate(data.created)}
          </time>
        )
      }
    </Fragment>
    {
      showToc ? (
        <div class="topic-layout">
          <aside class="topic-toc">
            <nav class="topic-toc-nav" aria-label="In this article">
              <details class="topic-toc-details" open>
                <summary class="topic-toc-title section-label">In this article</summary>
                <ol class="topic-toc-list">
                  {tocSections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`}>{section.text}</a>
                      {section.children.length > 0 && (
                        <ol class="topic-toc-sublist">
                          {section.children.map((child) => (
                            <li>
                              <a href={`#${child.slug}`}>{child.text}</a>
                            </li>
                          ))}
                        </ol>
                      )}
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          </aside>
          <div class:list={['topic-main', { 'topic-list': data.display === 'list' }]}>
            <Content />
          </div>
        </div>
      ) : (
        <div class:list={{ 'topic-list': data.display === 'list' }}>
          <Content />
        </div>
      )
    }
  </Entry>
</BaseLayout>

{
  showToc && (
    <script>
      const details = document.querySelector<HTMLDetailsElement>('.topic-toc-details')

      if (details) {
        const desktop = window.matchMedia('(min-width: 900px)')
        const forceOpenOnDesktop = () => {
          if (desktop.matches) {
            details.open = true
          }
        }

        forceOpenOnDesktop()
        desktop.addEventListener('change', forceOpenOnDesktop)
      }
    </script>
  )
}

<style>
  /* One column by default; a main + sticky right-rail TOC at desktop widths, mirroring
     the food/neighborhood slug asides. DOM order is aside-then-main so the TOC leads on
     mobile (where it stacks above the article), like the neighborhood page. */
  .topic-layout {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-md);
  }

  .topic-toc-nav {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  /* Summary doubles as the "In this article" heading and the mobile toggle. Its own
     padding spans the full width of the box so the WHOLE bar is the tap target, not just
     the text/chevron. Strip the default disclosure marker so we can draw our own chevron. */
  .topic-toc-title {
    margin: 0;
    padding: var(--spacing-md) var(--spacing-base);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    list-style: none;
  }

  .topic-toc-title::-webkit-details-marker {
    display: none;
  }

  /* Chevron rotates from pointing-down (collapsed) to up (expanded). */
  .topic-toc-title::after {
    content: '';
    inline-size: 0.5em;
    block-size: 0.5em;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .topic-toc-details[open] .topic-toc-title::after {
    transform: rotate(-135deg);
  }

  /* The summary's bottom padding is trimmed when open so the gap to the list isn't
     doubled up with the list's own top spacing. */
  .topic-toc-details[open] .topic-toc-title {
    padding-block-end: var(--spacing-md);
  }

  @media (min-width: 900px) {
    .topic-layout {
      grid-template-columns: minmax(0, 1fr) 240px;
      align-items: start;
      gap: 2.5rem;
    }

    .topic-main {
      grid-column: 1;
      grid-row: 1;
    }

    .topic-toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--spacing-md));
      /* Shed the box for a plain border-left, like the food / neighborhood asides. */
      border-inline-start: 1px solid var(--color-line);
      padding-inline-start: var(--spacing-lg);
    }

    .topic-toc-nav {
      background: none;
      border: 0;
    }

    /* On desktop the rail is always open (the script keeps it so): the summary reverts
       to a plain heading — no pointer affordance, no chevron. The box's inner padding
       is dropped now that the column's border-left provides the inset. */
    .topic-toc-title {
      cursor: default;
      padding-inline: 0;
      padding-block: 0 var(--spacing-sm);
    }

    .topic-toc-title::after {
      display: none;
    }

    .topic-toc-list {
      padding-inline: 0;
    }
  }

  /* Numbered top-level sections (lower-roman, continuing the post's prior look). The box's
     horizontal padding lives here now that the summary owns the top bar's padding. */
  .topic-toc-list {
    margin: 0;
    list-style: none;
    counter-reset: toc;
  }

  .topic-toc-list > li {
    counter-increment: toc;
    line-height: 1.3;
  }

  .topic-toc a {
    color: var(--color-text);
    font-weight: 400;
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .topic-toc a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Nested h3s: indented, quieter, and smaller than their section. */
  .topic-toc-sublist {
    margin: 2px 0 var(--spacing-xs);
    padding-inline-start: var(--spacing-md);
    list-style: none;
  }

  .topic-toc-sublist li {
    line-height: 1.3;
    padding-block: 2px;
  }

  .topic-toc-sublist li + li {
    margin-block-start: 0;
  }

  .topic-toc-sublist a {
    font-weight: 500;
    font-size: var(--font-size-xs);
    color: var(--color-muted-2);
  }
</style>
