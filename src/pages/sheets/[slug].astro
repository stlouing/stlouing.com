---
import { getImage } from 'astro:assets'
import { getCollection, render } from 'astro:content'

import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconInstagram from '../../assets/IconInstagram.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import Rating from '../../components/Rating.astro'
import { hasBody, published } from '../../lib/content'
import { cuisineLabel } from '../../lib/cuisine'
import { googleMapsHref } from '../../lib/maps'
import { placeLocation } from '../../lib/place-location'
import { href } from '../../lib/url'

export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { area, district } = placeLocation(data)
const thumbnail = data.photo
  ? await getImage({ src: data.photo, width: 480, format: 'webp' })
  : undefined
const chips = [
  data.cuisine.map((value) => cuisineLabel(value)).join(', '),
  area?.name,
  district?.name,
].filter(Boolean)
const addressLines = data.address ?? []
const placeHref = href(`/food/${entry.id}/`)
const { Content } = await render(entry)
---

<div class="popup-scroll">
  {
    thumbnail && (
      <div
        class="popup-photo"
        style={`background-image: url('${thumbnail.src}')`}
        aria-hidden="true"
      />
    )
  }
  <Rating rating={data.rating} />
  <div class="popup-meta list-eyebrow">
    {
      chips.map((chip, index) => (
        <Fragment>
          {index > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
          <span class="eyebrow eyebrow--muted">{chip}</span>
        </Fragment>
      ))
    }
  </div>
  <h2 id="place-sheet-title">
    <a class="title-serif title-link" href={placeHref}>{data.title}</a>
  </h2>
  {data.description && <p class="popup-tagline description">{data.description}</p>}
  {
    addressLines.length > 0 && (
      <span class="popup-address">
        {
          addressLines.map((line, index) => (
            <Fragment>
              {index > 0 && <br />}
              {line}
            </Fragment>
          ))
        }
      </span>
    )
  }
  <div class="action-buttons">
    {
      data.url && (
        <a class="btn btn-outline" href={data.url} target="_blank" rel="noopener">
          Website
          <IconExternalLink />
        </a>
      )
    }
    {
      data.instagram && (
        <a class="btn btn-outline" href={data.instagram} target="_blank" rel="noopener">
          Instagram
          <IconInstagram />
        </a>
      )
    }
    <a class="btn btn-outline" href={googleMapsHref(data)} target="_blank" rel="noopener">
      Directions
      <IconMapPin />
    </a>
  </div>
  {
    hasBody(entry) && (
      <div class="body">
        <div class="detail-main">
          <Content />
        </div>
      </div>
    )
  }
</div>
