---
import { getImage } from 'astro:assets'
import { getCollection, render } from 'astro:content'

import Icon from '../../components/Icon.astro'
import Rating from '../../components/Rating.astro'
import { hasBody, published } from '../../lib/content'
import { googleMapsHref } from '../../lib/maps'
import { href } from '../../lib/url'

export async function getStaticPaths() {
  const places = published(await getCollection('food'))

  return places.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const thumbnail = data.photo
  ? await getImage({ src: data.photo, width: 480, format: 'webp' })
  : undefined
const addressLines = data.address ?? []
const placeHref = href(`/food/${entry.id}/`)
const { Content } = await render(entry)
---

<div class="popup-scroll">
  {
    thumbnail && (
      <div
        class="popup-photo"
        style={`background-image: url('${thumbnail.src}')`}
        aria-hidden="true"
      />
    )
  }
  <Rating rating={data.rating} />
  <h2 id="place-sheet-title">
    <a class="title-serif title-link" href={placeHref}>{data.title}</a>
  </h2>
  {data.description && <p class="popup-tagline description">{data.description}</p>}
  {
    addressLines.length > 0 && (
      <span class="popup-address">
        {
          addressLines.map((line, index) => (
            <Fragment>
              {index > 0 && <br />}
              {line}
            </Fragment>
          ))
        }
      </span>
    )
  }
  <div class="action-buttons">
    {
      data.url && (
        <a class="btn btn-outline" href={data.url} target="_blank" rel="noopener">
          Website
          <Icon name="external-link" />
        </a>
      )
    }
    {
      data.instagram && (
        <a class="btn btn-outline" href={data.instagram} target="_blank" rel="noopener">
          Instagram
          <Icon name="instagram" />
        </a>
      )
    }
    <a class="btn btn-outline" href={googleMapsHref(data)} target="_blank" rel="noopener">
      Directions
      <Icon name="map-pin" />
    </a>
  </div>
  {
    hasBody(entry) && (
      <div class="body">
        <div class="detail-main">
          <Content />
        </div>
      </div>
    )
  }
</div>
