---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import List from '../../components/List.astro'
import Chip from '../../components/Chip.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'

const hikes = published(await getCollection('hikes')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)
const rendered = await Promise.all(
  hikes.map(async (hike) => ({ hike, Content: (await render(hike)).Content })),
)
const difficulties = [
  ...new Set(hikes.map((hike) => hike.data.difficulty).filter(Boolean)),
] as string[]
const areas = [...new Set(hikes.map((hike) => hike.data.area).filter(Boolean))].sort() as string[]
const hasCoords = hikes.some((hike) => hike.data.coords)
---

<BaseLayout>
  <FilterMapPage
    class="hikes"
    label="hikes"
    count={hikes.length}
    searchPlaceholder="name, area..."
    facets={[
      { label: 'Difficulty', facet: 'difficulty', options: difficulties },
      { label: 'Area', facet: 'area', options: areas },
    ]}
    sorts={[
      // { label: 'Name (A-Z)', value: 'title:asc' },
      // { label: 'Distance (short→long)', value: 'distance:asc' },
      // { label: 'Distance (long→short)', value: 'distance:desc' },
    ]}
    hasCoords={hasCoords}
    mapLabel="Map of hikes"
    emptyText="No hikes match those filters.">
    <List title="Hikes" class="list-with-map">
      {
        rendered.map(({ hike, Content }) => (
          <li
            id={hike.id}
            data-filter-item
            data-difficulty={hike.data.difficulty ?? ''}
            data-area={hike.data.area ?? ''}
            data-coords={hike.data.coords?.join(',') ?? ''}
            data-title={hike.data.title}
            data-marker="🥾"
            data-sort-title={hike.data.title}
            data-sort-distance={hike.data.distanceMiles ?? ''}
            data-search={[hike.data.title, hike.data.area, hike.data.difficulty, ...hike.data.tags]
              .filter(Boolean)
              .join(' ')}>
            <div class="list-details">
              {hasBody(hike) ? (
                <a class="list-title" href={href(`/hikes/${hike.id}`)}>
                  {hike.data.title}
                </a>
              ) : (
                <span class="list-title">{hike.data.title}</span>
              )}
              {hike.data.area && <span class="list-meta">{hike.data.area}</span>}
              {hike.data.distanceMiles && <Chip>{hike.data.distanceMiles} mi</Chip>}
              {hike.data.difficulty && <Chip>{hike.data.difficulty}</Chip>}
            </div>
            <Content />
          </li>
        ))
      }
    </List>
  </FilterMapPage>
</BaseLayout>
