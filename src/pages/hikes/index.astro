---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterBar from '../../components/FilterBar.astro'
import ViewToggle from '../../components/ViewToggle.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'

const hikes = published(await getCollection('hikes')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)
const difficulties = [
  ...new Set(hikes.map((hike) => hike.data.difficulty).filter(Boolean)),
] as string[]
const areas = [...new Set(hikes.map((hike) => hike.data.area).filter(Boolean))].sort() as string[]
const hasCoords = hikes.some((hike) => hike.data.coords)
---

<BaseLayout>
  <div class="hikes" data-filter-root data-view="list">
    <header class="secondary-header">
      <FilterBar
        label="hikes"
        count={hikes.length}
        searchPlaceholder="name, area..."
        facets={[
          { label: 'Difficulty', facet: 'difficulty', options: difficulties },
          { label: 'Area', facet: 'area', options: areas },
        ]}
      />
      {hasCoords && <ViewToggle />}
    </header>

    <h1>Hikes</h1>

    <ul class="list">
      {
        hikes.map((hike) => (
          <li
            id={hike.id}
            data-filter-item
            data-difficulty={hike.data.difficulty ?? ''}
            data-area={hike.data.area ?? ''}
            data-coords={hike.data.coords?.join(',') ?? ''}
            data-title={hike.data.title}
            data-marker="🥾"
            data-search={[
              hike.data.title,
              hike.data.description,
              hike.data.area,
              hike.data.difficulty,
              ...hike.data.tags,
            ]
              .filter(Boolean)
              .join(' ')}>
            {hasBody(hike) ? (
              <a class="list-title" href={href(`/hikes/${hike.id}`)}>
                {hike.data.title}
              </a>
            ) : (
              <span class="list-title">{hike.data.title}</span>
            )}
            <p class="meta">
              {hike.data.area && <span>{hike.data.area}</span>}
              {hike.data.distanceMiles && <span class="chip">{hike.data.distanceMiles} mi</span>}
              {hike.data.difficulty && <span class="chip">{hike.data.difficulty}</span>}
            </p>
            {hike.data.description && <p class="list-description">{hike.data.description}</p>}
          </li>
        ))
      }
    </ul>
    {hasCoords && <div class="map" data-map aria-label="Map of hikes" />}
    <p class="empty" data-filter-empty hidden>No hikes match those filters.</p>
  </div>

  <script>
    import { initFilterableMapPage } from '../../scripts/views'
    initFilterableMapPage()
  </script>
</BaseLayout>
