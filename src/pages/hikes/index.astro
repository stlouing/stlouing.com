---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterBar from '../../components/FilterBar.astro'
import ViewToggle from '../../components/ViewToggle.astro'
import { href } from '../../lib/url'
import { published, hasBody } from '../../lib/content'

const hikes = published(await getCollection('hikes')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)

const difficulties = [
  ...new Set(hikes.map((hike) => hike.data.difficulty).filter(Boolean)),
] as string[]
const areas = [...new Set(hikes.map((hike) => hike.data.area).filter(Boolean))].sort() as string[]
const hasCoords = hikes.some((hike) => hike.data.coords)
---

<BaseLayout>
  <div class="hikes" data-filter-root data-view="list">
    <FilterBar
      label="hikes"
      count={hikes.length}
      searchPlaceholder="name, area…"
      facets={[
        { label: 'Difficulty', facet: 'difficulty', options: difficulties },
        { label: 'Area', facet: 'area', options: areas },
      ]}
    />

    {hasCoords && <ViewToggle />}

    <h1>Hikes</h1>

    <div class="results">
      <ul class="place-list">
        {
          hikes.map((hike) => (
            <li
              class="place"
              id={hike.id}
              data-filter-item
              data-difficulty={hike.data.difficulty ?? ''}
              data-area={hike.data.area ?? ''}
              data-coords={hike.data.coords?.join(',') ?? ''}
              data-title={hike.data.title}
              data-marker="🥾"
              data-search={[
                hike.data.title,
                hike.data.description,
                hike.data.area,
                hike.data.difficulty,
                ...hike.data.tags,
              ]
                .filter(Boolean)
                .join(' ')}>
              {hasBody(hike) ? (
                <a class="name" href={href(`/hikes/${hike.id}`)}>
                  {hike.data.title}
                </a>
              ) : (
                <span class="name">{hike.data.title}</span>
              )}
              <p class="meta">
                {hike.data.area && <span class="where">{hike.data.area}</span>}
                {hike.data.distanceMiles != null && (
                  <span class="chip">{hike.data.distanceMiles} mi</span>
                )}
                {hike.data.difficulty && <span class="chip">{hike.data.difficulty}</span>}
              </p>
              {hike.data.description && <p class="desc">{hike.data.description}</p>}
            </li>
          ))
        }
      </ul>
      {hasCoords && <div class="map" data-map aria-label="Map of hikes" />}
      <p class="empty" data-filter-empty hidden>No hikes match those filters.</p>
    </div>
  </div>

  <script>
    import { initFilterableMapPage } from '../../scripts/views'
    initFilterableMapPage()
  </script>

  <style>
    .place-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .place {
      margin: 0;
      padding-block: 0.7rem;
      border-block-end: 1px solid var(--color-line);

      & .name {
        font-family: var(--font-mono);
        font-size: 1.05rem;
        color: var(--color-text);
        text-decoration: none;

        &::before {
          content: '› ';
          color: var(--color-accent);
        }
      }

      & a.name:hover {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }

      & .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin: 0.25rem 0 0;
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
      }

      & .where {
        font-style: italic;
      }

      & .desc {
        margin: 0.3rem 0 0;
        font-family: var(--font-body);
        color: var(--color-text-muted);
      }

      & .chip {
        border: 1px solid var(--color-line);
        border-radius: 999px;
        padding: 0.05rem 0.5rem;
      }
    }
  </style>
</BaseLayout>
