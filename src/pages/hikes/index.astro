---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import List from '../../components/List.astro'
import MapRow from '../../components/MapRow.astro'
import { published, hasBody } from '../../lib/content'

const hikes = published(await getCollection('hikes')).sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
)
const rendered = await Promise.all(
  hikes.map(async (hike) => ({ hike, Content: (await render(hike)).Content })),
)
const difficulties = [
  ...new Set(hikes.map((hike) => hike.data.difficulty).filter(Boolean)),
] as string[]
const areas = [...new Set(hikes.map((hike) => hike.data.area).filter(Boolean))].sort() as string[]
const hasCoords = hikes.some((hike) => hike.data.coords)
---

<BaseLayout>
  <FilterMapPage
    class="hikes"
    label="hikes"
    count={hikes.length}
    searchPlaceholder="name, area..."
    facets={[
      { label: 'Difficulty', facet: 'difficulty', options: difficulties },
      { label: 'Area', facet: 'area', options: areas },
    ]}
    sorts={[
      { label: 'Name (A-Z)', value: 'title:asc' },
      { label: 'Distance (short→long)', value: 'distance:asc' },
      { label: 'Distance (long→short)', value: 'distance:desc' },
    ]}
    hasCoords={hasCoords}
    mapLabel="Map of hikes"
    emptyText="No hikes match those filters.">
    <List class="map-list">
      {
        rendered.map(({ hike, Content }) => (
          <MapRow
            id={hike.id}
            title={hike.data.title}
            detailHref={`/hikes/${hike.id}`}
            marker="🥾"
            coords={hike.data.coords?.join(',') ?? ''}
            url={hike.data.url ?? ''}
            search={[hike.data.title, hike.data.area, hike.data.difficulty, ...hike.data.tags]
              .filter(Boolean)
              .join(' ')}
            attrs={{
              'data-difficulty': hike.data.difficulty ?? '',
              'data-area': hike.data.area ?? '',
              'data-sort-title': hike.data.title,
              'data-sort-distance': String(hike.data.distanceMiles ?? ''),
            }}>
            <Fragment slot="sub">
              {hike.data.area && (
                <button
                  type="button"
                  class="list-meta list-meta-filter"
                  data-filter-set="area"
                  data-filter-value={hike.data.area}>
                  {hike.data.area}
                </button>
              )}
              {(hike.data.difficulty || hike.data.distanceMiles) && (
                <div class="chips">
                  {hike.data.difficulty && (
                    <button
                      type="button"
                      class="chip"
                      data-filter-set="difficulty"
                      data-filter-value={hike.data.difficulty}>
                      {hike.data.difficulty}
                    </button>
                  )}
                  {hike.data.distanceMiles && (
                    <span class="chip">{hike.data.distanceMiles} mi</span>
                  )}
                </div>
              )}
            </Fragment>
            <Content />
          </MapRow>
        ))
      }
    </List>
  </FilterMapPage>
</BaseLayout>
