---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EditThisPage from '../../components/EditThisPage.astro'
import TagList from '../../components/TagList.astro'
import Backlinks from '../../components/Backlinks.astro'
import Chip from '../../components/Chip.astro'
import { published, hasBody } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'

export async function getStaticPaths() {
  const hikes = published(await getCollection('hikes')).filter(hasBody)

  return hikes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)
---

<BaseLayout crumb={data.title}>
  <article class="entry">
    <header class="entry-header">
      <h1>{data.title}</h1>
      <div class="entry-bar">
        <div class="meta">
          {data.area && <span>{data.area}</span>}
          {data.distanceMiles && <Chip>{data.distanceMiles} mi</Chip>}
          {data.difficulty && <Chip>{data.difficulty}</Chip>}
        </div>
        <EditThisPage path={entry.filePath} inline />
      </div>
      <TagList tags={data.tags} />
    </header>

    <div class="body">
      <Content />
    </div>

    <footer class="entry-footer">
      <Backlinks links={backlinks} />
    </footer>
  </article>
</BaseLayout>
