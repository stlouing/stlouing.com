---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import NeighborhoodLocator from '../../components/NeighborhoodLocator.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import { href } from '../../lib/url'
import { resolveVerdict } from '../../lib/verdict'
import { published, excerpt } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import {
  foodByNeighborhood,
  normalizeName,
  neighborhoodInfo,
  neighborhoodPopulation,
  neighborhoodGeneratedSummary,
  neighborsOf,
  festivalsIn,
  neighborhoodResourceLinks,
} from '../../lib/neighborhoods'
import neighborhoods from '../../data/neighborhoods.json'
import SourceLink from '../../components/SourceLink.astro'
import NeighborhoodFacts from '../../components/NeighborhoodFacts.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconChart from '../../assets/IconChart.astro'
import IconBook from '../../assets/IconBook.astro'
import IconLandmark from '../../assets/IconLandmark.astro'

// An icon per resource link, matching the Food page's labeled source links.
const resourceIcons: Record<string, typeof IconExternalLink> = {
  Wikipedia: IconBook,
  MyTownView: IconChart,
  Website: IconExternalLink,
  'St. Louis City': IconLandmark,
}

// A page for EVERY real neighborhood, not just the ones with a writeup. Where a
// markdown file exists its prose is rendered; otherwise the page still stands on
// the computed data layer (region, borders, food, events, locator map), so no
// neighborhood is a dead end.
export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))
  const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

  return neighborhoods
    .filter((neighborhood) => !('ignored' in neighborhood))
    .map((neighborhood) => ({
      params: { slug: neighborhood.slug },
      props: { entry: entryBySlug.get(neighborhood.slug) ?? null },
    }))
}

const { slug = '' } = Astro.params
const { entry } = Astro.props
const info = neighborhoodInfo(slug)
const title = info?.name ?? slug

// Prose layer: present only when a markdown file with a real body backs this
// neighborhood. Otherwise the page shows an explicit "not yet explored" stub.
const rendered = entry ? await render(entry) : null
const Content = rendered?.Content
const hasWriteup = Boolean(entry?.body && entry.body.trim())
const backlinks = entry ? await getBacklinks(entry.id) : []
const tags = entry?.data.tags ?? []

// Computed data layer.
const population = neighborhoodPopulation(slug)
const neighbors = neighborsOf(slug)
const festivals = festivalsIn(slug)
const placesByNeighborhood = await foodByNeighborhood()
const places = placesByNeighborhood.get(normalizeName(title)) ?? []

// External resources: the place's own site (if any), Wikipedia, and the
// auto-generated City of St. Louis + MyTownView profiles — rendered as a button bar.
const resourceLinks = neighborhoodResourceLinks(slug, title, entry?.data.url, entry?.data.wikipedia)

// The generated fallback line for a neighborhood without its own summary.
const generated = neighborhoodGeneratedSummary(slug)

// On-page summary under the title: a manual `description` when set, otherwise the
// generated line. Deliberately NOT the writeup excerpt — that just repeats the
// opening paragraph rendered right below it.
const summary = entry?.data.description ?? generated

// SEO meta description: a real writeup excerpt is the most useful + unique per
// page; fall back to the summary when there's no writeup.
const metaDescription = entry?.body ? excerpt(entry.body, 155) : summary

// SEO title to catch "<name> St. Louis" searches. Parks/cemeteries (numbered
// 80+) aren't neighborhoods, so they just get the city.
const seoTitle = info
  ? `${title}, ${info.number >= 80 ? 'St. Louis' : 'a St. Louis neighborhood'}`
  : undefined

const trail = [
  { label: 'Neighborhoods', href: '/neighborhoods' },
  { label: title, href: `/neighborhoods/${slug}` },
]
---

<BaseLayout crumb={title} title={seoTitle} description={metaDescription}>
  <Breadcrumbs trail={trail} />
  <Entry title={title} tags={tags} editPath={entry?.filePath} backlinks={backlinks}>
    {
      summary && (
        <p class="entry-summary" slot="lede">
          {summary}
        </p>
      )
    }
    {
      resourceLinks.length > 0 && (
        <div class="resource-bar" slot="header-extra">
          {resourceLinks.map((link) => {
            const Icon = resourceIcons[link.label]
            return (
              <SourceLink href={link.href} label={link.label}>
                {Icon && <Icon slot="icon" />}
              </SourceLink>
            )
          })}
        </div>
      )
    }
    <div class="neighborhood-layout">
      <aside class="neighborhood-aside">
        <NeighborhoodFacts population={population} />
        <figure class="locator-figure">
          <NeighborhoodLocator slug={slug} name={title} />
          <figcaption>{title} relative to St. Louis</figcaption>
        </figure>
      </aside>
      <div class="neighborhood-main">
        {
          hasWriteup && Content ? (
            <Content />
          ) : (
            <div class="not-explored">
              <p>I haven't explored {title} yet.</p>
              <p>
                Is there something you want to suggest here? Let me know in the{' '}
                <a href={href('/feedback')}>feedback form</a>!
              </p>
            </div>
          )
        }

        {
          festivals.length > 0 && (
            <nav class="backlinks">
              <h2>Annual events</h2>
              <ul>
                {festivals.map((festival) => (
                  <li>
                    <span class="list-title-item">{festival.name}</span>
                    <span class="collection">{festival.when}</span>
                    <p class="event-note">{festival.blurb}</p>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          places.length > 0 && (
            <RelatedList title="Food">
              {places.map((place) => (
                <RelatedCard
                  href={href(`/food/${place.id}`)}
                  title={place.data.title}
                  meta={place.data.cuisine[0]}
                  verdict={resolveVerdict(place.data)}
                />
              ))}
            </RelatedList>
          )
        }

        {
          neighbors.length > 0 && (
            <RelatedList title="Borders">
              {neighbors.map((neighbor) => (
                <RelatedCard
                  href={href(`/neighborhoods/${neighbor.slug}`)}
                  title={neighbor.name}
                  meta={neighbor.group}
                  metaType="neighborhood"
                />
              ))}
            </RelatedList>
          )
        }
      </div>
    </div>
  </Entry>
</BaseLayout>

<style>
  /* Writeup + sidebar (locator map + facts), mirroring the Food detail page. One
     column until there's room for the aside alongside. */
  .neighborhood-layout {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-md);
  }

  .neighborhood-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  @media screen and (min-width: 900px) {
    .neighborhood-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
      align-items: start;
      gap: 2.5rem;
    }

    /* DOM order is aside-then-main so the locator + facts lead on mobile; on
       desktop they're placed back into the right column. */
    .neighborhood-main {
      grid-column: 1;
      grid-row: 1;
    }

    .neighborhood-aside {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--spacing-md));
    }
  }

  @media (max-width: 700px) {
    .side-card {
      padding: var(--spacing-sm);
    }
  }

  .locator-figure {
    width: 100%;
    margin: 0 auto;
  }

  .locator-figure :global(svg) {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .locator-figure figcaption {
    margin-block-start: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .list-title-item {
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--font-size-md);
  }

  .event-note {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-md);
    color: var(--color-text-article);
  }

  /* Explicit stub treatment for a neighborhood without a writeup: a dashed note
     reads as "intentionally unfinished" rather than a sparse, broken page. */
  .not-explored {
    margin-block-end: var(--spacing-lg);
    padding: var(--spacing-md);
    border: 1px dashed var(--color-line-input);
    border-radius: var(--radius);
    color: var(--color-text-muted);
  }

  .not-explored p {
    margin: 0;
  }

  .not-explored p + p {
    margin-block-start: var(--spacing-sm);
  }

  /* The tall locator SVG reads poorly stacked on mobile; the facts card stays. */
  @media screen and (max-width: 700px) {
    .locator-figure {
      display: none;
    }
  }
</style>
