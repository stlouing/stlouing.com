---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Byline from '../../components/Byline.astro'
import NeighborhoodLocator from '../../components/NeighborhoodLocator.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import IconMapPin from '../../assets/IconMapPin.astro'
import { href, displayUrl } from '../../lib/url'
import { resolveVerdict } from '../../lib/verdict'
import { formatDate } from '../../lib/dates'
import { published, excerpt } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import {
  foodByNeighborhood,
  normalizeName,
  neighborhoodInfo,
  hasNeighborhoodShape,
  neighborhoodPopulation,
  neighborhoodGeneratedSummary,
  neighborsOf,
  festivalsIn,
  neighborhoodResourceLinks,
  regionOf,
} from '../../lib/neighborhoods'
import { cuisineEmoji } from '../../lib/emoji'
import neighborhoods from '../../data/neighborhoods.json'
import SourceLink from '../../components/SourceLink.astro'
import NeighborhoodFacts from '../../components/NeighborhoodFacts.astro'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconChart from '../../assets/IconChart.astro'
import IconBook from '../../assets/IconBook.astro'
import IconLandmark from '../../assets/IconLandmark.astro'
import IconCalendar from '../../assets/IconCalendar.astro'

// An icon per resource link, matching the Food page's labeled source links.
const resourceIcons: Record<string, typeof IconExternalLink> = {
  Wikipedia: IconBook,
  MyTownView: IconChart,
  Website: IconExternalLink,
  'St. Louis City': IconLandmark,
}

// A page for EVERY real neighborhood, not just the ones with a writeup. Where a
// markdown file exists its prose is rendered; otherwise the page still stands on
// the computed data layer (region, borders, food, events, locator map), so no
// neighborhood is a dead end.
export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))
  const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

  return neighborhoods
    .filter((neighborhood) => !('ignored' in neighborhood))
    .map((neighborhood) => ({
      params: { slug: neighborhood.slug },
      props: { entry: entryBySlug.get(neighborhood.slug) ?? null },
    }))
}

const { slug = '' } = Astro.params
const { entry } = Astro.props
const info = neighborhoodInfo(slug)
const title = info?.name ?? slug

// Prose layer: present only when a markdown file with a real body backs this
// neighborhood. Otherwise the page shows an explicit "not yet explored" stub.
const rendered = entry ? await render(entry) : null
const Content = rendered?.Content
const hasWriteup = Boolean(entry?.body && entry.body.trim())
const backlinks = entry ? await getBacklinks(entry.id) : []
// The neighborhood's tags double as the aside "Vibe" chips, so they're shown there
// (with icons, linking to /tags) rather than in the Entry header's tag row.
const tags = entry?.data.tags ?? []

// Signature attractions/landmarks for the "Notable spots" list.
const attractions = entry?.data.attractions ?? []

// Computed data layer.
const population = neighborhoodPopulation(slug)
// Nearby neighborhoods: a manual `neighbors` list (frontmatter) for entries the
// geo adjacency graph doesn't cover (county municipalities), else the computed set.
const neighbors =
  entry?.data.neighbors && entry.data.neighbors.length > 0
    ? entry.data.neighbors.flatMap((neighborSlug) => {
        const neighbor = neighborhoodInfo(neighborSlug)
        return neighbor ? [neighbor] : []
      })
    : neighborsOf(slug)
const festivals = festivalsIn(slug)
const placesByNeighborhood = await foodByNeighborhood()
const places = placesByNeighborhood.get(normalizeName(title)) ?? []

// Each neighborhood's tagline + vibe tags (and whether it has a writeup), keyed by
// slug, for the "Nearby Neighborhoods" cards. Unexplored neighborhoods have no
// tagline/tags and fall back to a placeholder on the card.
const neighborMetaBySlug = new Map(
  published(await getCollection('neighborhoods')).map((neighborhoodEntry) => [
    neighborhoodEntry.id,
    {
      description: neighborhoodEntry.data.description,
      tags: neighborhoodEntry.data.tags ?? [],
      written: Boolean(neighborhoodEntry.body && neighborhoodEntry.body.trim()),
    },
  ]),
)

// Show up to 5 nearby neighborhoods, explored ones first — unexplored ones only
// fill in when there aren't 5 explored neighbors to show.
const exploredNeighbors = neighbors.filter(
  (neighbor) => neighborMetaBySlug.get(neighbor.slug)?.written,
)
const unexploredNeighbors = neighbors.filter(
  (neighbor) => !neighborMetaBySlug.get(neighbor.slug)?.written,
)
const nearbyNeighbors = [...exploredNeighbors, ...unexploredNeighbors].slice(0, 5)

// External resources: the place's own site (if any), Wikipedia, and the
// auto-generated City of St. Louis + MyTownView profiles — rendered as a button bar.
const resourceLinks = neighborhoodResourceLinks(slug, title, entry?.data.url, entry?.data.wikipedia)

// The generated fallback line for a neighborhood without its own summary.
const generated = neighborhoodGeneratedSummary(slug)

// On-page summary under the title: a manual `description` when set, otherwise the
// generated line. Deliberately NOT the writeup excerpt — that just repeats the
// opening paragraph rendered right below it.
const summary = entry?.data.description ?? generated

// The footer timestamp: the last revision when set, otherwise the created date.
// Only written neighborhoods (a markdown entry) carry dates.
const lastUpdated = entry ? (entry.data.updated ?? entry.data.created) : undefined

// SEO meta description: the writeup excerpt when there is one (a fuller sentence
// than the short tagline), else the authored `description`, else the generated line.
const metaDescription = entry?.body
  ? excerpt(entry.body, 155)
  : (entry?.data.description ?? generated)

// SEO title: "<name> - <kind> in St. Louis", so "St. Louis" is in the title for
// search. Parks read "Park in St. Louis"; county municipalities (type 'city') and
// other typed areas read "<Type> in <region>" (e.g. "City in St. Louis County").
let seoTitle: string | undefined
if (info) {
  let kind: string
  if (info.type === 'park') {
    kind = 'Park in St. Louis'
  } else if (info.type) {
    kind = `${info.type.charAt(0).toUpperCase()}${info.type.slice(1)} in ${info.group}`
  } else {
    kind = 'Neighborhood in St. Louis'
  }
  seoTitle = `${title} - ${kind}`
}

// Breadcrumb stops at the region (the neighborhood name is already the page H1).
const region = info ? regionOf(info) : undefined
const trail = [
  { label: 'Neighborhoods', href: '/neighborhoods/' },
  ...(region ? [{ label: region.label, href: `/neighborhoods/${region.slug}/` }] : []),
]
---

<BaseLayout crumb={title} title={seoTitle} description={metaDescription}>
  <Breadcrumbs trail={trail} />
  <Entry title={title} backlinks={backlinks} share={false}>
    {
      summary && (
        <p class="entry-summary" slot="lede">
          {summary}
        </p>
      )
    }
    <div class="detail-layout">
      <div class="detail-main">
        {
          hasWriteup && Content ? (
            <Content />
          ) : (
            <div class="not-explored">
              <p>I haven't written about {title} yet.</p>
              <p>
                Is there something you want to suggest here?
                <a href={href('/feedback/')}>Let me know</a>!
              </p>
            </div>
          )
        }

        <Byline>
          {
            lastUpdated && (
              <Fragment slot="footer-meta">
                Last updated{' '}
                <time class="dt-updated" datetime={lastUpdated.toISOString()}>
                  {formatDate(lastUpdated)}
                </time>
              </Fragment>
            )
          }
        </Byline>

        {
          attractions.length > 0 && (
            <RelatedList title="Notable spots">
              {attractions.map((spot) => (
                <RelatedCard
                  href={spot.url}
                  title={spot.name}
                  description={spot.description}
                  external>
                  <IconLandmark slot="icon" />
                </RelatedCard>
              ))}
            </RelatedList>
          )
        }

        {
          places.length > 0 && (
            <RelatedList title="Nearby Food">
              {places.map((place) => (
                <RelatedCard
                  href={href(`/food/${place.id}/`)}
                  title={place.data.title}
                  meta={place.data.cuisine[0]}
                  emoji={cuisineEmoji([place.data.cuisine[0]])}
                  verdict={resolveVerdict(place.data)}
                />
              ))}
            </RelatedList>
          )
        }

        {
          festivals.length > 0 && (
            <RelatedList title="Annual events">
              {festivals.map((festival) => (
                <RelatedCard
                  title={festival.name}
                  meta={festival.when}
                  metaType="date"
                  description={festival.blurb}>
                  <IconCalendar slot="icon" />
                </RelatedCard>
              ))}
            </RelatedList>
          )
        }

        {
          nearbyNeighbors.length > 0 && (
            <RelatedList title="Nearby Neighborhoods">
              {nearbyNeighbors.map((neighbor) => {
                const neighborMeta = neighborMetaBySlug.get(neighbor.slug)
                return (
                  <RelatedCard
                    href={href(`/neighborhoods/${neighbor.slug}/`)}
                    title={neighbor.name}
                    meta={neighbor.group}
                    metaType="neighborhood"
                    description={neighborMeta?.description ?? ''}
                    tags={[]}>
                    <IconMapPin slot="icon" />
                  </RelatedCard>
                )
              })}
            </RelatedList>
          )
        }
      </div>
      <aside class="detail-aside">
        {
          (hasNeighborhoodShape(slug) || info?.coords) && (
            <figure class="neighborhood-locator-figure">
              <NeighborhoodLocator slug={slug} name={title} coords={info?.coords} />
              <figcaption>
                {title} in {info?.group === 'St. Louis County' ? 'St. Louis County' : 'St. Louis'}
              </figcaption>
            </figure>
          )
        }
        {
          resourceLinks.length > 0 && (
            <>
              <hr class="detail-divider" />
              <div class="detail-links-section">
                <h2 class="section-label detail-section-label">Links</h2>
                <div class="detail-links">
                  {resourceLinks.map((link) => {
                    const Icon = resourceIcons[link.label]
                    // The Website link shows its bare host (no scheme/www), like
                    // the Food page; the named resources keep their labels.
                    const label = link.label === 'Website' ? displayUrl(link.href) : link.label

                    return (
                      <SourceLink
                        href={link.href}
                        label={label}
                        variant="muted"
                        compact={false}
                        class="btn-inline">
                        {Icon && <Icon slot="icon" />}
                      </SourceLink>
                    )
                  })}
                </div>
              </div>
            </>
          )
        }
        <hr class="detail-divider" />
        <NeighborhoodFacts population={population} spots={places.length} tags={tags} />
        <hr class="detail-divider" />
        <a class="btn btn-quiet detail-back-link" href={href('/neighborhoods/')}>
          Back to the Neighborhood Map <IconArrowRight />
        </a>
      </aside>
    </div>
  </Entry>
</BaseLayout>

<style>
  /* The locator map + its caption at the top of the shared sidebar. The map carries
     its own frame (NeighborhoodLocator); the caption is a quiet mono line under it. */
  .neighborhood-locator-figure {
    margin: 0;
  }

  .neighborhood-locator-figure figcaption {
    margin-block-start: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-muted);
    text-align: center;
  }
</style>
