---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Entry from '../../components/Entry.astro'
import { href } from '../../lib/url'
import { published } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import { foodByNeighborhood, normalizeName, wikipediaHref } from '../../lib/neighborhoods'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import neighborhoods from '../../data/neighborhoods.json'
import SourceLink from '../../components/SourceLink.astro'

// A page per written neighborhood (a collection file) — mirrors food/[slug].
export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))

  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)

// Food places located in this neighborhood (same loose name-join as the index).
const placesByNeighborhood = await foodByNeighborhood()
const places = placesByNeighborhood.get(normalizeName(data.title)) ?? []

// Breadcrumb: Neighborhoods / <name>. The leaf links to this neighborhood on the
// map (its hash on the index), replacing the old inline "View on the map" link.
const trail = [
  { label: 'Neighborhoods', href: '/neighborhoods' },
  { label: data.title, href: `/neighborhoods#${entry.id}` },
]

// Auto-generated description from the neighborhood's region + official number.
// Kept here in code (not in the markdown frontmatter) so the wording is easy to
// tweak in one place; the region comes from src/data/neighborhoods.json.
const info = neighborhoods.find((item) => item.slug === entry.id) as
  | { number: number; numberLabel?: string; group: string }
  | undefined
const description = info
  ? `Neighborhood #${info.numberLabel ?? info.number}, in St. Louis's ${info.group}.`
  : undefined
---

<BaseLayout crumb={data.title} description={description}>
  <Breadcrumbs trail={trail} />
  <Entry title={data.title} tags={data.tags} editPath={entry.filePath} backlinks={backlinks}>
    {
      description && (
        <p class="entry-summary" slot="lede">
          {description}
        </p>
      )
    }
    <Fragment slot="meta">
      <SourceLink href={data.url} />
      <SourceLink href={data.wikipedia ?? wikipediaHref(data.title)} label="Wikipedia" />
    </Fragment>
    <Content />
    {
      places.length > 0 && (
        <footer class="entry-footer">
          <nav class="backlinks">
            <h2>Food</h2>
            <ul>
              {places.map((place) => (
                <li>
                  <a class="place-link" href={href(`/food/${place.id}`)}>
                    {place.data.title}
                  </a>
                  <a class="collection" href={href(`/food?cuisine=${place.data.cuisine[0]}`)}>
                    {place.data.cuisine[0]}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </footer>
      )
    }
  </Entry>
</BaseLayout>
