---
import { getCollection, render } from 'astro:content'
import { getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Backlinks from '../../components/Backlinks.astro'
import Comments from '../../components/Comments.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import NeighborhoodHero from '../../components/NeighborhoodHero.astro'
import RelatedList from '../../components/RelatedList.astro'
import RelatedCard from '../../components/RelatedCard.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { resolveVerdict, resolveWriterState, verdictLabels } from '../../lib/verdict'
import { published, excerpt, META_DESCRIPTION_CHARS } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import {
  foodByNeighborhood,
  normalizeName,
  neighborBearing,
  neighborhoodInfo,
  neighborhoodPopulation,
  neighborhoodGeneratedSummary,
  neighborhoodMetaDescription,
  neighborsOf,
  festivalsIn,
  corridorsIn,
  neighborhoodResourceLinks,
  regionOf,
} from '../../lib/neighborhoods'
import neighborhoods from '../../data/neighborhoods.json'
import Button from '../../components/Button.astro'
import SourceLink from '../../components/SourceLink.astro'
import NeighborhoodFacts from '../../components/NeighborhoodFacts.astro'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconChart from '../../assets/IconChart.astro'
import IconBook from '../../assets/IconBook.astro'
import IconLandmark from '../../assets/IconLandmark.astro'

const resourceIcons: Record<string, typeof IconExternalLink> = {
  Wikipedia: IconBook,
  MyTownView: IconChart,
  Website: IconExternalLink,
  'St. Louis City': IconLandmark,
}

// A page for EVERY real neighborhood, not just the ones with a writeup. Where a
// markdown file exists its prose is rendered; otherwise the page still stands on
// the computed data layer (region, borders, food, events, map), so no
// neighborhood is a dead end.
export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))
  const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

  return neighborhoods
    .filter((neighborhood) => !('ignored' in neighborhood))
    .map((neighborhood) => ({
      params: { slug: neighborhood.slug },
      props: { entry: entryBySlug.get(neighborhood.slug) ?? null },
    }))
}

const { slug = '' } = Astro.params
const { entry } = Astro.props
const info = neighborhoodInfo(slug)
const title = info?.name ?? slug

// Prose layer: present only when a markdown file with a real body backs this
// neighborhood. Otherwise the page shows an explicit "not yet explored" stub.
const rendered = entry ? await render(entry) : null
const Content = rendered?.Content

// Social-share image: the neighborhood photo when one is set (resized to the
// ~1200px social-card width, as JPEG since share crawlers don't all take
// webp); data-only pages fall back to the site flag.
const sharePhoto = entry?.data.photo
  ? await getImage({ src: entry.data.photo, width: 1200, format: 'jpeg' })
  : undefined
const hasWriteup = Boolean(entry?.body && entry.body.trim())
const backlinks = entry ? await getBacklinks(entry.id) : []
// The neighborhood's tags double as the "Tags" chips in the pane's aside
// sections rather than a header tag row.
const tags = entry?.data.tags ?? []

const attractions = entry?.data.attractions ?? []

const population = neighborhoodPopulation(slug)
// Nearby neighborhoods: a manual `neighbors` list (frontmatter) for entries the
// geo adjacency graph doesn't cover (county municipalities), else the computed set.
const neighbors =
  entry?.data.neighbors && entry.data.neighbors.length > 0
    ? entry.data.neighbors.flatMap((neighborSlug) => {
        const neighbor = neighborhoodInfo(neighborSlug)
        return neighbor ? [neighbor] : []
      })
    : neighborsOf(slug)
const festivals = festivalsIn(slug)

// Walkable strips through this neighborhood, each linking to its Walkable
// St. Louis section — shown only once the article itself is published (drafts
// count in dev).
const walkableStLouisLive = published(await getCollection('topics')).some(
  (topic) => topic.id === 'walkable-st-louis',
)
const corridors = walkableStLouisLive ? corridorsIn(slug) : []

const placesByNeighborhood = await foodByNeighborhood()
const places = placesByNeighborhood.get(normalizeName(title)) ?? []

// Which neighborhoods have a writeup, keyed by slug, so the Nearby
// Neighborhoods rail can lead with explored ones.
const writtenBySlug = new Map(
  published(await getCollection('neighborhoods')).map((neighborhoodEntry) => [
    neighborhoodEntry.id,
    Boolean(neighborhoodEntry.body && neighborhoodEntry.body.trim()),
  ]),
)

// Show up to 5 nearby neighborhoods, explored ones first — not-yet-visited ones
// only fill in when there aren't 5 explored neighbors to show.
const exploredNeighbors = neighbors.filter((neighbor) => writtenBySlug.get(neighbor.slug))
const notYetVisitedNeighbors = neighbors.filter((neighbor) => !writtenBySlug.get(neighbor.slug))
const nearbyNeighbors = [...exploredNeighbors, ...notYetVisitedNeighbors].slice(0, 5)

// External resources: the place's own site (if any), Wikipedia, and the
// auto-generated City of St. Louis + MyTownView profiles — rendered as a button bar.
const resourceLinks = neighborhoodResourceLinks(slug, title, entry?.data.url, entry?.data.wikipedia)

const generated = neighborhoodGeneratedSummary(slug)

// On-page summary under the title: the manual `description` tagline when set,
// otherwise the generated line. Deliberately NOT the writeup excerpt — that just
// repeats the opening paragraph rendered right below it.
const tagline = entry?.data.description
const summary = tagline ?? generated

// The "Last walked" stat + byline timestamp: the last revision when set,
// otherwise the created date. Only written neighborhoods carry dates.
const lastUpdated = entry ? (entry.data.updated ?? entry.data.created) : undefined

// SEO meta description: the writeup excerpt when there is one (a fuller sentence
// than the short tagline); otherwise the generated line enriched with borders and
// the reviewed-food count, prefixed by the authored tagline when one exists — so
// data-only pages don't all share a near-identical short snippet. The generated
// line gets whatever character budget the tagline leaves (the ". " join costs 2),
// keeping the whole description inside the meta-description cap.
const generatedBudget = META_DESCRIPTION_CHARS - (tagline ? tagline.length + 2 : 0)
const metaDescription = hasWriteup
  ? excerpt(entry?.body, META_DESCRIPTION_CHARS)
  : [tagline, neighborhoodMetaDescription(slug, neighbors, places.length, generatedBudget)]
      .filter(Boolean)
      .join('. ')

// SEO title: "<name> - <kind> in St. Louis", so "St. Louis" is in the title for
// search. Parks read "Park in St. Louis"; county municipalities (type 'city') and
// other typed areas read "<name>, Missouri - <Type> in <region>" (e.g.
// "Kirkwood, Missouri - City in St. Louis County") since county place names
// aren't self-locating the way city neighborhoods are.
let seoTitle: string | undefined
if (info) {
  if (info.type === 'park') {
    seoTitle = `${title} - Park in St. Louis`
  } else if (info.type) {
    const kind = `${info.type.charAt(0).toUpperCase()}${info.type.slice(1)} in ${info.group}`
    seoTitle = `${title}, Missouri - ${kind}`
  } else {
    seoTitle = `${title} - Neighborhood in St. Louis`
  }
}

// Breadcrumb stops at the region (the neighborhood name is already the page H1).
const region = info ? regionOf(info) : undefined
const trail = [
  { label: 'Neighborhoods', href: '/neighborhoods/' },
  ...(region ? [{ label: region.label, href: `/neighborhoods/${region.slug}/` }] : []),
]

// The map pane's food pins: every mapped spot in this neighborhood, coords
// flipped to MapLibre's [lng, lat] order (food frontmatter stores [lat, lng]);
// cuisine/verdict/tagline feed the click popup.
const heroSpots = places.flatMap((place) => {
  const [lat, lng] = place.data.coords ?? []
  if (lat === undefined || lng === undefined) {
    return []
  }
  const verdict = resolveVerdict(place.data)

  return [
    {
      title: place.data.title,
      url: `/food/${place.id}/`,
      coords: [lng, lat] as [number, number],
      cuisine: place.data.cuisine[0],
      verdict: verdict ? { key: verdict, label: verdictLabels[verdict] } : undefined,
      tagline: place.data.description ?? '',
    },
  ]
})

// Boundary color for the map pane: the same region tokens the neighborhoods
// index map paints its polygons with.
const boundaryTokenByRegion: Record<string, string> = {
  'north-city': '--color-map-north',
  'central-corridor': '--color-map-central',
  'south-city': '--color-map-south',
  'st-louis-county': '--color-map-county',
  parks: '--color-map-park',
}
const boundaryToken = boundaryTokenByRegion[region?.slug ?? ''] ?? '--color-map-accent'
---

<BaseLayout
  crumb={title}
  title={seoTitle}
  description={metaDescription}
  ogType="article"
  ogImage={sharePhoto ? rootRelative(sharePhoto.src) : undefined}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}>
  <div class="map-split neighborhood-split" data-map-split data-view="map">
    <div class="results">
      <article class="page content-pane detail-pane">
        <div class="detail-pane-inner">
          <Breadcrumbs trail={trail} />

          <header class="detail-pane-header">
            <h1 class="detail-pane-title">{title}</h1>
            {summary && <p class="entry-summary detail-pane-tagline">{summary}</p>}
            {
              (population != null || places.length > 0) && (
                <div class="pane-stats">
                  {population != null && (
                    <div class="pane-stat">
                      <span class="pane-stat-label">Population</span>
                      <span class="pane-stat-value">{population.toLocaleString('en-US')}</span>
                    </div>
                  )}
                  {places.length > 0 && (
                    <div class="pane-stat">
                      <span class="pane-stat-label">Spots explored</span>
                      <span class="pane-stat-value">{places.length}</span>
                    </div>
                  )}
                  {/* Revealed by comments.ts once the comments backend answers;
                    the value reads "Leave a comment" until comments exist,
                    then the live count. */}
                  <a class="pane-stat pane-stat-link" href="#comments" data-comments-link hidden>
                    <span class="pane-stat-label">Comments</span>
                    <span class="pane-stat-value continue-link">
                      <span data-comments-cell-value>Leave a comment</span>
                    </span>
                  </a>
                </div>
              )
            }
          </header>

          <div class="body">
            {
              hasWriteup && Content ? (
                <Content />
              ) : (
                <div class="not-explored">
                  <p>I haven't written about {title} yet.</p>
                  <p>
                    Is there something you want to suggest here?
                    <a href={href('/contact/')}>Let me know</a>!
                  </p>
                </div>
              )
            }
          </div>

          {
            lastUpdated && (
              <Byline>
                <Fragment slot="footer-meta">
                  <EntryDates created={entry?.data.created} updated={entry?.data.updated} />
                </Fragment>
              </Byline>
            )
          }

          {
            places.length > 0 && (
              <RelatedList title="Food & Drink" class="related-cards">
                {places.map((place) => (
                  <RelatedCard
                    href={href(`/food/${place.id}/`)}
                    title={place.data.title}
                    meta={place.data.cuisine[0]}
                    description={place.data.description}
                    verdict={resolveVerdict(place.data)}
                    unratedLabel={
                      resolveVerdict(place.data)
                        ? undefined
                        : resolveWriterState(place.data).statement
                    }
                  />
                ))}
              </RelatedList>
            )
          }

          {
            corridors.length > 0 && (
              <RelatedList title="Walkable streets">
                {corridors.map((corridor) => (
                  <RelatedCard
                    href={href(`/walkable-st-louis/#${corridor.anchor}`)}
                    title={corridor.name}
                    meta={corridor.street}
                    metaType="text"
                    description={`${corridor.from} to ${corridor.to}`}
                  />
                ))}
              </RelatedList>
            )
          }

          {
            festivals.length > 0 && (
              <RelatedList title="Annual events">
                {festivals.map((festival) => (
                  <RelatedCard
                    title={festival.name}
                    meta={festival.when}
                    metaType="date"
                    description={festival.blurb}
                  />
                ))}
              </RelatedList>
            )
          }

          {
            attractions.length > 0 && (
              <RelatedList title="Landmarks">
                {attractions.map((spot) => (
                  <RelatedCard
                    href={spot.url}
                    title={spot.name}
                    description={spot.description}
                    external
                  />
                ))}
              </RelatedList>
            )
          }

          <div class="pane-aside">
            {
              nearbyNeighbors.length > 0 && (
                <nav class="detail-links-section" aria-label="Nearby neighborhoods">
                  <h2 class="detail-section-label head-black head-black--sm head-rule">
                    Nearby Neighborhoods
                  </h2>
                  <div class="detail-links">
                    {nearbyNeighbors.map((neighbor) => {
                      // The pixel arrow points east at rest, so a compass bearing
                      // (clockwise from north) becomes its CSS rotation by -90°.
                      const bearing = neighborBearing(slug, neighbor.slug)
                      const rotation = bearing === undefined ? undefined : (bearing + 270) % 360

                      return (
                        <Button
                          href={href(`/neighborhoods/${neighbor.slug}/`)}
                          variant="quiet"
                          compact={false}
                          class="btn-inline">
                          {rotation !== undefined && (
                            <span
                              class:list={['neighbor-arrow', `neighbor-arrow--r${rotation}`]}
                              aria-hidden="true">
                              <IconArrowRight />
                            </span>
                          )}
                          {neighbor.name}
                        </Button>
                      )
                    })}
                  </div>
                </nav>
              )
            }
            {
              resourceLinks.length > 0 && (
                <div class="detail-links-section">
                  <h2 class="detail-section-label head-black head-black--sm head-rule">Links</h2>
                  <div class="detail-links">
                    {resourceLinks.map((link) => {
                      const Icon = resourceIcons[link.label]
                      const label = link.label === 'Website' ? displayUrl(link.href) : link.label

                      return (
                        <SourceLink
                          href={link.href}
                          label={label}
                          variant="quiet"
                          compact={false}
                          class="btn-inline">
                          {Icon && <Icon slot="icon" />}
                        </SourceLink>
                      )
                    })}
                  </div>
                </div>
              )
            }
            <NeighborhoodFacts tags={tags} />
          </div>

          <Comments kind="neighborhood" slug={slug} title={title} />

          <footer>
            <Backlinks links={backlinks} />
          </footer>
        </div>
      </article>

      <NeighborhoodHero
        slug={slug}
        boundaryToken={boundaryToken}
        coords={info?.coords}
        spots={heroSpots}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .detail-pane {
    padding-block-end: calc(var(--spacing-xl) + var(--spacing-md));
  }

  /* The pane's reading column: the article content sits in a centered measure
     rather than spanning the full half-viewport pane. */
  .detail-pane-inner {
    max-width: calc(var(--measure-reading) + 2 * var(--spacing-lg));
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
  }

  /* Breadcrumbs: left-aligned in the pane (the shared component centers them). */
  .detail-pane :global(.breadcrumbs) {
    justify-content: flex-start;
    margin-block-start: var(--spacing-xl);
  }

  /* The header voice (.detail-pane-header/.pane-stats) is a global pattern
     shared with the food detail page. */

  /* Rail / Links / Tags: quiet sections — stacked on phones; on wider screens
     Nearby Neighborhoods and Links pair up side by side with Tags spanning
     the full row beneath them. */
  .pane-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    margin-block: var(--spacing-xl);
  }

  @media (min-width: 701px) {
    .pane-aside {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xl) var(--spacing-lg);
      align-items: start;
    }

    /* The Tags card is a component root (no page scope attribute). */
    .pane-aside > :global(.side-card) {
      grid-column: 1 / -1;
    }
  }

  /* The compass arrow leading each neighbor row (the Links-bar icon spot):
     the pixel arrow icon rotated per direction. */
  .neighbor-arrow {
    display: inline-flex;
    color: var(--color-muted);
  }

  .neighbor-arrow :global(.icon) {
    width: 14px;
    height: 14px;
  }

  .neighbor-arrow--r45 :global(.icon) {
    transform: rotate(45deg);
  }

  .neighbor-arrow--r90 :global(.icon) {
    transform: rotate(90deg);
  }

  .neighbor-arrow--r135 :global(.icon) {
    transform: rotate(135deg);
  }

  .neighbor-arrow--r180 :global(.icon) {
    transform: rotate(180deg);
  }

  .neighbor-arrow--r225 :global(.icon) {
    transform: rotate(225deg);
  }

  .neighbor-arrow--r270 :global(.icon) {
    transform: rotate(270deg);
  }

  .neighbor-arrow--r315 :global(.icon) {
    transform: rotate(315deg);
  }
</style>
