---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/url'
import { published } from '../lib/content'
import neighborhoods from '../data/neighborhoods.json'
import IconMapPin from '../assets/IconMapPin.astro'

// A human-readable map of the whole site, pulled live from the content
// collections so it never drifts. (This is the people-facing index; the
// machine-readable /sitemap.xml is separate.)
const byTitle = (left: { data: { title: string } }, right: { data: { title: string } }): number =>
  left.data.title.localeCompare(right.data.title)

const food = published(await getCollection('food')).sort(byTitle)
const topics = published(await getCollection('topics')).sort(byTitle)

// Every real neighborhood (skip the `ignored` rows folded into a merged one),
// alphabetical for findability — each has a page, written or data-only.
const hoods = neighborhoods
  .filter((neighborhood) => !('ignored' in neighborhood))
  .sort((left, right) => left.name.localeCompare(right.name))

interface Entry {
  title: string
  path: string
}
interface SitemapGroup {
  label: string
  path?: string
  // The marquee interactive maps — given a featured treatment below.
  featured?: boolean
  items: Entry[]
}

const groups: SitemapGroup[] = [
  {
    label: 'Pages',
    items: [
      { title: 'About', path: '/about/' },
      { title: 'Updates', path: '/updates/' },
      { title: 'The Best Food in St. Louis', path: '/best/' },
      { title: 'The Backlog', path: '/food/backlog/' },
      { title: 'Annual Events', path: '/events/' },
      { title: 'Tags', path: '/tags/' },
      { title: 'Contact', path: '/contact/' },
    ],
  },
  {
    label: 'Topics',
    path: '/topics/',
    items: topics.map((topic) => ({ title: topic.data.title, path: `/${topic.id}/` })),
  },
  {
    label: 'Food',
    path: '/food/',
    featured: true,
    items: food.map((place) => ({ title: place.data.title, path: `/food/${place.id}/` })),
  },
  {
    label: 'Neighborhoods',
    path: '/neighborhoods/',
    featured: true,
    items: hoods.map((neighborhood) => ({
      title: neighborhood.name,
      path: `/neighborhoods/${neighborhood.slug}/`,
    })),
  },
]
---

<BaseLayout
  crumb="Sitemap"
  title="All St. Louing Content"
  description="A human-readable map of everything on St. Louing.">
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Sitemap</h1>
      </div>
    </header>

    <div class="body">
      {
        groups.map((group) => (
          <section class:list={['sitemap-section', { featured: group.featured }]}>
            <h2 class="sitemap-head head-black head-black--lg head-rule">
              <span class="sitemap-head-label">
                {group.path ? (
                  <a class="sitemap-label" href={href(group.path)}>
                    {group.label}
                  </a>
                ) : (
                  <span class="sitemap-label">{group.label}</span>
                )}
                {group.featured && (
                  <span class="sitemap-map-badge">
                    <IconMapPin /> Map
                  </span>
                )}
                <span class="sitemap-count">{group.items.length}</span>
              </span>
            </h2>
            <ul class="sitemap-list">
              {group.items.map((entry) => (
                <li>
                  <a href={href(entry.path)}>{entry.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .body {
    max-width: none;
  }

  .sitemap-section {
    margin-block-start: var(--spacing-lg);
  }

  .sitemap-head-label {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .sitemap-map-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 2px var(--spacing-xs);
    border: 1px solid var(--color-accent);
    border-radius: 20px;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-accent);
  }

  .sitemap-map-badge :global(.icon) {
    color: var(--color-accent);
    height: 14px;
    width: 14px;
  }

  .sitemap-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin: 0 0 var(--spacing-sm);
  }

  .sitemap-head a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .sitemap-head a:hover {
    color: var(--color-accent-blue);
  }

  .sitemap-count {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
    font-weight: 400;
    color: var(--color-muted);
  }

  .sitemap-list {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 12rem;
    column-gap: var(--spacing-lg);
  }

  .sitemap-list li {
    margin: 0 0 var(--spacing-xs);
    break-inside: avoid;
  }

  .sitemap-list a {
    text-decoration: none;
  }

  .sitemap-list a:hover {
    text-decoration: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 2px;
  }
</style>
