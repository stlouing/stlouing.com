---
import PageMasthead from '../../components/PageMasthead.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import List from '../../components/List.astro'
import ListItem from '../../components/ListItem.astro'
import { href } from '../../lib/url'
import { cuisineLabel } from '../../lib/cuisine'
import { allTags, collectTagged, tagSlug } from '../../lib/tags'

export async function getStaticPaths() {
  const tags = await allTags()
  const items = await collectTagged()

  return tags.map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, items: items.filter((item) => item.tags.includes(tag)) },
  }))
}

const { tag, items } = Astro.props

const COLLECTION_LABEL: Record<string, string> = {
  food: 'Food',
  Neighborhoods: 'Neighborhoods',
  Topics: 'Topics',
  Notes: 'Notes',
}
const grouped = ['food', 'Neighborhoods', 'Topics', 'Notes']
  .map((collection) => ({
    label: COLLECTION_LABEL[collection] ?? collection,
    items: items.filter((item) => item.collection === collection),
  }))
  .filter((group) => group.items.length > 0)

const countLabel = `${items.length} ${items.length === 1 ? 'entry' : 'entries'}`
---

<BaseLayout crumb={`#${tag}`} title={`Tags: ${cuisineLabel(tag)} - St. Louing`} noindex>
  <article class="page">
    <PageMasthead title={`#${tag}`}>
      <p slot="lede">{countLabel}</p>
    </PageMasthead>

    <div class="reading-col">
      {
        grouped.map((group) => (
          <section class="tag-section">
            <SectionHeading title={group.label} />
            <List>
              {group.items.map((item) => (
                <ListItem title={item.title} href={href(item.url)} description={item.description} />
              ))}
            </List>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .tag-section {
    margin-block-start: var(--spacing-lg);
  }
</style>
