---
import BaseLayout from '../../layouts/BaseLayout.astro'
import List from '../../components/List.astro'
import ListItem from '../../components/ListItem.astro'
import { href } from '../../lib/url'
import { allTags, collectTagged } from '../../lib/tags'

export async function getStaticPaths() {
  const tags = await allTags()
  const items = await collectTagged()
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, items: items.filter((item) => item.tags.includes(tag)) },
  }))
}

const { tag, items } = Astro.props
---

<BaseLayout crumb={`#${tag}`}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>{`#${tag}`}</h1>
      </div>
    </header>
    <List>
      {
        items.map((item) => (
          <ListItem title={item.title} href={href(item.url)}>
            <span class="collection">{item.collection}</span>
          </ListItem>
        ))
      }
    </List>
  </article>
</BaseLayout>
