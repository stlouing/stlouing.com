---
import PageMasthead from '../../components/PageMasthead.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import TagIcon from '../../components/TagIcon.astro'
import { href } from '../../lib/url'
import { cuisineLabel } from '../../lib/cuisine'
import { tagGroups, tagSlug } from '../../lib/tags'

const { cuisines, vibes, topics } = await tagGroups()

const groups = [
  { label: 'Cuisines', kind: 'cuisine', tags: cuisines },
  { label: 'Neighborhood vibes', kind: 'vibe', tags: vibes },
  { label: 'Topics', kind: 'topic', tags: topics },
].filter((group) => group.tags.length > 0)
---

<BaseLayout title="Tags - St. Louing" noindex>
  <article class="page">
    <PageMasthead title="Tags">
      <p slot="lede">Browse everything by cuisine, neighborhood vibe, or topic.</p>
    </PageMasthead>

    <div class="tag-groups reading-col">
      {
        groups.map((group) => (
          <section>
            <Heading>{group.label}</Heading>
            <ul class="tag-row">
              {group.tags.map(({ tag, count }) => (
                <li>
                  <a class="tag-chip" href={href(`/tags/${tagSlug(tag)}/`)}>
                    {group.kind === 'vibe' && <TagIcon tag={tag} />}
                    <span>{group.kind === 'cuisine' ? cuisineLabel(tag) : tag}</span>
                    {count > 1 && <span class="tag-n">{count}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>

  .tag-groups {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-lg);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-block: var(--spacing-sm) 0;
    padding: 0;
    list-style: none;

    li {
      margin: 0;
    }
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: 20px;
    background: var(--color-surface);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    line-height: 1;

    &:hover {
      border-color: var(--color-accent-blue);
      color: var(--color-accent-blue);
    }
  }

  .tag-chip :global(.icon) {
    width: 14px;
    height: 14px;
  }

  .tag-n {
    color: var(--color-muted);
    font-size: var(--font-size-xs);
  }
</style>
