---
import { SITE_NAME } from '../../lib/site'
import Chip from '../../components/Chip.astro'
import PageMasthead from '../../components/PageMasthead.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import TagIcon from '../../components/TagIcon.astro'
import { href } from '../../lib/url'
import { cuisineLabel } from '../../lib/cuisine'
import { tagGroups, tagSlug } from '../../lib/tags'

const { cuisines, vibes, topics } = await tagGroups()

const groups = [
  { label: 'Cuisines', kind: 'cuisine', tags: cuisines },
  { label: 'Neighborhood vibes', kind: 'vibe', tags: vibes },
  { label: 'Topics', kind: 'topic', tags: topics },
].filter((group) => group.tags.length > 0)
---

<BaseLayout title={`Tags - ${SITE_NAME}`} noindex>
  <article>
    <PageMasthead title="Tags">
      <p slot="lede">Browse everything by cuisine, neighborhood vibe, or topic.</p>
    </PageMasthead>

    <div class="tag-groups reading-col">
      {
        groups.map((group) => (
          <section>
            <Heading>{group.label}</Heading>
            <ul class="tag-row">
              {group.tags.map(({ tag, count }) => (
                <li>
                  <Chip class="chip--lg" href={href(`/tags/${tagSlug(tag)}/`)}>
                    {group.kind === 'vibe' && <TagIcon tag={tag} />}
                    <span>{group.kind === 'cuisine' ? cuisineLabel(tag) : tag}</span>
                    {count > 1 && <span class="count">{count}</span>}
                  </Chip>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>

  .tag-groups {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-block: var(--spacing-sm) 0;
    padding: 0;
    list-style: none;

    li {
      margin: 0;
    }
  }

  .tag-row :global(.icon) {
    width: 14px;
    height: 14px;
  }
</style>
