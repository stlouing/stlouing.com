---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import { href } from '../lib/url'
import { published, excerpt, sortTopics } from '../lib/content'

// A paragraph-length teaser from the top of each article (the shorter
// PREVIEW_EXCERPT_CHARS is tuned for one-line list rows, not cards).
const TOPIC_EXCERPT_CHARS = 300

const topics = sortTopics(published(await getCollection('topics')))
---

<BaseLayout
  title="Topics: Deep-Dives into St. Louis Food and Culture"
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
      <p class="entry-summary">Deep-dives into St. Louis food and culture</p>
    </header>
    <div class="topic-list">
      {
        topics.map((topic) => (
          <a class="topic-card" href={href(`/${topic.id}/`)}>
            <span class="topic-icon">
              <Icon name={topic.data.icon} />
            </span>
            <div class="topic-main">
              <h2 class="topic-title">{topic.data.title}</h2>
              {topic.data.description && (
                <p class="topic-description">{topic.data.description}.</p>
              )}
              <p class="topic-excerpt">{excerpt(topic.body, TOPIC_EXCERPT_CHARS)}</p>
            </div>
            <span class="topic-arrow">
              <IconArrowRight />
            </span>
          </a>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .topic-list {
    margin-block-start: var(--spacing-md);
  }

  /* Each card is one whole-row link — content left, an arrow on the right —
     divided on hairlines (the site's list idiom, not boxes). Like the list
     items, the card pulls itself a step wider than the text column so the
     hover highlight extends past the text while the text stays aligned. */
  .topic-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-lg);
    padding-inline: var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  /* The same whole-row highlight the list items use: a soft text-over-
     background tint that works in both themes. */
  .topic-card:hover {
    background: color-mix(in srgb, var(--color-text) 5%, var(--color-background));
  }

  /* The hairline divider, drawn inset back to the text column — a border on
     the pulled-wide card would overhang the rules above and below it. */
  .topic-card::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline: var(--spacing-sm);
    height: 1px;
    background: var(--color-line);
  }

  .topic-card:last-child::after {
    content: none;
  }

  /* The site's serif heading voice, at heading size — mono is for labels and
     turns clumsy at display sizes, and the serif is what separates the title
     from the lede and excerpt below it. */
  .topic-title {
    margin-block: 0 var(--spacing-sm);
    font-family: var(--font-serif);
    /* ~23px on phones up to the full xxxl on wide screens, on the same clamp
       idiom as the global heading scale. */
    font-size: clamp(1.375rem, 1.2rem + 1vw, var(--font-size-xxxl));
    font-weight: 500;
    color: var(--color-text-heading);
  }

  .topic-card:hover .topic-title {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* The icon rides its own left column, top-aligned and nudged to sit
     optically against the title's first line (24px serif on a ~29px line box)
     while the title, lede, and excerpt share one text edge. */
  .topic-icon {
    display: inline-flex;
    align-self: start;
    margin-block-start: 4px;
    color: var(--color-accent);

    :global(svg) {
      width: 20px;
      height: 20px;
      color: inherit;
    }
  }

  /* The subtitle: the body serif in accent, like the map lists' taglines. */
  .topic-description {
    margin-block: var(--spacing-xs) 0;
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .topic-excerpt {
    margin-block: var(--spacing-sm) 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .topic-arrow {
    display: inline-flex;
    color: var(--color-muted);

    :global(svg) {
      width: 20px;
      height: 20px;
      color: inherit;
    }
  }

  .topic-card:hover .topic-arrow {
    color: var(--color-accent);
  }
</style>
