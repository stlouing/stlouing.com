---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import Icon from '../components/Icon.astro'
import { href } from '../lib/url'
import { published, excerpt, sortTopics, PREVIEW_EXCERPT_CHARS } from '../lib/content'

const topics = sortTopics(published(await getCollection('topics')))
---

<BaseLayout
  title="Topics: Deep-Dives into St. Louis Food and Culture"
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
      <p class="entry-summary">Deep-dives into St. Louis food and culture</p>
    </header>
    <List>
      {
        topics.map((topic) => (
          <ListItem
            title={topic.data.title}
            href={href(`/${topic.id}/`)}
            description={
              topic.data.description
                ? `${topic.data.description}.`
                : excerpt(topic.body, PREVIEW_EXCERPT_CHARS)
            }>
            <Icon name={topic.data.icon} slot="icon" />
          </ListItem>
        ))
      }
    </List>
  </article>
</BaseLayout>
