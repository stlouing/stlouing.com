---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import { href } from '../lib/url'
import { published, excerpt } from '../lib/content'

// Evergreen pages, newest-tended first (not chronological like Notes), but the
// St. Louis Overview is always pinned to the top as the entry point.
const pinnedId = 'overview'
const topics = published(await getCollection('topics')).sort((left, right) => {
  if (left.id === pinnedId) {
    return -1
  }
  if (right.id === pinnedId) {
    return 1
  }

  return right.data.updated.valueOf() - left.data.updated.valueOf()
})
---

<BaseLayout
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
    </header>
    <List>
      {
        topics.map((topic) => (
          <ListItem
            title={topic.data.title}
            href={href(`/${topic.id}`)}
            description={
              topic.data.description ? `${topic.data.description}.` : excerpt(topic.body)
            }
          />
        ))
      }
    </List>
  </article>
</BaseLayout>
