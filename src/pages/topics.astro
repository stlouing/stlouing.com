---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import ListItem from '../components/ListItem.astro'
import Icon from '../components/Icon.astro'
import { href } from '../lib/url'
import { published, excerpt } from '../lib/content'

const pinnedId = 'field-notes'
const topics = published(await getCollection('topics')).sort((left, right) => {
  if (left.id === pinnedId) {
    return -1
  }
  if (right.id === pinnedId) {
    return 1
  }

  return right.data.updated.valueOf() - left.data.updated.valueOf()
})
---

<BaseLayout
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
      <p class="entry-summary">Deep-dives into St. Louis food and culture</p>
    </header>
    <List>
      {
        topics.map((topic) => (
          <ListItem
            title={topic.data.title}
            href={href(`/${topic.id}/`)}
            description={
              topic.data.description ? `${topic.data.description}.` : excerpt(topic.body)
            }>
            <Icon name={topic.data.icon} slot="icon" />
          </ListItem>
        ))
      }
    </List>
  </article>
</BaseLayout>
