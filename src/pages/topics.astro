---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import { href } from '../lib/url'
import { published, excerpt, sortTopics } from '../lib/content'

// A paragraph-length teaser from the top of each article (the shorter
// PREVIEW_EXCERPT_CHARS is tuned for one-line list rows, not cards).
const TOPIC_EXCERPT_CHARS = 250

const topics = sortTopics(published(await getCollection('topics')))
---

<BaseLayout
  title="Topics: Deep-Dives into St. Louis Food and Culture"
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header entry-header-with-flag">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
      <p class="description description--lg">Deep-dives into St. Louis food and culture</p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>
    <div class="card-grid card-cells card-cells--three">
      <div class="card-rows">
        {
          topics.map((topic) => (
            <Card
              href={href(`/${topic.id}/`)}
              title={topic.data.title}
              meta={topic.data.category}
              description={topic.data.description}
              excerpt={excerpt(topic.body, TOPIC_EXCERPT_CHARS)}>
              <span class="continue-link">
                Continue reading <IconArrowRight />
              </span>
            </Card>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .card-grid {
    margin-block-start: var(--spacing-md);
  }

  .card-grid :global(.continue-link) {
    display: block;
    margin-block-start: auto;
    padding-block-start: var(--spacing-sm);
    text-align: end;
  }
</style>
