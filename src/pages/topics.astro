---
import { BEST_PROMO_PHOTO_ID, CITY } from '../lib/site'
import { groups, sections } from '../lib/sections'
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import { href } from '../lib/url'
import { published, sortTopics, topicDate, PINNED_TOPIC_ID } from '../lib/content'
import { formatDay, formatMonthShort, groupByYear, isoDate } from '../lib/dates'
import SectionHeading from '../components/SectionHeading.astro'

const allTopics = published(await getCollection('topics'))
const topics = sortTopics(allTopics.filter((topic) => topic.data.pinned))
const postDate = (post: (typeof allTopics)[number]) => post.data.created ?? topicDate(post)
const posts = allTopics
  .filter((topic) => !topic.data.pinned)
  .sort((left, right) => postDate(right).valueOf() - postDate(left).valueOf())
const postYears = groupByYear(posts, postDate)
const bestSection = sections.find((section) => section.path === '/best/')
const bestPhotoPlace = published(await getCollection('food')).find(
  (place) => place.id === BEST_PROMO_PHOTO_ID,
)

const topicCard = (topic: (typeof topics)[number]) => ({
  href: href(`/${topic.id}/`),
  title: topic.data.title,
  meta: topic.data.category,
  description: topic.data.description,
  photo: topic.data.photo,
  photoAlt: topic.data.photoCaption,
  linkLabel: 'Continue reading',
})
const pinnedTopic = topics.find((topic) => topic.id === PINNED_TOPIC_ID)
const otherTopics = topics.filter((topic) => topic.id !== PINNED_TOPIC_ID)

const cards = [
  ...(pinnedTopic ? [topicCard(pinnedTopic)] : []),
  ...(bestSection
    ? [
        {
          href: href(bestSection.path),
          title: bestSection.label,
          meta: groups.find((group) => group.id === bestSection.group)?.label,
          description: bestSection.description,
          photo: bestPhotoPlace?.data.photo,
          photoAlt: bestPhotoPlace?.data.title,
          linkLabel: 'View all',
        },
      ]
    : []),
  ...otherTopics.map(topicCard),
]
---

<BaseLayout
  title={`${CITY} Deep Dives`}
  description={`Evergreen deep-dives into ${CITY} food, drink, and culture, tended and updated over time.`}>
  <article>
    <PageMasthead title="Topics" wide>
      <p slot="lede">Deep-dives into {CITY} food and culture</p>
    </PageMasthead>
    <div class="card-grid card-cells card-cells--three">
      <div class="card-rows">
        {
          cards.map((card) => (
            <Card
              class="card--xl"
              accentMeta
              href={card.href}
              title={card.title}
              meta={card.meta}
              description={card.description}
              photo={card.photo}
              photoAlt={card.photoAlt}>
              <span class="continue-link">
                {card.linkLabel} <IconArrowRight />
              </span>
            </Card>
          ))
        }
      </div>
    </div>
    {
      posts.length > 0 && (
        <section class="topic-posts">
          <SectionHeading title="Posts" />
          {postYears.map((group) => (
            <Fragment>
              <p class="dated-year eyebrow">{group.year}</p>
              <ol class="divided-list dated-rows">
                {group.items.map((post) => (
                  <li>
                    <time class="date-stamp" datetime={isoDate(postDate(post))}>
                      <span class="eyebrow eyebrow--muted">{formatMonthShort(postDate(post))}</span>
                      <span class="date-stamp-day">{formatDay(postDate(post))}</span>
                    </time>
                    <div class="topic-post">
                      <a class="title-serif title-link" href={href(`/${post.id}/`)}>
                        {post.data.title}
                      </a>
                      {post.data.description && <p class="description">{post.data.description}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </Fragment>
          ))}
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .card-grid :global(.card--xl .title-serif) {
    font-size: var(--font-size-xl);
  }

  .topic-posts {
    margin-block-start: var(--spacing-xxl);
  }

  .topic-post {
    display: grid;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .topic-post > * {
    margin: 0;
  }

  .card-grid {
    --card-photo-height: 180px;
  }

  .card-grid :global(.card-rows .card) {
    flex-direction: column;
  }

  .card-grid :global(.continue-link) {
    display: block;
    margin-block-start: auto;
    padding-block-start: var(--spacing-sm);
    text-align: end;
  }

  @media (min-width: 701px) {
    .card-grid :global(.card-rows) {
      position: relative;
      column-gap: 0;
      margin-inline: calc(-1 * var(--spacing-md));
    }

    .card-grid :global(.card-rows .card) {
      padding: var(--spacing-lg);
    }

    .card-grid :global(.card-rows::before),
    .card-grid :global(.card-rows::after) {
      content: '';
      position: absolute;
      inset-block: 0;
      border-inline-start: 1px dotted var(--color-line-input);
    }

    .card-grid :global(.card-rows::before) {
      inset-inline-start: 50%;
    }

    .card-grid :global(.card-rows::after) {
      display: none;
    }
  }

  @media (min-width: 1000px) {
    .card-grid :global(.card-rows::before) {
      inset-inline-start: calc(100% / 3);
    }

    .card-grid :global(.card-rows::after) {
      display: block;
      inset-inline-start: calc(200% / 3);
    }
  }
</style>
