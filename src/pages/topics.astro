---
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import { href } from '../lib/url'
import { published, excerpt, sortTopics } from '../lib/content'

const TOPIC_EXCERPT_CHARS = 250

const topics = sortTopics(published(await getCollection('topics')))
---

<BaseLayout
  title="St. Louis Deep Dives"
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <PageMasthead title="Topics" wide>
      <p slot="lede">Deep-dives into St. Louis food and culture</p>
    </PageMasthead>
    <div class="card-grid card-cells card-cells--three">
      <div class="card-rows">
        {
          topics.map((topic) => (
            <Card
              href={href(`/${topic.id}/`)}
              title={topic.data.title}
              meta={topic.data.category}
              description={topic.data.description}
              excerpt={excerpt(topic.body, TOPIC_EXCERPT_CHARS)}>
              <span class="continue-link">
                Continue reading <IconArrowRight />
              </span>
            </Card>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .card-grid {
    margin-block-start: 0;
  }

  .card-grid :global(.card-meta) {
    color: var(--color-accent);
  }

  .card-grid :global(.card .title-serif) {
    font-size: clamp(1.375rem, 1.2rem + 1vw, var(--font-size-xxxl));
  }

  .card-grid :global(.card-description) {
    font-size: var(--font-size-lg);
    margin-block-end: var(--spacing-md);
  }

  .card-grid :global(.continue-link) {
    display: block;
    margin-block-start: auto;
    padding-block-start: var(--spacing-sm);
    text-align: end;
  }

  @media (min-width: 701px) {
    .card-grid :global(.card-rows) {
      position: relative;
      column-gap: 0;
      margin-inline: calc(-1 * var(--spacing-md));
    }

    .card-grid :global(.card-rows .card) {
      padding-inline: var(--spacing-md);
    }

    .card-grid :global(.card-rows::before),
    .card-grid :global(.card-rows::after) {
      content: '';
      position: absolute;
      inset-block: 0;
      border-inline-start: 1px dotted var(--color-line-input);
    }

    .card-grid :global(.card-rows::before) {
      inset-inline-start: calc(100% / 3);
    }

    .card-grid :global(.card-rows::after) {
      inset-inline-start: calc(200% / 3);
    }
  }
</style>
