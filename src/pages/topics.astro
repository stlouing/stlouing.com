---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import { href } from '../lib/url'
import { published, excerpt, sortTopics } from '../lib/content'

// A paragraph-length teaser from the top of each article (the shorter
// PREVIEW_EXCERPT_CHARS is tuned for one-line list rows, not cards).
const TOPIC_EXCERPT_CHARS = 300

const topics = sortTopics(published(await getCollection('topics')))
---

<BaseLayout
  title="Topics: Deep-Dives into St. Louis Food and Culture"
  description="Evergreen deep-dives into St. Louis food, drink, and culture, tended and updated over time.">
  <article class="page">
    <header class="entry-header entry-header-with-flag">
      <div class="entry-bar">
        <h1>Topics</h1>
      </div>
      <p class="entry-summary">Deep-dives into St. Louis food and culture</p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>
    <div class="topic-grid">
      {
        topics.map((topic) => (
          <a class="topic-card hover-wash" href={href(`/${topic.id}/`)}>
            {topic.data.category && <p class="topic-kicker eyebrow">{topic.data.category}</p>}
            <h2 class="topic-title title-serif title-link">{topic.data.title}</h2>
            {topic.data.description && <p class="topic-description desc-muted desc-muted--lg">{topic.data.description}</p>}
            <p class="topic-excerpt">{excerpt(topic.body, TOPIC_EXCERPT_CHARS)}</p>
            {/* A span, not a nested link — the whole card is the anchor. */}
            <span class="continue-link">
              Continue reading <IconArrowRight />
            </span>
          </a>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  /* Cards fan into columns on the wide page (3 at desktop, 2 mid, 1 phone),
     each an equal-height flex stack with the continue link on the floor.
     Counts are fixed per breakpoint (not auto-fill) so the vertical gutter
     rules below know which cards start a row. */
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md) var(--spacing-xl);
    margin-block-start: var(--spacing-md);
  }

  @media (max-width: 1000px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .topic-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The card pulls itself a step wider than the text column so the hover
     highlight extends past the text while the text stays aligned. */
  .topic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: var(--spacing-lg);
    padding-inline: var(--spacing-md);
    margin-inline: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }

  /* The dotted divider under every card row. */
  .topic-card::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline: var(--spacing-sm);
    height: 0;
    border-block-end: 1px dotted var(--color-line-input);
  }

  /* And a matching dotted rule up each column gutter: every card draws one
     just off its leading edge (the cards overhang their tracks by --spacing-sm,
     so -sm lands on the gutter's center line), and the rules are switched off
     for cards that start a row — per column count, matching the grids above. */
  .topic-card::before {
    content: '';
    position: absolute;
    inset-block: var(--spacing-sm);
    inset-inline-start: calc(-1 * var(--spacing-sm));
    width: 0;
    border-inline-start: 1px dotted var(--color-line-input);
  }

  .topic-card:nth-child(3n + 1)::before {
    display: none;
  }

  @media (max-width: 1000px) {
    .topic-card:nth-child(3n + 1)::before {
      display: block;
    }

    .topic-card:nth-child(odd)::before {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .topic-card:nth-child(n)::before {
      display: none;
    }
  }

  .topic-title {
    margin-block: 0 var(--spacing-sm);
    font-size: clamp(1.375rem, 1.2rem + 1vw, var(--font-size-xxxl));
  }

  /* The continue link anchors the card's bottom-right corner, pinned to the
     flex floor so it lines up across a grid row. */
  .topic-card .continue-link {
    display: block;
    margin-block-start: auto;
    padding-block-start: var(--spacing-sm);
    text-align: end;
  }

  .topic-kicker {
    margin: 0 0 var(--spacing-xs);
  }

  .topic-description {
    margin-block: var(--spacing-xs) 0;
  }

  .topic-excerpt {
    margin-block: var(--spacing-sm) var(--spacing-sm);
    font-family: var(--font-serif);
    font-size: var(--font-size-md);
    color: var(--color-text);
    line-height: 1.45;
  }
</style>
