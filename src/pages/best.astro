---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/url'
import { published } from '../lib/content'
import { cuisineLabel } from '../lib/cuisine'
import IconAward from '../assets/IconAward.astro'
import IconStar from '../assets/IconStar.astro'
import superlatives from '../data/superlatives.json'

interface Award {
  label: string
  slug: string
  note?: string
}

// Only rated places I've actually visited feed the rankings.
const visited = published(await getCollection('food')).filter(
  (place) => typeof place.data.rating === 'number',
)

// The single highest-rated place in each cuisine.
const bestByCuisine = new Map<string, (typeof visited)[number]>()
for (const place of visited) {
  for (const cuisine of place.data.cuisine) {
    const current = bestByCuisine.get(cuisine)
    if (!current || (place.data.rating ?? 0) > (current.data.rating ?? 0)) {
      bestByCuisine.set(cuisine, place)
    }
  }
}
const cuisineWinners = [...bestByCuisine.entries()].sort(
  (left, right) => (right[1].data.rating ?? 0) - (left[1].data.rating ?? 0),
)

// Hand-authored favorites (the editorial picks a ranking can't express), resolved
// from src/data/superlatives.json against the food collection.
const foodBySlug = new Map(published(await getCollection('food')).map((place) => [place.id, place]))
const favorites = (superlatives as Award[])
  .map((award) => ({ ...award, place: foodBySlug.get(award.slug) }))
  .filter((award) => award.place)

const description = "The best of the St. Louis food I've tried, by category."
---

<BaseLayout article crumb="Best of" title="The Best Food in St. Louis" description={description}>
  <article class="page">
    <header class="entry-header reading-col">
      <div class="entry-bar">
        <h1>The Best Food in St. Louis</h1>
      </div>
      <p class="entry-summary">My favorite restaurants, bars, and cafes so far!</p>
    </header>

    <div class="best-body reading-col">
      {
        favorites.length > 0 && (
          <section class="fact-section">
            <h2 class="head-black head-rule">My Favorites</h2>
            <p class="description">My favorite individual items throughout the St. Louis area.</p>
            <div class="favorites-grid">
              {favorites.map((award) => (
                <a class="favorite" href={href(`/food/${award.place!.id}/`)}>
                  <span class="favorite-icon" aria-hidden="true">
                    <IconAward />
                  </span>
                  <span class="favorite-text">
                    <span class="favorite-label eyebrow eyebrow--muted">{award.label}</span>
                    <span class="favorite-name">{award.place!.data.title}</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class="fact-section">
        <h2 class="head-black head-rule">Best by Cuisine</h2>
        <p class="description">The best restaurants I've tried so far for each type of cuisine.</p>
        <table class="best-table">
          <thead>
            <tr>
              <th>Cuisine</th>
              <th>Place</th>
              <th align="right">Rating</th>
            </tr>
          </thead>
          <tbody>
            {
              cuisineWinners.map(([cuisine, place]) => (
                <tr>
                  <td class="best-cuisine">{cuisineLabel(cuisine)}</td>
                  <td>
                    <a href={href(`/food/${place.id}/`)}>{place.data.title}</a>
                  </td>
                  <td align="right">
                    <span class="best-rating">
                      {place.data.rating}
                      <IconStar />
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  /* The dividers are the grid's own 1px gap showing the line-colored track
     behind the cards, so rows + columns are handled uniformly with no
     per-cell border math. */
  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .favorite {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
  }

  .favorite:hover .favorite-name {
    color: var(--color-text-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .favorite {
      padding: var(--spacing-sm);
    }
  }

  /* The global `.icon` rule pins icons muted, so recolor to the accent here. */
  .favorite-icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .favorite-icon :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent-gold);
  }

  .favorite-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .favorite-label {
    line-height: 1.2;
  }

  .favorite-name {
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--font-size-md);
  }

  @media (max-width: 700px) {
    .favorites-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .favorites-grid {
      grid-template-columns: 1fr;
    }
  }

  .fact-section {
    h2 {
      margin-bottom: var(--spacing-xs);
    }
  }

  /* The cuisine is the row's lookup key. Collapse the column to its content
     (width: 1% + nowrap under auto table layout) so the place column takes the
     remaining width instead of auto-layout padding this one out. */
  .best-cuisine {
    width: 1%;
    white-space: nowrap;
    font-weight: 500;
  }

  .best-table td a {
    font-weight: 600;
  }
  /* Hover underline for the place links — the global rule only grants it to
     `.body` prose tables, and this table lives outside one. */
  .best-table td a:hover {
    text-decoration-line: underline;
  }

  .best-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-sans-serif);
    font-weight: 700;
    line-height: 1;
    color: var(--color-text);
  }

  .best-rating :global(.icon) {
    width: 0.9em;
    height: 0.9em;
    color: var(--color-accent-gold);
    fill: currentColor;
    stroke: currentColor;
  }

  .description {
    color: var(--color-muted-2);
  }
</style>
