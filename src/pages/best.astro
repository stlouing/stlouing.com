---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/url'
import { published } from '../lib/content'
import { cuisineEmoji } from '../lib/emoji'
import RelatedList from '../components/RelatedList.astro'
import RelatedCard from '../components/RelatedCard.astro'
import superlatives from '../data/superlatives.json'

interface Award {
  label: string
  slug: string
  note?: string
}

// Only rated places I've actually visited feed the rankings.
const visited = published(await getCollection('food')).filter(
  (place) => typeof place.data.rating === 'number',
)

// The single highest-rated place in each cuisine.
const bestByCuisine = new Map<string, (typeof visited)[number]>()
for (const place of visited) {
  for (const cuisine of place.data.cuisine) {
    const current = bestByCuisine.get(cuisine)
    if (!current || (place.data.rating ?? 0) > (current.data.rating ?? 0)) {
      bestByCuisine.set(cuisine, place)
    }
  }
}
const cuisineWinners = [...bestByCuisine.entries()].sort(
  (left, right) => (right[1].data.rating ?? 0) - (left[1].data.rating ?? 0),
)

// Hand-authored favorites (the editorial picks a ranking can't express), resolved
// from src/data/superlatives.json against the food collection.
const foodBySlug = new Map(published(await getCollection('food')).map((place) => [place.id, place]))
const favorites = (superlatives as Award[])
  .map((award) => ({ ...award, place: foodBySlug.get(award.slug) }))
  .filter((award) => award.place)

const description = "The best of the St. Louis food I've tried, by category."
---

<BaseLayout crumb="Best of" description={description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>Best of St. Louis Food</h1>
      </div>
      <p class="entry-summary">My favorite restaurants so far</p>
    </header>

    <p>
      To see all food I've explored so far, visit the <a href={href('/food')}>Food Map</a>. To see
      all the places I have yet to try or rate, visit
      <a href={href('/food/on-the-list')}>the list</a> of places I want to try.
    </p>

    {
      favorites.length > 0 && (
        <section class="fact-section">
          <h2>Favorites</h2>
          <p class="description">My favorite individual items throughout the St. Louis area.</p>
          <div class="favorites-grid">
            {favorites.map((award) => (
              <a class="favorite" href={href(`/food/${award.place!.id}`)}>
                <span class="favorite-emoji" aria-hidden="true">
                  {cuisineEmoji(award.place!.data.cuisine)}
                </span>
                <span class="favorite-text">
                  <span class="favorite-label">{award.label}</span>
                  <span class="favorite-name">{award.place!.data.title}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <hr />

    <section class="fact-section">
      <h2>Best by cuisine</h2>
      <p class="description">The best restaurants I've tried so far for each type of cuisine.</p>
      <div class="cuisine-winners">
        {
          cuisineWinners.map(([cuisine, place]) => (
            <RelatedCard
              href={href(`/food/${place.id}`)}
              title={place.data.title}
              meta={cuisine}
              emoji={cuisineEmoji([cuisine])}
              rating={place.data.rating}
            />
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* The favorites: a 3-up grid of cards in one bordered frame. The dividers are
     the grid's own 1px gap showing the line-colored track behind the cards, so
     rows + columns are handled uniformly with no per-cell border math. */
  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .favorite {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
  }

  .favorite:hover .favorite-name {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .favorite {
      padding: var(--spacing-sm);
    }
  }

  /* The leading cuisine emoji, in place of the old star badge. */
  .favorite-emoji {
    flex-shrink: 0;
    font-size: var(--font-size-xl);
    line-height: 1;
  }

  .favorite-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .favorite-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-accent);
    line-height: 1.2;
  }

  .favorite-name {
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--font-size-md);
  }

  @media (max-width: 700px) {
    .favorites-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .favorites-grid {
      grid-template-columns: 1fr;
    }
  }

  .fact-section {
    h2 {
      margin-bottom: var(--spacing-xs);
    }
  }

  .description {
    color: var(--color-text-muted-2);
  }
</style>
