---
import Subheading from '../components/Subheading.astro'
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import ReaderFavorites from '../components/ReaderFavorites.astro'
import { published, excerpt, META_DESCRIPTION_CHARS, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import { href } from '../lib/url'
import { SUPABASE_ENABLED } from '../lib/site'
import superlatives from '../data/superlatives.json'

interface Award {
  label: string
  slug: string
}

const food = published(await getCollection('food'))
const foodBySlug = new Map(food.map((place) => [place.id, place]))
const resolvedAwards = (superlatives as Award[]).flatMap((award) => {
  const place = foodBySlug.get(award.slug)

  return place ? [{ ...award, place, teaser: excerpt(place.body ?? '', PREVIEW_EXCERPT_CHARS) }] : []
})

const awards = [
  ...resolvedAwards.filter((award) => award.place.data.photo),
  ...resolvedAwards.filter((award) => !award.place.data.photo),
]

const readersEnabled = SUPABASE_ENABLED

const descriptionLead = 'My picks for the best food in St. Louis, by category: '
const descriptionSuffix = ', and more.'
const fittingLabels: string[] = []
for (const award of resolvedAwards) {
  const candidate = [...fittingLabels, award.label].join(', ')
  if (descriptionLead.length + candidate.length + descriptionSuffix.length > META_DESCRIPTION_CHARS) {
    break
  }
  fittingLabels.push(award.label)
}
const description = `${descriptionLead}${fittingLabels.join(', ')}${descriptionSuffix}`
---

<BaseLayout article crumb="Best of" title="The Best Food in St. Louis" description={description}>
  <article class="page">
    <PageMasthead title="The Best Food in St. Louis" wide>
      <p slot="lede">My subjective favorites and readers top-voted spots</p>
    </PageMasthead>

    <div class="detail-layout">
      <div class="detail-main">
        <div class="photo-cards">
          {
            awards.map(({ label, place, teaser }) => (
              <div class="best-cell">
                <Subheading level={3}>{label.charAt(0).toUpperCase() + label.slice(1)}</Subheading>
                <Card
                  class="is-horizontal card--lg"
                  href={href(`/food/${place.id}/`)}
                  title={place.data.title}
                  description={place.data.description}
                  excerpt={teaser}
                  photo={place.data.photo}
                />
              </div>
            ))
          }
        </div>
      </div>

      {
        readersEnabled && (
          <aside class="detail-aside">
            <ReaderFavorites />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>

  .photo-cards {
    grid-template-columns: 1fr;
    grid-auto-rows: auto;
    row-gap: var(--spacing-lg);
  }

  .best-cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-block-end: var(--spacing-md);
    border-block-end: 1px solid var(--color-line);
  }

  .best-cell:last-child {
    border-block-end: 0;
  }

  .best-cell :global(.card) {
    flex: 1;
  }
</style>
