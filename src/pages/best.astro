---
import Subheading from '../components/Subheading.astro'
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import ReaderFavorites from '../components/ReaderFavorites.astro'
import { published, excerpt, META_DESCRIPTION_CHARS, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import { href } from '../lib/url'
import { CITY, SUPABASE_ENABLED } from '../lib/site'
import { optionalData } from '../lib/optional-data'

interface Award {
  label: string
  slug: string
}

const food = published(await getCollection('food'))
const foodBySlug = new Map(food.map((place) => [place.id, place]))
const bestFoodPicks = optionalData<Award[]>(
  import.meta.glob('../data/best-food.json', { eager: true, import: 'default' }),
  [],
)
const resolvedAwards = bestFoodPicks.flatMap((award) => {
  const place = foodBySlug.get(award.slug)

  return place ? [{ ...award, place, teaser: excerpt(place.body ?? '', PREVIEW_EXCERPT_CHARS) }] : []
})

const awards = [
  ...resolvedAwards.filter((award) => award.place.data.photo),
  ...resolvedAwards.filter((award) => !award.place.data.photo),
]

const readersEnabled = SUPABASE_ENABLED

const descriptionLead = `My picks for the best food in ${CITY}, by category: `
const descriptionSuffix = ', and more.'
const fittingLabels: string[] = []
for (const award of resolvedAwards) {
  const candidate = [...fittingLabels, award.label].join(', ')
  if (descriptionLead.length + candidate.length + descriptionSuffix.length > META_DESCRIPTION_CHARS) {
    break
  }
  fittingLabels.push(award.label)
}
const description = `${descriptionLead}${fittingLabels.join(', ')}${descriptionSuffix}`
---

<BaseLayout crumb="Best of" title={`The Best Food in ${CITY}`} description={description}>
  <article>
    <PageMasthead title={`The Best Food in ${CITY}`} wide>
      <p slot="lede">
        My subjective favorites{readersEnabled && ' and readers top-voted spots'}
      </p>
    </PageMasthead>

    <div class:list={[{ 'detail-layout detail-layout--wide': readersEnabled }]}>
      <div class="detail-main">
        <div class="best-list">
          {
            awards.map(({ label, place, teaser }) => (
              <section class="best-entry">
                <Subheading level={3}>{label.charAt(0).toUpperCase() + label.slice(1)}</Subheading>
                <Card
                  class="card--lg card--xl"
                  href={href(`/food/${place.id}/`)}
                  title={place.data.title}
                  description={place.data.description}
                  excerpt={teaser}
                  photo={place.data.photo}
                  photoSizes="(min-width: 1000px) 320px, 100vw"
                />
              </section>
            ))
          }
        </div>
      </div>

      {
        readersEnabled && (
          <aside class="detail-aside">
            <ReaderFavorites />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .best-list {
    --best-label-width: 12rem;
    container-type: inline-size;
  }

  .best-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    column-gap: var(--spacing-xl);
    padding-block: var(--spacing-xl);
    border-block-end: 1px solid var(--color-line);
  }

  .best-entry:first-child {
    padding-block-start: 0;
  }

  .best-entry:last-child {
    border-block-end: 0;
  }

  .best-entry :global(.card) {
    gap: var(--spacing-md);
  }

  .best-entry :global(.card-body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .best-entry :global(.card-media) {
    order: 1;
    height: auto;
    aspect-ratio: 3 / 2;
    margin: 0;
  }

  @container (min-width: 30rem) {
    .best-entry :global(.card) {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--spacing-xl);
    }

    .best-entry :global(.card-media) {
      flex: 0 0 40%;
      width: auto;
      min-width: 0;
    }
  }

  @container (min-width: 48rem) {
    .best-entry {
      grid-template-columns: var(--best-label-width) minmax(0, 1fr);
    }

    .best-entry > :global(.subheading) {
      padding-block-start: calc(
        (var(--font-size-title-xl) * 1.25 - var(--font-size-xxl) * 1.1) / 2
      );
    }
  }
</style>
