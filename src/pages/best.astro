---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import ReaderFavorites from '../components/ReaderFavorites.astro'
import { published, excerpt, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import { href } from '../lib/url'
import { SUPABASE_ENABLED } from '../lib/site'
import superlatives from '../data/superlatives.json'

interface Award {
  label: string
  slug: string
}

const food = published(await getCollection('food'))
const foodBySlug = new Map(food.map((place) => [place.id, place]))
const resolvedAwards = (superlatives as Award[]).flatMap((award) => {
  const place = foodBySlug.get(award.slug)

  return place ? [{ ...award, place, teaser: excerpt(place.body ?? '', PREVIEW_EXCERPT_CHARS) }] : []
})

const awards = [
  ...resolvedAwards.filter((award) => award.place.data.photo),
  ...resolvedAwards.filter((award) => !award.place.data.photo),
]

const readersEnabled = SUPABASE_ENABLED

const description = "The best of the St. Louis food I've tried, by category."
---

<BaseLayout article crumb="Best of" title="The Best Food in St. Louis" description={description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>The Best Food in St. Louis</h1>
      </div>
      <p class="description description--lg">My subjective favorites and readers top-voted spots</p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>

    <div class="detail-layout">
      <div class="detail-main">
        <div class="photo-cards">
          {
            awards.map(({ label, place, teaser }) => (
              <div class="best-cell">
                <h3 class="best-type eyebrow">{label}</h3>
                <Card
                  class="is-horizontal"
                  href={href(`/food/${place.id}/`)}
                  title={place.data.title}
                  description={place.data.description}
                  excerpt={teaser}
                  photo={place.data.photo}
                />
              </div>
            ))
          }
        </div>
      </div>

      {
        readersEnabled && (
          <aside class="detail-aside">
            <ReaderFavorites />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .best-mine {
    margin: 0 0 var(--spacing-lg);
  }

  .photo-cards {
    grid-template-columns: 1fr;
    grid-auto-rows: auto;
    row-gap: var(--spacing-xl);
  }

  .best-cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .best-type {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin: 0 0 var(--spacing-sm);
    line-height: 1;
    color: var(--color-accent);
  }

  .best-type::before,
  .best-type::after {
    content: '';
    flex: 1;
    border-block-end: 1px solid var(--color-line);
  }

  .best-cell :global(.photo-card) {
    flex: 1;
    padding-block: var(--spacing-md);
  }
</style>
