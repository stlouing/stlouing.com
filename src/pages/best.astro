---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import FoodCard from '../components/FoodCard.astro'
import ReaderFavorites from '../components/ReaderFavorites.astro'
import { published, excerpt, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import superlatives from '../data/superlatives.json'

interface Award {
  label: string
  slug: string
}

// Hand-authored awards (src/data/superlatives.json) resolved against the food
// collection, kept in the file's editorial order. Unresolvable slugs drop out.
const food = published(await getCollection('food'))
const foodBySlug = new Map(food.map((place) => [place.id, place]))
const resolvedAwards = (superlatives as Award[]).flatMap((award) => {
  const place = foodBySlug.get(award.slug)

  return place ? [{ ...award, place, teaser: excerpt(place.body ?? '', PREVIEW_EXCERPT_CHARS) }] : []
})

// Photo cards group together at the top so grid rows stay even; the JSON's
// editorial order is kept within each group.
const awards = [
  ...resolvedAwards.filter((award) => award.place.data.photo),
  ...resolvedAwards.filter((award) => !award.place.data.photo),
]

// The Reader Favorites aside is live data (Supabase get_reader_ratings) —
// ReaderFavorites renders nothing without creds, and the aside is gated too so
// a credless build doesn't leave an empty right column.
const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)

const description = "The best of the St. Louis food I've tried, by category."
---

<BaseLayout article crumb="Best of" title="The Best Food in St. Louis" description={description}>
  <article class="page">
    <header class="entry-header">
      <div class="entry-bar">
        <h1>The Best Food in St. Louis</h1>
      </div>
      <p class="entry-summary">My subjective favorites and readers top-voted spots</p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>

    <div class="detail-layout">
      <div class="detail-main">
        <!-- <h2 class="best-mine head-black head-rule">My Favorites</h2> -->
        <div class="food-cards">
          {
            awards.map(({ label, place, teaser }) => (
              <div class="best-cell">
                <h3 class="best-type head-black head-rule">{label}</h3>
                <FoodCard place={place} teaser={teaser} horizontal />
              </div>
            ))
          }
        </div>
      </div>

      {
        readersEnabled && (
          <aside class="detail-aside">
            <ReaderFavorites />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .best-mine {
    margin: 0 0 var(--spacing-lg);
  }

  /* One horizontal card per row on this page (the homepage keeps the 2-up grid). */
  .food-cards {
    grid-template-columns: 1fr;
    grid-auto-rows: auto;
  }

  /* Each grid cell opens with the award type in the small bold label voice
     (head-black--sm — a clear step below the My Favorites section header), so
     the top line stays consistent whether or not the card below has a photo. */
  .best-cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .best-type {
    margin: 0 0 var(--spacing-sm);
  }

  .best-cell :global(.food-card) {
    flex: 1;
  }
</style>
