---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import MapRow from '../components/MapRow.astro'
import NeighborhoodMap from '../components/NeighborhoodMap.astro'
import neighborhoods from '../data/neighborhoods.json'
import { published, excerpt, hasBody, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import {
  neighborhoodResourceLinks,
  neighborhoodPopulation,
  foodByNeighborhood,
  normalizeName,
} from '../lib/neighborhoods'

// The list shows every neighborhood; ones with a writeup are listed first (then
// the rest, in their numbered order). Written rows render their writeup expanded;
// the map highlights + scrolls to a given one (see neighborhood-map.ts).
const entries = published(await getCollection('neighborhoods'))
const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))
// Food spots per neighborhood (keyed by normalized name), for the map hover card.
const foodByHood = await foodByNeighborhood()

// "Written" means a real writeup body — not just that a markdown file exists. A
// frontmatter-only entry (e.g. the Delmar Loop, which carries only its links)
// renders no writeup, so it stays in "The rest" until prose is added.
const isWritten = (slug: string) => hasBody(entryBySlug.get(slug) ?? {})

// Neighborhoods with a writeup come first (stable sort keeps the numbered order
// within each group).
const listed = neighborhoods
  .filter((neighborhood) => !('ignored' in neighborhood))
  .sort((left, right) => Number(isWritten(right.slug)) - Number(isWritten(left.slug)))
const count = listed.length
const writtenCount = listed.filter((neighborhood) => isWritten(neighborhood.slug)).length
const restCount = listed.length - writtenCount

// Per-neighborhood facts the map popup needs (area + resource links), stashed as
// data attributes on each row so the client map can read them without re-deriving.
// Resources come from the shared helper so the popup matches the detail page +
// list (deduped Website, plus the City of St. Louis link the popup used to omit).
// Default preview line for a neighborhood without a writeup, so an un-explored row
// (and its map popup) reads as intentional rather than unfinished.
const NOT_EXPLORED_EXCERPT = "I haven't explored this neighborhood yet."

function popupData(slug: string, name: string, group: string) {
  const entry = entryBySlug.get(slug)
  const links = neighborhoodResourceLinks(slug, name, entry?.data.url, entry?.data.wikipedia)
  const hrefFor = (label: string) => links.find((link) => link.label === label)?.href

  return {
    area: group,
    // Quick facts for the map hover card: residents + how many food spots I've
    // mapped here (0 when none yet).
    population: neighborhoodPopulation(slug),
    spots: foodByHood.get(normalizeName(name))?.length ?? 0,
    official: hrefFor('Website'),
    wikipedia: hrefFor('Wikipedia'),
    city: hrefFor('St. Louis City'),
    mytownview: hrefFor('MyTownView'),
    // The accent tagline (the manual description), shown in the popup + list row
    // when one is set.
    tagline: entry?.data.description,
    // Popup teaser: the writeup excerpt when there is one; otherwise a default
    // "not explored yet" line so the card never reads as empty/unfinished.
    excerpt:
      entry?.body !== undefined && entry.body.length > 0
        ? excerpt(entry.body, PREVIEW_EXCERPT_CHARS)
        : NOT_EXPLORED_EXCERPT,
  }
}

// The map "section" for an area — drives the colored dot on its list chip, using
// the same precedence as the map's colorForArea (park → county → city region).
function sectionOf(area: { group?: string; type?: string }): string {
  if (area.type === 'park') {
    return 'park'
  }
  if (area.group === 'St. Louis County') {
    return 'county'
  }
  if (area.group === 'North City') {
    return 'north'
  }
  if (area.group === 'South City') {
    return 'south'
  }

  return 'central'
}
---

<BaseLayout
  crumb="Neighborhoods"
  title="The St. Louis Neighborhood Map - City and County"
  description="A map and field guide to all 79 neighborhoods and 9 parks of the City of St. Louis, including local food, events, population, borders, and discoveries.">
  <div class="map-split" data-map-split data-view="map">
    {
      /* Pre-paint: on mobile (one pane at a time) open on the reading list rather
        than the full-bleed map, so the page lands on scrollable rows. Desktop shows
        both panes regardless of data-view, so it stays on the map default. */
    }
    <script is:inline>
      {
        const split = document.currentScript.parentElement
        if (window.matchMedia('(max-width: 700px)').matches) {
          split.dataset.view = 'content'
        }
      }
    </script>
    <div class="results">
      <article class="page content-pane map-list section-list">
        <div class="list-pane-header">
          <span class="pane-left">
            <h1 class="pane-title">Neighborhoods, Parks, & Cities</h1>
            <span class="pane-count">{count}</span>
          </span>
        </div>
        <ul class="list">
          {
            listed.map((neighborhood, index) => {
              const written = isWritten(neighborhood.slug)
              const numberLabel = neighborhood?.numberLabel
                ? neighborhood.numberLabel
                : neighborhood.number
              const popup = popupData(neighborhood.slug, neighborhood.name, neighborhood.group)
              const section = sectionOf(neighborhood)
              // The group's own region/county dot color (ignoring type), so a park
              // popup can show its region chip alongside the green "Park" chip.
              const regionKey = sectionOf({ group: neighborhood.group })
              const entry = entryBySlug.get(neighborhood.slug)
              // The list row shows at most 3 resource links: drop the City of St.
              // Louis page (it stays on the detail page) so the row keeps Wikipedia,
              // MyTownView, and the optional Website.
              const resourceLinks = written
                ? neighborhoodResourceLinks(
                    neighborhood.slug,
                    neighborhood.name,
                    entry?.data.url,
                    entry?.data.wikipedia,
                  )
                    .filter((link) => link.label !== 'St. Louis City')
                    .slice(0, 3)
                : []

              // A section header sits above the first row of each group — the
              // ones with a writeup, then the rest.
              const previous = listed[index - 1]
              const showHeader = index === 0 || written !== isWritten(previous.slug)

              return (
                <Fragment>
                  {showHeader && (
                    <li class="section-head">
                      <span class="section-label">{written ? 'Explored' : 'Not Explored'}</span>
                      <span class="section-count">{written ? writtenCount : restCount}</span>
                    </li>
                  )}
                  <MapRow
                    id={neighborhood.slug}
                    title={neighborhood.name}
                    detailHref={`/neighborhoods/${neighborhood.slug}/`}
                    readMore={false}
                    filterable={false}
                    class={written ? 'is-written' : undefined}
                    attrs={{
                      'data-section': neighborhood.slug,
                      'data-area': popup.area ?? '',
                      'data-wikipedia': popup.wikipedia ?? '',
                      'data-city': popup.city ?? '',
                      'data-mytownview': popup.mytownview ?? '',
                      'data-official': popup.official ?? '',
                      'data-region': regionKey,
                      'data-type': section === 'park' ? 'park' : '',
                      'data-tagline': popup.tagline ?? '',
                      'data-excerpt': popup.excerpt ?? '',
                      'data-population': popup.population ? String(popup.population) : '',
                      'data-spots': String(popup.spots),
                    }}>
                    {neighborhood.group && (
                      <span class="list-meta" slot="title-after">
                        {section === 'park' ? 'Park' : neighborhood.group}
                      </span>
                    )}
                    {popup.tagline && <div class="list-tagline">{popup.tagline}</div>}
                    {written && entry && (
                      <div class="map-preview">{excerpt(entry.body, PREVIEW_EXCERPT_CHARS)}</div>
                    )}
                  </MapRow>
                </Fragment>
              )
            })
          }
        </ul>
      </article>
      <NeighborhoodMap />
    </div>
  </div>
</BaseLayout>

<style>
  .section-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    font-weight: 500;
  }
</style>
