---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import NeighborhoodMap from '../components/NeighborhoodMap.astro'
import neighborhoods from '../data/neighborhoods.json'
import { href } from '../lib/url'
import { published } from '../lib/content'
import IconArrowRight from '../assets/IconArrowRight.astro'

// Pre-render the body of any neighborhood that has a written Markdown entry; the
// rest fall back to a placeholder so all 88 sections exist on the page.
const entries = await getCollection('neighborhoods')
type RenderedContent = Awaited<ReturnType<typeof render>>['Content']
const rendered = new Map<string, RenderedContent>()

for (const entry of entries) {
  const { Content } = await render(entry)
  rendered.set(entry.id, Content)
}

// Group food places by neighborhood so each section can list its restaurants.
// Normalize names (lowercase, alphanumerics only) so e.g. "North Hampton" and
// "Northampton" still join.
const normalizeName = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '')
const foodPlaces = published(await getCollection('food'))
const foodByNeighborhood = new Map<string, typeof foodPlaces>()

for (const place of foodPlaces) {
  if (!place.data.neighborhood) {
    continue
  }
  const key = normalizeName(place.data.neighborhood)
  const existing = foodByNeighborhood.get(key) ?? []
  existing.push(place)
  foodByNeighborhood.set(key, existing)
}
---

<BaseLayout crumb="Neighborhoods">
  <div class="map-split" data-map-split data-view="map">
    <div class="results">
      <article class="page content-pane">
        <header class="pane-header">
          <h1>Neighborhoods</h1>
        </header>
        <List>
          {
            neighborhoods
              .filter((neighborhood) => !('ignored' in neighborhood))
              .map((neighborhood) => {
                const Content = rendered.get(neighborhood.slug)
                const places = foodByNeighborhood.get(normalizeName(neighborhood.name)) ?? []
                const isExpandable = Boolean(Content) || places.length > 0
                const numberLabel = neighborhood?.numberLabel
                  ? neighborhood.numberLabel
                  : neighborhood.number

                return (
                  <li id={neighborhood.slug} data-section={neighborhood.slug}>
                    {isExpandable ? (
                      <button
                        type="button"
                        class="list-title neighborhood-toggle"
                        aria-expanded="false">
                        <span class="number">{`${numberLabel}.`}</span>
                        {neighborhood.name}
                      </button>
                    ) : (
                      <span class="list-title">
                        <span class="number">{`${numberLabel}.`}</span>
                        {neighborhood.name}
                      </span>
                    )}
                    {isExpandable && (
                      <div class="neighborhood-body list-description">
                        {Content && <Content />}
                        {places.length > 0 && (
                          <div class="neighborhood-food">
                            <h3>Food</h3>
                            <ul>
                              {places.map((place) => (
                                <li>
                                  <a href={href(`/food/${place.id}`)}>{place.data.title}</a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {Content && (
                          <a class="more" href={href(`/neighborhoods/${neighborhood.slug}`)}>
                            Read more <IconArrowRight />
                          </a>
                        )}
                      </div>
                    )}
                  </li>
                )
              })
          }
        </List>
      </article>
      <NeighborhoodMap />
    </div>
  </div>
</BaseLayout>

<style>
  .number {
    color: var(--color-accent);
  }

  .more {
    margin-top: var(--spacing-sm);
  }
</style>
