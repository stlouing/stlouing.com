---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import NeighborhoodMap from '../components/NeighborhoodMap.astro'
import neighborhoods from '../data/neighborhoods.json'
import { href } from '../lib/url'
import { published, hasBody } from '../lib/content'
import IconArrowRight from '../assets/IconArrowRight.astro'

// The list shows each written neighborhood's rendered writeup, clamped to a few
// lines (keeps inline links + formatting, just cuts it off) with "Read more" to
// the full page. Neighborhoods with a writeup start expanded.
const entries = await getCollection('neighborhoods')
type RenderedContent = Awaited<ReturnType<typeof render>>['Content']
const rendered = new Map<string, RenderedContent>()
const writtenUp = new Set<string>()

for (const entry of entries) {
  const { Content } = await render(entry)
  rendered.set(entry.id, Content)
  if (hasBody(entry)) {
    writtenUp.add(entry.id)
  }
}

// Group food places by neighborhood so each section can list its restaurants.
// Normalize names (lowercase, alphanumerics only) so e.g. "North Hampton" and
// "Northampton" still join.
const normalizeName = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '')
const foodPlaces = published(await getCollection('food'))
const foodByNeighborhood = new Map<string, typeof foodPlaces>()

for (const place of foodPlaces) {
  if (!place.data.neighborhood) {
    continue
  }
  const key = normalizeName(place.data.neighborhood)
  const existing = foodByNeighborhood.get(key) ?? []
  existing.push(place)
  foodByNeighborhood.set(key, existing)
}
---

<BaseLayout crumb="Neighborhoods">
  <div class="map-split" data-map-split data-view="map">
    <div class="results">
      <article class="page content-pane">
        <header class="pane-header">
          <h1>Neighborhoods</h1>
          <ul class="region-legend" aria-label="Map regions">
            <li class="region-legend-item region-north">North</li>
            <li class="region-legend-item region-central">Central</li>
            <li class="region-legend-item region-south">South</li>
          </ul>
        </header>
        <List>
          {
            neighborhoods
              .filter((neighborhood) => !('ignored' in neighborhood))
              .map((neighborhood) => {
                const Content = rendered.get(neighborhood.slug)
                const places = foodByNeighborhood.get(normalizeName(neighborhood.name)) ?? []
                const isExpandable = Boolean(Content) || places.length > 0
                const expanded = writtenUp.has(neighborhood.slug)
                const numberLabel = neighborhood?.numberLabel
                  ? neighborhood.numberLabel
                  : neighborhood.number

                return (
                  <li
                    id={neighborhood.slug}
                    data-section={neighborhood.slug}
                    class:list={{ 'is-active': expanded }}>
                    {isExpandable ? (
                      <button
                        type="button"
                        class="neighborhood-toggle"
                        aria-expanded={expanded ? 'true' : 'false'}>
                        <div class="list-title">
                          <span class="number">{`${numberLabel}.`}</span>
                          <span>{neighborhood.name}</span>
                        </div>
                        {Content && (
                          <a class="more" href={href(`/neighborhoods/${neighborhood.slug}`)}>
                            More <IconArrowRight />
                          </a>
                        )}
                      </button>
                    ) : (
                      <div class="list-title">
                        <span class="number">{`${numberLabel}.`}</span>
                        <span>{neighborhood.name}</span>
                      </div>
                    )}
                    {isExpandable && (
                      <div class="neighborhood-body list-description">
                        {Content && (
                          <div class="neighborhood-preview">
                            <Content />
                          </div>
                        )}
                        {/* {places.length > 0 && (
                          <div class="neighborhood-food">
                            <h3>Food</h3>
                            <ul>
                              {places.map((place) => (
                                <li>
                                  <a href={href(`/food/${place.id}`)}>{place.data.title}</a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )} */}
                      </div>
                    )}
                  </li>
                )
              })
          }
        </List>
      </article>
      <NeighborhoodMap />
    </div>
  </div>
</BaseLayout>

<style>
  .number {
    color: var(--color-accent);
  }

  .more {
    font-size: var(--font-size-sm);
  }

  button.neighborhood-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Cut the inline writeup off after a few lines — keeps its links + formatting
     (unlike a plain-text excerpt); the full text is on the "Read more" page. */
  .neighborhood-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }

  /* Compact color key for the map's region groups, sitting beside the title.
     Each dot pulls from the same --color-map-* token the polygons use. */
  .region-legend {
    display: flex;
    flex-wrap: wrap;
    align-self: center;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .region-legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 2px var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  .region-legend-item::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--legend-color);
    flex-shrink: 0;
  }

  .region-north {
    --legend-color: var(--color-map-north);
  }

  .region-central {
    --legend-color: var(--color-map-central);
  }

  .region-south {
    --legend-color: var(--color-map-south);
  }
</style>
