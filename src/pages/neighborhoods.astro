---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import List from '../components/List.astro'
import NeighborhoodMap from '../components/NeighborhoodMap.astro'
import neighborhoods from '../data/neighborhoods.json'
import { href } from '../lib/url'
import { published, excerpt } from '../lib/content'
import { wikipediaHref, neighborhoodInfo, neighborhoodResources } from '../lib/neighborhoods'
import IconArrowRight from '../assets/IconArrowRight.astro'

// The list shows every neighborhood; ones with a writeup are listed first (then
// the rest, in their numbered order). Written rows render their writeup expanded;
// the map highlights + scrolls to a given one (see neighborhood-map.ts).
const entries = published(await getCollection('neighborhoods'))
const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))
type RenderedContent = Awaited<ReturnType<typeof render>>['Content']
const rendered = new Map<string, RenderedContent>()

for (const entry of entries) {
  const { Content } = await render(entry)
  rendered.set(entry.id, Content)
}

// Neighborhoods with a writeup come first (stable sort keeps the numbered order
// within each group).
const listed = neighborhoods
  .filter((neighborhood) => !('ignored' in neighborhood))
  .sort((left, right) => Number(rendered.has(right.slug)) - Number(rendered.has(left.slug)))
const count = listed.length
const writtenCount = listed.filter((neighborhood) => rendered.has(neighborhood.slug)).length
const restCount = listed.length - writtenCount

// Per-neighborhood facts the map popup needs (area + resource links), stashed as
// data attributes on each row so the client map can read them without re-deriving.
function popupData(slug: string, name: string, group: string) {
  const info = neighborhoodInfo(slug)
  const niche = (info ? neighborhoodResources(info) : []).find(
    (resource) => resource.label === 'Niche',
  )?.href
  const entry = entryBySlug.get(slug)

  return {
    area: group,
    official: entry?.data.url,
    wikipedia: entry?.data.wikipedia ?? wikipediaHref(name),
    niche,
    excerpt: entry?.body ? excerpt(entry.body, 150) : undefined,
  }
}
---

<BaseLayout crumb="Neighborhoods">
  <div class="map-split" data-map-split data-view="map">
    <div class="results">
      <article class="page content-pane">
        <div class="list-pane-header">
          <span class="pane-left">
            <h1 class="pane-title">Neighborhoods</h1>
            <span class="pane-count">{count}</span>
          </span>
          <ul class="region-legend" aria-label="Map regions">
            <li class="region-legend-item region-north">North</li>
            <li class="region-legend-item region-central">Central</li>
            <li class="region-legend-item region-south">South</li>
          </ul>
        </div>
        <List>
          {
            listed.map((neighborhood, index) => {
                const Content = rendered.get(neighborhood.slug)
                const written = rendered.has(neighborhood.slug)
                const numberLabel = neighborhood?.numberLabel
                  ? neighborhood.numberLabel
                  : neighborhood.number
                const popup = popupData(neighborhood.slug, neighborhood.name, neighborhood.group)

                // A section header sits above the first row of each group — the
                // ones with a writeup, then the rest.
                const previous = listed[index - 1]
                const showHeader = index === 0 || written !== rendered.has(previous.slug)

                return (
                  <Fragment>
                    {showHeader && (
                      <li class="section-head">
                        <span class="section-label">{written ? 'Explored' : 'The rest'}</span>
                        <span class="section-count">{written ? writtenCount : restCount}</span>
                      </li>
                    )}
                    <li
                      id={neighborhood.slug}
                      data-section={neighborhood.slug}
                      class:list={[{ 'is-written': written }]}
                      data-area={popup.area}
                      data-wikipedia={popup.wikipedia}
                      data-niche={popup.niche}
                      data-official={popup.official}
                      data-excerpt={popup.excerpt}
                    >
                      <div class="neighborhood-head">
                        <div class="list-title">
                          <span class="number">{`${numberLabel}.`}</span>
                          <span>{neighborhood.name}</span>
                        </div>
                        {written && (
                          <a class="more" href={href(`/neighborhoods/${neighborhood.slug}`)}>
                            More <IconArrowRight />
                          </a>
                        )}
                      </div>
                      {written && Content && (
                        <div class="neighborhood-body list-description">
                          <div class="neighborhood-preview">
                            <Content />
                          </div>
                        </div>
                      )}
                    </li>
                  </Fragment>
                )
              })
          }
        </List>
      </article>
      <NeighborhoodMap />
    </div>
  </div>
</BaseLayout>

<style>
  /* Match the Food list's row titles (body serif), not the mono List default. */
  .neighborhood-head .list-title {
    font-family: var(--font-body);
  }

  .number {
    color: var(--color-accent);
  }

  /* Section header above each group (Explored / The rest): a quiet label with its
     count flush right — no rule line, to keep the list from feeling line-heavy. */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-md) var(--spacing-xs);
    border: 0;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-text-muted);
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .more {
    font-size: var(--font-size-sm);
  }

  .neighborhood-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  /* Cut the inline writeup off after a few lines — keeps its links + formatting
     (unlike a plain-text excerpt); the full text is on the "Read more" page. */
  .neighborhood-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }

  /* Compact color key for the map's region groups, sitting beside the title.
     Each dot pulls from the same --color-map-* token the polygons use. */
  .region-legend {
    display: flex;
    flex-wrap: wrap;
    align-self: center;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .region-legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 2px var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  .region-legend-item::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--legend-color);
    flex-shrink: 0;
  }

  .region-north {
    --legend-color: var(--color-map-north);
  }

  .region-central {
    --legend-color: var(--color-map-central);
  }

  .region-south {
    --legend-color: var(--color-map-south);
  }
</style>
