---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SUPABASE_ENABLED } from '../lib/site'

const description = 'Sign your name and leave a note.'

// Same gate as ReadersVerdict: the book only works when the site is built with
// Supabase creds. Without them the page points at Feedback instead of rendering
// a form that goes nowhere.
const guestbookEnabled = SUPABASE_ENABLED
---

<BaseLayout article crumb="Guestbook" description={description}>
  <article class="page">
    <header class="entry-header entry-header-with-flag reading-col">
      <div class="entry-bar">
        <h1>Guestbook</h1>
      </div>
      <p class="entry-summary">Passing through? Sign your name and leave a note.</p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>

    {
      guestbookEnabled ? (
        <div class="guestbook reading-col" data-guestbook>
          <section class="panel" aria-label="Sign the guestbook" data-sign-panel>
            <form class="form-stack" data-sign-form>
              <label class="field">
                <span>Name</span>
                <input type="text" data-sign-name maxlength="80" autocomplete="name" required />
              </label>
              <label class="field">
                <span>Message</span>
                <textarea
                  data-sign-message
                  rows="4"
                  maxlength="1000"
                  required
                />
              </label>
              {/* Honeypot - hidden from people, tempting to bots. Filled === silently dropped. */}
              <div class="hp" aria-hidden="true">
                <label>
                  Leave this field empty
                  <input type="text" data-sign-hp tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn-dark btn-compact" data-sign-submit>
                  Sign
                </button>
                <span class="form-status" data-sign-status role="status" aria-live="polite" />
              </div>
            </form>
            <p class="signed-note desc-muted" data-signed-note hidden>
              Thanks for signing!
            </p>
          </section>

          <section aria-label="Signatures">
            <div class="feed-head head-rule">
              <h2 class="head-black head-black--lg">Messages</h2>
              <span class="feed-count" data-count />
            </div>
            <ul class="feed" data-entries />
            <p class="feed-empty desc-muted" data-empty hidden>
              None yet
            </p>
            <p class="form-status" data-load-status role="status" aria-live="polite" />
            <button type="button" class="btn btn-outline btn-compact feed-older" data-older hidden>
              Show older entries
            </button>
          </section>
        </div>
      ) : (
        <p class="closed-note reading-col">Guestbook closed.</p>
      )
    }
  </article>
</BaseLayout>

<script>
  import { initGuestbook } from '../scripts/guestbook'
  initGuestbook()
</script>

<style>
  .guestbook {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    margin-block-start: var(--spacing-lg);
  }

  .signed-note {
    margin: 0;
    text-align: center;
  }

  .closed-note {
    margin-block-start: var(--spacing-lg);
  }
</style>
