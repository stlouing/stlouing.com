---
import PageMasthead from '../components/PageMasthead.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import CardList from '../components/CardList.astro'
import Card from '../components/Card.astro'
import Icon from '../components/Icon.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import { href } from '../lib/url'
---

<BaseLayout crumb="Not found" title="Page Not Found" noindex>
  <article>
    <PageMasthead title="Page Not Found" wide>
      <p slot="lede">That page doesn't exist (or it moved). Try these:</p>
    </PageMasthead>

    <CardList title="Maps">
      <Card href={href('/food/')} title="Food Map" meta="Map">
        <Icon name="utensils" slot="icon" />
      </Card>
      <Card href={href('/neighborhoods/')} title="Neighborhood Map" meta="Map">
        <IconMapPin slot="icon" />
      </Card>
    </CardList>

    <p class="home-link">
      <a href={href('/')}>Back home</a>
    </p>
  </article>

  <style>
    .home-link {
      margin-block-start: var(--spacing-xl);
    }
  </style>
</BaseLayout>
