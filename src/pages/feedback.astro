---
import BaseLayout from '../layouts/BaseLayout.astro'
import { FEEDBACK_ENDPOINT } from '../lib/site'

const description = 'Send a note, a correction, or a recommendation.'
---

<BaseLayout article crumb="Feedback" description={description}>
  <article class="page">
    <header class="entry-header entry-header-with-flag reading-col">
      <div class="entry-bar">
        <h1>Feedback</h1>
      </div>
      <p class="entry-summary">
        If you have a question, comment, or if I got something wrong, please reach out!
      </p>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>

    <div class="feedback-body reading-col">
      {
        FEEDBACK_ENDPOINT && (
          <section class="feedback-panel panel" aria-label="Feedback form">
            {/* <h2 class="feedback-title title-serif">Send feedback</h2> */}
            <form class="feedback-form" method="POST" action={FEEDBACK_ENDPOINT}>
              <label class="field">
                <span class="field-label">Your note</span>
                <textarea name="message" rows="6" required />
              </label>

              <label class="field">
                <span class="field-label">
                  Name <span class="optional">(optional)</span>
                </span>
                <input type="text" name="name" autocomplete="name" />
              </label>

              <label class="field">
                <span class="field-label">
                  Email <span class="optional">(optional)</span>
                </span>
                <input type="email" name="email" autocomplete="email" />
              </label>

              <input type="hidden" name="_subject" value="St. Louing feedback" />

              <p class="gotcha" aria-hidden="true">
                <label>
                  Leave this field empty
                  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
                </label>
              </p>

              <div class="form-actions">
                <button type="submit" class="btn btn-dark btn-compact">
                  Send
                </button>
                <span class="form-status" data-form-status role="status" aria-live="polite" />
              </div>
            </form>
          </section>
        )
      }

      <p class="feedback-alt">
        Prefer email? <a href="mailto:hello+feedback@stlouing.com">hello@stlouing.com</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .feedback-panel {
    margin-block-start: var(--spacing-lg);
  }

  /* For the (currently commented-out) panel title, matching .gb-form-title. */
  .feedback-title {
    margin: 0 0 var(--spacing-md);
    text-align: center;
    line-height: 1.1;
    font-size: var(--font-size-xl);
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .field-label {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
    color: var(--color-muted-2);
  }

  .optional {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    font-family: var(--font-serif);
    text-transform: none;
  }

  textarea[name='message'] {
    padding: var(--spacing-sm);
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-line-input);
    border-radius: var(--radius);
    font-family: var(--font-serif);
    font-size: var(--font-size-md);
    line-height: 1.45;
    resize: vertical;
  }

  textarea[name='message']:focus {
    outline: none;
    border: 1px solid var(--color-accent-blue);
    box-shadow: 0 0 0 1px var(--color-accent-blue);
  }

  input[name='email'],
  input[name='name'] {
    max-width: 22rem;
  }

  /* Honeypot: off-screen for humans, bots see it. */
  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .form-status,
  .feedback-alt {
    color: var(--color-muted);
  }

  .feedback-alt {
    margin-block-start: var(--spacing-lg);
  }
</style>

<script>
  // Progressive enhancement: without JS the form does a native POST (Formspree
  // shows its own confirmation). With JS we POST in the background and swap in an
  // inline "thanks" so the visitor never leaves the page.
  const form = document.querySelector<HTMLFormElement>('.feedback-form')
  const status = form?.querySelector<HTMLElement>('[data-form-status]')

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      status.textContent = 'Sending...'

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })

        if (response.ok) {
          form.reset()
          status.textContent = 'Thanks!'
        } else {
          status.textContent = 'Something went wrong. Please try email below.'
        }
      } catch {
        status.textContent = 'Something went wrong. Please try email below.'
      }
    })
  }
</script>
