---
// The shared shell for a filterable list/map directory page (Food, Hikes): the
// `[data-filter-root]` container, the sticky filter toolbar (view toggle +
// filters/sort), the results region with the map and empty state, and the
// progressive-enhancement script. The list itself is passed as the default slot.
import FilterBar from './FilterBar.astro'
import ViewToggle from './ViewToggle.astro'
import ClearFilters from './ClearFilters.astro'

interface Facet {
  label: string
  facet: string
  options: string[]
}

interface SortOption {
  label: string
  value: string
}

interface Props {
  label: string
  count: number
  searchPlaceholder?: string
  facets: Facet[]
  sorts?: SortOption[]
  hasCoords: boolean
  mapLabel: string
  emptyText: string
  class?: string
}

const {
  label,
  count,
  searchPlaceholder,
  facets,
  sorts,
  hasCoords,
  mapLabel,
  emptyText,
  class: className,
} = Astro.props
---

<div class={className} data-filter-root data-view="list">
  {/* Pre-paint: set the saved/default view before this subtree paints, so the
      page doesn't flash the list then snap into the map app-shell. Mirrors the
      theme pre-paint script in BaseLayout. The storage key + default are
      duplicated as literals because an inline script can't import views.ts. */}
  <script is:inline>
    {
      const filterRoot = document.currentScript.parentElement
      const savedView = localStorage.getItem('list-map-view')
      filterRoot.dataset.view = savedView === 'list' || savedView === 'map' ? savedView : 'map'
    }
  </script>
  <header class="secondary-header">
    <div class="wrap">
      {hasCoords && <ViewToggle />}
      <FilterBar
        label={label}
        count={count}
        searchPlaceholder={searchPlaceholder}
        facets={facets}
        sorts={sorts}
      />
    </div>
    {/* Applied-filter tray: chips for each active facet (filter.ts builds them)
        plus the clear-all control. Hidden until a filter is active. */}
    <div class="wrap active-filters" data-filter-active hidden>
      <span class="active-label">Filters</span>
      <div class="filter-chips" data-filter-chips></div>
      <ClearFilters />
    </div>
  </header>

  <div class="results">
    <slot />
    {hasCoords && <div class="map" data-map aria-label={mapLabel} />}
    <p class="empty" data-filter-empty hidden>{emptyText}</p>
  </div>
</div>

<script>
  import { initFilterableMapPage } from '../scripts/views'
  initFilterableMapPage()
</script>
