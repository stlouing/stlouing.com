---
// The shared shell for a filterable list/map directory page (Food, Hikes): the
// `[data-filter-root]` container, the sticky filter toolbar (filters/sort), the
// results region with the map and empty state, and the progressive-enhancement
// script. The list itself is passed as the default slot.
//
// Two view modes:
// - default ("toggle"): a top List/Map ViewToggle, one pane at a time (Hikes).
// - `floating`: no top toggle; desktop always shows both panes, mobile opens on
//   the list and flips to the map via a floating bottom button (Food, matching
//   the Neighborhoods page).
import FilterBar from './FilterBar.astro'
import ViewToggle from './ViewToggle.astro'
import ClearFilters from './ClearFilters.astro'

interface Facet {
  label: string
  facet: string
  options: (string | { value: string; label: string })[]
}

interface SortOption {
  label: string
  value: string
}

interface Props {
  label: string
  count: number
  searchPlaceholder?: string
  facets: Facet[]
  sorts?: SortOption[]
  hasCoords: boolean
  mapLabel: string
  emptyText: string
  class?: string
  floating?: boolean
  // Opt into marker clustering on the map (Food only) — emits data-map-cluster,
  // which map.ts reads to gate its clustering codepath.
  cluster?: boolean
  // Forwarded to FilterBar: render its search field (off when the page hosts
  // its own [data-filter-search] input, e.g. the food pane header).
  search?: boolean
}

const {
  label,
  count,
  searchPlaceholder,
  search,
  facets,
  sorts,
  hasCoords,
  mapLabel,
  emptyText,
  class: className,
  floating = false,
  cluster = false,
} = Astro.props
---

<div
  class={className}
  data-filter-root
  data-view="list"
  data-view-mode={floating ? 'floating' : 'toggle'}
>
  {
    /* Pre-paint: set the starting view before this subtree paints, so the page
      doesn't flash one layout then snap into another. Mirrors the theme pre-paint
      script in BaseLayout. */
  }
  {
    floating ? (
      <script is:inline>
        {
          const filterRoot = document.currentScript.parentElement
          // Floating mode: open on the list on mobile (readable rows first, and
          // the map isn't built until the user asks for it); desktop always shows
          // both panes, which is the 'map' state.
          filterRoot.dataset.view = window.matchMedia('(max-width: 700px)').matches
            ? 'list'
            : 'map'
        }
      </script>
    ) : (
      <script is:inline>
        {
          const filterRoot = document.currentScript.parentElement
          const savedView = localStorage.getItem('list-map-view')
          // No saved preference: default to the list on mobile (so the page opens
          // on readable rows, not a full-bleed map a one-finger swipe can't scroll
          // past) and to the map on wider screens.
          const defaultView = window.matchMedia('(max-width: 700px)').matches ? 'list' : 'map'
          filterRoot.dataset.view =
            savedView === 'list' || savedView === 'map' ? savedView : defaultView
        }
      </script>
    )
  }
  <header class="secondary-header">
    <div class="wrap">
      {hasCoords && !floating && <ViewToggle />}
      <FilterBar
        label={label}
        count={count}
        searchPlaceholder={searchPlaceholder}
        facets={facets}
        sorts={sorts}
        search={search}
      />
    </div>
    {
      /* Applied-filter tray: chips for each active facet (filter.ts builds them)
        plus the clear-all control. Hidden until a filter is active. */
    }
    <div class="wrap active-filters" data-filter-active hidden>
      <div class="filter-chips" data-filter-chips></div>
      <ClearFilters />
    </div>
  </header>

  <div class="results">
    <slot />
    {
      hasCoords && (
        <div class="map" data-map data-map-cluster={cluster ? '' : undefined} aria-label={mapLabel} />
      )
    }
    {
      hasCoords && floating && (
        <button type="button" class="map-split-toggle btn-dark" data-map-split-toggle>
          View map
        </button>
      )
    }
    <p class="empty" data-filter-empty hidden>
      {emptyText}
      <ClearFilters />
    </p>
  </div>
</div>

<script>
  import { initFilterableMapPage } from '../scripts/views'
  initFilterableMapPage()
</script>
