---
import FilterBar from './FilterBar.astro'
import ViewToggle from './ViewToggle.astro'
import ClearFilters from './ClearFilters.astro'

interface Facet {
  label: string
  facet: string
  options: (string | { value: string; label: string })[]
}

interface SortOption {
  label: string
  value: string
}

interface Props {
  label: string
  count: number
  searchPlaceholder?: string
  facets: Facet[]
  sorts?: SortOption[]
  hasCoords: boolean
  mapLabel: string
  emptyText: string
  class?: string
  floating?: boolean
  cluster?: boolean
  search?: boolean
}

const {
  label,
  count,
  searchPlaceholder,
  search,
  facets,
  sorts,
  hasCoords,
  mapLabel,
  emptyText,
  class: className,
  floating = false,
  cluster = false,
} = Astro.props
---

<div
  class={className}
  data-filter-root
  data-view="list"
  data-view-mode={floating ? 'floating' : 'toggle'}
>
  {
    floating ? (
      <script is:inline>
        {
          const filterRoot = document.currentScript.parentElement
          filterRoot.dataset.view = window.matchMedia('(max-width: 700px)').matches
            ? 'list'
            : 'map'
        }
      </script>
    ) : (
      <script is:inline>
        {
          const filterRoot = document.currentScript.parentElement
          const savedView = localStorage.getItem('list-map-view')
          const defaultView = window.matchMedia('(max-width: 700px)').matches ? 'list' : 'map'
          filterRoot.dataset.view =
            savedView === 'list' || savedView === 'map' ? savedView : defaultView
        }
      </script>
    )
  }
  <header class="secondary-header">
    <div class="wrap">
      {hasCoords && !floating && <ViewToggle />}
      <FilterBar
        label={label}
        count={count}
        searchPlaceholder={searchPlaceholder}
        facets={facets}
        sorts={sorts}
        search={search}
      />
    </div>
    <div class="wrap active-filters" data-filter-active hidden>
      <div class="filter-chips" data-filter-chips></div>
      <ClearFilters />
    </div>
  </header>

  <div class="results">
    <slot />
    {
      hasCoords && (
        <div class="map" data-map data-map-cluster={cluster ? '' : undefined} aria-label={mapLabel} />
      )
    }
    {
      hasCoords && floating && (
        <button type="button" class="map-split-toggle btn-dark" data-map-split-toggle>
          View map
        </button>
      )
    }
    <p class="empty" data-filter-empty hidden>
      {emptyText}
      <ClearFilters />
    </p>
  </div>
</div>

<script>
  import { initFilterableMapPage } from '../scripts/views'
  initFilterableMapPage()
</script>
