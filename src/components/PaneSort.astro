---
interface SortOption {
  label: string
  narrowLabel?: string
  value: string
}

interface Props {
  options: SortOption[]
}

const { options } = Astro.props
---

<select class="pane-sort" data-filter-sort aria-label="Sort">
  {
    options.map((option) => (
      <option value={option.value} data-narrow-label={option.narrowLabel}>
        {option.label}
      </option>
    ))
  }
</select>

<style>
  .pane-sort {
    flex-shrink: 0;
  }
</style>
