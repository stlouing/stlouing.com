---
import Icon from './Icon.astro'

interface Props {
  label: string
  placeholder: string
  narrowPlaceholder?: string
}

const { label, placeholder, narrowPlaceholder } = Astro.props
---

<label class="pane-search-wrap">
  <Icon name="search" />
  <input
    class="pane-search"
    type="search"
    placeholder={placeholder}
    data-narrow-placeholder={narrowPlaceholder}
    autocomplete="off"
    aria-label={label}
    data-filter-search
  />
</label>

<style>
  .pane-search-wrap {
    position: relative;
    display: flex;
    flex: 1;
    margin-inline-start: var(--spacing-lg);
  }

  .pane-search-wrap :global(.icon) {
    position: absolute;
    inset-inline-start: var(--spacing-sm);
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    pointer-events: none;
  }

  .pane-search {
    width: 100%;
    padding-inline-start: calc(var(--spacing-sm) + 16px + var(--spacing-sm));
  }
</style>
