---
interface Props {
  coords?: [number, number]
  label?: string
}

const { coords, label } = Astro.props
const description = label ? `Map showing this spot in ${label}` : 'Map showing this spot'
---

{
  coords && (
    <div class="locator">
      <div
        class="locator-map"
        data-locator
        data-coords={coords.join(',')}
        role="img"
        aria-label={description}
      />
      <span class="locator-tag">{label ?? 'Map'}</span>
    </div>
  )
}

<style>
  .locator {
    position: relative;
  }

  .locator-map {
    position: relative;
    height: 220px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 11px,
        color-mix(in srgb, var(--color-line-input) 28%, transparent) 11px 12px
      ),
      var(--color-background);
    overflow: hidden;
  }

  .locator-tag {
    position: absolute;
    z-index: 500;
    left: var(--spacing-sm);
    top: var(--spacing-sm);
    padding: 2px var(--spacing-sm);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-background);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-text);
    pointer-events: none;
  }
</style>

<script>
  const boxes = [...document.querySelectorAll<HTMLElement>('[data-locator]')]

  if (boxes.length) {
    const upgrade = (box: HTMLElement) => {
      import('../scripts/locator').then(({ initLocator }) => initLocator(box))
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target)
              upgrade(entry.target as HTMLElement)
            }
          }
        },
        { rootMargin: '200px' },
      )
      for (const box of boxes) {
        observer.observe(box)
      }
    } else {
      for (const box of boxes) {
        upgrade(box)
      }
    }
  }
</script>
