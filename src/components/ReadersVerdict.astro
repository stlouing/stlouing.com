---
// The readers' 👍/👎 poll for a food page (shown only when Supabase is
// configured), rendered as one cell of the header stats bar: the vote pill
// over a "Your rating" label, beside the My rating and Comments cells.
// src/scripts/readers-verdict.ts loads live counts and records votes. Public
// discussion lives in the separate Comments section (comments.ts).
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class="verdict-bar"
      data-readers-verdict
      data-slug={slug}
      aria-label={`Rate ${title}`}>
      <span class="pane-stat-label">Your rating</span>
      <div class="rv-pill">
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact"
          data-vote="like"
          aria-pressed="false"
          aria-label="I liked it"
          disabled>
          <IconThumbsUp />
          Liked
          <span class="rv-count" data-count-like />
        </button>
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact"
          data-vote="dislike"
          aria-pressed="false"
          aria-label="Not for me"
          disabled>
          <IconThumbsDown />
          Not for me
          <span class="rv-count" data-count-dislike />
        </button>
      </div>
      <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />
    </section>
  )
}

<style>
  /* A stats-bar cell: the vote pill over its label (mirrors .pane-stat). */
  .verdict-bar {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  /* One split control, not two separate buttons: the halves share a middle
     border (the left button owns it, so hover/active states color it). */
  .rv-pill {
    display: inline-flex;
    gap: 0;
    /* Pinned to the cell floor like the sibling cells' values. */
    margin-block-start: auto;
  }

  .rv-pill .rv-choice + .rv-choice {
    border-inline-start: 0;
  }

  .rv-choice {
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: 1.3;

    &:disabled {
      cursor: default;
    }
  }

  .rv-choice :global(.icon) {
    color: var(--color-muted);
    width: 16px;
    height: 16px;
  }

  .rv-choice.is-active :global(.icon) {
    color: inherit;
  }

  .rv-count {
    font-variant-numeric: tabular-nums;

    &:empty {
      display: none;
    }
  }

  .rv-vote-status {
    margin: var(--spacing-xs) 0 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }
</style>
