---
// The combined review bar for a food page: the writer's verdict (fleur rating +
// statement, always shown) and the readers' 👍/👎 poll (shown only when Supabase is
// configured) sit side by side in one bar at the top of the page. A vote reveals an
// optional (private) note below it. src/scripts/readers-verdict.ts loads live counts,
// records votes, and reveals the note.
//
// Type system follows the rest of the app: mono uppercase for labels/meta, Georgia +
// the display serif for the verdict value. Icons, never emoji — the "Liked it" side
// carries the app's heart; the tally rides muted to the right.
//
// The bar wears the shared Win98 dialog chrome (.win98-* in global.css): title bar,
// beveled vote/submit buttons, sunken inputs. The chrome re-themes itself for dark
// mode; the interior styles only through the --win98-* tokens and goes monochrome
// (see the .verdict-bar comment below).
import Rating from './Rating.astro'
import { href } from '../lib/url'
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import IconThumbsDown from '../assets/IconThumbsDown.astro'
import IconPencil from '../assets/IconPencil.astro'
import IconX from '../assets/IconX.astro'
import { type WriterState } from '../lib/verdict'

interface Props {
  slug: string
  title: string
  // The writer's stance for the "My Review" slot — a rated verdict, or an
  // unrated placeholder ("Haven't visited yet" / "Haven't reviewed yet").
  // Resolved by resolveWriterState so a stub place still shows a line.
  writerState?: WriterState
}

const { slug, title, writerState } = Astro.props

const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)
---

{
  (writerState || readersEnabled) && (
    <section
      class="verdict-bar win98-window"
      data-readers-verdict={readersEnabled ? '' : undefined}
      data-slug={slug}
      aria-label={`Review of ${title}`}>
      <div class="win98-titlebar">
        <span class="win98-caption">
          <img class="win98-titlebar-icon" src={href('/stlflag.png')} alt="" width="16" height="16" />
          {readersEnabled ? 'Rate this restaurant' : 'Ratings'}
        </span>
      </div>
      <div class="vb-row">
        {writerState && (
          <div
            class:list={[
              'vb-mine',
              writerState.verdict ? `verdict-${writerState.verdict}` : 'vb-mine-muted',
            ]}>
            <span class="vb-label">My Rating</span>
            <div class="vb-mine-row">
              <span class="vb-mine-value">{writerState.statement}</span>
              <Rating verdict={writerState.verdict} />
            </div>
          </div>
        )}

        {readersEnabled && (
          <div class="vb-take">
            <span class="vb-label">Readers' Rating</span>
            {/* Pre-vote nudge; hidden once this browser has voted (text set by the script). */}
            <p class="rv-cta" data-cta>
              Been here? What did you think?
            </p>
            <div class="rv-pill">
              <button
                type="button"
                class="rv-choice win98-button"
                data-vote="like"
                aria-pressed="false"
                aria-label="I liked it"
                disabled>
                <IconThumbsUp />
                Liked
                <span class="rv-count" data-count-like />
              </button>
              <button
                type="button"
                class="rv-choice win98-button"
                data-vote="dislike"
                aria-pressed="false"
                aria-label="Not for me"
                disabled>
                <IconThumbsDown />
                Not for me
                <span class="rv-count" data-count-dislike />
              </button>
            </div>
          </div>
        )}
      </div>

      {readersEnabled && (
        <>
          <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />

          <div class="rv-note" data-note hidden>
            {/* Collapsed state: a quiet trigger that reopens the form. The reader's
                collapse choice is remembered in localStorage (see readers-verdict.ts). */}
            <button type="button" class="rv-note-trigger" data-note-trigger hidden>
              <IconPencil />
              Leave a comment
            </button>
            <form class="rv-note-form" data-note-form>
              <div class="rv-note-head">
                <span class="rv-note-trigger">Leave a comment</span>
                <button
                  type="button"
                  class="rv-note-close"
                  data-note-close
                  aria-label="Collapse the comment form">
                  <IconX />
                </button>
              </div>
              <label class="rv-field">
                <span class="rv-field-label">
                  Name <span class="rv-field-note">(optional)</span>
                </span>
                <input
                  class="rv-input win98-field"
                  type="text"
                  data-note-name
                  maxlength="80"
                  autocomplete="name"
                />
              </label>
              <label class="rv-field">
                <span class="rv-field-label">Note</span>
                <textarea
                  class="rv-input rv-note-textarea win98-field"
                  data-note-comment
                  rows="3"
                  maxlength="2000"
                  placeholder="What did you order? How was it?"
                />
              </label>
              {/* Honeypot — hidden from people, tempting to bots. Filled == silently dropped. */}
              <div class="rv-hp" aria-hidden="true">
                <label>
                  Website
                  <input type="text" data-note-hp tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button type="submit" class="rv-note-submit win98-button">
                Submit
              </button>
            </form>
            <p class="rv-note-status" data-note-status role="status" aria-live="polite" />
          </div>
        </>
      )}
    </section>
  )
}

<style>
  /* One Win98 window at the top of the writeup: title bar, then My Rating on
     the left and the Readers' Rating poll beside it on the gray face, the note
     form below. The chrome comes from .win98-window. The site's colored inks
     (verdict colors, fleur gold, accent ledes) read low-contrast on the gray
     face, so the interior goes monochrome — statement and fleurs in the
     window's text ink, muted secondary text — with the window accent kept
     only for small touches (thumbs, statuses). The Rating fleurs fill with
     --color-map-north via currentColor; remapping it here recolors them. */
  .verdict-bar {
    --color-map-north: var(--win98-text);

    margin-block-end: var(--spacing-lg);
  }

  .vb-row {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-lg);
    padding: var(--spacing-md);
  }

  /* The two mono uppercase eyebrows ("My Review" / "Your Take") ride muted, not
     the accent that .section-label uses. */
  .vb-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    color: var(--win98-text);
    white-space: nowrap;
  }

  /* --- My Review (fleur rating + colored verdict value) --- the eyebrow rides on
     top, the fleur + statement on the row below it. */
  .vb-mine {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
  }

  .vb-mine-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  /* The statement rides plain black on the gray face (the verdict still shows
     in the fleur count beside it). */
  .vb-mine-value {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 400;
    line-height: 1;
    color: var(--win98-text);
  }

  /* Unrated place: a quiet, verdict-less line ("Haven't visited yet"). */
  .vb-mine-muted .vb-mine-value {
    color: var(--win98-muted);
  }

  /* --- Readers' Rating (poll) --- an eyebrow over the two thumb buttons, mirroring
     the My Rating column and divided from it by a hairline. */
  .vb-take {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
    /* An etched groove divider: shadow line with the highlight just inside it. */
    border-inline-start: 1px solid var(--win98-shadow);
    box-shadow: inset 1px 0 0 var(--win98-highlight);
    padding-inline-start: var(--spacing-lg);
  }

  /* Pre-vote nudge over the pill: a quiet italic serif line. */
  .rv-cta {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--win98-muted);
  }

  .rv-cta[hidden] {
    display: none;
  }

  /* The 👍 / 👎 poll as two Win98 push buttons; the voted side holds the
     pressed-in state (.is-active, handled by .win98-button). */
  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
  }

  /* Roomier than the stock .win98-button, but the bevels come from it. */
  .rv-choice {
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: 1.3;

    &:disabled {
      cursor: default;
    }
  }

  /* The thumbs ride in the pinned accent (override the global muted .icon). */
  .rv-choice :global(.icon) {
    color: var(--win98-accent-2);
    width: 16px;
    height: 16px;
  }

  /* The live count after the thumb — hidden when zero (the script leaves it empty). */
  .rv-count {
    font-variant-numeric: tabular-nums;

    &:empty {
      display: none;
    }
  }

  /* Shown only if a vote fails to record (then the buttons re-enable for a retry). */
  .rv-vote-status {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--win98-accent);

    &:empty {
      display: none;
    }
  }

  /* Optional note, revealed after a vote: stacked Name + Note fields, spanning
     the full width, split from the rating row above by an etched groove. */
  .rv-note {
    padding: var(--spacing-md);
    border-block-start: 1px solid var(--win98-shadow);
    box-shadow: inset 0 1px 0 var(--win98-highlight);
  }

  .rv-note-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  /* The [hidden] attribute (set after a note is saved, or when collapsed) must win
     over display:flex. */
  .rv-note-form[hidden] {
    display: none;
  }

  /* The form's header row: a label paired with the collapse (×) control. */
  .rv-note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    width: 100%;
  }

  /* The small × that collapses the form back down to the "Leave a comment" trigger. */
  .rv-note-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xs);
    margin: calc(-1 * var(--spacing-xs));
    border: 0;
    background: none;
    color: var(--win98-muted);
    cursor: pointer;

    &:hover {
      color: var(--win98-accent);
    }

    :global(.icon) {
      width: 16px;
      height: 16px;
    }
  }

  /* Collapsed state: a quiet mono link-button (pencil + "Leave a comment") standing
     in for the whole form. Reopens it on click. */
  .rv-note-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0;
    border: 0;
    background: none;
    color: var(--win98-muted);
    /* font-family: var(--font-mono); */
    font-size: var(--font-size-md);
    font-weight: 500;

    &[hidden] {
      display: none;
    }

    :global(.icon) {
      width: 15px;
      height: 15px;
      color: inherit;
    }
  }

  button.rv-note-trigger {
    cursor: pointer;

    &:hover {
      color: var(--win98-accent);
    }
  }

  /* A labeled field: the mono eyebrow over its input, each spanning the row. */
  .rv-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
    min-width: 0;
  }

  .rv-field-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--win98-text);
    line-height: 1.5;
  }

  .rv-field-note {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--win98-muted);
  }

  /* Sunken .win98-field wells; the bevel replaces the input border, so focus
     moves to an outline (the bevel lives in box-shadow and must survive). */
  .rv-input {
    padding: var(--spacing-sm);
    border: 0;
    border-radius: var(--radius);
    color: var(--win98-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 400;
    min-width: 0;

    &:focus {
      outline: 2px solid var(--win98-accent);
      outline-offset: 1px;
    }
  }

  .rv-note-textarea {
    resize: vertical;
    line-height: 1.4;
  }

  /* Off-screen honeypot — present for bots, invisible and unfocusable for people. */
  .rv-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* The Submit action: a stock Win98 push button at dialog-button size. */
  .rv-note-submit {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  /* An inline error ("Couldn't save that") under the row; hidden while empty. */
  .rv-note-status {
    margin: var(--spacing-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--win98-accent);

    &:empty {
      display: none;
    }
  }

  /* Stack the bar's segments on a narrow screen. The vertical divider between them
     becomes a horizontal rule above the readers' section, so My Rating and Readers'
     Rating stay clearly separated. */
  @media (max-width: 700px) {
    .vb-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .vb-take {
      margin-block-start: var(--spacing-sm);
      padding-block-start: var(--spacing-sm);
      /* The groove divider rotates horizontal when the columns stack. */
      border-block-start: 1px solid var(--win98-shadow);
      box-shadow: inset 0 1px 0 var(--win98-highlight);
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }
</style>
