---
// The readers' 👍/👎 poll for a food page (shown only when Supabase is
// configured), rendered as one cell of the header stats bar: the vote pill
// over a "Your rating" label, beside the My rating and Comments cells.
// src/scripts/readers-verdict.ts loads live counts and records votes. Public
// discussion lives in the separate Comments section (comments.ts).
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class="verdict-bar"
      data-readers-verdict
      data-slug={slug}
      aria-label={`Rate ${title}`}>
      <span class="pane-stat-label">Your rating</span>
      <div class="rv-pill">
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact"
          data-vote="like"
          aria-pressed="false"
          aria-label="I liked it"
          disabled>
          <IconThumbsUp />
          Liked
          <span class="rv-count" data-count-like />
        </button>
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact"
          data-vote="dislike"
          aria-pressed="false"
          aria-label="Not for me"
          disabled>
          <IconThumbsDown />
          Not for me
          <span class="rv-count" data-count-dislike />
        </button>
      </div>
      <p class="rv-vote-status form-status" data-vote-status role="status" aria-live="polite" />
    </section>
  )
}

<style>
  /* A stats-bar cell: the vote pill over its label (mirrors .pane-stat). */
  .verdict-bar {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
    /* Pinned to the cell floor like the sibling cells' values. */
    margin-block-start: auto;
  }

  /* Two separate rounded pills on the page background, a wash tint on hover;
     the voted one flips to the solid-ink btn-dark colors via the global
     .is-active twin. */
  .rv-choice {
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: 1.3;
    border-radius: 999px;

    &:disabled {
      cursor: default;
    }
  }

  /* Base colors stay off the voted half — these scoped rules land after the
     global .rv-choice.is-active twin in the bundle and would win the
     specificity tie, washing out the solid-ink selected state. */
  .rv-choice:not(.is-active) {
    background: var(--color-background);
    border-color: var(--color-line-input);
  }

  .rv-choice:not(:disabled, .is-active):hover {
    background: var(--color-wash);
  }

  .rv-choice :global(.icon) {
    color: var(--color-muted);
    width: 16px;
    height: 16px;
  }

  .rv-choice.is-active :global(.icon) {
    color: inherit;
  }

  .rv-count {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);

    &:empty {
      display: none;
    }
  }

  .rv-choice.is-active .rv-count {
    color: inherit;
  }

  /* The shared .form-status voice, with room above the pills. */
  .rv-vote-status {
    margin-block-start: var(--spacing-xs);
  }
</style>
