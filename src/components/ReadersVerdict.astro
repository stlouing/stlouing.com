---
// The readers' 👍/👎 poll for a food page (shown only when Supabase is
// configured). A vote reveals an optional (private) note below it.
// src/scripts/readers-verdict.ts loads live counts, records votes, and
// reveals the note.
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import IconThumbsDown from '../assets/IconThumbsDown.astro'
import IconPencil from '../assets/IconPencil.astro'
import IconX from '../assets/IconX.astro'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)
---

{
  readersEnabled && (
    <section
      class="verdict-bar panel"
      data-readers-verdict
      data-slug={slug}
      aria-label={`Review of ${title}`}>
      <h2 class="vb-title title-serif">Rate this restaurant</h2>
      <div class="vb-row">
        {readersEnabled && (
          <div class="vb-take">
            <p class="rv-cta" data-cta>
              Been here? What did you think?
            </p>
            <div class="rv-pill">
              <button
                type="button"
                class="rv-choice btn btn-outline btn-compact"
                data-vote="like"
                aria-pressed="false"
                aria-label="I liked it"
                disabled>
                <IconThumbsUp />
                Liked
                <span class="rv-count" data-count-like />
              </button>
              <button
                type="button"
                class="rv-choice btn btn-outline btn-compact"
                data-vote="dislike"
                aria-pressed="false"
                aria-label="Not for me"
                disabled>
                <IconThumbsDown />
                Not for me
                <span class="rv-count" data-count-dislike />
              </button>
            </div>
          </div>
        )}
      </div>

      {readersEnabled && (
        <>
          <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />

          <div class="rv-note" data-note hidden>
            <button type="button" class="rv-note-trigger" data-note-trigger hidden>
              <IconPencil />
              Leave a comment
            </button>
            <form class="rv-note-form" data-note-form>
              <div class="rv-note-head">
                <span class="rv-note-trigger">Leave a comment</span>
                <button
                  type="button"
                  class="rv-note-close"
                  data-note-close
                  aria-label="Collapse the comment form">
                  <IconX />
                </button>
              </div>
              <label class="rv-field">
                <span class="rv-field-label">
                  Name <span class="rv-field-note">(optional)</span>
                </span>
                <input
                  class="rv-input"
                  type="text"
                  data-note-name
                  maxlength="80"
                  autocomplete="name"
                />
              </label>
              <label class="rv-field">
                <span class="rv-field-label">Note</span>
                <textarea
                  class="rv-input rv-note-textarea"
                  data-note-comment
                  rows="3"
                  maxlength="2000"
                  placeholder="What did you order? How was it?"
                />
              </label>
              {/* Honeypot - hidden from people, tempting to bots. Filled === silently dropped. */}
              <div class="rv-hp" aria-hidden="true">
                <label>
                  Website
                  <input type="text" data-note-hp tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button type="submit" class="rv-note-submit btn btn-dark btn-compact">
                Submit
              </button>
            </form>
            <p class="rv-note-status" data-note-status role="status" aria-live="polite" />
          </div>
        </>
      )}
    </section>
  )
}

<style>
  .verdict-bar {
    margin-block-end: var(--spacing-lg);
  }

  .vb-title {
    margin: 0 0 var(--spacing-md);
    text-align: center;
    line-height: 1.1;
    font-size: var(--font-size-xl);
  }

  .vb-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-lg);
  }

  .vb-take {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .rv-cta {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--color-muted);
  }

  .rv-cta[hidden] {
    display: none;
  }

  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
  }

  .rv-choice {
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: 1.3;

    &:disabled {
      cursor: default;
    }
  }

  .rv-choice :global(.icon) {
    color: var(--color-muted);
    width: 16px;
    height: 16px;
  }

  .rv-choice.is-active :global(.icon) {
    color: inherit;
  }

  .rv-count {
    font-variant-numeric: tabular-nums;

    &:empty {
      display: none;
    }
  }

  .rv-vote-status {
    margin: var(--spacing-sm) 0 0;
    padding: 0;
    text-align: center;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

  .rv-note {
    margin-block-start: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);
  }

  .rv-note-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .rv-note-form[hidden] {
    display: none;
  }

  .rv-note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    width: 100%;
  }

  .rv-note-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xs);
    margin: calc(-1 * var(--spacing-xs));
    border: 0;
    background: none;
    color: var(--color-muted);
    cursor: pointer;

    &:hover {
      color: var(--color-text-heading);
    }

    :global(.icon) {
      width: 16px;
      height: 16px;
    }
  }

  .rv-note-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-size: var(--font-size-md);
    font-weight: 500;

    &[hidden] {
      display: none;
    }

    :global(.icon) {
      width: 15px;
      height: 15px;
      color: inherit;
    }
  }

  button.rv-note-trigger {
    cursor: pointer;

    &:hover {
      color: var(--color-text-heading);
    }
  }

  .rv-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
    min-width: 0;
  }

  .rv-field-label {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-text);
    line-height: 1.5;
  }

  .rv-field-note {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .rv-input {
    padding: var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: var(--radius);
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
    font-weight: 400;
    min-width: 0;

    &:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 1px var(--color-accent);
    }
  }

  .rv-note-textarea {
    resize: vertical;
    line-height: 1.4;
  }

  /* Off-screen honeypot */
  .rv-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .rv-note-submit {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  .rv-note-status {
    margin: var(--spacing-sm) 0 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

</style>
