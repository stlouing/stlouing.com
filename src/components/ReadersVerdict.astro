---
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class="verdict-bar pane-stat"
      data-readers-verdict
      data-slug={slug}
      aria-label={`Rate ${title}`}>
      <span class="pane-stat-label eyebrow eyebrow--muted">Your rating</span>
      <div class="rv-pill">
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="like"
          aria-pressed="false"
          aria-label="I liked it"
          disabled>
          <IconThumbsUp />
          Liked
          <span class="rv-count" data-count-like />
        </button>
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="dislike"
          aria-pressed="false"
          aria-label="Not for me"
          disabled>
          <IconThumbsDown />
          Not for me
          <span class="rv-count" data-count-dislike />
        </button>
      </div>
      <p class="rv-vote-status form-status" data-vote-status role="status" aria-live="polite" />
    </section>
  )
}

<style>
  .verdict-bar {
    margin: 0;
  }

  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
    margin-block-start: auto;
  }

  .rv-choice {
    font-size: var(--font-size-xs);
    line-height: 1.3;
    border-radius: var(--radius-pill);

    &:disabled {
      cursor: default;
    }
  }

  .rv-choice:not(.is-active) {
    background: var(--color-background);
  }

  .rv-choice:not(:disabled, .is-active):hover {
    background: var(--color-wash);
  }

  .rv-count {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);

    &:empty {
      display: none;
    }
  }

  .rv-choice.is-active .rv-count {
    color: inherit;
  }

  .rv-vote-status {
    margin-block-start: var(--spacing-xs);
  }
</style>
