---
// The readers' 👍/👎 poll for a food page (shown only when Supabase is
// configured). src/scripts/readers-verdict.ts loads live counts and records
// votes. Public discussion happens in the Comments section below the writeup.
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class="verdict-bar panel"
      data-readers-verdict
      data-slug={slug}
      aria-label={`Review of ${title}`}>
      <h2 class="vb-title title-serif">Rate this restaurant</h2>
      <div class="vb-row">
        {readersEnabled && (
          <div class="vb-take">
            <div class="rv-pill">
              <button
                type="button"
                class="rv-choice btn btn-outline btn-compact"
                data-vote="like"
                aria-pressed="false"
                aria-label="I liked it"
                disabled>
                <IconThumbsUp />
                Liked
                <span class="rv-count" data-count-like />
              </button>
              <button
                type="button"
                class="rv-choice btn btn-outline btn-compact"
                data-vote="dislike"
                aria-pressed="false"
                aria-label="Not for me"
                disabled>
                <IconThumbsDown />
                Not for me
                <span class="rv-count" data-count-dislike />
              </button>
            </div>
          </div>
        )}
      </div>

      {readersEnabled && (
        <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />
      )}
    </section>
  )
}

<style>
  .verdict-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--spacing-lg);
  }

  .vb-title {
    margin: 0;
    text-align: center;
    line-height: 1.1;
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .vb-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-lg);
  }

  .vb-take {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .rv-cta {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--color-muted);
  }

  .rv-cta[hidden] {
    display: none;
  }

  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
  }

  .rv-choice {
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
    line-height: 1.3;

    &:disabled {
      cursor: default;
    }
  }

  .rv-choice :global(.icon) {
    color: var(--color-muted);
    width: 16px;
    height: 16px;
  }

  .rv-choice.is-active :global(.icon) {
    color: inherit;
  }

  .rv-count {
    font-variant-numeric: tabular-nums;

    &:empty {
      display: none;
    }
  }

  .rv-vote-status {
    flex-basis: 100%;
    margin: var(--spacing-sm) 0 0;
    padding: 0;
    text-align: center;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .vb-title {
      margin-bottom: var(--spacing-xs);
    }

    .verdict-bar {
      justify-content: center;
    }
  }
</style>
