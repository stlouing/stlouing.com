---
// Verdict block for a food page: the writer's verdict (always shown) stacked over a
// readers' 👍/👎 poll (shown only when Supabase is configured). One bordered card,
// divided. src/scripts/readers-verdict.ts loads live counts, records votes, and reveals
// the optional (private) note.
//
// Type system follows the rest of the app: mono uppercase for labels/meta (the shared
// .section-label idiom), Georgia for the question + verdict value + inputs. Icons, never
// emoji — the writer disc reuses the app's per-verdict icon; the poll buttons use thumbs.
import IconHeart from '../assets/IconHeart.astro'
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import IconThumbsDown from '../assets/IconThumbsDown.astro'
import IconCircleMinus from '../assets/IconCircleMinus.astro'
import IconHeartOff from '../assets/IconHeartOff.astro'
import { verdictStatements, type Verdict } from '../lib/verdict'

interface Props {
  slug: string
  title: string
  verdict?: Verdict
}

const { slug, title, verdict } = Astro.props

// Same icon-per-verdict mapping the Verdict chip/card uses, so the writer's verdict
// reads consistently across the app.
const verdictIcons = {
  loved: IconHeart,
  liked: IconThumbsUp,
  neutral: IconCircleMinus,
  'not-for-me': IconHeartOff,
} satisfies Record<Verdict, unknown>

const WriterIcon = verdict ? verdictIcons[verdict] : null
const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)
const questionId = `rv-q-${slug}`
---

{
  (verdict || readersEnabled) && (
    <section
      id="readers-verdict"
      class="verdict-block"
      data-readers-verdict={readersEnabled ? '' : undefined}
      data-slug={slug}>
      {verdict && WriterIcon && (
        <div class:list={['vb-writer', `verdict-${verdict}`]}>
          <span class="vb-writer-disc">
            <WriterIcon />
          </span>
          <span class="vb-writer-text">
            <span class="vb-writer-label">My Review</span>
            <span class="vb-writer-value">{verdictStatements[verdict]}</span>
          </span>
        </div>
      )}

      {readersEnabled && (
        <div class="vb-readers">
          <p class="vb-readers-label section-label" data-summary>
            Readers' Review
          </p>
          <h2 class="vb-question" id={questionId}>
            Been to {title}?
          </h2>

          <div class="rv-buttons">
            <button type="button" class="rv-choice" data-vote="like" aria-pressed="false" disabled>
              <IconThumbsUp />
              <span class="rv-text">I liked it</span>
              <span class="rv-count" data-count-like />
            </button>
            <button
              type="button"
              class="rv-choice"
              data-vote="dislike"
              aria-pressed="false"
              disabled>
              <IconThumbsDown />
              <span class="rv-text">Not for me</span>
              <span class="rv-count" data-count-dislike />
            </button>
          </div>

          <div class="rv-bar" role="presentation">
            <span class="rv-bar-fill" data-bar-fill />
          </div>

          <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />

          <div class="rv-note" data-note hidden>
            <form class="rv-note-form" data-note-form>
              <label class="rv-field">
                <span class="rv-field-label">
                  Comment <span class="rv-field-note">(optional)</span>
                </span>
                <textarea
                  class="rv-input"
                  data-note-comment
                  rows="3"
                  maxlength="2000"
                  placeholder="What did you think?"
                />
              </label>
              <label class="rv-field">
                <span class="rv-field-label">Name</span>
                <input
                  class="rv-input"
                  type="text"
                  data-note-name
                  maxlength="80"
                  autocomplete="name"
                />
              </label>
              {/* Honeypot — hidden from people, tempting to bots. Filled == silently dropped. */}
              <div class="rv-hp" aria-hidden="true">
                <label>
                  Website
                  <input type="text" data-note-hp tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <div class="rv-note-actions">
                <button type="submit" class="rv-note-submit">
                  Submit
                </button>
                <span class="rv-note-status" data-note-status role="status" aria-live="polite" />
              </div>
            </form>
            <p class="rv-note-thanks" data-note-thanks role="status" hidden>
              Thanks! Your note is saved.
            </p>
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  /* One bordered card, set off from the writeup above, holding both verdicts split by
     a hairline. Square corners to match the rest of the app. */
  .verdict-block {
    margin-block-start: var(--spacing-lg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    /* Anchor target for the top-of-page teaser — clear the sticky header on jump. */
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--spacing-md));
  }

  /* --- Writer's verdict (top) --- disc icon + mono label + colored serif value.
     Per-verdict color drives the disc + value. */
  .vb-writer {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .verdict-block:has(.vb-readers) .vb-writer {
    border-block-end: 1px solid var(--color-line);
  }

  .vb-writer.verdict-loved {
    --vb-color: var(--color-verdict-loved);
  }
  .vb-writer.verdict-liked {
    --vb-color: var(--color-verdict-liked);
  }
  .vb-writer.verdict-neutral {
    --vb-color: var(--color-verdict-neutral);
  }
  .vb-writer.verdict-not-for-me {
    --vb-color: var(--color-verdict-notforme);
  }

  /* Solid disc; the glyph reads in the surface color for contrast (overrides the
     global .icon muted rule via :global — the icon comes from a child component). */
  .vb-writer-disc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--vb-color);
  }

  .vb-writer-disc :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--color-surface);
  }

  .vb-writer-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vb-writer-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1.2;
    font-weight: 500;
  }

  .vb-writer-value {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--vb-color);
  }

  /* --- Readers' poll (bottom) --- */
  .vb-readers {
    padding: var(--spacing-lg);
  }

  /* The eyebrow doubles as the live tally line ("Readers · 90% liked it · 142 votes"),
     set by the script; .section-label supplies the mono uppercase accent styling. */
  .vb-readers-label {
    margin: 0 0 var(--spacing-sm);
  }

  .vb-question {
    margin: 0 0 var(--spacing-md) !important;
    font-family: var(--font-body);
    font-size: var(--font-size-xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-heading);
  }

  /* Two side-by-side vote buttons; they stack when the card gets narrow. */
  .rv-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
  }

  /* Same shape language as the global .btn (mono, weight 500). Inactive reads like
     .btn-outline; the chosen side fills with the accent like .btn-filled. */
  .rv-choice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-muted);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;

    /* Accent outline that fills on hover, like the "Clear filters" pill. */
    &:hover:not(:disabled) {
      border: 1px solid var(--color-accent);
      background: var(--color-accent);
      color: var(--color-background);
    }

    &:disabled {
      cursor: default;
    }

    /* Once voted, the poll is locked — dim the side you didn't pick. */
    &:disabled:not(.is-active) {
      opacity: 0.55;
    }

    &.is-active {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-background);
    }
  }

  /* Thumb icons follow the button's text color (override the global muted .icon). */
  .rv-choice :global(.icon) {
    color: inherit;
  }

  /* The tally rides after the label as a quieter mono figure. */
  .rv-count {
    color: var(--color-muted);

    &:empty {
      display: none;
    }
  }

  /* On the accent fill (chosen or hovered) the tally rides the button's text color. */
  .rv-choice.is-active .rv-count,
  .rv-choice:hover:not(:disabled) .rv-count {
    color: inherit;
    opacity: 0.85;
  }

  .rv-bar {
    margin-block-start: var(--spacing-md);
    height: 6px;
    border-radius: var(--radius);
    background: var(--color-line);
    overflow: hidden;
  }

  .rv-bar-fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.35s ease;
  }

  /* Shown only if a vote fails to record (then the buttons re-enable for a retry). */
  .rv-vote-status {
    margin: var(--spacing-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

  /* Optional note: quiet by default, expands to a small form. */
  .rv-note {
    margin-block-start: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px solid var(--color-line);
  }

  .rv-note-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-block-start: var(--spacing-md);
  }

  /* The [hidden] attribute (set after a note is saved) must win over display:flex. */
  .rv-note-form[hidden] {
    display: none;
  }

  .rv-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .rv-field-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-muted-2);
    line-height: 1.5;
  }

  .rv-field-note {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .rv-input {
    padding: var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: var(--radius);
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;

    /* Match the app's global input focus: accent border + 1px ring, no outline
       (and so no outline-offset gap). */
    &:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 1px var(--color-accent);
    }
  }

  textarea.rv-input {
    resize: vertical;
  }

  /* Off-screen honeypot — present for bots, invisible and unfocusable for people. */
  .rv-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .rv-note-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .rv-note-submit {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-line-input);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    cursor: pointer;

    &:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .rv-note-status {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-muted);
  }

  /* Replaces the form once a note is saved. */
  .rv-note-thanks {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    font-weight: 500;
  }

  @media (max-width: 34rem) {
    .rv-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>
