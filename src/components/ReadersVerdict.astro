---
// The combined review bar for a food page: the writer's verdict (fleur rating +
// statement, always shown) and the readers' 👍/👎 poll (shown only when Supabase is
// configured) sit side by side in one bar at the top of the page. A vote reveals an
// optional (private) note below it. src/scripts/readers-verdict.ts loads live counts,
// records votes, and reveals the note.
//
// Type system follows the rest of the app: mono uppercase for labels/meta, Georgia +
// the display serif for the verdict value. Icons, never emoji — the "Liked it" side
// carries the app's heart; the tally rides muted to the right.
import Rating from './Rating.astro'
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import IconThumbsDown from '../assets/IconThumbsDown.astro'
import IconPencil from '../assets/IconPencil.astro'
import IconX from '../assets/IconX.astro'
import { type WriterState } from '../lib/verdict'

interface Props {
  slug: string
  title: string
  // The writer's stance for the "My Review" slot — a rated verdict, or an
  // unrated placeholder ("Haven't visited yet" / "Haven't reviewed yet").
  // Resolved by resolveWriterState so a stub place still shows a line.
  writerState?: WriterState
}

const { slug, title, writerState } = Astro.props

const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)
---

{
  (writerState || readersEnabled) && (
    <section
      class="verdict-bar"
      data-readers-verdict={readersEnabled ? '' : undefined}
      data-slug={slug}
      aria-label={`Review of ${title}`}>
      <div class="vb-row">
        {writerState && (
          <div
            class:list={[
              'vb-mine',
              writerState.verdict ? `verdict-${writerState.verdict}` : 'vb-mine-muted',
            ]}>
            <span class="vb-label">My Rating</span>
            <div class="vb-mine-row">
              <span class="vb-mine-value">{writerState.statement}</span>
              {writerState.verdict && <Rating verdict={writerState.verdict} />}
            </div>
          </div>
        )}

        {readersEnabled && (
          <div class="vb-take">
            <span class="vb-label">Readers' Rating</span>
            {/* Pre-vote nudge; hidden once this browser has voted (text set by the script). */}
            <p class="rv-cta" data-cta>
              Been here? What did you think?
            </p>
            <div class="rv-pill">
              <button
                type="button"
                class="rv-choice"
                data-vote="like"
                aria-pressed="false"
                aria-label="I liked it"
                disabled>
                <IconThumbsUp />
                Liked
                <span class="rv-count" data-count-like />
              </button>
              <button
                type="button"
                class="rv-choice"
                data-vote="dislike"
                aria-pressed="false"
                aria-label="Not for me"
                disabled>
                <IconThumbsDown />
                Nope
                <span class="rv-count" data-count-dislike />
              </button>
            </div>
          </div>
        )}
      </div>

      {readersEnabled && (
        <>
          <p class="rv-vote-status" data-vote-status role="status" aria-live="polite" />

          <div class="rv-note" data-note hidden>
            {/* Collapsed state: a quiet trigger that reopens the form. The reader's
                collapse choice is remembered in localStorage (see readers-verdict.ts). */}
            <button type="button" class="rv-note-trigger" data-note-trigger hidden>
              <IconPencil />
              Leave a comment
            </button>
            <form class="rv-note-form" data-note-form>
              <div class="rv-note-head">
                <span class="rv-note-trigger">Leave a comment</span>
                <button
                  type="button"
                  class="rv-note-close"
                  data-note-close
                  aria-label="Collapse the comment form">
                  <IconX />
                </button>
              </div>
              <label class="rv-field">
                <span class="rv-field-label">
                  Name <span class="rv-field-note">(optional)</span>
                </span>
                <input
                  class="rv-input"
                  type="text"
                  data-note-name
                  maxlength="80"
                  autocomplete="name"
                />
              </label>
              <label class="rv-field">
                <span class="rv-field-label">Note</span>
                <textarea
                  class="rv-input rv-note-textarea"
                  data-note-comment
                  rows="3"
                  maxlength="2000"
                  placeholder="What did you order? How was it?"
                />
              </label>
              {/* Honeypot — hidden from people, tempting to bots. Filled == silently dropped. */}
              <div class="rv-hp" aria-hidden="true">
                <label>
                  Website
                  <input type="text" data-note-hp tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button type="submit" class="rv-note-submit">
                Submit
              </button>
            </form>
            <p class="rv-note-status" data-note-status role="status" aria-live="polite" />
          </div>
        </>
      )}
    </section>
  )
}

<style>
  /* One bordered bar at the top of the writeup: My Review on the left, a divided
     Your Take poll in the middle, the live tally pushed to the right. The top row
     rides on the surface; the note area below it takes the (darker) page
     background, so padding lives on the children, not the bar. Square corners to
     match the rest of the app. */
  .verdict-bar {
    margin-block: var(--spacing-lg);
    border: 1px solid var(--color-line-contrast);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }

  .vb-row {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  /* The two mono uppercase eyebrows ("My Review" / "Your Take") ride muted, not
     the accent that .section-label uses. */
  .vb-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* --- My Review (fleur rating + colored verdict value) --- the eyebrow rides on
     top, the fleur + statement on the row below it. */
  .vb-mine {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
  }

  .vb-mine-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .vb-mine.verdict-loved {
    --vb-color: var(--color-verdict-loved);
  }
  .vb-mine.verdict-liked {
    --vb-color: var(--color-verdict-liked);
  }
  .vb-mine.verdict-neutral {
    --vb-color: var(--color-verdict-neutral);
  }
  .vb-mine.verdict-not-for-me {
    --vb-color: var(--color-verdict-notforme);
  }

  /* Unrated place: a quiet, verdict-less line ("Haven't visited yet"). */
  .vb-mine.vb-mine-muted {
    --vb-color: var(--color-muted-2);
  }

  .vb-mine-value {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: 400;
    line-height: 1;
    color: var(--vb-color);
  }

  /* The placeholder phrase is longer than a verdict word, so it rides a touch
     smaller and in muted ink. */
  .vb-mine-muted .vb-mine-value {
    font-size: var(--font-size-lg);
    color: var(--color-muted-2);
  }

  /* --- Readers' Rating (poll) --- an eyebrow over the two thumb buttons, mirroring
     the My Rating column and divided from it by a hairline. */
  .vb-take {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
    border-inline-start: 1px solid var(--color-line);
    padding-inline-start: var(--spacing-lg);
  }

  /* Pre-vote nudge over the pill: a quiet italic serif line. */
  .rv-cta {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--color-muted);
  }

  .rv-cta[hidden] {
    display: none;
  }

  /* The 👍 / 👎 poll as one rounded pill: two segments split by a hairline. Outlined
     until you vote; the chosen side then fills with the accent. */
  .rv-pill {
    display: inline-flex;
    border: 1px solid var(--color-muted);
    border-radius: 999px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .rv-choice {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    cursor: pointer;
    line-height: 1.3;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;

    &:disabled {
      cursor: default;
    }

    &:hover:not(:disabled) {
      background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    }

    /* The side you voted fills with the accent. */
    &.is-active {
      background: var(--color-accent);
      color: var(--color-background);
    }
  }

  /* The hairline splitting the two pill segments. */
  .rv-choice + .rv-choice {
    border-inline-start: 1px solid var(--color-muted);
  }

  /* Icons follow the segment's text color (override the global muted .icon). */
  .rv-choice :global(.icon) {
    color: inherit;
    width: 16px;
    height: 16px;
  }

  /* The live count after the thumb — hidden when zero (the script leaves it empty). */
  .rv-count {
    font-variant-numeric: tabular-nums;

    &:empty {
      display: none;
    }
  }

  /* Shown only if a vote fails to record (then the buttons re-enable for a retry). */
  .rv-vote-status {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

  /* Optional note, revealed after a vote: stacked Name + Note fields, spanning the
     full width and split from the rating row above by a dashed rule. */
  .rv-note {
    padding: var(--spacing-md);
    border-block-start: 1px dashed var(--color-line);
  }

  .rv-note-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  /* The [hidden] attribute (set after a note is saved, or when collapsed) must win
     over display:flex. */
  .rv-note-form[hidden] {
    display: none;
  }

  /* The form's header row: a label paired with the collapse (×) control. */
  .rv-note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    width: 100%;
  }

  /* The small × that collapses the form back down to the "Leave a comment" trigger. */
  .rv-note-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xs);
    margin: calc(-1 * var(--spacing-xs));
    border: 0;
    background: none;
    color: var(--color-muted);
    cursor: pointer;

    &:hover {
      color: var(--color-accent);
    }

    :global(.icon) {
      width: 16px;
      height: 16px;
    }
  }

  /* Collapsed state: a quiet mono link-button (pencil + "Leave a comment") standing
     in for the whole form. Reopens it on click. */
  .rv-note-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted-2);
    /* font-family: var(--font-mono); */
    /* font-size: var(--font-size-xs); */
    font-weight: 500;

    &[hidden] {
      display: none;
    }

    :global(.icon) {
      width: 15px;
      height: 15px;
      color: inherit;
    }
  }

  button.rv-note-trigger {
    cursor: pointer;

    &:hover {
      color: var(--color-accent);
    }
  }

  /* A labeled field: the mono eyebrow over its input, each spanning the row. */
  .rv-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: 100%;
    min-width: 0;
  }

  .rv-field-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-muted-2);
    line-height: 1.5;
  }

  .rv-field-note {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .rv-input {
    padding: var(--spacing-sm);
    border: 1px solid var(--color-line-input);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    min-width: 0;

    /* Match the app's global input focus: accent border + 1px ring, no outline. */
    &:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 1px var(--color-accent);
    }
  }

  .rv-note-textarea {
    resize: vertical;
    line-height: 1.4;
  }

  /* Off-screen honeypot — present for bots, invisible and unfocusable for people. */
  .rv-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* The dark "Submit" action, set off from the quiet inputs. */
  .rv-note-submit {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-text-heading);
    border-radius: var(--radius);
    background: var(--color-text-heading);
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    cursor: pointer;

    &:hover {
      opacity: 0.9;
    }
  }

  /* An inline error ("Couldn't save that") under the row; hidden while empty. */
  .rv-note-status {
    margin: var(--spacing-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-accent);

    &:empty {
      display: none;
    }
  }

  /* Stack the bar's segments on a narrow screen. The vertical divider between them
     becomes a horizontal rule above the readers' section, so My Rating and Readers'
     Rating stay clearly separated. */
  @media (max-width: 700px) {
    .vb-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .vb-take {
      margin-block-start: var(--spacing-sm);
      padding-block-start: var(--spacing-sm);
      border-block-start: 1px solid var(--color-line);
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }
</style>
