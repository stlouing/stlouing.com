---
// A color-coded verdict label (Loved / Liked / Fine / Not for me), shown in place
// of a numeric rating on the Food detail pages and the Best of page. It's just a
// Chip recolored to the verdict's token — see the `.chip.verdict-*` rules in
// global.css.
import Chip from './Chip.astro'
import { verdictLabels, type Verdict } from '../lib/verdict'
import IconHeart from '../assets/IconHeart.astro'
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import IconCircleMinus from '../assets/IconCircleMinus.astro'
import IconHeartOff from '../assets/IconHeartOff.astro'

// A Lucide icon per verdict: heart (loved), thumbs-up (liked), circle-minus
// (neutral), heart-off (not-for-me) — softer, less aggressive than thumbs/faces.
// Shown before the label when `icon` is set.
const verdictIcons = {
  loved: IconHeart,
  liked: IconThumbsUp,
  neutral: IconCircleMinus,
  'not-for-me': IconHeartOff,
} satisfies Record<Verdict, unknown>

interface Props {
  verdict: Verdict
  // Show the verdict icon (off by default).
  icon?: boolean
  // Show the text label (on by default). Turn off for an icon-only chip — the
  // label still rides along as an aria-label for screen readers.
  label?: boolean
  // Render as a circular badge (pairs with an icon-only chip).
  round?: boolean
  // Fill the pill with the verdict color (off by default — used on detail pages).
  filled?: boolean
  narrow?: boolean
  // Render as a rating pill (icon disc + the word, with a "My Rating" eyebrow at
  // full size), bordered + tinted to the verdict.
  card?: boolean
  // Compact `card`: smaller scale and no eyebrow — for inline meta rows.
  compact?: boolean
}

const {
  verdict,
  icon = false,
  label = true,
  round = false,
  filled = false,
  narrow = false,
  card = false,
  compact = false,
} = Astro.props
const Icon = verdictIcons[verdict]
---

{
  card ? (
    // "Rating" is the front-end word for a verdict — we only ever say "verdict"
    // in code.
    <div class:list={['verdict-card', `verdict-${verdict}`, { 'is-compact': compact }]}>
      <span class="verdict-card-icon">
        <Icon />
      </span>
      <span class="verdict-card-text">
        <span class="verdict-card-label">My Rating</span>
        <span class="verdict-card-value">{verdictLabels[verdict]}</span>
      </span>
    </div>
  ) : (
    <Chip
      class:list={[`verdict-${verdict}`, { 'is-filled': filled, 'is-narrow': narrow }]}
      round={round}
      aria-label={label ? undefined : verdictLabels[verdict]}>
      {icon && <Icon />}
      {label && <span>{verdictLabels[verdict]}</span>}
    </Chip>
  )
}
