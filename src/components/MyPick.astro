---
// A sidebar "My pick" card on a food page: the dish to order, with an optional
// note. Driven by the optional `pick` field in the food schema; renders nothing
// without one (the writeup author fills it in per place).
interface Props {
  pick: { name: string; note?: string }
}

const { pick } = Astro.props
---

<div class="my-pick">
  <h2 class="my-pick-label section-label">My pick</h2>
  <div class="pick">
    <div class="pick-body">
      <strong class="pick-name">{pick.name}</strong>
      {pick.note && <p class="pick-note">{pick.note}</p>}
    </div>
  </div>
</div>

<style>
  /* No card chrome of its own — the pick lives inside the food sidebar card. */
  /* Font from the shared global `.section-label`; keep only the spacing. */
  .my-pick-label {
    margin: 0 0 var(--spacing-xs);
  }

  .pick {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .pick-name {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-md);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-heading);
  }

  .pick-note {
    margin: var(--spacing-xs) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    line-height: 1.3;
  }
</style>
