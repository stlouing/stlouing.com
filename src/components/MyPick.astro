---
// A sidebar "My pick" card on a food page: the dish to order, with an optional
// note. Driven by the optional `pick` field in the food schema; renders nothing
// without one (the writeup author fills it in per place).
import AsideHeading from './AsideHeading.astro'

interface Props {
  pick: { name: string; note?: string }
}

const { pick } = Astro.props
---

<div class="my-pick">
  <AsideHeading title="My Pick" />
  <div class="pick">
    <div class="pick-body">
      <strong class="pick-name title-serif">{pick.name}</strong>
      {pick.note && <p class="pick-note description">{pick.note}</p>}
    </div>
  </div>
</div>

<style>
  .pick {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .pick-note {
    margin: var(--spacing-xs) 0 0;
  }
</style>
