---
import Icon from './Icon.astro'

interface Props {
  href?: string
  websiteHref?: string
  directionsHref?: string
}

const { href, websiteHref, directionsHref } = Astro.props
---

<span class="action-buttons">
  {
    href && (
      <a class="btn btn-dark" href={href}>
        View more
      </a>
    )
  }
  {
    websiteHref && (
      <a class="btn btn-outline" href={websiteHref} target="_blank" rel="noopener">
        Website
        <Icon name="external-link" />
      </a>
    )
  }
  {
    directionsHref && (
      <a class="btn btn-outline" href={directionsHref} target="_blank" rel="noopener">
        Directions
        <Icon name="map" />
      </a>
    )
  }
</span>
