---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Rating from './Rating.astro'
import type { Verdict } from '../lib/verdict'

interface Props {
  href?: string
  title: string
  meta?: string | string[]
  accentMeta?: boolean
  description?: string
  excerpt?: string
  photo?: ImageMetadata
  photoAlt?: string
  photoSizes?: string
  verdict?: Verdict
  external?: boolean
  class?: string
}

const {
  href,
  title,
  meta,
  accentMeta = false,
  description,
  excerpt,
  photo,
  photoAlt,
  photoSizes = '(min-width: 700px) 520px, 100vw',
  verdict,
  external = false,
  class: className,
} = Astro.props

const metaParts = (Array.isArray(meta) ? meta : [meta]).filter(
  (part): part is string => Boolean(part),
)
const hasIcon = Astro.slots.has('icon')
const Tag = href ? 'a' : 'div'
const linkAttributes = href
  ? external
    ? { href, target: '_blank', rel: 'noopener' }
    : { href }
  : {}
---

<Tag class:list={['card', className]} {...linkAttributes}>
  {
    photo && (
      <Image
        class="card-media"
        src={photo}
        alt={photoAlt ?? title}
        widths={[520, 1040]}
        sizes={photoSizes}
      />
    )
  }
  {
    hasIcon && (
      <span class="card-icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <span class="card-body">
    {
      metaParts.length > 0 && (
        <span class:list={['card-meta', 'eyebrow', { 'eyebrow--muted': !accentMeta }]}>
          {metaParts.map((part, partIndex) => (
            <>
              {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
              {part}
            </>
          ))}
        </span>
      )
    }
    <span class="title-serif title-link">{title}</span>
    {description && <p class="card-description description">{description}</p>}
    {excerpt && <p class="card-excerpt excerpt">{excerpt}</p>}
    <slot />
  </span>
  {verdict && <Rating verdict={verdict} />}
</Tag>
