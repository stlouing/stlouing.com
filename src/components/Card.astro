---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Rating from './Rating.astro'
import TagIcon from './TagIcon.astro'
import type { Verdict } from '../lib/verdict'

interface Props {
  href?: string
  title: string
  meta?: string | string[]
  description?: string
  excerpt?: string
  photo?: ImageMetadata
  photoAlt?: string
  verdict?: Verdict
  tags?: string[]
  external?: boolean
  class?: string
}

const {
  href,
  title,
  meta,
  description,
  excerpt,
  photo,
  photoAlt,
  verdict,
  tags = [],
  external = false,
  class: className,
} = Astro.props

const metaParts = (Array.isArray(meta) ? meta : [meta]).filter(
  (part): part is string => Boolean(part),
)
const hasIcon = Astro.slots.has('icon')
const Tag = href ? 'a' : 'div'
const linkAttributes = href
  ? external
    ? { href, target: '_blank', rel: 'noopener' }
    : { href }
  : {}
---

<Tag class:list={['card', className]} {...linkAttributes}>
  {photo && <Image class="card-media" src={photo} alt={photoAlt ?? title} width={520} />}
  {
    hasIcon && (
      <span class="card-icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <span class="card-body">
    {
      metaParts.length > 0 && (
        <span class="card-meta eyebrow eyebrow--muted">
          {metaParts.map((part, partIndex) => (
            <>
              {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
              {part}
            </>
          ))}
        </span>
      )
    }
    <span class="title-serif title-link">{title}</span>
    {description && <p class="card-description description">{description}</p>}
    {excerpt && <p class="card-excerpt excerpt">{excerpt}</p>}
    {
      tags.length > 0 && (
        <span class="card-tags" aria-hidden="true">
          {tags.map((tag) => (
            <span class="card-tag">
              <TagIcon tag={tag} />
              {tag}
            </span>
          ))}
        </span>
      )
    }
    <slot />
  </span>
  {verdict && <Rating verdict={verdict} />}
</Tag>
