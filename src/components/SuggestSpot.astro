---
import IconPlus from '../assets/IconPlus.astro'
import CategoryChip from './CategoryChip.astro'
import ShareActions from './ShareActions.astro'
import SheetDialog from './SheetDialog.astro'
import { FEEDBACK_ENDPOINT, SITE_NAME } from '../lib/site'
import { spotCategories, SPOT_SECTION_ORDER, type SpotCategoryKey } from '../lib/spots'

interface Props {
  where?: string
  category?: SpotCategoryKey
  subject?: string
}

const { where, category, subject = 'map' } = Astro.props
const categories: SpotCategoryKey[] = [...SPOT_SECTION_ORDER, 'food']
---

{
  FEEDBACK_ENDPOINT && (
    <>
      <button
        type="button"
        class="pill-button suggest-spot"
        data-suggest-open
        data-goatcounter-click="suggest-open"
        aria-label="Suggest a spot">
        <span class="pill-button-badge" aria-hidden="true">
          <IconPlus />
        </span>
        <span class="suggest-spot-label">Suggest</span>
      </button>
      <SheetDialog data-suggest-dialog labelledBy="suggest-title">
        <div class="popup-scroll">
          <div data-suggest-thanks hidden>
            <div class="sheet-title">
              <span class="title-serif">Thanks for the tip!</span>
            </div>
            <p class="sheet-lede description">
              Know someone who'd like this {subject}? Help spread the word! I'm always updating it
              and adding more spots.
            </p>
            <ShareActions placement="suggest" />
          </div>
          <div data-suggest-ask>
            <div class="sheet-title" id="suggest-title">
              <span class="title-serif">Know somewhere I missed?</span>
            </div>
            <p class="sheet-lede description">
              Add a place you love and help someone else find it.
            </p>
            <form class="suggest-form form-stack" method="POST" action={FEEDBACK_ENDPOINT}>
              <label class="field">
                <span>Name of the place</span>
                <input type="text" name="place" required />
              </label>
              <label class="field">
                <span>Address or neighborhood</span>
                <input type="text" name="where" value={where} />
              </label>
              {category ? (
                <input type="hidden" name="category" value={spotCategories[category].label} />
              ) : (
                <fieldset class="field suggest-categories">
                  <legend class="field-legend">Type of place</legend>
                  <div class="category-chips">
                    {categories.map((key) => (
                      <CategoryChip as="label" category={key} label={spotCategories[key].label}>
                        <input type="radio" name="category" value={spotCategories[key].label} />
                      </CategoryChip>
                    ))}
                  </div>
                </fieldset>
              )}
              <label class="field">
                <span>Anything else you want to add?</span>
                <textarea name="why" rows="2" />
              </label>
              <input type="hidden" name="_subject" value={`${SITE_NAME} spot suggestion`} />
              <p class="hp" aria-hidden="true">
                <label>
                  Leave this field empty
                  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
                </label>
              </p>
              <div class="form-actions">
                <button type="submit" class="btn btn-dark">
                  Submit
                </button>
                <span class="form-status" data-form-status role="status" aria-live="polite" />
              </div>
            </form>
          </div>
        </div>
      </SheetDialog>
    </>
  )
}

<script>
  import { bindFeedbackForm } from '../scripts/feedback-form'
  import { bindSheetDialog } from '../scripts/sheet-dialog'

  const dialog = document.querySelector<HTMLDialogElement>('[data-suggest-dialog]')
  const opener = document.querySelector<HTMLButtonElement>('[data-suggest-open]')
  const form = dialog?.querySelector<HTMLFormElement>('.suggest-form')
  const status = dialog?.querySelector<HTMLElement>('[data-form-status]')
  const ask = dialog?.querySelector<HTMLElement>('[data-suggest-ask]')
  const thanks = dialog?.querySelector<HTMLElement>('[data-suggest-thanks]')
  const analytics = window as Window & {
    goatcounter?: { count: (variables: { path: string; event: boolean }) => void }
  }
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')

  if (dialog && opener && form && status && ask && thanks) {
    bindSheetDialog({
      dialog,
      opener,
      onOpen: () => {
        if (finePointer.matches) {
          form.querySelector<HTMLInputElement>('input[name="place"]')?.focus()
        }
      },
      onClose: () => {
        ask.hidden = false
        thanks.hidden = true
        status.textContent = ''
      },
    })

    bindFeedbackForm(form, status, {
      onSuccess: () => {
        ask.hidden = true
        thanks.hidden = false
        analytics.goatcounter?.count({ path: 'suggest-sent', event: true })
      },
      buildBody: (data) => {
        const lines = [
          `Place: ${String(data.get('place') ?? '').trim()}`,
          `Where: ${String(data.get('where') ?? '').trim()}`,
          `Category: ${String(data.get('category') ?? '').trim()}`,
          `Why: ${String(data.get('why') ?? '').trim()}`,
          `Page: ${window.location.href}`,
        ]
        const body = new FormData()
        body.set('message', lines.join('\n'))
        body.set('_subject', String(data.get('_subject') ?? ''))
        body.set('_gotcha', String(data.get('_gotcha') ?? ''))

        return body
      },
    })
  }
</script>
