---
import MastheadBrand from './MastheadBrand.astro'
import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'
import Icon from './Icon.astro'
import { CITY, FOUNDED_YEAR, REGION, SITE_NAME, SOCIALS } from '../lib/site'

const instagram = SOCIALS.find((social) => social.label === 'Instagram')

interface Props {
  trail: Array<any>
  variant?: 'home' | 'compact'
}

const { variant = 'compact' } = Astro.props
---

{
  variant === 'home' && (
    <>
      <header class="masthead-home">
        <div class="masthead-ear">
          <div class="wrap wrap-wide masthead-ear-line eyebrow eyebrow--muted">
            <span>An Independent Guide</span>
            <span class="masthead-ear-group">
              <span>{CITY}, {REGION}</span>
              <FleurGlyph class="ear-fleur" />
              <span>Est. {FOUNDED_YEAR}</span>
            </span>
          </div>
        </div>
        <div class="wrap wrap-wide nameplate">
          <h1 class="nameplate-title title-display">{SITE_NAME}</h1>
        </div>
      </header>
    </>
  )
}
<div class:list={['masthead-nav', { 'is-home': variant === 'home' }]} data-header>
  <div class="wrap wrap-wide masthead-nav-inner">
    <MastheadBrand />
    {
      variant === 'home' && (
        <span class="masthead-tagline eyebrow eyebrow--muted">An Independent Guide to {CITY}</span>
      )
    }
    <Nav />
    <div class="masthead-tools">
      {
        instagram && (
          <a
            class="btn btn-quiet btn-quiet--plain masthead-social"
            href={instagram.url}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            data-goatcounter-click="instagram-header"
            data-tooltip="Instagram"
            data-tooltip-align="end">
            <Icon name="instagram" />
          </a>
        )
      }
      <ThemeToggle />
    </div>
  </div>
  {variant === 'home' && <div class="masthead-double-rule"></div>}
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }

  const masthead = document.querySelector('.masthead-home')
  if (header && masthead) {
    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting)
    })
    observer.observe(masthead)
  } else if (header) {
    const setStuck = () => {
      header.classList.toggle('is-stuck', window.scrollY > 0)
    }

    setStuck()
    window.addEventListener('scroll', setStuck, { passive: true })
  }
</script>

<style>
  .masthead-ear {
    border-block-end: 1px solid var(--color-line-contrast);
  }

  .masthead-ear-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xs);
  }

  .masthead-ear-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .masthead-ear-line :global(.ear-fleur) {
    width: 0.55em;
  }

  .nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .nameplate-title {
    margin: 0;
    font-size: clamp(3rem, 1.5rem + 7vw, 6.5rem);
  }

  .masthead-nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-start: 1px solid var(--color-line-contrast);
    background: var(--color-background);
    transform: translateZ(0);
    isolation: isolate;
    transition:
      background-color var(--duration-slow) ease,
      color var(--duration-slow) ease;
  }

  .masthead-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .masthead-tools {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .masthead-tools :global(.btn-quiet--plain) {
    color: var(--color-muted);
  }

  .masthead-tools :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .masthead-nav .masthead-tools .masthead-social,
  .masthead-nav .masthead-tools .masthead-social:hover {
    --masthead-social-size: 1.875rem;
    box-sizing: border-box;
    justify-content: center;
    flex-shrink: 0;
    width: var(--masthead-social-size);
    height: var(--masthead-social-size);
    padding: 0;
    margin-inline-end: var(--spacing-xs);
    border: var(--spacing-xxs) solid transparent;
    border-radius: 50%;
    background:
      var(--gradient-instagram) padding-box,
      var(--color-bar-text) border-box;
    color: var(--color-bar-text);
  }

  .masthead-nav .masthead-tools .masthead-social:hover {
    filter: brightness(1.1);
  }

  .masthead-social :global(.icon) {
    color: var(--color-bar-text);
  }

  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) {
    background: var(--color-bar-background);
    border-block-start-color: var(--color-bar-background);
    color: var(--color-bar-text);
  }

  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.masthead-brand),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.masthead-brand:hover),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.site-nav-inline a),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.site-nav-inline a:hover),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.site-nav-inline a[aria-current='page']),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) .masthead-tools :global(.btn-quiet--plain),
  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) .masthead-tools :global(.btn-quiet--plain:hover) {
    color: var(--color-bar-text);
  }

  .masthead-nav .masthead-tools :global(.theme-toggle:hover) {
    color: var(--color-accent-blue);
  }

  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) .masthead-tools :global(.theme-toggle:hover) {
    color: var(--color-flag-yellow);
  }

  .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.site-nav-inline .nav-fleur) {
    color: var(--color-flag-yellow);
  }

  @media (min-width: 701px) {
    .masthead-nav-inner {
      padding-block: var(--spacing-xs);
    }
  }

  .masthead-nav.is-home :global(.masthead-brand) {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) ease;
  }

  .masthead-nav.is-home.is-stuck :global(.masthead-brand) {
    opacity: 1;
    visibility: visible;
  }

  .masthead-tagline {
    display: none;
  }

  .masthead-double-rule {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    height: 7px;
    border-block-start: 4px solid var(--color-line-contrast);
    border-block-end: 1px solid var(--color-line-contrast);
  }

  .masthead-nav.is-stuck .masthead-double-rule {
    display: none;
  }

  @media (max-width: 700px) {
    .masthead-nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      row-gap: var(--spacing-xs);
    }

    .masthead-nav-inner :global(.masthead-brand) {
      grid-area: brand;
    }

    .masthead-tools {
      grid-area: toggle;
    }

    .masthead-nav-inner :global(.site-nav-inline) {
      grid-area: nav;
      justify-content: space-between;
      column-gap: 0;
      padding-block: 0;
    }

    .masthead-nav-inner {
      padding-block: 0;
      row-gap: 0;
    }

    .masthead-nav-inner :global(.masthead-brand) {
      padding-block: calc(var(--spacing-sm) * 0.75);
    }

    .masthead-tagline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      grid-column: 1 / -1;
      grid-row: 1;
      align-self: stretch;
      border-block-end: 1px solid var(--color-line);
      white-space: nowrap;
      transition: opacity var(--duration-fast) ease;
    }

    .masthead-nav.is-stuck .masthead-tagline {
      opacity: 0;
      visibility: hidden;
    }

    .masthead-nav.is-home .masthead-tools {
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--duration-fast) ease;
    }

    .masthead-nav.is-home.is-stuck .masthead-tools {
      opacity: 1;
      visibility: visible;
    }

    .masthead-nav:where(:not(.is-home), .is-home.is-stuck) :global(.site-nav-inline) {
      margin-inline: calc(-1 * var(--spacing-md));
      padding: 0;
      background: var(--color-bar-background-sub);
    }

    .masthead-nav-inner :global(.site-nav-inline a) {
      display: flex;
      flex: 1 1 auto;
      justify-content: center;
      padding-block: var(--spacing-sm) calc(var(--spacing-sm) - 3px);
      border-block-end: 3px solid transparent;
      text-decoration: none;
    }

    .masthead-nav-inner :global(.site-nav-inline a:hover),
    .masthead-nav-inner :global(.site-nav-inline a[aria-current='page']) {
      border-block-end-color: var(--color-flag-yellow);
    }

    .masthead-ear {
      display: none;
    }

    .nameplate {
      padding-block: var(--spacing-sm);
    }
  }
</style>
