---
import IconFlag from '../assets/IconFlag.astro'

import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import { href } from '../lib/url'

interface Props {
  trail: Array<any>
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="site-name" href={href('/')}>
      <IconFlag alt="St. Louis flag" /> St. Louing
    </a>
    <div class="header-actions">
      <Nav />
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // Publish the sticky header's height so in-page anchors (:target) can offset
  // by it. Tracks wrapping/resize so the offset stays correct across breakpoints.
  const header = document.querySelector<HTMLElement>('.site-header')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-end: 1px solid var(--color-line);
    padding-block: var(--spacing-md);
    background: var(--color-surface);
    transform: translateZ(0);
    isolation: isolate;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  a.site-name {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--font-size-md);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-weight: 700;

    &:hover {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 2px;
    }
  }

  /* Mobile: name + theme toggle on the top row, nav stacked below as an even
     three-column grid. Desktop (above) is unchanged. */
  @media (max-width: 700px) {
    .site-header {
      padding-block: var(--spacing-sm);
    }

    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name theme'
        'nav nav';
      align-items: center;
      column-gap: var(--spacing-md);
      row-gap: var(--spacing-sm);
    }

    .site-name {
      grid-area: name;
    }

    /* Unwrap the actions so the nav and toggle place into the grid independently
       (display:contents keeps them as DOM children but drops the wrapper box). */
    .header-actions {
      display: contents;
    }

    .header-actions :global(.theme-toggle) {
      grid-area: theme;
      justify-self: end;
    }

    .header-actions :global(.site-nav) {
      grid-area: nav;
      display: flex;
      justify-content: start;
      column-gap: var(--spacing-md);
      row-gap: var(--spacing-xs);
    }
  }
</style>
