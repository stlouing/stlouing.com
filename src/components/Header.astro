---
import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'
import { href } from '../lib/url'
// import FleurDeLis from '../assets/FleurDeLis.astro'

interface Props {
  trail: Array<any>
  // 'home' renders the full newspaper masthead: ear row, big centered <h1>
  // nameplate, and the nav bar that sticks once the nameplate scrolls away.
  // 'compact' (every other page) renders ONLY the nav bar, with the pixel
  // flag + wordmark on the left as the way home.
  variant?: 'home' | 'compact'
}

const { variant = 'compact' } = Astro.props
---

{
  variant === 'home' && (
    <>
      {/* The nameplate scrolls away; only .masthead-nav below is sticky. The two
         blocks are siblings (not nested) because a sticky element can only stick
         within its parent's box — nesting the nav inside the masthead header
         would end its sticky range where the masthead ends. */}
      <header class="masthead-home">
        <div class="masthead-ear">
          <div class="wrap wrap-wide masthead-ear-line eyebrow eyebrow--muted">
            <span class="masthead-ear-left">
              <span>An Independent Guide</span>
            </span>
            <span class="masthead-ear-right">
              <span>St. Louis, Missouri</span>
              <FleurGlyph class="ear-fleur" />
              <span>Est. 2026</span>
            </span>
          </div>
        </div>
        <div class="wrap wrap-wide nameplate">
          <h1 class="nameplate-title">St. Louing</h1>
        </div>
      </header>
    </>
  )
}
{
  /* One nav bar for every page: brand hard left, links centered, theme switch
   hard right. On the homepage it sits below the nameplate and carries the
   brand once the nameplate scrolls away. */
}
<div class:list={['masthead-nav', { 'is-home': variant === 'home' }]} data-header>
  <div class="wrap wrap-wide masthead-nav-inner">
    <a class="masthead-brand" href={href('/')}>
      <!-- <FleurDeLis class="brand-crest" />
      St. Louing -->
      <img class="brand-flag" src={href('/flag-square.svg')} alt="" width="28" height="28" /> St. Louing
    </a>
    <Nav />
    <ThemeToggle variant="quiet" />
  </div>
  <div class="masthead-double-rule"></div>
</div>

<script>
  // Publish the sticky nav bar's height so in-page anchors (:target) can
  // offset by it. Tracks wrapping/resize so the offset stays correct across
  // breakpoints.
  const header = document.querySelector<HTMLElement>('[data-header]')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }

  // Homepage: the bar's brand stays hidden while the big nameplate is on
  // screen, fading in once the masthead scrolls away and the bar sticks.
  // Inner pages: the bar sits at the very top, so any scroll means stuck.
  // Either way `.is-stuck` also thins the Scotch rule to a single hairline.
  const masthead = document.querySelector('.masthead-home')
  if (header && masthead) {
    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting)
    })
    observer.observe(masthead)
  } else if (header) {
    const setStuck = () => {
      header.classList.toggle('is-stuck', window.scrollY > 0)
    }

    setStuck()
    window.addEventListener('scroll', setStuck, { passive: true })
  }
</script>

<style>
  .masthead-brand :global(.brand-crest) {
    width: 28px;
    height: 28px;
  }

  .masthead-ear {
    border-block-end: 1px solid var(--color-line-contrast);
  }

  .masthead-ear-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xs);
  }

  .masthead-ear-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .masthead-ear-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-sm);
  }

  /* Flat :global on purpose (nested :global gets stripped by the compiler);
     scoped to the whole line so the fleur can sit in any ear slot. */
  .masthead-ear-line :global(.ear-fleur) {
    width: 0.55em;
    height: auto;
    flex-shrink: 0;
    color: var(--color-accent-gold);
  }

  .nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .nameplate-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    font-size: clamp(3rem, 1.5rem + 7vw, 6.5rem);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  .masthead-nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-start: 1px solid var(--color-line-contrast);
    background: var(--color-background);
    transform: translateZ(0);
    isolation: isolate;
  }

  /* Three zones: 1fr rails pin the brand hard left and the toggle hard right
     while the links hold the true center. */
  .masthead-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .masthead-nav-inner :global(.theme-toggle) {
    justify-self: end;
  }

  .masthead-brand {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: var(--spacing-shmedium);
    color: var(--color-text-heading);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    white-space: nowrap;
  }

  /* On the homepage the brand waits under the nameplate — invisible (but
     still holding its grid cell, so the links stay centered) until the bar
     sticks. */
  .masthead-nav.is-home .masthead-brand {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }

  .masthead-nav.is-home.is-stuck .masthead-brand {
    opacity: 1;
    visibility: visible;
  }

  .masthead-brand:hover {
    color: var(--color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .brand-flag {
    width: 28px;
    height: 28px;
    image-rendering: pixelated;
    flex-shrink: 0;
    border-radius: 6px;
  }

  /* Thick bar, 2px gap, thin line — the borders draw both, the height between
     them opens the gap. The transition lets the stuck collapse below read as
     a slide (it fires mid-scroll) instead of a 6px jump. */
  .masthead-double-rule {
    height: 7px;
    border-block-start: 4px solid var(--color-line-contrast);
    border-block-end: 1px solid var(--color-line-contrast);
    transition:
      height 0.15s ease,
      border-block-start-width 0.15s ease;
  }

  /* Scrolled (stuck): the rule collapses to just the thin line, so the bar
     closes symmetrically — hairline, padding, links, padding, hairline — with
     no leftover slot where the thick bar was. */
  .masthead-nav.is-stuck .masthead-double-rule {
    height: 1px;
    border-block-start-width: 0;
  }

  @media (max-width: 700px) {
    .masthead-nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      row-gap: var(--spacing-xs);
    }

    .masthead-brand {
      grid-area: brand;
    }

    .masthead-nav-inner :global(.theme-toggle) {
      grid-area: toggle;
    }

    .masthead-nav-inner :global(.site-nav-inline) {
      grid-area: nav;
      justify-content: space-between;
      padding-block: 0;
    }

    /* Homepage: a phone shows neither the brand (it links to the page you're
       on) nor the theme toggle — just the one nav row, whether stuck or not,
       so the bar's height never changes and the content below never jumps. */
    .masthead-nav.is-home .masthead-nav-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'nav';
    }

    .masthead-nav.is-home .masthead-brand,
    .masthead-nav.is-home :global(.theme-toggle) {
      display: none;
    }

    /* The ear row is too cramped to read on a phone — drop it entirely, so
       the masthead starts at the nameplate. */
    .masthead-ear {
      display: none;
    }

    .nameplate {
      padding-block: var(--spacing-sm);
    }
  }
</style>
