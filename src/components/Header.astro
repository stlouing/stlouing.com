---
import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'
import { href } from '../lib/url'

interface Props {
  trail: Array<any>
  variant?: 'home' | 'compact'
}

const { variant = 'compact' } = Astro.props
---

{
  variant === 'home' && (
    <>
      <header class="masthead-home">
        <div class="masthead-ear">
          <div class="wrap wrap-wide masthead-ear-line eyebrow eyebrow--muted">
            <span class="masthead-ear-left">
              <span>An Independent Guide</span>
            </span>
            <span class="masthead-ear-right">
              <span>St. Louis, Missouri</span>
              <FleurGlyph class="ear-fleur" />
              <span>Est. 2026</span>
            </span>
          </div>
        </div>
        <div class="wrap wrap-wide nameplate">
          <h1 class="nameplate-title">St. Louing</h1>
        </div>
      </header>
    </>
  )
}
<div class:list={['masthead-nav', { 'is-home': variant === 'home' }]} data-header>
  <div class="wrap wrap-wide masthead-nav-inner">
    <a class="masthead-brand" href={href('/')}>
      <img class="brand-flag" src={href('/flag-square.svg')} alt="" width="28" height="28" /> St. Louing
    </a>
    <Nav />
    <ThemeToggle variant="quiet" />
  </div>
  <div class="masthead-double-rule"></div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }

  const masthead = document.querySelector('.masthead-home')
  if (header && masthead) {
    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting)
    })
    observer.observe(masthead)
  } else if (header) {
    const setStuck = () => {
      header.classList.toggle('is-stuck', window.scrollY > 0)
    }

    setStuck()
    window.addEventListener('scroll', setStuck, { passive: true })
  }
</script>

<style>
  .masthead-brand :global(.brand-crest) {
    width: 28px;
    height: 28px;
  }

  .masthead-ear {
    border-block-end: 1px solid var(--color-line-contrast);
  }

  .masthead-ear-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xs);
  }

  .masthead-ear-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .masthead-ear-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-sm);
  }

  .masthead-ear-line :global(.ear-fleur) {
    width: 0.55em;
    height: auto;
    flex-shrink: 0;
    color: var(--color-accent-gold);
  }

  .nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .nameplate-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    font-size: clamp(3rem, 1.5rem + 7vw, 6.5rem);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  .masthead-nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-start: 1px solid var(--color-line-contrast);
    background: var(--color-background);
    transform: translateZ(0);
    isolation: isolate;
  }

  .masthead-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .masthead-nav-inner :global(.theme-toggle) {
    justify-self: end;
  }

  .masthead-brand {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: var(--spacing-shmedium);
    color: var(--color-text-heading);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    white-space: nowrap;
  }

  .masthead-nav.is-home .masthead-brand {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }

  .masthead-nav.is-home.is-stuck .masthead-brand {
    opacity: 1;
    visibility: visible;
  }

  .masthead-brand:hover {
    color: var(--color-text-heading);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .brand-flag {
    width: 28px;
    height: 28px;
    image-rendering: pixelated;
    flex-shrink: 0;
    border-radius: 6px;
  }

  .masthead-double-rule {
    height: 7px;
    border-block-start: 4px solid var(--color-line-contrast);
    border-block-end: 1px solid var(--color-line-contrast);
    transition:
      height 0.15s ease,
      border-block-start-width 0.15s ease;
  }

  .masthead-nav.is-stuck .masthead-double-rule {
    height: 1px;
    border-block-start-width: 0;
  }

  @media (max-width: 700px) {
    .masthead-nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      row-gap: var(--spacing-xs);
    }

    .masthead-brand {
      grid-area: brand;
    }

    .masthead-nav-inner :global(.theme-toggle) {
      grid-area: toggle;
    }

    .masthead-nav-inner :global(.site-nav-inline) {
      grid-area: nav;
      justify-content: space-between;
      padding-block: 0;
    }

    .masthead-nav.is-home .masthead-nav-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'nav';
    }

    .masthead-nav.is-home .masthead-brand,
    .masthead-nav.is-home :global(.theme-toggle) {
      display: none;
    }

    .masthead-ear {
      display: none;
    }

    .nameplate {
      padding-block: var(--spacing-sm);
    }
  }
</style>
