---
import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import FleurGlyph from '../assets/FleurGlyph.astro'
import { href } from '../lib/url'
import { CITY, FOUNDED_YEAR, REGION, SITE_NAME } from '../lib/site'

interface Props {
  trail: Array<any>
  variant?: 'home' | 'compact'
}

const { variant = 'compact' } = Astro.props
---

{
  variant === 'home' && (
    <>
      <header class="masthead-home">
        <div class="masthead-ear">
          <div class="wrap wrap-wide masthead-ear-line eyebrow eyebrow--muted">
            <span>An Independent Guide</span>
            <span class="masthead-ear-group">
              <span>{CITY}, {REGION}</span>
              <FleurGlyph class="ear-fleur" />
              <span>Est. {FOUNDED_YEAR}</span>
            </span>
          </div>
        </div>
        <div class="wrap wrap-wide nameplate">
          <h1 class="nameplate-title title-display">{SITE_NAME}</h1>
        </div>
      </header>
    </>
  )
}
<div class:list={['masthead-nav', { 'is-home': variant === 'home' }]} data-header>
  <div class="wrap wrap-wide masthead-nav-inner">
    <a class="masthead-brand title-display title-link" href={href('/')}>
      <img class="brand-mark" src={href('/logo.svg')} alt="" width="32" height="32" /> {SITE_NAME}
    </a>
    <Nav />
    <ThemeToggle />
  </div>
  <div class="masthead-double-rule"></div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }

  const masthead = document.querySelector('.masthead-home')
  if (header && masthead) {
    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting)
    })
    observer.observe(masthead)
  } else if (header) {
    const setStuck = () => {
      header.classList.toggle('is-stuck', window.scrollY > 0)
    }

    setStuck()
    window.addEventListener('scroll', setStuck, { passive: true })
  }
</script>

<style>
  .masthead-ear {
    border-block-end: 1px solid var(--color-line-contrast);
  }

  .masthead-ear-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xs);
  }

  .masthead-ear-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .masthead-ear-line :global(.ear-fleur) {
    width: 0.55em;
  }

  .nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .nameplate-title {
    margin: 0;
    font-size: clamp(3rem, 1.5rem + 7vw, 6.5rem);
  }

  .masthead-nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-start: 1px solid var(--color-line-contrast);
    background: var(--color-background);
    transform: translateZ(0);
    isolation: isolate;
  }

  .masthead-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .masthead-nav-inner :global(.theme-toggle) {
    justify-self: end;
  }

  .masthead-brand {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-xl);
    white-space: nowrap;
  }

  .masthead-nav:not(.is-home) :global(.site-nav-inline) {
    margin-block-start: 4px;
  }

  .masthead-nav.is-home .masthead-brand {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) ease;
  }

  .masthead-nav.is-home.is-stuck .masthead-brand {
    opacity: 1;
    visibility: visible;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .masthead-double-rule {
    height: 7px;
    border-block-start: 4px solid var(--color-line-contrast);
    border-block-end: 1px solid var(--color-line-contrast);
    transition:
      height var(--duration-fast) ease,
      border-block-start-width var(--duration-fast) ease;
  }

  .masthead-nav.is-stuck .masthead-double-rule {
    height: 1px;
    border-block-start-width: 0;
  }

  @media (max-width: 700px) {
    .masthead-nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      row-gap: var(--spacing-xs);
    }

    .masthead-brand {
      grid-area: brand;
    }

    .masthead-nav-inner :global(.theme-toggle) {
      grid-area: toggle;
    }

    .masthead-nav-inner :global(.site-nav-inline) {
      grid-area: nav;
      justify-content: space-between;
      padding-block: 0;
    }

    .masthead-nav.is-home .masthead-nav-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'nav';
    }

    .masthead-nav.is-home .masthead-brand,
    .masthead-nav.is-home :global(.theme-toggle) {
      display: none;
    }

    .masthead-ear {
      display: none;
    }

    .nameplate {
      padding-block: var(--spacing-sm);
    }
  }
</style>
