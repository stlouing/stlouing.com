---
import Nav from './Nav.astro'
import ThemeToggle from './ThemeToggle.astro'
import { href } from '../lib/url'

interface Props {
  trail: Array<any>
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="site-name" href={href('/')}>
      <img class="stlouis-flag" src={href('/stlflag.png')} alt="" width="32" height="32" /> St.
      Louing
    </a>
    <div class="header-actions">
      <Nav />
      <ThemeToggle />
    </div>
  </div>
</header>

{
  /* Masthead strip: the rules run full-bleed edge-to-edge, while the caption
   stays in the 880px `.wrap` so it lines up with the nav above. */
}
<div class="masthead">
  <div class="masthead-rule"></div>
  <div class="wrap">
    <div class="masthead-line">
      <span class="masthead-left">An Independent Guide</span>
      <span class="masthead-middle">St. Louis, Missouri</span>
      <span class="masthead-right">est. 2026</span>
    </div>
  </div>
  <div class="masthead-rule-thin"></div>
  <div class="masthead-rule-thin"></div>
</div>

<script>
  // Publish the sticky header's height so in-page anchors (:target) can offset
  // by it. Tracks wrapping/resize so the offset stays correct across breakpoints.
  const header = document.querySelector<HTMLElement>('.site-header')
  if (header) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`)
    setHeight()
    window.addEventListener('resize', setHeight)
  }
</script>

<style>
  /* Thick line stacked over a thin line: the element's own top border is thick,
     its bottom border thin, and its height opens the gap between them. */
  .masthead-rule {
    height: 2px;
    border-block-start: 1px solid var(--color-line-contrast);
    border-block-end: 1px solid var(--color-line-contrast);
  }
  .masthead-rule-thin {
    height: 1px;
    border-block-end: 1px solid var(--color-line-contrast);

    &:last-of-type {
      margin-top: 2px;
    }
  }

  .masthead-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-muted);
    font-weight: 500;
  }

  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-block-end: 1px solid var(--color-line-contrast);
    padding-block: var(--spacing-sm);
    background: var(--color-background);
    transform: translateZ(0);
    isolation: isolate;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  a.site-name {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--font-size-md);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-weight: 700;

    &:hover {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 2px;
    }
  }

  /* Mobile: name + theme toggle on the top row, nav stacked below as an even
     three-column grid. Desktop (above) is unchanged. */
  @media (max-width: 700px) {
    /* The masthead caption is too cramped to read on a phone — drop it. */
    .masthead {
      display: none;
    }

    /* No bottom padding — the nav toolbar sits flush on the header's bottom
       border, so its cell dividers connect top line to bottom line. */
    .site-header {
      padding-block: var(--spacing-sm) 0;
    }

    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name theme'
        'nav nav';
      align-items: center;
      column-gap: var(--spacing-md);
      row-gap: var(--spacing-sm);
    }

    .site-name {
      grid-area: name;
    }

    /* Unwrap the actions so the nav and toggle place into the grid independently
       (display:contents keeps them as DOM children but drops the wrapper box). */
    .header-actions {
      display: contents;
    }

    .header-actions :global(.theme-toggle) {
      grid-area: theme;
      justify-self: end;
    }

    .header-actions :global(.site-nav) {
      grid-area: nav;
      display: flex;
      justify-content: start;
      /* No column gap — the nav's toolbar cells pad themselves off their
         dividers. Negative margins cancel the .wrap inline padding so the
         toolbar runs edge to edge. */
      column-gap: 0;
      row-gap: var(--spacing-xs);
      margin-inline: calc(-1 * var(--spacing-md));
      width: calc(100% + 2 * var(--spacing-md));
      /* The rule separating the name row above from the toolbar. */
      border-block-start: 1px solid var(--color-line);
    }
  }
</style>
