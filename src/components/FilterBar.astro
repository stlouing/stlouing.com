---
interface Facet {
  label: string
  facet: string
  options: (string | { value: string; label: string })[]
}

interface SortOption {
  label: string
  value: string
}

interface Props {
  label: string
  count: number
  facets: Facet[]
  searchPlaceholder?: string
  sorts?: SortOption[]
  search?: boolean
}

const {
  label,
  count,
  facets,
  searchPlaceholder = 'name...',
  sorts = [],
  search = true,
} = Astro.props
---

<form class="filters" role="search" aria-label={`Filter ${label}`}>
  {
    facets.map((facet) => (
      <p class="field">
        <label for={facet.facet}>{facet.label}</label>
        <select
          id={facet.facet}
          data-filter-facet={facet.facet}
          data-filter-label={facet.label}
          autocomplete="off">
          <option value="">All</option>
          {facet.options.map((option) => {
            const value = typeof option === 'string' ? option : option.value
            const optionLabel = typeof option === 'string' ? option : option.label

            return <option value={value}>{optionLabel}</option>
          })}
        </select>
      </p>
    ))
  }
  {
    sorts.length > 0 && (
      <p class="field">
        <label for="sort">Sort</label>
        <select id="sort" data-filter-sort>
          {sorts.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </p>
    )
  }
  {
    search && (
      <p class="field">
        <label for="q">Search</label>
        <input
          id="q"
          type="search"
          placeholder={searchPlaceholder}
          autocomplete="off"
          data-filter-search
        />
      </p>
    )
  }
</form>
