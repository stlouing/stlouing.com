---
interface Facet {
  label: string
  facet: string
  options: string[]
}

interface Props {
  label: string
  count: number
  facets: Facet[]
  searchPlaceholder?: string
}

const { label, count, facets, searchPlaceholder = 'name…' } = Astro.props
---

<form class="filters" role="search" aria-label={`Filter ${label}`}>
  <p class="field">
    <label for="q">Search</label>
    <input
      id="q"
      type="search"
      placeholder={searchPlaceholder}
      autocomplete="off"
      data-filter-search
    />
  </p>
  {
    facets.map((facet) => (
      <p class="field">
        <label for={facet.facet}>{facet.label}</label>
        <select id={facet.facet} data-filter-facet={facet.facet}>
          <option value="">All</option>
          {facet.options.map((option) => (
            <option value={option}>{option}</option>
          ))}
        </select>
      </p>
    ))
  }
  <!-- <p class="count"><span data-filter-count>{count}</span> {label}</p> -->
</form>
