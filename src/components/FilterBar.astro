---
interface Facet {
  label: string
  facet: string
  options: string[]
}

interface SortOption {
  label: string
  // "field:direction", e.g. "title:asc" or "rating:desc"; matches data-sort-<field>.
  value: string
}

interface Props {
  label: string
  count: number
  facets: Facet[]
  searchPlaceholder?: string
  sorts?: SortOption[]
}

const { label, count, facets, searchPlaceholder = 'name...', sorts = [] } = Astro.props
---

<form class="filters" role="search" aria-label={`Filter ${label}`}>
  {
    facets.map((facet) => (
      <p class="field">
        <label for={facet.facet}>{facet.label}</label>
        <select
          id={facet.facet}
          data-filter-facet={facet.facet}
          data-filter-label={facet.label}
          autocomplete="off">
          <option value="">All</option>
          {facet.options.map((option) => (
            <option value={option}>{option}</option>
          ))}
        </select>
      </p>
    ))
  }
  {
    sorts.length > 0 && (
      <p class="field">
        <label for="sort">Sort</label>
        <select id="sort" data-filter-sort>
          {sorts.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </p>
    )
  }
  <p class="field">
    <label for="q">Search</label>
    <input
      id="q"
      type="search"
      placeholder={searchPlaceholder}
      autocomplete="off"
      data-filter-search
    />
  </p>
</form>
