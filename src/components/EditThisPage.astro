---
import IconPencil from '../assets/IconPencil.astro'
import { editUrl } from '../lib/site'

interface Props {
  path?: string
}

const { path } = Astro.props
---

{
  path && (
    <p class="edit-page">
      <a href={editUrl(path)} rel="noopener">
        <IconPencil />
        Found a mistake? Edit this page
      </a>
    </p>
  )
}

<style>
  .edit-page {
    margin-block-start: var(--spacing-lg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);

    a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);

      &:hover {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
      }
    }
  }
</style>
