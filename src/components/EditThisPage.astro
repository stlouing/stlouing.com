---
import IconPencil from '../assets/IconPencil.astro'
import { editUrl } from '../lib/site'

interface Props {
  path?: string
  // Drop the standalone top margin when placed in a header/meta row.
  inline?: boolean
}

const { path, inline = false } = Astro.props
---

{
  path && (
    <p class:list={['edit-page', { inline }]}>
      <a href={editUrl(path)} rel="noopener">
        <IconPencil />
        Edit this page
      </a>
    </p>
  )
}

<style>
  .edit-page {
    margin-block-start: var(--spacing-lg);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);

    &.inline {
      margin: 0;
    }

    a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);

      &:hover {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
      }
    }
  }

  /* Desktop-only chrome — hide the edit link on narrow screens. */
  @media (max-width: 700px) {
    .edit-page {
      display: none;
    }
  }
</style>
