---
// Shared row for the Food/Hikes filterable list+map (rendered inside List, within
// FilterMapPage). Owns the markup the filter script + map depend on (the `<li>`
// with `data-filter-item` and the `data-*` values); each page fills the slots:
//   lead         — left column, e.g. a rating badge
//   title-after  — inline beside the name, e.g. the neighborhood
//   row-end      — right of the headline, e.g. cuisine chips
//   sub          — a second meta line, e.g. the address
//   (default)    — the panel revealed when the row is expanded
// Styling lives in global.css (`.list-with-map …`) so it reaches the slotted bits.
import { href } from '../lib/url'
import IconArrowRight from '../assets/IconArrowRight.astro'

interface Props {
  id: string
  title: string
  // Canonical detail page; the "Read more" target inside the open panel.
  detailHref: string
  // Show the "Read more" deep link in the panel — only worth it when the
  // detail page holds more than the panel already shows (i.e. a real body).
  readMore?: boolean
  marker: string
  coords?: string
  url?: string
  search: string
  // Per-collection data-* attributes (facets + data-sort-*) spread onto the <li>.
  attrs?: Record<string, string>
}

const {
  id,
  title,
  detailHref,
  readMore = true,
  marker,
  coords = '',
  url = '',
  search,
  attrs = {},
} = Astro.props
---

<li
  id={id}
  data-filter-item
  data-coords={coords}
  data-title={title}
  data-url={url}
  data-marker={marker}
  data-search={search}
  {...attrs}>
  <div class="list-details">
    {
      Astro.slots.has('lead') && (
        <div class="list-lead">
          <slot name="lead" />
        </div>
      )
    }
    <div class="list-main">
      <div class="list-row">
        <div class="list-headline">
          <a class="list-title" href={href(detailHref)}>{title}</a>
          <slot name="title-after" />
        </div>
        <slot name="row-end" />
      </div>
      {
        Astro.slots.has('sub') && (
          <div class="list-sub">
            <slot name="sub" />
          </div>
        )
      }
    </div>
  </div>
  <div class="list-description">
    <slot />
    {
      readMore && (
        <a class="more" href={href(detailHref)}>
          Read more <IconArrowRight />
        </a>
      )
    }
  </div>
</li>
