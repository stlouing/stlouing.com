---
// Shared detail-page shell for collection entries (food, hikes, notes, topics):
// the article header (title, a `meta` row, tags), the body, and a backlinks
// footer. Passing `permalink` marks it up as an IndieWeb h-entry
// (notes/topics); without it, it's a plain directory entry (food/hikes).
//
// Slots: `lede` (under the title), `meta` (the meta row), `header-extra` (after
// the meta row, e.g. an address), `footer-meta` (the quiet last-updated byline at
// the foot of the article), and the default slot (the body). The Share + Feedback
// buttons ride top-right of the header on every entry page.
import TagList from './TagList.astro'
import Backlinks from './Backlinks.astro'
import NewsletterSignup from './NewsletterSignup.astro'
import ShareActions from './ShareActions.astro'
import Byline from './Byline.astro'
import { href } from '../lib/url'
import type { Backlink } from '../lib/backlinks'

interface Props {
  title: string
  tags?: string[]
  backlinks?: Backlink[]
  permalink?: string
  // Whether Entry renders the last-updated byline itself, after the body. Pages
  // whose body holds trailing sections (e.g. food/neighborhood "More in…" lists)
  // pass `share={false}` and render <Byline> at the right spot.
  share?: boolean
}

const { title, tags = [], backlinks = [], permalink, share = true } = Astro.props
const isArticle = Boolean(permalink)
---

<article class:list={['entry', { 'h-entry': isArticle }]}>
  <header class="entry-header">
    <div class="entry-headline">
      <h1 class:list={{ 'p-name': isArticle }}>{title}</h1>
      <div class="entry-headline-sub">
        <div class="entry-headline-lede">
          <slot name="lede" />
        </div>
        <div class="entry-headline-actions">
          <ShareActions title={title} />
        </div>
      </div>
    </div>

    {
      (Astro.slots.has('meta') || tags.length > 0) && (
        <div class="entry-bar">
          <div class="meta">
            <slot name="meta" />
            <TagList tags={tags} />
          </div>
        </div>
      )
    }

    <slot name="header-extra" />
    {
      isArticle && (
        <>
          <a class="u-url" rel="bookmark" href={permalink} hidden>
            Permalink
          </a>
          <a class="p-author h-card" rel="author" href={href('/')} hidden>
            St. Louing
          </a>
        </>
      )
    }
  </header>

  <div class:list={['body', { 'e-content': isArticle }]}>
    <slot />
  </div>

  {
    share && Astro.slots.has('footer-meta') && (
      <Byline>
        <Fragment slot="footer-meta">
          <slot name="footer-meta" />
        </Fragment>
      </Byline>
    )
  }

  <footer>
    <Backlinks links={backlinks} />
  </footer>
</article>

{/* Full-width newsletter band: the flag "river" spans edge to edge, the signup
    stays wrap-width, and the real site footer follows below. */}
<section class="entry-newsletter">
  <NewsletterSignup compact />
</section>

<style>
  /* The title owns the full measure (long titles were wrapping early when it
     shared a row with the buttons); the lede and the Share / Feedback buttons
     share the row beneath it, buttons right-aligned on the lede line. */
  .entry-headline-sub {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .entry-headline-lede {
    min-width: 0;
  }

  .entry-headline-actions {
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  /* Stack on narrow screens: buttons drop below the lede, left-aligned. */
  @media screen and (max-width: 700px) {
    .entry-headline-sub {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }

    .entry-headline-actions {
      margin-inline-start: 0;
    }
  }

  /* Break the newsletter band out of the centered .wrap so its river runs edge to
     edge; the signup inside re-constrains to the measure. */
  .entry-newsletter {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block-start: var(--spacing-xl);
  }
</style>
