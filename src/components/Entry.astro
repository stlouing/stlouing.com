---
// Shared detail-page shell for collection entries (food, hikes, notes, topics):
// the article header (title, a `meta` row, tags), the body, and a backlinks
// footer. Passing `permalink` marks it up as an IndieWeb h-entry
// (notes/topics); without it, it's a plain directory entry (food/hikes).
//
// Slots: `lede` (under the title), `meta` (the meta row), `header-extra`
// (after the meta row, e.g. an address), `footer-meta` (the quiet
// last-updated byline at the foot of the article), and the default slot (the
// body).
import TagList from './TagList.astro'
import Backlinks from './Backlinks.astro'
import Byline from './Byline.astro'
import { href } from '../lib/url'
import type { Backlink } from '../lib/backlinks'

interface Props {
  title: string
  tags?: string[]
  backlinks?: Backlink[]
  permalink?: string
  // Whether Entry renders the last-updated byline itself, after the body. Pages
  // whose body holds trailing sections (e.g. food/neighborhood "More in…" lists)
  // pass `share={false}` and render <Byline> at the right spot.
  share?: boolean
}

const { title, tags = [], backlinks = [], permalink, share = true } = Astro.props
const isArticle = Boolean(permalink)
---

<article class:list={['entry', { 'h-entry': isArticle }]}>
  <header class="entry-header entry-header-with-flag">
    <div class="entry-headline">
      <h1 class:list={{ 'p-name': isArticle }}>{title}</h1>
      <div class="entry-headline-sub">
        <div class="entry-headline-lede">
          <slot name="lede" />
        </div>
      </div>
      <div class="river-border-basic" aria-hidden="true"></div>
    </div>

    {
      (Astro.slots.has('meta') || tags.length > 0) && (
        <div class="entry-bar">
          <div class="meta">
            <slot name="meta" />
            <TagList tags={tags} />
          </div>
        </div>
      )
    }

    <slot name="header-extra" />
    {
      isArticle && (
        <>
          <a class="u-url" rel="bookmark" href={permalink} hidden>
            Permalink
          </a>
          <a class="p-author h-card" rel="author" href={href('/')} hidden>
            St. Louing
          </a>
        </>
      )
    }
  </header>

  <div class:list={['body', { 'e-content': isArticle }]}>
    <slot />
  </div>

  {
    share && Astro.slots.has('footer-meta') && (
      <Byline>
        <Fragment slot="footer-meta">
          <slot name="footer-meta" />
        </Fragment>
      </Byline>
    )
  }

  <footer>
    <Backlinks links={backlinks} />
  </footer>
</article>

<style>
  .entry-headline-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .entry-headline-lede {
    min-width: 0;
    max-width: 600px;
  }
</style>
