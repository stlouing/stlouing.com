---
import Backlinks from './Backlinks.astro'
import ShareCard from './ShareCard.astro'
import Byline from './Byline.astro'
import PageMasthead from './PageMasthead.astro'
import { href } from '../lib/url'
import { SITE_NAME, SUPABASE_ENABLED } from '../lib/site'
import type { Backlink } from '../lib/backlinks'

interface Props {
  title: string
  backlinks?: Backlink[]
  permalink?: string
  eyebrow?: string
}

const {
  title,
  backlinks = [],
  permalink,
  eyebrow,
} = Astro.props
const isArticle = Boolean(permalink)
const hasComments = SUPABASE_ENABLED && Astro.slots.has('comments')
---

<article class:list={['entry', { 'h-entry': isArticle }]}>
  <header>
    <PageMasthead
      title={title}
      eyebrow={eyebrow}
      actions
      headingClass={isArticle ? 'p-name title-page--article' : 'title-page--article'}
      commentsAnchor={hasComments}>
      <slot name="lede" slot="lede" />
      {
        Astro.slots.has('footer-meta') && (
          <Byline author slot="byline">
            <Fragment slot="footer-meta">
              <slot name="footer-meta" />
            </Fragment>
          </Byline>
        )
      }
    </PageMasthead>

    {
      Astro.slots.has('meta') && (
        <div class="entry-bar">
          <div class="meta">
            <slot name="meta" />
          </div>
        </div>
      )
    }

    <slot name="header-extra" />
    {
      isArticle && (
        <>
          <a class="u-url" rel="bookmark" href={permalink} hidden>
            Permalink
          </a>
          <a class="p-author h-card" rel="author" href={href('/')} hidden>
            {SITE_NAME}
          </a>
        </>
      )
    }
  </header>

  <div class:list={['body', { 'e-content': isArticle }]}>
    <slot />
  </div>

  <ShareCard shareTitle={title} />

  {
    hasComments && (
      <div class="entry-comments">
        <slot name="comments" />
      </div>
    )
  }

</article>

