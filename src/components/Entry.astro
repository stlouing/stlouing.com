---
import TagList from './TagList.astro'
import Backlinks from './Backlinks.astro'
import Byline from './Byline.astro'
import PageMasthead from './PageMasthead.astro'
import { href } from '../lib/url'
import { SITE_NAME, SUPABASE_ENABLED } from '../lib/site'
import type { Backlink } from '../lib/backlinks'

interface Props {
  title: string
  tags?: string[]
  backlinks?: Backlink[]
  permalink?: string
  share?: boolean
  eyebrow?: string
}

const {
  title,
  tags = [],
  backlinks = [],
  permalink,
  share = true,
  eyebrow,
} = Astro.props
const isArticle = Boolean(permalink)
const hasComments = SUPABASE_ENABLED && Astro.slots.has('comments')
---

<article class:list={['entry', { 'h-entry': isArticle }]}>
  <header>
    <PageMasthead
      title={title}
      eyebrow={eyebrow}
      actions
      headingClass={isArticle ? 'p-name' : undefined}
      commentsAnchor={hasComments}>
      <slot name="lede" slot="lede" />
    </PageMasthead>

    {
      (Astro.slots.has('meta') || tags.length > 0) && (
        <div class="entry-bar">
          <div class="meta">
            <slot name="meta" />
            <TagList tags={tags} />
          </div>
        </div>
      )
    }

    <slot name="header-extra" />
    {
      isArticle && (
        <>
          <a class="u-url" rel="bookmark" href={permalink} hidden>
            Permalink
          </a>
          <a class="p-author h-card" rel="author" href={href('/')} hidden>
            {SITE_NAME}
          </a>
        </>
      )
    }
  </header>

  <div class:list={['body', { 'e-content': isArticle }]}>
    <slot />
  </div>

  {
    share && Astro.slots.has('footer-meta') && (
      <Byline>
        <Fragment slot="footer-meta">
          <slot name="footer-meta" />
        </Fragment>
      </Byline>
    )
  }

  {
    hasComments && (
      <div class="entry-comments">
        <slot name="comments" />
      </div>
    )
  }

  <footer>
    <Backlinks links={backlinks} />
  </footer>
</article>

