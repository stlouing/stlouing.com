---
import { render } from 'astro:content'
import { getChangelog } from '../lib/changelog'
import { formatDay, formatMonthShort, isoDate } from '../lib/dates'
import { href } from '../lib/url'
import PanelHeading from './PanelHeading.astro'
import Icon from './Icon.astro'

const LATEST_UPDATE_COUNT = 5

const latestUpdates = await Promise.all(
  (await getChangelog()).slice(0, LATEST_UPDATE_COUNT).map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)
---

<section class="whats-new">
  <PanelHeading title="What's New" />
  {
    latestUpdates[0] && (
      <p class="dated-year eyebrow">{latestUpdates[0].date.getUTCFullYear()}</p>
    )
  }
  <ul class="divided-list dated-rows recent-list">
    {
      latestUpdates.map((update) => (
        <li>
          <time class="date-stamp" datetime={isoDate(update.date)}>
            <span class="eyebrow eyebrow--muted">{formatMonthShort(update.date)}</span>
            <span class="date-stamp-day">{formatDay(update.date)}</span>
          </time>
          <div class="changelog-body">
            <update.Content />
          </div>
        </li>
      ))
    }
  </ul>
  <div class="panel-footer panel-footer--end">
    <a class="continue-link" href={href('/updates/')}>
      All updates <Icon name="arrow-right" />
    </a>
  </div>
</section>

<style>
  .whats-new {
    min-width: 0;
  }

  .recent-list :global(p) {
    font-size: var(--font-size-sm);
  }
</style>
