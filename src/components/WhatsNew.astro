---
import { render } from 'astro:content'
import { getChangelog } from '../lib/changelog'
import { formatDate } from '../lib/dates'
import { href } from '../lib/url'
import PanelHeading from './PanelHeading.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'

const latestUpdates = await Promise.all(
  (await getChangelog()).slice(0, 2).map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)
---

<section class="whats-new panel">
  <PanelHeading title="What's New" />
  <ul class="divided-list">
    {
      latestUpdates.map(({ date, Content }) => (
        <li class="recent-item">
          <time class="recent-date eyebrow nowrap" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
          <div class="recent-changes changelog-body">
            <Content />
          </div>
        </li>
      ))
    }
  </ul>
  <a class="whats-new-all continue-link" href={href('/updates/')}>
    All updates <IconArrowRight />
  </a>
</section>

<style>
  .whats-new {
    min-width: 0;
  }

  .recent-item {
    display: grid;
    row-gap: var(--spacing-xs);
    padding-block: var(--spacing-md);
  }

  .recent-item:first-child {
    padding-block-start: 0;
  }

  .recent-item:last-child {
    padding-block-end: 0;
  }

  .recent-date {
    text-align: center;
  }

  .recent-changes :global(p) {
    font-size: var(--font-size-sm);
  }

  .recent-changes :global(a) {
    color: var(--color-text-heading);
    font-weight: 600;
    text-decoration-line: none;
  }

  .recent-changes :global(a:hover) {
    color: var(--color-accent-blue);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent-blue);
  }

  .whats-new-all {
    display: block;
    text-align: end;
    margin-block-start: var(--spacing-sm);
  }
</style>
