---
// One row in a RelatedList: a leading mark (a cuisine emoji, or a line icon via
// the `icon` slot) beside a column of an optional muted mono kicker (the meta)
// over the serif name, plus an optional one-line description. Trailing slot holds
// a stat, rating, or verdict, then a navigation affordance (a right arrow for
// internal links, an external-link icon for outbound ones, nothing for non-links).
import IconArrowRight from '../assets/IconArrowRight.astro'
import IconExternalLink from '../assets/IconExternalLink.astro'
import IconStar from '../assets/IconStar.astro'
import VerdictChip from './Verdict.astro'
import TagIcon from './TagIcon.astro'
import { cuisineLabel } from '../lib/cuisine'
import type { Verdict } from '../lib/verdict'

interface Props {
  // When given, the row is a link; otherwise it renders as a plain row.
  href?: string
  title: string
  // The kicker text above the name (cuisine, neighborhood, event date, …).
  meta?: string
  // The kicker as discrete parts instead, joined by the map lists' hairline
  // tick dividers rather than punctuation. Wins over `meta` when present.
  metaParts?: string[]
  // How to render `meta`: 'cuisine' maps the key to its label; anything else is
  // shown verbatim.
  metaType?: 'cuisine' | 'neighborhood' | 'date' | 'text'
  // Optional verdict, shown as a Chip before the trailing affordance.
  verdict?: Verdict
  // Optional right-aligned secondary stat (e.g. a neighborhood's population).
  stat?: string
  // Optional leading emoji (e.g. a cuisine glyph). Mutually exclusive with the
  // `icon` slot.
  emoji?: string
  // Optional 0–10 score, rendered as a trailing accent star badge.
  rating?: number
  // Optional one-line description beneath the name.
  description?: string
  // Optional vibe tags, rendered as small chips beneath the description. Plain
  // spans (not links), since the card itself may already be a link.
  tags?: string[]
  // Open the link in a new tab (uses the external-link affordance).
  external?: boolean
}

const {
  href,
  title,
  meta,
  metaParts = [],
  metaType = 'cuisine',
  verdict,
  stat,
  emoji,
  rating,
  description,
  tags = [],
  external = false,
} = Astro.props

const hasIcon = Astro.slots.has('icon')
const Tag = href ? 'a' : 'div'
const linkAttributes = href
  ? external
    ? { href, target: '_blank', rel: 'noopener' }
    : { href }
  : {}
---

<Tag
  class:list={['related-card', { 'has-description': description || tags.length > 0 }]}
  {...linkAttributes}>
  {
    emoji && (
      <span class="related-lead" aria-hidden="true">
        {emoji}
      </span>
    )
  }
  {
    hasIcon && (
      <span class="related-lead related-lead-icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <span class="related-body">
    {
      metaParts.length > 0 ? (
        <span class="related-kicker eyebrow eyebrow--muted">
          {metaParts.map((part, partIndex) => (
            <>
              {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
              {part}
            </>
          ))}
        </span>
      ) : (
        meta && (
          <span class="related-kicker eyebrow eyebrow--muted">{metaType === 'cuisine' ? cuisineLabel(meta) : meta}</span>
        )
      )
    }
    <span class="related-title title-link">{title}</span>
    {description && <p class="related-desc desc-muted">{description}</p>}
    {
      tags.length > 0 && (
        <span class="related-tags" aria-hidden="true">
          {tags.map((tag) => (
            <span class="related-tag">
              <TagIcon tag={tag} />
              {tag}
            </span>
          ))}
        </span>
      )
    }
  </span>
  {stat && <span class="related-stat">{stat}</span>}
  {
    rating != null && (
      <span class="related-rating">
        <IconStar />
        {rating}
      </span>
    )
  }
  {verdict && <VerdictChip verdict={verdict} icon narrow filled />}
  {
    href && (
      <span class="related-arrow" aria-hidden="true">
        {external ? <IconExternalLink /> : <IconArrowRight />}
      </span>
    )
  }
</Tag>

<style>
  /* The base (homepage rail) voice hides the leading mark and trailing arrow;
     rows with a description top-align so the lead lines up with the name's
     first line. */
  .related-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-shmedium) 0;
    border-block-end: 1px dotted var(--color-line-input);
    text-decoration: none;
    color: var(--color-text);
  }

  .related-lead,
  .related-arrow {
    display: none;
  }

  /* Whole-row hover wash (matching the directory + map-list rows). A pseudo-element
     behind the content so the resting layout and the full-width divider stay put,
     while the highlight extends slightly past the text with rounded corners. */
  a.related-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    background: var(--color-wash);
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  a.related-card:hover::before {
    opacity: 1;
  }

  .related-card.has-description {
    align-items: flex-start;
  }

  .related-card:last-child {
    border-block-end: 0;
  }

  .related-lead {
    flex-shrink: 0;
    font-size: var(--font-size-xl);
    line-height: 1;
  }

  .related-lead-icon {
    display: inline-flex;
  }

  .related-lead-icon :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }

  /* Nudge the icon down to optically align with the first text line in tall,
     description-bearing rows. */
  .related-card.has-description .related-lead-icon :global(.icon) {
    margin-block-start: 2px;
  }

  .related-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: 2px;
  }

  /* The flex gap spaces the bare .eyebrow-divider ticks. */
  .related-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    line-height: 1.2;
  }

  .related-desc {
    margin: 0;
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-block-start: var(--spacing-xs);
  }

  .related-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--color-muted-2);
    border: 1px solid var(--color-line);
    padding: 1px var(--spacing-sm);
    line-height: 1.4;
    background: var(--color-surface);
  }

  .related-tag :global(.icon) {
    width: 0.9em;
    height: 0.9em;
  }

  .related-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-accent);
  }

  /* The global `.icon` rule pins icons muted, so set the accent color here (not
     via currentColor) and fill the star so it reads as a solid accent mark. */
  .related-rating :global(.icon) {
    width: 0.9em;
    height: 0.9em;
    color: var(--color-accent);
    fill: currentColor;
    stroke: currentColor;
  }

  .related-stat {
    flex-shrink: 0;
    text-align: end;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
