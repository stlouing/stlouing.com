---
// One row in a RelatedList: a leading mark (a cuisine emoji, or a line icon via
// the `icon` slot) beside a column of an optional muted mono kicker (the meta)
// over the serif name, plus an optional one-line description. Trailing slot holds
// a stat, rating, or verdict, then a navigation affordance (a right arrow for
// internal links, an external-link icon for outbound ones, nothing for non-links).
import IconArrowRight from '../assets/IconArrowRight.astro'
import IconExternalLink from '../assets/IconExternalLink.astro'
import IconStar from '../assets/IconStar.astro'
import VerdictChip from './Verdict.astro'
import TagIcon from './TagIcon.astro'
import { cuisineLabel } from '../lib/emoji'
import type { Verdict } from '../lib/verdict'

interface Props {
  // When given, the row is a link; otherwise it renders as a plain row.
  href?: string
  title: string
  // The kicker text above the name (cuisine, neighborhood, event date, …).
  meta?: string
  // How to render `meta`: 'cuisine' maps the key to its label; anything else is
  // shown verbatim.
  metaType?: 'cuisine' | 'neighborhood' | 'date' | 'text'
  // Optional verdict, shown as a Chip before the trailing affordance.
  verdict?: Verdict
  // Optional right-aligned secondary stat (e.g. a neighborhood's population).
  stat?: string
  // Optional leading emoji (e.g. a cuisine glyph). Mutually exclusive with the
  // `icon` slot.
  emoji?: string
  // Optional 0–10 score, rendered as a trailing accent star badge.
  rating?: number
  // Optional one-line description beneath the name.
  description?: string
  // Optional vibe tags, rendered as small chips beneath the description. Plain
  // spans (not links), since the card itself may already be a link.
  tags?: string[]
  // Open the link in a new tab (uses the external-link affordance).
  external?: boolean
}

const {
  href,
  title,
  meta,
  metaType = 'cuisine',
  verdict,
  stat,
  emoji,
  rating,
  description,
  tags = [],
  external = false,
} = Astro.props

const hasIcon = Astro.slots.has('icon')
const Tag = href ? 'a' : 'div'
const linkAttributes = href
  ? external
    ? { href, target: '_blank', rel: 'noopener' }
    : { href }
  : {}
---

<Tag
  class:list={['related-card', { 'has-description': description || tags.length > 0 }]}
  {...linkAttributes}>
  {
    emoji && (
      <span class="related-lead" aria-hidden="true">
        {emoji}
      </span>
    )
  }
  {
    hasIcon && (
      <span class="related-lead related-lead-icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <span class="related-body">
    {
      meta && (
        <span class="related-kicker">{metaType === 'cuisine' ? cuisineLabel(meta) : meta}</span>
      )
    }
    <span class="related-title">{title}</span>
    {description && <p class="related-desc">{description}</p>}
    {
      tags.length > 0 && (
        <span class="related-tags" aria-hidden="true">
          {tags.map((tag) => (
            <span class="related-tag">
              <TagIcon tag={tag} />
              {tag}
            </span>
          ))}
        </span>
      )
    }
  </span>
  {stat && <span class="related-stat">{stat}</span>}
  {
    rating != null && (
      <span class="related-rating">
        <IconStar />
        {rating}
      </span>
    )
  }
  {verdict && <VerdictChip verdict={verdict} icon narrow filled />}
  {
    href && (
      <span class="related-arrow" aria-hidden="true">
        {external ? <IconExternalLink /> : <IconArrowRight />}
      </span>
    )
  }
</Tag>

<style>
  /* One row per item, divided by a hairline (no divider after the last). The lead
     + trailing affordance sit on either side of the flex:1 body; rows with a
     description top-align so the lead lines up with the name's first line. */
  .related-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-block-end: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-text);
  }

  .related-card.has-description {
    align-items: flex-start;
  }

  /* No divider after the last row of a single column. Multi-column containers
     (e.g. On the List's grid) re-assert it so both stacks end on an even line. */
  .related-card:last-child {
    border-block-end: 0;
  }

  /* The leading mark: an emoji at the body's largest size, or a line icon recolored
     to the accent and sized to sit beside it. */
  .related-lead {
    flex-shrink: 0;
    font-size: var(--font-size-xl);
    line-height: 1;
  }

  .related-lead-icon {
    display: inline-flex;
  }

  .related-lead-icon :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }

  /* Nudge the icon down to optically align with the first text line in tall,
     description-bearing rows. */
  .related-card.has-description .related-lead-icon :global(.icon) {
    margin-block-start: 2px;
  }

  .related-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: var(--spacing-xs);
  }

  /* The meta as a muted mono kicker above the name. */
  .related-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-muted);
    line-height: 1.2;
  }

  /* The name reads as the Best page's serif card title. */
  .related-title {
    font-family: var(--font-body);
    font-size: var(--font-size-md);
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: 1.2;
    text-underline-offset: 2px;
  }

  .related-desc {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.3;
    font-size: var(--font-size-sm); 
  }

  /* Vibe tags: small mono pills beneath the description (e.g. a neighborhood's
     character). Plain, non-interactive — the row's own link carries the click. */
  .related-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-block-start: var(--spacing-xs);
  }

  .related-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-muted-2);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 1px var(--spacing-sm);
    line-height: 1.4;
    background: var(--color-surface);
  }

  .related-tag :global(.icon) {
    width: 0.9em;
    height: 0.9em;
  }

  .related-arrow {
    display: inline-flex;
    flex-shrink: 0;
  }

  /* Hover affordances only on actual links. */
  a.related-card:hover .related-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  a.related-card:hover .related-title,
  a.related-card:hover .related-arrow :global(.icon) {
    color: var(--color-accent);
  }

  /* A trailing rating badge: an accent star beside the 0–10 score, mono and
     tabular so scores line up down the column. */
  .related-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-accent);
  }

  /* The global `.icon` rule pins icons muted, so set the accent color here (not
     via currentColor) and fill the star so it reads as a solid accent mark. */
  .related-rating :global(.icon) {
    width: 0.9em;
    height: 0.9em;
    color: var(--color-accent);
    fill: currentColor;
    stroke: currentColor;
  }

  /* A right-aligned secondary stat (e.g. population): darker and heavier than the
     muted kicker, tabular so figures line up down the column. */
  .related-stat {
    flex-shrink: 0;
    text-align: end;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
