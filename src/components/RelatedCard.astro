---
// One row in a RelatedList: the entry name (body face, like a list title) over a
// quiet meta line — a context label (neighborhood, cuisine, region) and, optionally,
// the verdict as a Chip — with a trailing arrow centered against the whole row.
import IconArrowRight from '../assets/IconArrowRight.astro'
import VerdictChip from './Verdict.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import { cuisineEmoji, cuisineLabel } from '../lib/emoji'
import type { Verdict } from '../lib/verdict'

interface Props {
  href: string
  title: string
  // Left side of the meta line (e.g. the neighborhood, cuisine, or region).
  meta?: string
  // Optional verdict, shown as a Chip after the meta.
  verdict?: Verdict
  // Whether `meta` is a place (neighborhood/region) — body face with a map icon —
  // or a cuisine (mono tag). Controls the meta styling.
  metaType?: 'neighborhood' | 'cuisine'
  // Optional right-aligned secondary stat (e.g. a neighborhood's population),
  // styled distinctly from the left-side meta/location text.
  stat?: string
}

const { href, title, meta, verdict, metaType = 'cuisine', stat } = Astro.props
---

<a class="related-card" href={href}>
  <span class="related-body">
    <span class="related-title">{title}</span>
    {
      meta && (
        <span class="related-meta">
          <span class:list={['related-context', { 'is-place': metaType === 'neighborhood' }]}>
            {metaType === 'neighborhood' && (
              <>
                <IconMapPin /> {meta}
              </>
            )}
            {metaType === 'cuisine' && (
              <>
                <span class="related-emoji">{cuisineEmoji([meta])}</span>
                {cuisineLabel(meta)}
              </>
            )}
          </span>
        </span>
      )
    }
  </span>
  {stat && <span class="related-stat">{stat}</span>}
  {verdict && <VerdictChip verdict={verdict} icon narrow filled />}
  <span class="related-arrow" aria-hidden="true"><IconArrowRight /></span>
</a>

<style>
  /* One row per item, divided by a hairline (no divider after the last). The arrow
     is centered against the row; the title + meta stack on the left. */
  .related-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-block-end: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-text);
  }

  .related-card:last-child {
    border-block-end: 0;
  }

  .related-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: var(--spacing-xs);
  }

  /* Body face, a step up from the mono meta — reads as a heading, accent on hover. */
  .related-title {
    font-size: var(--font-size-md);
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: 1.2;
    text-underline-offset: 2px;
    font-family: var(--font-mono);
    letter-spacing: var(--letter-spacing-tight);
  }

  .related-arrow {
    display: inline-flex;
    flex-shrink: 0;
  }

  .related-card:hover .related-title {
    text-decoration-thickness: 2px;
    text-decoration: underline;
  }

  .related-card:hover .related-title,
  .related-card:hover .related-arrow :global(.icon) {
    color: var(--color-accent);
  }

  .related-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    line-height: 1;
  }

  .related-context {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  /* The cuisine emoji sits a touch larger than the mono tag it leads. */
  .related-emoji {
    font-size: var(--font-size-md);
  }

  /* A right-aligned secondary stat (e.g. population), pushed to the row's end by
     the flex:1 body. Distinct from the muted location meta: darker, heavier, and
     tabular so figures line up down the column. */
  .related-stat {
    flex-shrink: 0;
    text-align: end;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
