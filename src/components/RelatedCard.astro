---
// One row in a RelatedList: an optional leading icon (via the `icon` slot)
// beside a column of an optional muted kicker over the serif name, plus an
// optional one-line description and tag chips. An optional verdict trails as
// a fleur rating. Callers pass display-ready kicker text (map cuisine keys
// through cuisineLabel() at the call site); an array renders its parts joined
// by the shared hairline tick dividers.
import Rating from './Rating.astro'
import TagIcon from './TagIcon.astro'
import type { Verdict } from '../lib/verdict'

interface Props {
  // When given, the row is a link; otherwise it renders as a plain row.
  href?: string
  title: string
  // The kicker above the name (cuisine, neighborhood, event date, …) — a
  // string, or parts joined by hairline tick dividers.
  meta?: string | string[]
  // Optional verdict, shown as a trailing fleur rating; unrated places simply
  // show nothing.
  verdict?: Verdict
  // Optional one-line description beneath the name.
  description?: string
  // Optional vibe tags, rendered as small chips beneath the description. Plain
  // spans (not links), since the card itself may already be a link.
  tags?: string[]
  // Open the link in a new tab.
  external?: boolean
}

const { href, title, meta, verdict, description, tags = [], external = false } = Astro.props

const metaParts = (Array.isArray(meta) ? meta : [meta]).filter(
  (part): part is string => Boolean(part),
)
const hasIcon = Astro.slots.has('icon')
const Tag = href ? 'a' : 'div'
const linkAttributes = href
  ? external
    ? { href, target: '_blank', rel: 'noopener' }
    : { href }
  : {}
---

<Tag
  class:list={['related-card', { 'has-description': description || tags.length > 0 }]}
  {...linkAttributes}>
  {
    hasIcon && (
      <span class="related-lead" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <span class="related-body">
    {
      metaParts.length > 0 && (
        <span class="related-kicker eyebrow eyebrow--muted">
          {metaParts.map((part, partIndex) => (
            <>
              {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
              {part}
            </>
          ))}
        </span>
      )
    }
    <span class="title-serif title-link">{title}</span>
    {description && <p class="related-desc desc-muted">{description}</p>}
    {
      tags.length > 0 && (
        <span class="related-tags" aria-hidden="true">
          {tags.map((tag) => (
            <span class="related-tag">
              <TagIcon tag={tag} />
              {tag}
            </span>
          ))}
        </span>
      )
    }
  </span>
  {verdict && <Rating verdict={verdict} />}
</Tag>

<style>
  .related-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-shmedium) 0;
    border-block-end: 1px dotted var(--color-line-input);
    text-decoration: none;
    color: var(--color-text);
  }

  a.related-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    background: var(--color-wash);
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  a.related-card:hover::before {
    opacity: 1;
  }

  .related-card.has-description {
    align-items: flex-start;
  }

  .related-card:last-child {
    border-block-end: 0;
  }

  .related-lead {
    display: inline-flex;
    flex-shrink: 0;
  }

  .related-lead :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }

  .related-card.has-description .related-lead :global(.icon) {
    margin-block-start: 2px;
  }

  .related-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: 2px;
  }

  .related-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    line-height: 1.2;
  }

  .related-desc {
    margin: 0;
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    margin-block-start: var(--spacing-sm);
  }

  .related-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--color-muted-2);
    border: 1px solid var(--color-line);
    padding: 1px var(--spacing-sm);
    line-height: 1.4;
    background: var(--color-surface);
  }

  .related-tag :global(.icon) {
    width: 0.9em;
    height: 0.9em;
  }

  .related-card :global(.rating .rating-fleur) {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
