---
import Button from './Button.astro'
import { hostLabel } from '../lib/links'

interface Props {
  href?: string
  label?: string
  variant?: 'outline' | 'dark' | 'quiet'
  compact?: boolean
  class?: string
}

const { href: linkHref, label, variant = 'outline', compact = true, class: className } = Astro.props
const text = label ?? (linkHref ? hostLabel(linkHref) : '')
---

{
  linkHref && (
    <Button
      href={linkHref}
      variant={variant}
      compact={compact}
      class={className}
      target="_blank"
      rel="noopener">
      <slot name="icon" />
      {text}
    </Button>
  )
}
