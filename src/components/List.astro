---
interface Props {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class:list={[className]} {...rest}>
  <ul class="list">
    <slot />
  </ul>
</div>

<style>
  ul.list {
    list-style: none;
    margin: 0;
    padding: 0;

    .list-description {
      color: var(--color-muted);
      font-weight: 400;
      line-height: 1.5;

      &:last-child {
        margin-block-end: 0;
      }

      p:first-child {
        margin-block-start: var(--spacing-sm);
      }

      p:last-child {
        margin-block-end: 0;
      }
    }

    time + .list-description {
      margin-block-start: var(--spacing-sm);
    }

    .list-meta {
      font-size: var(--font-size-xxs);
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-weight: 500;
      font-style: normal;
      white-space: nowrap;
    }

    button.list-meta {
      &:hover {
        color: var(--color-text);
      }
    }

    time.list-meta {
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
    }

    /* The row's vertical padding lives on the link inside (.list-item) so the
       hover highlight covers the whole row; the divider stays on the li. */
    > li {
      margin: 0;
      border-block-end: 1px solid var(--color-line);

      &:last-child {
        border: none;
      }
    }

    .list-title {
      display: block;
      font-weight: 600;
      color: var(--color-text-heading);
      text-decoration: none;
      font-size: var(--font-size-md);
      font-family: var(--font-mono);
      line-height: 1.2;

      + .list-description {
        margin-block-start: 0;
      }
    }

    .list-details {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--spacing-md);
      row-gap: 0;
    }

    .list-details-content {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }
  }
</style>
