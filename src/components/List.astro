---
interface Props {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class:list={[className]} {...rest}>
  <ul class="list">
    <slot />
  </ul>
</div>

<style>
  ul.list {
    list-style: none;
    margin: 0;
    padding: 0;

    .list-description {
      color: var(--color-text-muted);
      font-size: var(--font-size-md);
      font-weight: 400;

      &:last-child {
        margin-block-end: 0;
      }

      p:first-child {
        margin-block-start: var(--spacing-sm);
      }

      p:last-child {
        margin-block-end: 0;
      }
    }

    time + .list-description {
      margin-block-start: var(--spacing-sm);
    }

    .list-meta {
      font-size: var(--font-size-xs);
      color: var(--color-text-muted-2);
      font-family: var(--font-mono);
      font-weight: 500;
      font-style: normal;
      white-space: nowrap;
    }

    button.list-meta {
      &:hover {
        color: var(--color-text);
      }
    }

    time.list-meta {
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
    }

    > li {
      margin: 0;
      padding-block: var(--spacing-xs);
      border-block-end: 1px solid var(--color-line);

      &:last-child {
        border: none;
      }
    }

    a.list-title,
    .list-title {
      display: block;
      font-weight: 700;
      color: var(--color-text);
      text-decoration: none;

      + .list-description {
        margin-block-start: 0;
      }

      &:hover {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
      }
    }

    .list-details {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--spacing-md);
      row-gap: 0;
    }

    .list-details-content {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }
  }
</style>
