---
interface Props {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class:list={[className]} {...rest}>
  <ul class="list">
    <slot />
  </ul>
</div>

<style>
  ul.list {
    list-style: none;
    margin: 0;
    padding: 0;

    .list-description {
      font-size: var(--font-size-sm);
      color: var(--color-muted);
      font-weight: 400;
      line-height: 1.4;

      &:last-child {
        margin-block-end: 0;
      }

      p:first-child {
        margin-block-start: var(--spacing-sm);
      }

      p:last-child {
        margin-block-end: 0;
      }
    }

    time + .list-description {
      margin-block-start: var(--spacing-sm);
    }

    .list-meta {
      font-size: var(--font-size-xxs);
      color: var(--color-accent);
      font-family: var(--font-sans-serif);
      font-weight: 500;
      font-style: normal;
      white-space: nowrap;
    }

    button.list-meta {
      &:hover {
        color: var(--color-text);
      }
    }

    time.list-meta {
      font-family: var(--font-sans-serif);
      font-size: var(--font-size-sm);
    }

    > li {
      margin: 0;
      border-block-end: 1px solid var(--color-line);

      &:last-child {
        border: none;
      }
    }

    .list-title + .list-description {
      margin-block-start: 0;
    }

  }
</style>
