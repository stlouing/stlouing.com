---
import ShareButton from './ShareButton.astro'
import Icon from './Icon.astro'
import { INSTAGRAM_HANDLE } from '../lib/site'

interface Props {
  shareTitle?: string
  placement: string
}

const { shareTitle, placement } = Astro.props
---

<div class="share-actions">
  <ShareButton title={shareTitle} variant="dark" label="Share" trackAs={`share-${placement}`} />
  {
    INSTAGRAM_HANDLE && (
      <a
        class="btn share-actions-instagram"
        href={`https://www.instagram.com/${INSTAGRAM_HANDLE}/`}
        target="_blank"
        rel="noopener"
        data-goatcounter-click={`instagram-${placement}`}>
        <Icon name="instagram" />
        Follow @{INSTAGRAM_HANDLE}
      </a>
    )
  }
</div>

<style>
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .share-actions :global(.btn) {
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-md);
    font-weight: 700;
    text-transform: none;
  }

  .share-actions-instagram {
    border: 0;
    background: var(--gradient-instagram-linear);
    color: var(--color-bar-text);
  }

  .share-actions-instagram:hover {
    color: var(--color-bar-text);
    filter: brightness(1.08);
  }

  @media (max-width: 700px) {
    .share-actions :global(.btn) {
      flex: 1 1 auto;
      justify-content: center;
      padding-inline: var(--spacing-sm);
      font-size: var(--font-size-sm);
    }

    .share-actions :global(.icon) {
      width: 1.125rem;
      height: 1.125rem;
    }
  }
</style>
