---
// The Share + Feedback buttons, shown top-right of an entry header (aligned
// with the title + lede). `title` seeds the native share payload.
import ShareButton from './ShareButton.astro'
import Button from './Button.astro'
import IconMessageCircleHeart from '../assets/IconMessageCircleHeart.astro'
import { href } from '../lib/url'

interface Props {
  title?: string
}

const { title } = Astro.props
---

<div class="share-actions">
  <ShareButton title={title} label="Share" variant="outline" compact class="share-pill" />
  <Button href={href('/feedback/')} variant="outline" compact class="share-pill">
    <IconMessageCircleHeart />
    Feedback
  </Button>
</div>

<style>
  .share-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);

    svg {
      height: 16px;
      width: 16px;
    }
  }

  .share-actions :global(.share-pill) {
    background: transparent;
  }
</style>
