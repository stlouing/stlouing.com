---
interface Props {
  variant?: 'button' | 'text'
}

const { variant = 'button' } = Astro.props
---

{
  variant === 'text' ? (
    <button type="button" class="text-button" data-filter-clear hidden>
      Clear filters
    </button>
  ) : (
    <button type="button" class="btn btn-dark btn-compact filter-clear" data-filter-clear hidden>
      Clear filters
    </button>
  )
}
