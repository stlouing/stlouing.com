---
import FleurGlyph from '../assets/FleurGlyph.astro'
import { fleurFills, ratingLabel } from '../lib/rating'

interface Props {
  rating?: number
}

const { rating } = Astro.props
---

<span class="rating" role="img" aria-label={ratingLabel(rating)}>
  {
    fleurFills(rating).map((fill) =>
      fill === 'half' ? (
        <span class="rating-half">
          <FleurGlyph class="rating-fleur" />
          <FleurGlyph class="rating-fleur is-filled" />
        </span>
      ) : (
        <FleurGlyph class:list={['rating-fleur', { 'is-filled': fill === 'full' }]} />
      ),
    )
  }
</span>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    vertical-align: -0.1em;
  }

  :where(.rating) :global(.rating-fleur) {
    width: 0.85em;
    height: 0.85em;
    max-width: none;
    color: color-mix(in srgb, var(--color-accent-gold) 26%, transparent);
  }

  .rating :global(.rating-fleur.is-filled) {
    color: var(--color-accent-gold);
  }
</style>
