---
// A star rating, shared by the Food list and detail pages.
import IconStar from '../assets/IconStar.astro'

interface Props {
  value: number
}

const { value } = Astro.props
---

<div class="rating">
  <IconStar />
  <span class="score"><span class="rating-value">{value}</span><span class="out-of">/10</span></span
  >
</div>

<style>
  .rating {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .score {
    line-height: 1;
    color: var(--color-text);
  }

  .rating-value {
    font-size: var(--font-size-lg);
  }

  .out-of {
    color: var(--color-text-muted);
    font-weight: 400;
    font-size: var(--font-size-sm);
  }

  /* Make the star a solid accent mark: fill it and override the shared muted
     `.icon` color so it reads as one unit with the number, not a gray outline. */
  .rating :global(svg) {
    color: var(--color-accent);
    fill: currentColor;
  }
</style>
