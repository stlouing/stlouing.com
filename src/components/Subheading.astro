---
interface Props {
  title: string
  level?: 2 | 3
}

const { title, level = 2 } = Astro.props
const Element = `h${level}` as 'h2' | 'h3'
---

<Element class="subheading">{title}</Element>

<style>
  .subheading {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-heading);
  }
</style>
