---
interface Props {
  level?: 2 | 3 | 4
  ruled?: boolean
}

const { level = 2, ruled = false } = Astro.props
const Element = `h${level}` as 'h2' | 'h3' | 'h4'
---

<div class:list={['subheading', 'heading-bar', { 'heading-bar--ruled': ruled }]}>
  <Element><slot /></Element>
  <slot name="aside" />
</div>

<style>
  .subheading {
    margin-block: 0 var(--spacing-md);
  }

  .subheading.heading-bar--ruled {
    margin-block-end: 0;
  }

  .subheading :is(h2, h3, h4) {
    margin: 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-heading);
  }

  .subheading h4 {
    font-size: var(--font-size-label);
  }
</style>
