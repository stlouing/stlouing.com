---
// The quiet aside label (Address, Links, My pick, the side cards): small
// bold uppercase, no rule.
interface Props {
  title: string
}

const { title } = Astro.props
---

<h2 class="aside-heading">{title}</h2>

<style>
  .aside-heading {
    margin: 0 0 var(--spacing-xs);
    padding-block-end: 3px;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-article);
    font-weight: 700;
    line-height: 1;
    letter-spacing: normal;
    color: var(--color-text-heading);
  }
</style>
