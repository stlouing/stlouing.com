---
// The ruled group-header row shared by the front page's sections and the
// related lists on detail pages: heavy black label on the left and, on the
// right, either a continue-link ("View all") or a muted kicker — both sitting
// on the label's baseline.
import IconArrowRight from '../assets/IconArrowRight.astro'

interface Props {
  title: string
  // When set, a continue-link renders on the right (e.g. the filtered food
  // list behind a "More in…" group).
  moreHref?: string
  moreLabel?: string
  // A muted uppercase note on the right instead of a link (the front page's
  // Maps group). Ignored when moreHref is set.
  kicker?: string
}

const { title, moreHref, moreLabel = 'View all', kicker } = Astro.props
---

<div class="group-header head-rule">
  <h2 class="group-label head-black">{title}</h2>
  {
    moreHref && (
      <a class="group-all continue-link" href={moreHref}>
        {moreLabel} <IconArrowRight />
      </a>
    )
  }
  {!moreHref && kicker && <span class="group-kicker eyebrow eyebrow--muted">{kicker}</span>}
</div>

<style>
  .group-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-block-end: var(--spacing-xs);
  }

  .group-header .group-label {
    margin: 0;
  }

  .group-kicker,
  .group-all {
    flex-shrink: 0;
  }
</style>
