---
// An inline locator map for a neighborhood page: the themed basemap framed to this
// one neighborhood, its boundary drawn as a single accent polygon. Renders a
// server-side placeholder box; the MapLibre chunk is imported only when the box
// nears the viewport (so a cold landing that never scrolls to it pays nothing).
interface Props {
  slug: string
  name?: string
  // Center [lat, lng] fallback for entries with no city-boundary polygon (county
  // municipalities): the locator draws a center pin instead of a polygon.
  coords?: [number, number]
  class?: string
}

const { slug, name, coords, class: className } = Astro.props
const label = name ? `Map of ${name} within St. Louis` : 'Neighborhood location within St. Louis'
---

<div
  class:list={['neighborhood-locator', className]}
  data-neighborhood-locator
  data-slug={slug}
  data-coords={coords ? coords.join(',') : undefined}
  role="img"
  aria-label={label}
>
</div>

<style>
  /* The placeholder before the map loads: a faint diagonal hatch that reads as a
     map while the chunk fetches (matches the food locator). */
  .neighborhood-locator {
    position: relative;
    height: 200px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 11px,
        color-mix(in srgb, var(--color-line-input) 28%, transparent) 11px 12px
      ),
      var(--color-background);
  }
</style>

<script>
  // Upgrade each placeholder into a map. MapLibre is heavy, so defer the dynamic
  // import until the locator nears the viewport (and keep it out of the main
  // bundle). Hidden boxes (the locator is desktop-only) never intersect, so mobile
  // pays nothing.
  const boxes = [...document.querySelectorAll<HTMLElement>('[data-neighborhood-locator]')]

  if (boxes.length) {
    const upgrade = (box: HTMLElement) => {
      import('../scripts/neighborhood-locator').then(({ initNeighborhoodLocator }) =>
        initNeighborhoodLocator(box),
      )
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target)
              upgrade(entry.target as HTMLElement)
            }
          }
        },
        { rootMargin: '200px' },
      )
      for (const box of boxes) {
        observer.observe(box)
      }
    } else {
      for (const box of boxes) {
        upgrade(box)
      }
    }
  }
</script>
