---
// A small "you are here" locator map: the whole city drawn faint, with one
// neighborhood filled in. Rendered as inline SVG (no Leaflet, no tiles) from the
// precomputed paths in src/data/neighborhood-geo.json, so it themes with CSS and
// costs nothing at runtime. Returns nothing when a slug has no shape.
import geo from '../data/neighborhood-geo.json'

interface Props {
  slug: string
  name?: string
  class?: string
}

const { slug, name, class: className } = Astro.props
const shapes = geo.shapes as Record<string, string>
const activePath = shapes[slug]

// The whole city as one solid silhouette (every neighborhood's path concatenated)
// — no internal borders to read as noise at thumbnail size. The active
// neighborhood is then drawn on top.
const cityPath = Object.values(shapes).join('')

const label = name ? `${name} relative to St. Louis` : 'Location within St. Louis'
---

{
  activePath && (
    <svg
      class:list={['locator', className]}
      viewBox={geo.viewBox}
      role="img"
      aria-label={label}
      xmlns="http://www.w3.org/2000/svg">
      <path class="locator-city" d={cityPath} />
      <path class="locator-active" d={activePath} />
    </svg>
  )
}

<style>
  .locator {
    width: 100%;
    height: auto;
  }

  /* The whole city as one faint, solid shape. */
  .locator-city {
    fill: var(--color-line);
  }

  /* The neighborhood this page is about, outlined in the page background so it
     reads cleanly against the silhouette even when it's a small area. */
  .locator-active {
    fill: var(--color-accent);
    stroke: var(--color-background);
    stroke-width: 3;
    stroke-linejoin: round;
  }
</style>
