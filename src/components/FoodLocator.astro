---
// An inline locator map for a food page. Renders a server-side placeholder box;
// the Leaflet + tiles chunk (~78 KB) is imported only when the box nears the
// viewport, so a cold landing that never scrolls to it pays nothing. Renders
// nothing without coordinates.
interface Props {
  coords?: [number, number]
  label?: string
}

const { coords, label } = Astro.props
const description = label ? `Map showing this spot in ${label}` : 'Map showing this spot'
---

{
  coords && (
    <div class="food-locator">
      <div
        class="food-locator-map"
        data-food-locator
        data-coords={coords.join(',')}
        role="img"
        aria-label={description}
      />
      <span class="food-locator-tag">{label ?? 'Map'}</span>
    </div>
  )
}

<style>
  .food-locator {
    position: relative;
  }

  /* The placeholder before the map loads: a faint diagonal hatch, echoing the
     map's own grid, so the box reads as a map even while the chunk is fetching.
     No border/radius of its own — it sits flush at the top of the food card, whose
     overflow clips the top corners, with a hairline dividing it from the body. */
  .food-locator-map {
    position: relative;
    height: 220px;
    border-block-end: 1px solid var(--color-line);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 11px,
        color-mix(in srgb, var(--color-line-input) 28%, transparent) 11px 12px
      ),
      var(--color-background);
    overflow: hidden;
  }

  /* The neighborhood tag, above Leaflet's panes and out of its container so
     initializing the map doesn't disturb it. Top-left, clear of the bottom
     attribution bar (the zoom control is moved to the top-right to match). */
  .food-locator-tag {
    position: absolute;
    z-index: 500;
    left: var(--spacing-sm);
    top: var(--spacing-sm);
    padding: 2px var(--spacing-sm);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-text-muted);
    pointer-events: none;
  }
</style>

<script>
  // The locator is pinned at the top of the sidebar, so it's always in view —
  // no need to defer on scroll. Just load the map chunk and upgrade each
  // placeholder. It stays a dynamic import so Leaflet + tiles are kept out of
  // the page's main bundle.
  const boxes = document.querySelectorAll<HTMLElement>('[data-food-locator]')
  if (boxes.length) {
    import('../scripts/locator').then(({ initLocator }) => {
      for (const box of boxes) {
        initLocator(box)
      }
    })
  }
</script>
