---
// Landing page for a neighborhood region (South City, Parks, …): a list of every
// neighborhood in the region, linking to each detail page. Rendered by the thin
// static routes under src/pages/neighborhoods/ (e.g. south-city.astro), which sit
// above the dynamic [slug].astro and so don't collide with it.
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from './Breadcrumbs.astro'
import RelatedCard from './RelatedCard.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import { published } from '../lib/content'
import { href } from '../lib/url'
import { regions, neighborhoodsInRegion } from '../lib/neighborhoods'

interface Props {
  region: string
}

const { region: regionSlug } = Astro.props
const region = regions.find((entry) => entry.slug === regionSlug)

if (!region) {
  throw new Error(`RegionPage: unknown region "${regionSlug}"`)
}

// Each neighborhood's tagline + vibe tags (and whether it has a writeup), keyed by
// slug — the same data the "Nearby Neighborhoods" cards use.
const metaBySlug = new Map(
  published(await getCollection('neighborhoods')).map((entry) => [
    entry.id,
    {
      description: entry.data.description,
      tags: entry.data.tags ?? [],
      written: Boolean(entry.body && entry.body.trim()),
    },
  ]),
)

// Explored (written) neighborhoods first, then the rest in their numbered order.
const members = neighborhoodsInRegion(regionSlug)
const sorted = [...members].sort(
  (left, right) =>
    Number(metaBySlug.get(right.slug)?.written ?? false) -
    Number(metaBySlug.get(left.slug)?.written ?? false),
)

const count = members.length
// "Central Corridor of St. Louis", but don't double up on a region that already
// names the city (e.g. "St. Louis County").
const seoTitle = region.label.includes('St. Louis') ? region.label : `${region.label} of St. Louis`
const metaDescription = `Every neighborhood in ${region.label}, St. Louis — ${count} in all.`
// Breadcrumb stops at the index — the region name is already the page H1 + tab.
const trail = [{ label: 'Neighborhoods', href: '/neighborhoods/' }]
---

<BaseLayout crumb={region.label} title={seoTitle} description={metaDescription}>
  <Breadcrumbs trail={trail} />
  <article class="page">
    <header class="entry-header entry-header-with-flag">
      <div class="entry-bar">
        <h1>{region.label}</h1>
        <span class="count">{count}</span>
      </div>
      <div class="river-border-basic" aria-hidden="true"></div>
    </header>
    <nav class="region-nav" aria-label="Regions">
      {
        regions.map((other) =>
          other.slug === regionSlug ? (
            <span class="region-nav-current" aria-current="page">
              {other.label}
            </span>
          ) : (
            <a href={href(`/neighborhoods/${other.slug}/`)}>{other.label}</a>
          ),
        )
      }
    </nav>
    <div class="region-list">
      {
        sorted.map((neighborhood) => {
          const meta = metaBySlug.get(neighborhood.slug)

          return (
            <RelatedCard
              href={href(`/neighborhoods/${neighborhood.slug}/`)}
              title={neighborhood.name}
              description={meta?.description ?? ''}
              tags={meta?.tags ?? []}>
              <IconMapPin slot="icon" />
            </RelatedCard>
          )
        })
      }
    </div>
  </article>
</BaseLayout>

<style>
  .entry-bar {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
  }

  .region-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    margin-block: 0 var(--spacing-lg);
    border-block-end: 1px solid var(--color-line);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
  }

  .region-nav a,
  .region-nav-current {
    padding-block: var(--spacing-xs);
    margin-block-end: -1px;
    border-block-end: 2px solid transparent;
    color: var(--color-muted);
    text-decoration: none;
  }

  .region-nav a:hover {
    color: var(--color-accent);
  }

  .region-nav-current {
    color: var(--color-text-heading);
    font-weight: 700;
    border-block-end-color: var(--color-accent);
  }

  .count {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-md);
    color: var(--color-muted);
  }
</style>
