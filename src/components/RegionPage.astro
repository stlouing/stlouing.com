---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from './Breadcrumbs.astro'
import Card from './Card.astro'
import { published } from '../lib/content'
import { href } from '../lib/url'
import { regions, neighborhoodsInRegion } from '../lib/neighborhoods'

interface Props {
  region: string
}

const { region: regionSlug } = Astro.props
const region = regions.find((entry) => entry.slug === regionSlug)

if (!region) {
  throw new Error(`RegionPage: unknown region "${regionSlug}"`)
}

const metaBySlug = new Map(
  published(await getCollection('neighborhoods')).map((entry) => [
    entry.id,
    {
      description: entry.data.description,
      tags: entry.data.tags ?? [],
      written: Boolean(entry.body && entry.body.trim()),
    },
  ]),
)

const members = neighborhoodsInRegion(regionSlug)
const sorted = [...members].sort((left, right) => {
  const contentDelta = Number(metaBySlug.has(right.slug)) - Number(metaBySlug.has(left.slug))
  if (contentDelta !== 0) {
    return contentDelta
  }

  return left.name.localeCompare(right.name)
})

const count = members.length
const seoTitle = region.label.includes('St. Louis') ? region.label : `${region.label} of St. Louis`
const metaDescription = `Every neighborhood in ${region.label}, St. Louis — ${count} in all.`
const trail = [{ label: 'Neighborhoods', href: '/neighborhoods/' }]
---

<BaseLayout crumb={region.label} title={seoTitle} description={metaDescription}>
  <article class="page region-page">
    <Breadcrumbs trail={trail} />

    <header class="detail-pane-header">
      <h1 class="detail-pane-title">{region.label}</h1>
      <p class="description description--lg detail-pane-tagline">
        {count}
        {regionSlug === 'parks' ? 'parks' : 'neighborhoods'}
      </p>
    </header>
    <nav class="region-nav" aria-label="Regions">
      {
        regions.map((other) =>
          other.slug === regionSlug ? (
            <span class="region-nav-current" aria-current="page">
              {other.label}
            </span>
          ) : (
            <a href={href(`/neighborhoods/${other.slug}/`)}>{other.label}</a>
          ),
        )
      }
    </nav>
    <div class="region-list card-cells card-cells--three">
      <div class="card-rows">
        {
          sorted.map((neighborhood) => {
            const meta = metaBySlug.get(neighborhood.slug)

            return (
              <Card
                href={href(`/neighborhoods/${neighborhood.slug}/`)}
                title={neighborhood.name}
                description={meta?.description ?? ''}
                tags={meta?.tags ?? []}
              />
            )
          })
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .region-page :global(.breadcrumbs) {
    justify-content: flex-start;
    margin-block-start: var(--spacing-xl);
  }

  .region-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    margin-block: 0 var(--spacing-lg);
    border-block-end: 1px solid var(--color-line);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
  }

  .region-nav a,
  .region-nav-current {
    padding-block: var(--spacing-xs);
    margin-block-end: -1px;
    border-block-end: 2px solid transparent;
    color: var(--color-muted);
    text-decoration: none;
  }

  .region-nav a:hover {
    color: var(--color-accent);
  }

  .region-nav-current {
    color: var(--color-text-heading);
    font-weight: 700;
    border-block-end-color: var(--color-accent);
  }
</style>
