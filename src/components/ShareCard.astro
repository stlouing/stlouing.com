---
import ShareActions from './ShareActions.astro'
import { href } from '../lib/url'
import { SITE_NAME } from '../lib/site'

interface Props {
  shareTitle: string
}

const { shareTitle } = Astro.props
---

<aside class="share-card callout">
  <span class="avatar-ring">
    <img src={href('/avatar.svg')} alt="" width="96" height="96" />
  </span>
  <div class="share-card-body">
    <h2 class="title-caps">Thanks for reading</h2>
    <p class="excerpt">
      <strong>{SITE_NAME}</strong> is an independent guide to the food and neighborhoods of St. Louis.
      I document the city through photography, maps, and writing.
    </p><p class="excerpt">
      The site has no ads, no spam, and no sponsors. Follow to keep up with new discoveries as I
      explore!
    </p>
    <ShareActions shareTitle={shareTitle} placement="end" />
  </div>
</aside>

<style>
  .share-card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--spacing-lg) var(--spacing-xl);
    max-width: var(--measure-reading);
    margin-block: var(--spacing-lg);
    padding: var(--spacing-lg);
  }

  .share-card .avatar-ring {
    --avatar-size: 5rem;
  }

  .share-card-body {
    display: grid;
    flex: 1 1 18rem;
    gap: var(--spacing-md);
  }

  .share-card-body :is(.title-caps, .excerpt) {
    margin: 0;
  }

  @media (max-width: 700px) {
    .share-card {
      padding: var(--spacing-lg);
    }

    .share-card-body .title-caps {
      font-size: var(--font-size-label);
    }
  }
</style>
