---
// The reader-voted favorites panel — places ranked by readers' 👍 votes, live
// from Supabase get_reader_ratings(). Shown in the /best aside ("Reader
// Favorites") and the shared page sidebar ("Most popular"). The panel bakes a
// slug → title map so the client script can name the winners, and stays hidden
// until the RPC answers; without Supabase creds it renders nothing at all.
import { getCollection } from 'astro:content'
import { published } from '../lib/content'
import FleurGlyph from '../assets/FleurGlyph.astro'

interface Props {
  title?: string
  // Optional italic line under the title (the sidebar's "reader votes" note).
  subtitle?: string
  maxRows?: number
  // Quiet variant for the page sidebar: eyebrow title, no fleurs, no thumbs —
  // /best keeps the full serif-and-fleurs panel.
  quiet?: boolean
}

const { title = 'Reader Favorites', subtitle, maxRows = 10, quiet = false } = Astro.props

const readersEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
)

const food = published(await getCollection('food'))
const placeTitles = Object.fromEntries(food.map((place) => [place.id, place.data.title]))
---

{
  readersEnabled && (
    <section
      class:list={['reader-favorites', 'panel', { 'reader-favorites--quiet': quiet }]}
      data-reader-favorites
      data-max-rows={maxRows}
      aria-label={title}
      hidden>
      <h2 class="reader-favorites-title">{title}</h2>
      {subtitle && <p class="reader-favorites-subtitle">{subtitle}</p>}
      {
        !quiet && (
          <div class="reader-favorites-fleurs" aria-hidden="true">
            <FleurGlyph />
            <FleurGlyph />
            <FleurGlyph />
          </div>
        )
      }
      <ol data-favorites-list />
      <p class="reader-favorites-empty desc-muted" data-favorites-empty hidden>
        No reader votes yet.
      </p>
      <script
        is:inline
        type="application/json"
        data-place-titles
        set:html={JSON.stringify(placeTitles)}
      />
    </section>
  )
}

<script>
  import { initReaderFavorites } from '../scripts/reader-favorites'
  initReaderFavorites()
</script>

<style>
  /* The What's New panel voice. Rows are injected by reader-favorites.ts, so
     their rules are flat :global() descendants (injected nodes never carry the
     Astro scope class). */
  .reader-favorites[hidden] {
    display: none;
  }

  .reader-favorites-title {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.05;
    font-size: var(--font-size-xxl);
  }

  .reader-favorites-fleurs {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-block: var(--spacing-sm);
    color: var(--color-accent-gold);
  }

  .reader-favorites-fleurs :global(svg) {
    width: 0.6rem;
    height: auto;
  }

  .reader-favorites-subtitle {
    margin: var(--spacing-xs) 0 var(--spacing-sm);
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  /* Quiet variant: the accent eyebrow voice in place of the serif masthead. */
  .reader-favorites--quiet .reader-favorites-title {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .reader-favorites--quiet :global(.fav-count) {
    font-weight: 500;
    font-size: var(--font-size-sm);
  }

  .reader-favorites--quiet :global(.fav-count svg) {
    display: none;
  }

  .reader-favorites ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reader-favorites :global(li) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-block: var(--spacing-xs);
  }

  .reader-favorites :global(li + li) {
    margin-block-start: 0;
    border-block-start: 1px dotted var(--color-line-input);
  }

  .reader-favorites :global(a) {
    min-width: 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-md);
    font-weight: 500;
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .reader-favorites :global(a:hover) {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .reader-favorites :global(.fav-count) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-md);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-muted);
  }

  .reader-favorites :global(.fav-count svg) {
    width: 14px;
    height: 14px;
    color: var(--color-accent-gold);
  }

  .reader-favorites-empty {
    margin: var(--spacing-sm) 0 0;
    text-align: center;
  }
</style>
