---
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
  compact?: boolean
}

const { slug, title, compact = false } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class:list={[compact ? 'vote-row' : 'vote-bar pane-stat']}
      data-reader-vote
      data-slug={slug}
      aria-label={`Rate ${title}`}>
      <span class:list={[{ 'pane-stat-label': !compact }, 'eyebrow eyebrow--muted']}>
        Your rating
      </span>
      <div class:list={['vote-pill', { 'vote-pill--split': compact }]}>
        <button
          type="button"
          class="vote-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="like"
          aria-pressed="false"
          aria-label="Thumbs up"
          disabled>
          <IconThumbsUp />
          <span class="vote-count" data-count-like />
        </button>
        <button
          type="button"
          class="vote-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="dislike"
          aria-pressed="false"
          aria-label="Thumbs down"
          disabled>
          <IconThumbsDown />
          <span class="vote-count" data-count-dislike />
        </button>
      </div>
      <p class="vote-feedback form-status" data-vote-status role="status" aria-live="polite" />
    </section>
  )
}

<style>
  .vote-bar {
    margin: 0;
  }

  .vote-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
  }

  .vote-choice {
    font-size: var(--font-size-xs);
    line-height: 1.3;
    border-radius: var(--radius-pill);

    &:disabled {
      cursor: default;
    }
  }

  .vote-choice:not(.is-active) {
    background: var(--color-background);
  }

  .vote-choice:not(:disabled, .is-active):hover {
    background: var(--color-wash);
  }

  .vote-count {
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-muted);

    &:empty {
      display: none;
    }
  }

  .vote-choice.is-active .vote-count {
    color: inherit;
  }

  :is(.vote-prompt, .vote-feedback) {
    margin: var(--spacing-xs) 0 0;
  }

  .vote-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);

    :is(.vote-prompt, .vote-feedback) {
      flex-basis: 100%;
      margin: 0;
    }

    .vote-feedback:empty {
      display: none;
    }
  }

  .vote-pill--split {
    gap: 0;
    margin: 0;

    .vote-choice {
      border-radius: 0;
      padding-inline: var(--spacing-md);
    }

    .vote-choice:first-child {
      border-start-start-radius: var(--radius-pill);
      border-end-start-radius: var(--radius-pill);
    }

    .vote-choice:last-child {
      border-inline-start-width: 0;
      border-start-end-radius: var(--radius-pill);
      border-end-end-radius: var(--radius-pill);
    }

    @media (max-width: 700px) {
      .vote-choice {
        padding-block: var(--spacing-sm);
        padding-inline: var(--spacing-base);
      }

      .vote-choice :global(.icon) {
        width: 1.125rem;
        height: 1.125rem;
      }
    }
  }
</style>
