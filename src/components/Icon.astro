---
import IconBook from '../assets/IconBook.astro'
import IconNotebookPen from '../assets/IconNotebookPen.astro'
import IconPizza from '../assets/IconPizza.astro'
import IconUtensils from '../assets/IconUtensils.astro'
import IconHeart from '../assets/IconHeart.astro'
import IconHeartCrack from '../assets/IconHeartCrack.astro'
import IconLandmark from '../assets/IconLandmark.astro'
import IconMountain from '../assets/IconMountain.astro'
import IconMap from '../assets/IconMap.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import IconCompass from '../assets/IconCompass.astro'
import IconFlag from '../assets/IconFlag.astro'
import IconStar from '../assets/IconStar.astro'
import IconAward from '../assets/IconAward.astro'
import IconCalendar from '../assets/IconCalendar.astro'
import IconChart from '../assets/IconChart.astro'
import IconTags from '../assets/IconTags.astro'
import IconListChecks from '../assets/IconListChecks.astro'
import IconInfo from '../assets/IconInfo.astro'
import IconWalk from '../assets/IconWalk.astro'
import IconHome from '../assets/IconHome.astro'
import IconMessageCircleHeart from '../assets/IconMessageCircleHeart.astro'
import IconFolderTree from '../assets/IconFolderTree.astro'
import IconTree from '../assets/IconTree.astro'
import IconShoppingBag from '../assets/IconShoppingBag.astro'

interface Props {
  name?: string
}

const iconByKeyword: Record<string, typeof IconBook> = {
  book: IconBook,
  notebook: IconNotebookPen,
  pizza: IconPizza,
  utensils: IconUtensils,
  heart: IconHeart,
  'heart-crack': IconHeartCrack,
  landmark: IconLandmark,
  mountain: IconMountain,
  map: IconMap,
  'map-pin': IconMapPin,
  compass: IconCompass,
  flag: IconFlag,
  star: IconStar,
  award: IconAward,
  calendar: IconCalendar,
  chart: IconChart,
  tags: IconTags,
  'list-checks': IconListChecks,
  info: IconInfo,
  walk: IconWalk,
  home: IconHome,
  'message-circle-heart': IconMessageCircleHeart,
  'folder-tree': IconFolderTree,
  tree: IconTree,
  'shopping-bag': IconShoppingBag,
}

const { name } = Astro.props
const ResolvedIcon = (name && iconByKeyword[name]) || IconBook
---

<ResolvedIcon />
