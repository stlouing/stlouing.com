import IconExternalLink from '@tabler/icons-astro/dist/esm/icons/external-link.mjs'
import IconFish from '@tabler/icons-astro/dist/esm/icons/fish.mjs'
import IconFlame from '@tabler/icons-astro/dist/esm/icons/flame.mjs'
