---
import IconBook from '../assets/IconBook.astro'
import IconPizza from '../assets/IconPizza.astro'
import IconUtensils from '../assets/IconUtensils.astro'
import IconHeart from '../assets/IconHeart.astro'
import IconLandmark from '../assets/IconLandmark.astro'
import IconTree from '../assets/IconTree.astro'
import IconShoppingBag from '../assets/IconShoppingBag.astro'
import IconPalette from '../assets/IconPalette.astro'
import IconHanger from '../assets/IconHanger.astro'
import IconMusic from '../assets/IconMusic.astro'
import IconChess from '../assets/IconChess.astro'
import IconBuildingMuseum from '../assets/IconBuildingMuseum.astro'
import IconBuildingCommunity from '../assets/IconBuildingCommunity.astro'
import IconAvocado from '../assets/IconAvocado.astro'
import IconBaguette from '../assets/IconBaguette.astro'
import IconBeer from '../assets/IconBeer.astro'
import IconBowlChopsticks from '../assets/IconBowlChopsticks.astro'
import IconBowlSpoon from '../assets/IconBowlSpoon.astro'
import IconBread from '../assets/IconBread.astro'
import IconBurger from '../assets/IconBurger.astro'
import IconCheese from '../assets/IconCheese.astro'
import IconChefHat from '../assets/IconChefHat.astro'
import IconCocktail from '../assets/IconCocktail.astro'
import IconCoffee from '../assets/IconCoffee.astro'
import IconDumpling from '../assets/IconDumpling.astro'
import IconFish from '../assets/IconFish.astro'
import IconFlame from '../assets/IconFlame.astro'
import IconFriedEgg from '../assets/IconFriedEgg.astro'
import IconGrill from '../assets/IconGrill.astro'
import IconIceCream from '../assets/IconIceCream.astro'
import IconLemon from '../assets/IconLemon.astro'
import IconCanary from '../assets/IconCanary.astro'
import IconPepper from '../assets/IconPepper.astro'
import IconSalad from '../assets/IconSalad.astro'
import IconSausage from '../assets/IconSausage.astro'
import IconSoup from '../assets/IconSoup.astro'
import IconWineGlass from '../assets/IconWineGlass.astro'

interface Props {
  name?: string
}

const iconByKeyword: Record<string, typeof IconBook> = {
  book: IconBook,
  pizza: IconPizza,
  utensils: IconUtensils,
  heart: IconHeart,
  landmark: IconLandmark,
  tree: IconTree,
  'shopping-bag': IconShoppingBag,
  palette: IconPalette,
  hanger: IconHanger,
  music: IconMusic,
  chess: IconChess,
  museum: IconBuildingMuseum,
  'building-community': IconBuildingCommunity,
  avocado: IconAvocado,
  baguette: IconBaguette,
  beer: IconBeer,
  'bowl-chopsticks': IconBowlChopsticks,
  'bowl-spoon': IconBowlSpoon,
  bread: IconBread,
  burger: IconBurger,
  cheese: IconCheese,
  'chef-hat': IconChefHat,
  cocktail: IconCocktail,
  coffee: IconCoffee,
  dumpling: IconDumpling,
  fish: IconFish,
  flame: IconFlame,
  'fried-egg': IconFriedEgg,
  grill: IconGrill,
  'ice-cream': IconIceCream,
  lemon: IconLemon,
  canary: IconCanary,
  pepper: IconPepper,
  salad: IconSalad,
  sausage: IconSausage,
  soup: IconSoup,
  'wine-glass': IconWineGlass,
}

const { name } = Astro.props
const ResolvedIcon = (name && iconByKeyword[name]) || IconBook
---

<ResolvedIcon />
