import IconPepper from '@tabler/icons-astro/dist/esm/icons/pepper.mjs'
import IconPizza from '@tabler/icons-astro/dist/esm/icons/pizza.mjs'
import IconPlus from '@tabler/icons-astro/dist/esm/icons/plus.mjs'
import IconSalad from '@tabler/icons-astro/dist/esm/icons/salad.mjs'
import IconSausage from '@tabler/icons-astro/dist/esm/icons/sausage.mjs'
import IconSearch from '@tabler/icons-astro/dist/esm/icons/search.mjs'
import IconShare2 from '@tabler/icons-astro/dist/esm/icons/share-2.mjs'
import IconShoppingBag from '@tabler/icons-astro/dist/esm/icons/shopping-bag.mjs'
import IconSoup from '@tabler/icons-astro/dist/esm/icons/soup.mjs'
import IconThumbDown from '@tabler/icons-astro/dist/esm/icons/thumb-down.mjs'
import IconThumbUp from '@tabler/icons-astro/dist/esm/icons/thumb-up.mjs'
import IconToolsKitchen2 from '@tabler/icons-astro/dist/esm/icons/tools-kitchen-2.mjs'
import IconTree from '@tabler/icons-astro/dist/esm/icons/tree.mjs'
import IconX from '@tabler/icons-astro/dist/esm/icons/x.mjs'

interface Props {
  name?: string
  stroke?: number
}

const iconByKeyword: Record<string, typeof IconBook> = {
  'arrow-right': IconArrowRight,
  avocado: IconAvocado,
  baguette: IconBaguette,
  beer: IconBeer,
  book: IconBook,
  'bowl-chopsticks': IconBowlChopsticks,
  'bowl-spoon': IconBowlSpoon,
  bread: IconBread,
  'building-community': IconBuildingCommunity,
  burger: IconBurger,
  canary: IconCanary,
  check: IconCheck,
  cheese: IconCheese,
  'chef-hat': IconChefHat,
  chess: IconChess,
  'chevron-down': IconChevronDown,
  cocktail: IconGlassCocktail,
  coffee: IconCoffee,
  dumpling: IconDumpling,
  'external-link': IconExternalLink,
  fish: IconFish,
  flame: IconFlame,
  'fried-egg': IconEggFried,
  grill: IconGrill,
  hanger: IconHanger,
  heart: IconHeart,
  'ice-cream': IconIceCream2,
  instagram: IconBrandInstagram,
  landmark: IconBuildingMonument,
  lemon: IconLemon2,
  mail: IconMail,
  map: IconMap,
  'map-pin': IconMapPin,
  menu: IconMenu2,
  'message-circle': IconMessageCircle,
  museum: IconBuildingBank,
  music: IconMusic,
  palette: IconPalette,
  pepper: IconPepper,
  pizza: IconPizza,
  plus: IconPlus,
  salad: IconSalad,
  sausage: IconSausage,
  search: IconSearch,
  share: IconShare2,
  'shopping-bag': IconShoppingBag,
  soup: IconSoup,
  'thumbs-down': IconThumbDown,
  'thumbs-up': IconThumbUp,
  tree: IconTree,
  utensils: IconToolsKitchen2,
  'wine-glass': IconGlassFull,
  x: IconX,
}

const { name, stroke = 1.75 } = Astro.props
const ResolvedIcon = (name && iconByKeyword[name]) || IconBook
---

<ResolvedIcon class="icon" stroke={stroke} />
