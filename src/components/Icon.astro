import IconGrill from '@tabler/icons-astro/dist/esm/icons/grill.mjs'
import IconHanger from '@tabler/icons-astro/dist/esm/icons/hanger.mjs'
import IconHeart from '@tabler/icons-astro/dist/esm/icons/heart.mjs'
import IconIceCream2 from '@tabler/icons-astro/dist/esm/icons/ice-cream-2.mjs'
import IconLemon2 from '@tabler/icons-astro/dist/esm/icons/lemon-2.mjs'
import IconMail from '@tabler/icons-astro/dist/esm/icons/mail.mjs'
import IconMap from '@tabler/icons-astro/dist/esm/icons/map.mjs'
import IconMapPin from '@tabler/icons-astro/dist/esm/icons/map-pin.mjs'
