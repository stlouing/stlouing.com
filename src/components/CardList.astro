---
import SectionHeading from './SectionHeading.astro'

interface Props {
  title: string
  id?: string
  class?: string
  moreHref?: string
  moreLabel?: string
}

const { title, id, class: className, moreHref, moreLabel } = Astro.props
---

<section id={id} class:list={['card-list', className]}>
  <SectionHeading title={title} moreHref={moreHref} moreLabel={moreLabel} />
  <div class="card-rows">
    <slot />
  </div>
</section>

<style>
  .card-list :global(.section-heading) {
    margin-block: var(--spacing-lg) 0;
  }
</style>
