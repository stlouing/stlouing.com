---
import SectionHeading from './SectionHeading.astro'

interface Props {
  title: string
  id?: string
}

const { title, id } = Astro.props
---

<section id={id} class="card-list">
  <SectionHeading title={title} />
  <div class="card-rows">
    <slot />
  </div>
</section>

<style>
  .card-list :global(.section-heading) {
    margin-block: var(--spacing-lg) 0;
  }
</style>
