---
// A titled list of Cards (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page, events, 404 suggestions) — a
// SectionHeading over a `.card-rows` stack. Pass `class="card-cells"` (or
// `card-cells card-cells--three`) for the wide-screen bordered grid variant.
import SectionHeading from './SectionHeading.astro'

interface Props {
  title: string
  class?: string
  // When set, a "View all" continue-link renders beside the heading (e.g. the
  // filtered food list behind a "More in…" group).
  moreHref?: string
  moreLabel?: string
}

const { title, class: className, moreHref, moreLabel } = Astro.props
---

<section class:list={['card-list', className]}>
  <SectionHeading title={title} moreHref={moreHref} moreLabel={moreLabel} />
  <div class="card-rows">
    <slot />
  </div>
</section>

<style>
  .card-list :global(.section-heading) {
    margin-block: var(--spacing-xl) 0;
  }
</style>
