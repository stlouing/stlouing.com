---
import { href } from '../lib/url'

interface Props {
  tags: string[]
}

const { tags } = Astro.props
---

{
  tags.length > 0 && (
    <p class="tags">
      {tags.map((tag) => (
        <a class="tag p-category" href={href(`/tags/${tag}`)}>
          #{tag}
        </a>
      ))}
    </p>
  )
}

<style>
  .tags {
    margin-block-start: var(--spacing-sm);
    margin-block-end: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .tags .tag {
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
