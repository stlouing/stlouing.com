---
// The article masthead: left-aligned heavy sans headline over the page ground,
// an optional lede, and the shared ActionBar (Share · Follow · Newsletter ·
// Comments — no Feedback). Used by topic pages via Entry's `masthead` prop.
// (The flag-blue field and river wave were retired 2026-09-07.)
import ActionBar from './ActionBar.astro'

interface Props {
  title: string
  // Extra class for the h1 (topic pages pass p-name for the h-entry).
  headingClass?: string
  // Small uppercase kicker above the title (topic pages pass their category).
  eyebrow?: string
  commentsAnchor?: boolean
}

const { title, headingClass, eyebrow, commentsAnchor = false } = Astro.props
---

<div class="page-masthead">
  <div class="masthead-field">
    <div class="masthead-inner">
      <div class="masthead-heading">
        {eyebrow && <p class="masthead-eyebrow eyebrow">{eyebrow}</p>}
        <h1 class:list={['masthead-title', headingClass]}>{title}</h1>
      </div>
      {
        Astro.slots.has('lede') && (
          <div class="masthead-lede">
            <slot name="lede" />
          </div>
        )
      }
      <ActionBar title={title} commentsAnchor={commentsAnchor} />
    </div>
  </div>
</div>

<style>
  /* Full-bleed via the site's 50vw idiom (main clips overflow-x). */
  .page-masthead {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    /* The same xl hand-off to the content as .detail-pane-header. */
    margin-block-end: var(--spacing-xl);
  }

  .masthead-field {
    background: none;
  }

  /* The inner column matches the article's reading column (620px centered),
     so the masthead text lines up with the body prose below. */
  .masthead-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: calc(var(--measure-reading) + 2 * var(--spacing-md));
    margin-inline: auto;
    padding-block: var(--spacing-xl) 0;
    padding-inline: var(--spacing-md);
  }

  /* Eyebrow hugs the title, outside the inner column's roomier gap. */
  .masthead-heading {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .masthead-eyebrow {
    margin: 0;
  }

  .masthead-title {
    margin: 0;
    /* max-width: 20ch; */
    font-family: var(--font-sans-serif);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 3rem);
    line-height: 1.1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  .masthead-lede {
    max-width: var(--measure-reading);
    font-size: var(--font-size-lg);
    line-height: 1.4;
    font-weight: 400;
    font-style: italic;
    color: var(--color-muted);
  }

  .masthead-lede :global(p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  /* The action bar sits a step below the lede, full column width. */
  .masthead-inner :global(.action-bar) {
    width: 100%;
    margin-block-start: var(--spacing-md);
  }
</style>
