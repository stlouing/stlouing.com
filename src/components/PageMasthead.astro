---
import ActionBar from './ActionBar.astro'

interface Props {
  title: string
  headingClass?: string
  eyebrow?: string
  actions?: boolean
  wide?: boolean
  commentsAnchor?: boolean
}

const {
  title,
  headingClass,
  eyebrow,
  actions = false,
  wide = false,
  commentsAnchor = false,
} = Astro.props
---

<div class="page-masthead">
  <div class:list={['masthead-inner', { 'has-actions': actions, 'is-wide': wide }]}>
    <div class="masthead-heading">
      {eyebrow && <p class="masthead-eyebrow eyebrow">{eyebrow}</p>}
      <h1 class:list={['masthead-title', 'title-page', headingClass]}>{title}</h1>
    </div>
    {
      Astro.slots.has('lede') && (
        <div class="masthead-lede description description--lg">
          <slot name="lede" />
        </div>
      )
    }
    {actions && <ActionBar title={title} commentsAnchor={commentsAnchor} />}
  </div>
</div>

<style>
  .page-masthead {
    margin-block-end: var(--spacing-xl);
  }

  .masthead-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
    width: 100%;
    max-width: var(--measure-reading);
    margin-inline: auto;
    padding-block: var(--spacing-xl) 0;
  }

  .masthead-inner.is-wide {
    max-width: none;
  }

  .masthead-inner:not(.has-actions) {
    padding-block-end: var(--spacing-md);
    border-block-end: 1px solid var(--color-line);
  }

  .masthead-heading {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .masthead-eyebrow {
    margin: 0;
  }

  .masthead-title {
    margin: 0;
  }

  .masthead-lede {
    max-width: var(--measure-reading);
    line-height: 1.4;
  }

  .masthead-lede :global(p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  .masthead-inner :global(.action-bar) {
    width: 100%;
    margin-block-start: var(--spacing-md);
  }
</style>
