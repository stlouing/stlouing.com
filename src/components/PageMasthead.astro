---
import ActionBar from './ActionBar.astro'

interface Props {
  title: string
  headingClass?: string
  eyebrow?: string
  actions?: boolean
  wide?: boolean
  commentsAnchor?: boolean
}

const {
  title,
  headingClass,
  eyebrow,
  actions = false,
  wide = false,
  commentsAnchor = false,
} = Astro.props
---

<div class="page-masthead">
  <div class="masthead-field">
    <div class:list={['masthead-inner', { 'has-actions': actions, 'is-wide': wide }]}>
      <div class="masthead-heading">
        {eyebrow && <p class="masthead-eyebrow eyebrow">{eyebrow}</p>}
        <h1 class:list={['masthead-title', headingClass]}>{title}</h1>
      </div>
      {
        Astro.slots.has('lede') && (
          <div class="masthead-lede">
            <slot name="lede" />
          </div>
        )
      }
      {actions && <ActionBar title={title} commentsAnchor={commentsAnchor} />}
    </div>
  </div>
</div>

<style>
  .page-masthead {
    margin-block-end: var(--spacing-xl);
  }

  .masthead-field {
    background: none;
  }

  .masthead-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: var(--measure-reading);
    margin-inline: auto;
    padding-block: var(--spacing-xl) 0;
  }

  .masthead-inner.is-wide {
    max-width: none;
  }

  .masthead-inner:not(.has-actions) {
    padding-block-end: var(--spacing-md);
    border-block-end: 1px solid var(--color-line);
  }

  .masthead-heading {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .masthead-eyebrow {
    margin: 0;
  }

  .masthead-title {
    margin: 0;
    font-family: var(--font-sans-serif);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 3rem);
    line-height: 1.1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  .masthead-lede {
    max-width: var(--measure-reading);
    font-size: var(--font-size-lg);
    line-height: 1.4;
    font-weight: 400;
    font-style: italic;
    color: var(--color-muted);
  }

  .masthead-lede :global(p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  .masthead-inner :global(.action-bar) {
    width: 100%;
    margin-block-start: var(--spacing-md);
  }
</style>
