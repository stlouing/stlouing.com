---
import { href } from '../lib/url'
import { NEWSLETTER_URL } from '../lib/site'
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span class="footer-tagline">Made in STL</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="https://www.instagram.com/st.louing" target="_blank">@st.louing</a>
      {
        NEWSLETTER_URL && (
          <a href={NEWSLETTER_URL} target="_blank">
            Newsletter
          </a>
        )
      }
      <a href={href('/feedback')}>Feedback</a>
    </nav>
  </div>
  <div class="river-border" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  /* Decorative "river" ribbon at the very bottom — the St. Louis flag's
     blue-and-white wave on red, repeated seamlessly. Flag colors are fixed in
     both themes. Tweak the height (60–100px) to taste. */
  .river-border {
    height: 16px;
    background: #c70f2e url('/river-border.svg') repeat-x center / auto 100%;
  }

  /* On small screens the footer competes with the full-height map pages, so drop
     the decorative ribbon + tagline and keep just the links. */
  @media screen and (max-width: 600px) {
    .river-border,
    .footer-tagline {
      display: none;
    }
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);

    & a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-accent);
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
      }

      &:hover {
        color: var(--color-accent);
      }
    }
  }

  @media (max-width: 700px) {
    .footer-inner {
      justify-content: space-between;
    }

    .footer-nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
