---
import IconExternalLink from '../assets/IconExternalLink.astro'
import IconRSS from '../assets/IconRSS.astro'
import { href } from '../lib/url'
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span>Made in and around STL.</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="https://github.com/stlouing/stlouing.com" target="_blank"
        >Source <IconExternalLink /></a
      >
      <a href={href('/rss.xml')} target="_blank">RSS <IconRSS /></a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding-block: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);

    & a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-accent);
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
      }

      &:hover {
        color: var(--color-accent);
      }
    }
  }
</style>
