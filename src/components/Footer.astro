---
import IconExternalLink from '../assets/IconExternalLink.astro'
import IconRSS from '../assets/IconRSS.astro'
import { href } from '../lib/url'
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span>Made in STL</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href={href('/feedback')}>Feedback</a>
      <a href="https://www.instagram.com/st.louing" target="_blank">@st.louing</a>
      <a href="https://github.com/stlouing/stlouing.com" target="_blank"
        >Source <IconExternalLink /></a
      >
      <a href={href('/rss.xml')} target="_blank">RSS <IconRSS /></a>
    </nav>
  </div>
  <div class="river-border" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  /* Decorative "river" ribbon at the very bottom — the St. Louis flag's
     blue-and-white wave on red, repeated seamlessly. Flag colors are fixed in
     both themes. Tweak the height (60–100px) to taste. */
  .river-border {
    height: 24px;
    background: #c70f2e url('/river-border.svg') repeat-x center / auto 100%;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);

    & a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-accent);
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
      }

      &:hover {
        color: var(--color-accent);
      }
    }
  }
</style>
