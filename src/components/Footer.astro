---
import { href } from '../lib/url'
import { NEWSLETTER_URL } from '../lib/site'
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span class="footer-tagline">Made in STL</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="https://www.instagram.com/st.louing" target="_blank">@st.louing</a>
      {
        NEWSLETTER_URL && (
          <a href={NEWSLETTER_URL} target="_blank">
            Newsletter
          </a>
        )
      }
      <a href={href('/feedback')}>Feedback</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .footer-tagline {
    font-weight: 500;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);

    & a {
      display: flex;
      gap: var(--spacing-sm);
      color: var(--color-text-muted);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-accent);
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
      }

      &:hover {
        color: var(--color-accent);
      }
    }
  }
</style>
