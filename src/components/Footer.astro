---
import { CITY_SHORT, INSTAGRAM_HANDLE } from '../lib/site'
import { href } from '../lib/url'
import Icon from './Icon.astro'
---

<footer class="site-footer">
  <div class="river-border" aria-hidden="true"></div>
  <div class="wrap wrap-wide footer-bottom">
    <span class="footer-made">
      Made with <Icon name="heart" /> in {CITY_SHORT}
    </span>
    <nav class="footer-links" aria-label="Footer">
      <a href={href('/about/#contact')}>Contact</a>
      {
        INSTAGRAM_HANDLE && (
          <a
            class="footer-instagram"
            href={`https://www.instagram.com/${INSTAGRAM_HANDLE}`}
            target="_blank"
            rel="noopener"
            data-goatcounter-click="instagram-footer">
            <Icon name="instagram" />
            {INSTAGRAM_HANDLE}
          </a>
        )
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    --footer-yellow: #f5dc0f;
    --footer-white: #ffffff;
    margin-block-start: var(--spacing-xl);
    padding-block-end: env(safe-area-inset-bottom, 0);
    background: linear-gradient(
      to bottom,
      transparent calc(var(--river-height) - 1px),
      var(--color-footer) calc(var(--river-height) - 1px)
    );
  }

  .river-border {
    pointer-events: none;
  }

  :global(body:is(:has([data-city-map]), :has([data-map-pane]))) {
    .site-footer {
      position: relative;
      z-index: 2;
      margin-block-start: calc(-1 * var(--river-height));
      pointer-events: none;
    }

    .footer-bottom {
      pointer-events: auto;
    }
  }

  @media (max-width: 999px) {
    :global(body:has(.map-split:not(.detail-split))) .site-footer {
      display: none;
    }
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: 0 var(--spacing-sm);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
  }

  .footer-made {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--footer-white);
    font-weight: 500;
  }

  .footer-made :global(.icon) {
    margin: 0 0.2rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-weight: 500;
    color: var(--footer-white);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--footer-white);
    text-underline-offset: 4px;
  }

  .footer-bottom :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: inherit;
  }

  .footer-links a:hover {
    color: var(--footer-yellow);
    text-decoration-color: var(--footer-yellow);
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-block-start: var(--spacing-lg);
    }
  }
</style>
