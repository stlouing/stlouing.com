---
// The site footer: the city flag as a band — red field, the river ribbon on
// top, the crest — carrying the site identity on the left and the newsletter
// handoff on the right, plus a plain Newsletter link in the bottom bar (map
// pages hide .footer-inner, so the bottom bar is their only newsletter entry
// point). Subscribing has to FINISH on Substack (a static site can't post into
// their signup API cross-origin, and their old `?email=` prefill is dead —
// verified 2026-08-29), so both are honest links to `${NEWSLETTER_URL}/subscribe`
// rather than an email input that would only pretend to subscribe (no iframe
// widget, no tracking, works without JS).
import { NEWSLETTER_URL, SITE_DESCRIPTION } from '../lib/site'
import { href } from '../lib/url'
import FleurDeLis from '../assets/FleurDeLis.astro'
import IconHeart from '../assets/IconHeart.astro'
import IconInstagram from '../assets/IconInstagram.astro'
---

<footer class="site-footer">
  <div class="river-border" aria-hidden="true"></div>
  <div class="wrap wrap-wide footer-inner">
    <div class="footer-identity">
      <FleurDeLis class="footer-crest" />
      <p class="footer-name">St. Louing</p>
      <p class="footer-description">{SITE_DESCRIPTION}</p>
    </div>
    <div class="footer-newsletter">
      <p class="footer-newsletter-title">Newsletter</p>
      <p class="footer-description">
        I'm always wandering St. Louis! Sign up if you want infrequent updates from the site. No
        ads, no spam.
      </p>
      {
        NEWSLETTER_URL && (
          <a
            class="btn btn-dark btn-compact newsletter-link"
            href={`${NEWSLETTER_URL}/subscribe`}
            target="_blank"
            rel="noopener">
            Subscribe
          </a>
        )
      }
    </div>
  </div>
  <div class="wrap wrap-wide footer-bottom">
    <span class="footer-made">
      Made with <IconHeart /> in STL
    </span>
    <nav class="footer-links" aria-label="Footer">
      {
        NEWSLETTER_URL && (
          <a href={`${NEWSLETTER_URL}/subscribe`} target="_blank" rel="noopener">
            Newsletter
          </a>
        )
      }
      <a href={href('/contact/')}>Contact</a>
      <a class="footer-instagram" href="https://www.instagram.com/st.louing" target="_blank">
        <IconInstagram />
        st.louing
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    --footer-red: #c70f2e;
    --footer-yellow: #f5dc0f;
    --footer-white: #ffffff;
    --footer-ink: #1b1a17;
    --river-height: 32px;
    margin-block-start: var(--spacing-xl);
    background: linear-gradient(
      to bottom,
      transparent var(--river-height),
      var(--footer-red) var(--river-height)
    );
  }

  .river-border {
    height: var(--river-height);
    pointer-events: none;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-xl) var(--spacing-xl);
    padding-block: var(--spacing-xl);
  }

  .footer-identity {
    flex: 1 1 18rem;
    max-width: 30rem;
  }

  .footer-identity :global(.footer-crest) {
    width: 64px;
    height: 64px;
    margin-block-end: var(--spacing-md);
  }

  .footer-name {
    margin: 0 0 var(--spacing-sm);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--footer-white);
  }

  .footer-newsletter-title {
    margin: 0 0 var(--spacing-sm);
    font-family: var(--font-sans-serif);
    font-weight: 600;
    font-size: var(--font-size-xxl);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--footer-white);
  }

  .footer-description {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-serif);
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--footer-white);
    opacity: 0.92;
  }

  .footer-newsletter .footer-description {
    max-width: 40ch;
  }

  .footer-newsletter {
    flex: 1 1 16rem;
    max-width: 26rem;
    align-self: flex-end;
  }

  .newsletter-link {
    margin-block-start: var(--spacing-md);
  }

  :global(body:has([data-map])) .footer-inner,
  :global(body:has([data-neighborhood-map])) .footer-inner {
    display: none;
  }

  :global(body:has([data-map])) .site-footer,
  :global(body:has([data-neighborhood-map])) .site-footer {
    position: relative;
    z-index: 2;
    margin-block-start: calc(-1 * var(--river-height));
    pointer-events: none;
  }

  :global(body:has([data-map])) .footer-bottom,
  :global(body:has([data-neighborhood-map])) .footer-bottom {
    pointer-events: auto;
  }

  :global(body:has([data-map])) .footer-bottom,
  :global(body:has([data-neighborhood-map])) .footer-bottom {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-md);
    border-block-start: 1px solid color-mix(in srgb, var(--footer-white) 30%, transparent);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xs);
  }

  .footer-made {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--footer-white);
    font-weight: 500;
  }

  .footer-made :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--footer-white);
    margin: 0 0.2rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    font-weight: 500;
    color: var(--footer-white);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--footer-white);
    text-underline-offset: 4px;
  }

  .footer-links :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: inherit;
  }

  .footer-links a:hover {
    color: var(--footer-yellow);
    text-decoration-color: var(--footer-yellow);
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-block-start: var(--spacing-lg);
    }

    .footer-inner {
      flex-direction: column;
      align-items: stretch;
      padding-block: var(--spacing-lg);
    }

    .footer-name {
      font-size: 2.25rem;
    }

    .footer-newsletter-title {
      font-size: var(--font-size-lg);
    }

    .footer-description {
      font-size: var(--font-size-sm);
    }

    .footer-identity,
    .footer-newsletter {
      flex: 0 0 auto;
      max-width: none;
      align-self: auto;
    }

    .footer-identity :global(.footer-crest) {
      width: 32px;
      height: 32px;
      margin-block-end: var(--spacing-shmedium);
    }

    .footer-bottom {
      padding-block: var(--spacing-sm);
    }
  }
</style>
