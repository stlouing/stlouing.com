---
import Icon from './Icon.astro'

interface Props {
  labelledBy: string
  [attribute: `data-${string}`]: unknown
}

const { labelledBy, ...attributes } = Astro.props
---

<dialog class="map-sheet sheet-dialog" aria-labelledby={labelledBy} {...attributes}>
  <button type="button" class="close-button map-sheet-close" data-sheet-close aria-label="Close">
    <Icon name="x" stroke={2} />
  </button>
  <div class="map-sheet-body" tabindex="-1" autofocus>
    <slot />
  </div>
</dialog>
