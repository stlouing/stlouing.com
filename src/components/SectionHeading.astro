---
import Icon from './Icon.astro'

interface Props {
  title: string
  moreHref?: string
  moreLabel?: string
}

const { title, moreHref, moreLabel = 'View all' } = Astro.props
---

<div class="section-heading heading-bar heading-bar--ruled">
  <h2 class="title-caps">{title}</h2>
  {
    moreHref && (
      <a class="continue-link" href={moreHref}>
        {moreLabel} <Icon name="arrow-right" />
      </a>
    )
  }
</div>

<style>
  .section-heading {
    margin-block: 0 var(--spacing-xs);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--font-size-label);
    font-weight: 700;
  }

  .section-heading a {
    flex-shrink: 0;
  }
</style>
