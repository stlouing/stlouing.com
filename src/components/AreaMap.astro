---
---

<div
  class="area-map"
  data-area-map
  role="application"
  aria-label="Map of St. Louis neighborhoods — click a neighborhood to jump to it">
</div>

<button type="button" class="map-split-toggle btn-dark" data-map-split-toggle>View map</button>

<script>
  import { initAreaMap } from '../scripts/area-map'
  initAreaMap()

  const split = document.querySelector('[data-map-split]')
  const toggle = document.querySelector('[data-map-split-toggle]')

  function updateToggleLabel(): void {
    const showingMap = split?.getAttribute('data-view') === 'map'
    if (toggle) {
      toggle.textContent = showingMap ? 'View list' : 'View map'
    }
  }

  toggle?.addEventListener('click', () => {
    const nextView = split?.getAttribute('data-view') === 'map' ? 'list' : 'map'
    split?.setAttribute('data-view', nextView)
    updateToggleLabel()
  })

  updateToggleLabel()
</script>
