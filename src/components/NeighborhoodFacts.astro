---
// The neighborhood aside card: a "by the numbers" block (population, mapped food
// spots) plus the vibe tags, kept out of the main column so the page doesn't open
// on a wall of metadata. Renders nothing when there's no data at all.
import Chip from './Chip.astro'
import TagIcon from './TagIcon.astro'
import { href } from '../lib/url'

interface Props {
  population?: number
  // Count of mapped food spots in this neighborhood (the Food list below).
  spots?: number
  // The neighborhood's tags (historic, dining, …), shown as the "Vibe" chips.
  // Real tags, so each links to its /tags page and joins the site taxonomy.
  tags?: string[]
}

const { population, spots, tags = [] } = Astro.props
const hasNumbers = population != null || (spots != null && spots > 0)
const hasVibe = tags.length > 0
const hasCard = hasNumbers || hasVibe
---

{
  hasCard && (
    <aside class="side-card">
      {hasNumbers && (
        <div class="card-section card-numbers">
          <h2 class="side-card-label section-label">By the numbers</h2>
          <dl class="facts">
            {population != null && (
              <div class="fact">
                <dt>Population</dt>
                <dd>{population.toLocaleString('en-US')}</dd>
              </div>
            )}
            {population != null && <p class="fact-source">2020 U.S. Census</p>}
            {spots != null && spots > 0 && (
              <div class="fact">
                <dt>Spots explored</dt>
                <dd>{spots}</dd>
              </div>
            )}
          </dl>
        </div>
      )}
      {hasVibe && (
        <div class:list={['card-section', { 'has-divider': hasNumbers }]}>
          <h2 class="side-card-label section-label">Vibe</h2>
          <div class="vibe-chips">
            {tags.map((tag) => (
              <Chip href={href(`/tags/${tag}/`)}>
                <TagIcon tag={tag} />
                <span>{tag}</span>
              </Chip>
            ))}
          </div>
        </div>
      )}
    </aside>
  )
}

<style>
  /* No box of its own — it sits as a plain labeled section in the shared
     border-left sidebar, set off from the section above by the aside's divider. */
  .side-card {
    padding: 0;
  }

  /* A second section (Vibe under By the numbers) gets a hairline rule above it. */
  .card-section.has-divider {
    margin-block-start: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px solid var(--color-line);
  }

  /* Font comes from the shared global `.section-label`; this keeps only the
     card-specific spacing (and the `.card-numbers` mobile-hide selector below). */
  .side-card-label {
    margin: 0 0 var(--spacing-sm);
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
  }

  .fact dt {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-family: var(--font-body);
  }

  .fact dd {
    margin: 0;
    font-weight: 600;
    font-size: var(--font-size-lg);
    color: var(--color-text-heading);
    font-variant-numeric: tabular-nums;
  }

  .fact-source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-muted);
  }

  .vibe-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  /* Mobile (declared last so it wins over the base rules at this width). The
     aside leads the page here, so it sheds the boxed card and reads as plain
     content: the two stats become self-labeled columns split by a vertical
     divider, and the section heading + census note drop away. */
  @media (max-width: 899px) {
    .side-card {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .card-numbers > .side-card-label,
    .fact-source {
      display: none;
    }

    .facts {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0;
    }

    .fact {
      flex: 1 1 0;
      flex-direction: column-reverse;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2px;
    }


    /* Labels read as compact mono captions under each big value. */
    .fact dt {
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing);
      line-height: 1.2;
      font-weight: 500;
      color: var(--color-muted)
    }

    .fact dd {
      font-size: var(--font-size-xl);
      line-height: 1.1;
    }

    /* Hairline between the numbers and the vibe tags, now that the box is gone. */
    .card-section.has-divider {
      margin-block-start: var(--spacing-md);
      padding-block-start: var(--spacing-md);
    }
  }
</style>
