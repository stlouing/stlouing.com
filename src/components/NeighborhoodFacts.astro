---
// The neighborhood aside card: a "by the numbers" block (population, mapped food
// spots) plus the vibe tags, kept out of the main column so the page doesn't open
// on a wall of metadata. Renders nothing when there's no data at all.
import Chip from './Chip.astro'
import { href } from '../lib/url'
import { tagEmoji } from '../lib/emoji'

interface Props {
  population?: number
  // Count of mapped food spots in this neighborhood (the Food list below).
  spots?: number
  // The neighborhood's tags (historic, dining, …), shown as the "Vibe" chips.
  // Real tags, so each links to its /tags page and joins the site taxonomy.
  tags?: string[]
}

const { population, spots, tags = [] } = Astro.props
const hasNumbers = population != null || (spots != null && spots > 0)
const hasVibe = tags.length > 0
const hasCard = hasNumbers || hasVibe
---

{
  hasCard && (
    <aside class="side-card">
      {hasNumbers && (
        <div class="card-section">
          <h2 class="side-card-label">By the numbers</h2>
          <dl class="facts">
            {population != null && (
              <div class="fact">
                <dt>Population</dt>
                <dd>{population.toLocaleString('en-US')}</dd>
              </div>
            )}
          </dl>
          {population != null && <p class="fact-source">2020 U.S. Census</p>}

          {spots != null && spots > 0 && (
            <div class="fact">
              <dt>Spots I've explored</dt>
              <dd>{spots}</dd>
            </div>
          )}
        </div>
      )}
      {hasVibe && (
        <div class:list={['card-section', { 'has-divider': hasNumbers }]}>
          <h2 class="side-card-label">Vibe</h2>
          <div class="vibe-chips">
            {tags.map((tag) => {
              const emoji = tagEmoji(tag)
              return (
                <Chip href={href(`/tags/${tag}`)}>
                  {emoji && <span>{emoji}</span>}
                  <span>{tag}</span>
                </Chip>
              )
            })}
          </div>
        </div>
      )}
    </aside>
  )
}

<style>
  .side-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--spacing-md);
    background: var(--color-surface);
  }

  /* A second section (Vibe under By the numbers) gets a hairline rule above it. */
  .card-section.has-divider {
    margin-block-start: var(--spacing-md);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px solid var(--color-line);
  }

  .side-card-label {
    margin: 0 0 var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .side-card {
      padding: var(--spacing-sm);
    }
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
  }

  .fact dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-family: var(--font-body);
  }

  .fact dd {
    margin: 0;
    font-weight: 700;
    font-size: var(--font-size-lg);
    color: var(--color-text-heading);
    font-variant-numeric: tabular-nums;
  }

  .fact-source {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxs);
    color: var(--color-text-muted);
  }

  .vibe-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }
</style>
