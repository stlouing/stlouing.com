---
import FleurRow from './FleurRow.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<header class="panel-heading">
  <h2 class="panel-title title-display">{title}</h2>
  <FleurRow />
</header>

<style>
  .panel-heading {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-block-end: var(--spacing-sm);
  }

  .panel-title {
    margin: 0;
    text-align: center;
    font-size: var(--font-size-xxxl);
  }
</style>
