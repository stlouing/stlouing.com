---
interface Props {
  href?: string
  class?: string
  round?: boolean
}

const { href: chipHref, class: className, round = false, ...rest } = Astro.props
---

{
  chipHref ? (
    <a class:list={['chip', { round }, className]} href={chipHref} {...rest}>
      <slot />
    </a>
  ) : (
    <span class:list={['chip', { round }, className]} {...rest}>
      <slot />
    </span>
  )
}
