---
interface Props {
  href?: string
  class?: string
}

const { href: chipHref, class: className, ...rest } = Astro.props
---

{
  chipHref ? (
    <a class:list={['chip', className]} href={chipHref} {...rest}>
      <slot />
    </a>
  ) : (
    <span class:list={['chip', className]} {...rest}>
      <slot />
    </span>
  )
}
