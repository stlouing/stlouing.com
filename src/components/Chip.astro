---
// A small pill of metadata (cuisine, verdict, distance, etc.). Renders as a link
// when `href` is given, otherwise a plain label. Color + border read from
// --chip-color / --chip-border, so variants (e.g. verdict chips, see global.css)
// recolor it without redefining the pill.
interface Props {
  href?: string
  class?: string
  round?: boolean
}

const { href: chipHref, class: className, round = false, ...rest } = Astro.props
---

{
  chipHref ? (
    <a class:list={['chip', { round }, className]} href={chipHref} {...rest}>
      <slot />
    </a>
  ) : (
    <span class:list={['chip', { round }, className]} {...rest}>
      <slot />
    </span>
  )
}

<style>
  .chip {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--chip-color, var(--color-text-muted));
    border: 1px solid var(--chip-border, var(--color-line-input));
    border-radius: 20px;
    padding: var(--spacing-xs) var(--spacing-sm);
    text-decoration: none;
    line-height: 1;
    font-weight: 500;
    background: var(--color-surface);
  }

  a.chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
