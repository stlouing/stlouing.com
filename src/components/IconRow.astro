---
// A shared icon + content row for the neighborhood detail page, used by both
// "Notable spots" and "Annual events". The only per-list differences are the
// leading icon (passed via the `icon` slot) and the optional `meta` label (an
// event's date). Otherwise: a name (linked when a `url` is given) and an
// optional one-line description beneath it.
interface Props {
  name: string
  url?: string
  meta?: string
  description?: string
}

const { name, url, meta, description } = Astro.props
---

<div class="icon-row">
  <slot name="icon" />
  <div class="icon-row-body">
    <div class="icon-row-head">
      {
        url ? (
          <a class="icon-row-name" href={url} target="_blank" rel="noopener">
            {name}
          </a>
        ) : (
          <span class="icon-row-name">{name}</span>
        )
      }
      {meta && <span class="icon-row-meta">{meta}</span>}
    </div>
    {description && <p class="icon-row-desc">{description}</p>}
  </div>
</div>

<style>
  .icon-row {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) 0;
    border-block-end: 1px solid var(--color-line);
  }

  .icon-row:last-child {
    border-block-end: 0;
  }

  .icon-row :global(.icon) {
    width: 16px;
    height: 16px;
    margin-block-start: 2px;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .icon-row-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .icon-row-head {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md);
  }

  .icon-row-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-md);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
    line-height: 1.2;
    text-decoration: none;
  }

  a.icon-row-name:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .icon-row-meta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .icon-row-desc {
    margin: 0;
    color: var(--color-text-muted-2);
    line-height: 1.3;
  }
</style>
