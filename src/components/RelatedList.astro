---
// A titled list of related entries (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page) — one row per item (see RelatedCard.astro).
interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="related">
  <h2 class="related-heading">{title}</h2>
  <div class="related-list">
    <slot />
  </div>
</section>

<style>
  .related {
    margin-block-start: var(--spacing-lg);
  }

  /* The front page's heavy black header voice over the thick rule — the same
     treatment as TOPICS / EXPLORE / FOOD. */
  .related-heading {
    margin-block-start: var(--spacing-xl);
    margin-bottom: var(--spacing-xs);
    padding-bottom: var(--spacing-xs);
    border-bottom: 2px solid var(--color-line-contrast);
    font-family: var(--font-display-black);
    font-weight: 400;
    /* Same size as the front page's TOPICS / MAPS / MORE rail headers. */
    font-size: var(--font-size-xxl);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }

  /* A bordered frame around the rows; overflow clips the row dividers to the
     rounded corners. */
  .related-list {
    /* overflow: hidden; */
    /* border: 1px solid var(--color-line); */
    /* border-radius: var(--radius); */
    /* background: var(--color-surface); */
    overflow: hidden;
  }
</style>
