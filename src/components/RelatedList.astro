---
// A titled list of related entries (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page) — one row per item (see RelatedCard.astro).
interface Props {
  title: string
  // Extra class for variants (e.g. the global `related-cards` two-up card grid).
  class?: string
}

const { title, class: className } = Astro.props
---

<section class:list={['related', className]}>
  <h2 class="related-heading head-black head-rule">{title}</h2>
  <div class="related-list">
    <slot />
  </div>
</section>

<style>
  .related {
    margin-block-start: var(--spacing-lg);
  }

  .related-heading {
    margin-block: var(--spacing-xl) var(--spacing-md);
  }

  .related-list {
    overflow: hidden;
  }
</style>
