---
// A titled list of related entries (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page) — one row per item (see RelatedCard.astro).
interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="related">
  <h2 class="section-label">{title}</h2>
  <div class="related-list">
    <slot />
  </div>
</section>

<style>
  .related {
    margin-block-start: var(--spacing-lg);
  }

  /* Heading font comes from the shared global `.section-label`; keep only the
     spacing below it. */
  .related h2 {
    margin-block-start: var(--spacing-xl);
    margin-bottom: var(--spacing-xs);
    padding-bottom: var(--spacing-xs);
    border-bottom: 2px solid var(--color-line-contrast);
  }

  /* A bordered frame around the rows; overflow clips the row dividers to the
     rounded corners. */
  .related-list {
    /* overflow: hidden; */
    /* border: 1px solid var(--color-line); */
    /* border-radius: var(--radius); */
    /* background: var(--color-surface); */
    overflow: hidden;
  }
</style>
