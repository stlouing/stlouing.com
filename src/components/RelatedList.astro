---
// A titled list of related entries (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page) — one row per item (see RelatedCard.astro).
interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="related">
  <h2>{title}</h2>
  <div class="related-list">
    <slot />
  </div>
</section>

<style>
  .related {
    margin-block-start: var(--spacing-lg);
  }

  /* Match the related-section headings elsewhere: quiet mono uppercase. */
  .related h2 {
    font-family: var(--font-body);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--spacing-sm);
  }

  /* A bordered frame around the rows; overflow clips the row dividers to the
     rounded corners. */
  .related-list {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }
</style>
