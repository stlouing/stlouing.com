---
// A titled list of related entries (more food on a food page, the food + bordering
// neighborhoods on a neighborhood page) — one row per item (see RelatedCard.astro),
// under the shared front-page group-header row (optionally with a "View all" link).
import SectionHeading from './SectionHeading.astro'

interface Props {
  title: string
  // Extra class for variants (e.g. the global `related-cards` two-up card grid).
  class?: string
  // When set, a "View all" continue-link renders beside the heading (e.g. the
  // filtered food list behind a "More in…" group).
  moreHref?: string
  moreLabel?: string
}

const { title, class: className, moreHref, moreLabel } = Astro.props
---

<section class:list={['related', className]}>
  <SectionHeading title={title} moreHref={moreHref} moreLabel={moreLabel} />
  <div class="related-list">
    <slot />
  </div>
</section>

<style>
  .related :global(.section-heading) {
    margin-block: var(--spacing-xl) 0;
  }

  .related-list {
    overflow: hidden;
  }
</style>
