---
import ShareButton from './ShareButton.astro'
import { NEWSLETTER_URL, SOCIALS } from '../lib/site'
import Icon from './Icon.astro'

interface Props {
  title: string
  commentsAnchor?: boolean
}

const { title, commentsAnchor = false } = Astro.props
const instagram = SOCIALS.find((social) => social.label === 'Instagram')
---

<div class="action-bar">
  <div class="action-bar-group">
    {
      commentsAnchor && (
        <a
          class="btn btn-quiet btn-quiet--plain btn-muted-icon"
          href="#comments"
          data-comments-link
          hidden>
          <Icon name="message-circle" />
          <span data-comments-link-label>Comments</span>
        </a>
      )
    }
    <ShareButton
      title={title}
      variant="quiet"
      class="btn-quiet--plain btn-muted-icon"
      trackAs="share-actionbar"
    />
  </div>
  <div class="action-bar-group">
    {
      instagram && (
        <a
          class="btn btn-quiet btn-quiet--plain btn-muted-icon"
          href={instagram.url}
          target="_blank"
          rel="noopener"
          aria-label="Follow on Instagram"
          data-goatcounter-click="instagram-actionbar"
          data-tooltip="Follow on Instagram"
          data-tooltip-align="end">
          <Icon name="instagram" />
        </a>
      )
    }
    {
      NEWSLETTER_URL && (
        <a
          class="btn btn-quiet btn-quiet--plain btn-muted-icon"
          href={`${NEWSLETTER_URL}/subscribe`}
          target="_blank"
          rel="noopener"
          aria-label="Newsletter"
          data-goatcounter-click="newsletter-actionbar"
          data-tooltip="Newsletter"
          data-tooltip-align="end">
          <Icon name="mail" />
        </a>
      )
    }
  </div>
</div>

<style>
  .action-bar {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
    border-block: 1px solid var(--color-line);
  }

  .action-bar-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .action-bar-group:first-child {
    margin-inline-start: calc(-1 * var(--spacing-sm));
  }

  .action-bar-group:last-child {
    gap: var(--spacing-xs);
    margin-inline-end: calc(-1 * var(--spacing-sm));
  }

  .action-bar :global(.btn-muted-icon .icon) {
    width: 20px;
    height: 20px;
    color: inherit;
  }
</style>
