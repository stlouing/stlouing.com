---
import type { ImageMetadata } from 'astro'
import Card from './Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'

interface Props {
  href: string
  title: string
  meta?: string
  description?: string
  excerpt?: string
  photo?: ImageMetadata
  photoAlt?: string
  linkLabel: string
}

const { href, title, meta, description, excerpt, photo, photoAlt, linkLabel } = Astro.props
---

<Card
  class="card--tall-photo card--promo"
  accentMeta
  href={href}
  title={title}
  meta={meta}
  description={description}
  excerpt={excerpt}
  photo={photo}
  photoAlt={photoAlt}>
  <span class="continue-link">
    {linkLabel} <IconArrowRight />
  </span>
</Card>
