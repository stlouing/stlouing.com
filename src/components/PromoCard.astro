---
import type { ImageMetadata } from 'astro'
import Card from './Card.astro'
import Icon from './Icon.astro'

interface Props {
  href: string
  title: string
  meta?: string
  excerpt?: string
  linkLabel: string
  photo?: ImageMetadata
  photoAlt?: string
}

const { href, title, meta, excerpt, linkLabel, photo, photoAlt } = Astro.props
---

<Card
  class="card--lg card--side-photo"
  accentMeta
  photo={photo}
  photoAlt={photoAlt}
  href={href}
  title={title}
  meta={meta}
  excerpt={excerpt}>
  <span class="continue-link">
    {linkLabel} <Icon name="arrow-right" />
  </span>
</Card>
