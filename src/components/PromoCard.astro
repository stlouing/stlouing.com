---
import Card from './Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'

interface Props {
  href: string
  title: string
  meta?: string
  description?: string
  excerpt?: string
  linkLabel: string
}

const { href, title, meta, description, excerpt, linkLabel } = Astro.props
---

<Card
  accentMeta
  href={href}
  title={title}
  meta={meta}
  description={description}
  excerpt={excerpt}>
  <span class="continue-link">
    {linkLabel} <IconArrowRight />
  </span>
</Card>
