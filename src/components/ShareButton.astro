---
import Icon from './Icon.astro'
import Button from './Button.astro'

interface Props {
  title?: string
  label?: string
  class?: string
  variant?: 'outline' | 'quiet' | 'dark'
  compact?: boolean
  iconOnly?: boolean
  trackAs?: string
  [key: string]: unknown
}

const {
  title,
  label = 'Share',
  class: className,
  variant = 'outline',
  compact = false,
  iconOnly = false,
  trackAs,
  ...rest
} = Astro.props
---

<Button
  class={className}
  variant={variant}
  compact={compact}
  data-share
  data-share-title={title}
  data-goatcounter-click={trackAs}
  aria-label="Share this page"
  {...rest}>
  <Icon name="share" />
  {!iconOnly && <span class="share-label">{label}</span>}
</Button>
