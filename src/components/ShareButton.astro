---
// Share button: native share sheet on mobile, copy-link fallback on desktop
// (wired by src/scripts/share.ts). `title` seeds the native share payload.
import IconShare from '../assets/IconShare.astro'
import Button from './Button.astro'

interface Props {
  title?: string
  label?: string
  class?: string
  variant?: 'outline' | 'quiet' | 'dark'
  compact?: boolean
}

const { title, label = 'Share', class: className, variant = 'outline', compact = false } = Astro.props
---

<Button
  class={className}
  variant={variant}
  compact={compact}
  data-share
  data-share-title={title}
  aria-label="Share this page">
  <IconShare />
  {label}
</Button>
