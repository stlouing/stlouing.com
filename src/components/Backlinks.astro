---
import { href } from '../lib/url'
import type { Backlink } from '../lib/backlinks'

interface Props {
  links: Backlink[]
}

const { links } = Astro.props
---

{
  links.length > 0 && (
    <nav class="backlinks" aria-label="Mentioned in">
      <h2>Mentioned in</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={href(link.url)}>{link.title}</a>
            <span class="coll">{link.collection}</span>
          </li>
        ))}
      </ul>
    </nav>
  )
}
