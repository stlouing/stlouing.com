---
import { href } from '../lib/url'
import CardList from './CardList.astro'
import Card from './Card.astro'
import type { Backlink } from '../lib/backlinks'

interface Props {
  links: Backlink[]
}

const { links } = Astro.props

const labelByCollection: Record<string, string> = {
  food: 'Food',
  neighborhoods: 'Neighborhood',
  notes: 'Note',
  topics: 'Topic',
}
---

{
  links.length > 0 && (
    <CardList title="Mentioned in">
      {links.map((link) => {
        const label = labelByCollection[link.collection] ?? link.collection

        return (
          <Card
            href={href(link.url)}
            title={link.title}
            meta={label}
            description={link.description}
          />
        )
      })}
    </CardList>
  )
}
