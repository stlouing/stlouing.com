---
import { href } from '../lib/url'
import RelatedList from './RelatedList.astro'
import RelatedCard from './RelatedCard.astro'
import type { Backlink } from '../lib/backlinks'

interface Props {
  links: Backlink[]
}

const { links } = Astro.props

// A singular kicker label per collection, so each "Mentioned in" row reads like
// the other related lists. Topics are the fallback for any unmapped collection.
const labelByCollection: Record<string, string> = {
  food: 'Food',
  hikes: 'Hike',
  neighborhoods: 'Neighborhood',
  notes: 'Note',
  topics: 'Topic',
}
---

{
  links.length > 0 && (
    <RelatedList title="Mentioned in">
      {links.map((link) => {
        const label = labelByCollection[link.collection] ?? link.collection

        return (
          <RelatedCard
            href={href(link.url)}
            title={link.title}
            meta={label}
            description={link.description}
          />
        )
      })}
    </RelatedList>
  )
}
