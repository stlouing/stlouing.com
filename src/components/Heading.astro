---
interface Props {
  level?: 1 | 2 | 3
  class?: string
}

const { level = 2, class: className } = Astro.props
const Element = `h${level}` as 'h1' | 'h2' | 'h3'
---

<div class:list={['heading', 'heading-bar', 'heading-bar--ruled', className]}>
  <Element class="title-caps"><slot /></Element>
  <slot name="aside" />
</div>

<style>
  .heading {
    margin-block: 0 var(--spacing-xs);
  }

  .heading :is(h1, h2, h3) {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin: 0;
  }
</style>
