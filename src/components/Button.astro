---
interface Props {
  href?: string
  variant?: 'outline' | 'quiet' | 'dark'
  compact?: boolean
  class?: string
  [key: string]: unknown
}

const {
  href: linkHref,
  variant = 'outline',
  compact = false,
  class: className,
  ...rest
} = Astro.props
const classes = ['btn', `btn-${variant}`, { 'btn-compact': compact }, className]
---

{
  linkHref ? (
    <a class:list={classes} href={linkHref} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
