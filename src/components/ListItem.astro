---
// One row of the shared `.list`. The entire row is a single link (when `href` is
// given), so the whole thing is clickable with a hover highlight — like the
// RelatedCard rows, rather than only the title being a link. The title and an
// optional trailing meta share a space-between row; pass `meta` for a plain string
// (count/date) or use the `meta` slot for semantic markup (e.g. <time>). The
// description and any extra content (chips, collection labels) stack below via the
// default slot. Pass an `icon` slot for a leading accent icon.
interface Props {
  title: string
  href?: string
  meta?: string
  description?: string
}

const { title, href: linkHref, meta, description } = Astro.props
const Tag = linkHref ? 'a' : 'div'
const hasIcon = Astro.slots.has('icon')
---

<li>
  <Tag class:list={['list-item', { 'has-icon': hasIcon, 'hover-wash': Boolean(linkHref) }]} href={linkHref}>
    {
      hasIcon && (
        <span class="list-icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )
    }
    <span class="list-item-body">
      <div class="list-row">
        <span class="list-title">{title}</span>
        {meta && <span class="list-meta">{meta}</span>}
        <slot name="meta" />
      </div>
      {description && <p class="list-description">{description}</p>}
      <slot />
    </span>
  </Tag>
</li>

<style>
  /* The whole row is the click target; on hover only the title reacts (accent +
     underline). The row's divider comes from `.list > li` in List.astro. */
  .list-item {
    display: block;
    padding-block: var(--spacing-sm);
    /* Horizontal padding pulled back out with a matching negative margin so the
       hover highlight extends past the text while the text stays aligned with
       the row dividers. */
    padding-inline: var(--spacing-sm);
    margin-inline: calc(-1 * var(--spacing-sm));
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }

  .list-item.has-icon {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .list-item-body {
    flex: 1;
    min-width: 0;
  }

  /* Leading icon: accent (overriding the global muted `.icon`). */
  .list-icon {
    flex-shrink: 0;
    display: inline-flex;
  }

  .list-icon :global(.icon) {
    width: 1rem;
    height: 1rem;
    margin-block-start: 2px;
    /* Hooks so a section can recolor its rows (the Chip.astro pattern) without
       specificity fights; defaults keep the accent look everywhere else. */
    color: var(--list-icon-color, var(--color-accent-2));
  }

  a.list-item:hover .list-title {
    color: var(--list-hover-color, var(--color-accent));
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .list-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-block: 0 2px;
  }
</style>
