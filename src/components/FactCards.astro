---
import AsideHeading from './AsideHeading.astro'
import Chip from './Chip.astro'
import TagIcon from './TagIcon.astro'
import { href } from '../lib/url'
import { tagSlug } from '../lib/tags'

interface Props {
  population?: number
  spots?: number
  tags?: string[]
}

const { population, spots, tags = [] } = Astro.props
const hasNumbers = population != null || (spots != null && spots > 0)
const hasVibe = tags.length > 0
const hasCard = hasNumbers || hasVibe
---

{
  hasCard && (
    <aside class="side-card">
      {hasNumbers && (
        <div class="card-section card-numbers">
          <AsideHeading title="By the numbers" />
          <dl class="facts">
            {population != null && (
              <div class="fact">
                <dt>Population</dt>
                <dd>{population.toLocaleString('en-US')}</dd>
              </div>
            )}
            {population != null && <p class="fact-source">2020 U.S. Census</p>}
            {spots != null && spots > 0 && (
              <div class="fact">
                <dt>Spots explored</dt>
                <dd>{spots}</dd>
              </div>
            )}
          </dl>
        </div>
      )}
      {hasVibe && (
        <div class:list={['card-section', { 'has-divider': hasNumbers }]}>
          <AsideHeading title="Tags" />
          <div class="vibe-chips">
            {tags.map((tag) => (
              <Chip class="chip-blue" href={href(`/tags/${tagSlug(tag)}/`)}>
                <TagIcon tag={tag} />
                <span>{tag}</span>
              </Chip>
            ))}
          </div>
        </div>
      )}
    </aside>
  )
}

<style>
  .side-card {
    padding: 0;
  }

  .card-section.has-divider {
    margin-block-start: var(--spacing-lg);
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    font-family: var(--font-sans-serif);
  }

  .fact dt {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-family: var(--font-serif);
  }

  .fact dd {
    margin: 0;
    font-weight: 600;
    font-size: var(--font-size-lg);
    color: var(--color-text-heading);
    font-variant-numeric: tabular-nums;
  }

  .fact-source {
    margin: 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-xxs);
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .facts > .fact:not(:first-child) {
      margin-block-start: var(--spacing-xs);
      padding-block-start: var(--spacing-xs);
      border-block-start: 1px dotted var(--color-line-input);
    }
  }

  .vibe-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .vibe-chips :global(.chip) {
    border-radius: 0;
  }

  @media (max-width: 899px) {
    .side-card {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .card-numbers > :global(.aside-heading),
    .fact-source {
      display: none;
    }

    .facts {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0;
    }

    .fact {
      flex: 1 1 0;
      flex-direction: column-reverse;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2px;
    }

    .fact dt {
      font-family: var(--font-sans-serif);
      font-size: var(--font-size-xs);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing);
      line-height: 1.2;
      font-weight: 500;
      color: var(--color-muted)
    }

    .fact dd {
      font-size: var(--font-size-xl);
      line-height: 1.1;
    }

    .card-section.has-divider {
      margin-block-start: var(--spacing-md);
      padding-block-start: var(--spacing-md);
    }
  }
</style>
