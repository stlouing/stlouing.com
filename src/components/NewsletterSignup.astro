---
// Newsletter signup. A plain form that hands off to Substack (no iframe widget,
// no tracking, works without JS): submitting GETs to `${NEWSLETTER_URL}/subscribe`
// with the email, which Substack prefills + handles double-opt-in.
// `compact` is the tighter variant used in entry footers.
import { NEWSLETTER_URL } from '../lib/site'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<section class:list={['newsletter', { compact }]} aria-label="Newsletter signup">
  <div class="river-border" aria-hidden="true"></div>
  <div class="newsletter-inner">
    <div class="newsletter-text">
      <p class="newsletter-title">Newsletter</p>
      <p class="newsletter-blurb">
        I'm always poking around St. Louis. When I find a something worth writing about, you'll hear
        about it.
      </p>
    </div>
    <form
      class="newsletter-form"
      action={`${NEWSLETTER_URL}/subscribe`}
      method="get"
      target="_blank">
      <input
        type="email"
        name="email"
        placeholder="you@email.com"
        aria-label="Your email"
        required
      />
      <button type="submit">Subscribe</button>
    </form>
  </div>
</section>

<style>
  .newsletter.compact {
    /* background: var(--color-surface); */
  }

  .newsletter-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm) var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-lg) var(--spacing-lg);
    border-top: 1px solid var(--color-line);
  }

  .newsletter.compact .newsletter-inner {
    max-width: var(--measure);
    margin-inline: auto;
    border-top: 0;
  }

  .newsletter-text {
    flex: 1 1 11rem;
  }

  .newsletter-title {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin: 0;
    /* Scales down on narrow screens so the headline never crowds the form. */
    font-size: clamp(1.625rem, 1rem + 2.6vw, 2rem); /* 26px - 32px */
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    font-family: var(--font-body);
  }

  /* The mail glyph follows the title color (the global .icon rule pins it muted). */
  .newsletter-title :global(.icon) {
    color: inherit;
  }

  .newsletter-blurb {
    margin: var(--spacing-sm) 0 0;
    font-size: var(--font-size-md);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    flex: 1 1 16rem;
    max-width: 24rem;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .newsletter-form button {
    padding: var(--spacing-xs) var(--spacing-md);
    background: var(--color-accent);
    color: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    cursor: pointer;
  }

  .newsletter-form button:hover {
    opacity: 0.92;
  }

  /* Stack the copy over a full-width form on phones. Reset the row's grow/spread so
     the stacked blocks size to content instead of stretching down the column. */
  @media (max-width: 700px) {
    .newsletter-inner {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .newsletter-text,
    .newsletter-form {
      flex: 0 0 auto;
    }

    .newsletter-form {
      max-width: none;
    }
  }
</style>
