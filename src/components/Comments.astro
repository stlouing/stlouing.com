---
// Public per-page comments (shown only when Supabase is configured), backed by
// the RLS-locked `comments` table. Pages are keyed by (kind, slug) because
// topic ids, food ids, and neighborhood slugs can collide. The whole section
// ships `hidden` — src/scripts/comments.ts reveals it after the first
// successful read, so a deploy that outruns the SQL setup (or an offline
// visit) shows nothing rather than an error on every page.
import Heading from './Heading.astro'
import { SUPABASE_ENABLED } from '../lib/site'

interface Props {
  kind: 'topic' | 'food' | 'neighborhood'
  slug: string
  title: string
}

const { kind, slug, title } = Astro.props
---

{
  SUPABASE_ENABLED && (
    <section
      id="comments"
      class="comments"
      data-comments
      data-kind={kind}
      data-slug={slug}
      aria-label={`Comments on ${title}`}
      hidden>
      <Heading>
        Comments
        <span slot="aside" class="count" data-count />
      </Heading>

      <section aria-label="Leave a comment">
        <form class="form-stack" data-form>
          <label class="field">
            <span>Name</span>
            <input type="text" data-name maxlength="80" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Comment</span>
            <textarea data-message rows="4" maxlength="2000" required />
          </label>
          {/* Honeypot - hidden from people, tempting to bots. Filled === silently dropped. */}
          <div class="hp" aria-hidden="true">
            <label>
              Leave this field empty
              <input type="text" data-hp tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-dark btn-compact" data-submit>
              Post
            </button>
            <span class="form-status" data-form-status role="status" aria-live="polite" />
          </div>
        </form>
      </section>

      <div>
        <ul class="feed" data-entries />
        <p class="feed-empty description" data-empty hidden>
          No comments yet.
        </p>
        <p class="form-status" data-load-status role="status" aria-live="polite" />
        <button type="button" class="btn btn-outline btn-compact feed-older" data-older hidden>
          Show older comments
        </button>
      </div>
    </section>
  )
}

<script>
  import { initComments } from '../scripts/comments'
  initComments()
</script>

<style>
  .comments {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-block-start: var(--spacing-xl);
  }

  .comments[hidden] {
    display: none;
  }

</style>
