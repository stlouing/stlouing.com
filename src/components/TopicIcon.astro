---
// A Lucide icon for a topic, keyed by its id, shared by the homepage directory
// and the /topics list so both stay in sync. Unmapped topics fall back to a book.
import IconNotebookPen from '../assets/IconNotebookPen.astro'
import IconHeartCrack from '../assets/IconHeartCrack.astro'
import IconPizza from '../assets/IconPizza.astro'
import IconUtensils from '../assets/IconUtensils.astro'
import IconBook from '../assets/IconBook.astro'

interface Props {
  id: string
}

const { id } = Astro.props

const iconByTopic: Record<string, typeof IconBook> = {
  'field-notes': IconNotebookPen,
  'the-great-divorce': IconHeartCrack,
  'st-louis-style-pizza': IconPizza,
  'regional-foods': IconUtensils,
}

const Icon = iconByTopic[id] ?? IconBook
---

<Icon />
