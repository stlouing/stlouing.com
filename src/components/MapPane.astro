---
import MapLegend from './MapLegend.astro'
import BadgeIcons from './BadgeIcons.astro'
import ReadersVerdictTemplate from './ReadersVerdictTemplate.astro'
import SuggestSpot from './SuggestSpot.astro'
import type { Feature, Polygon } from 'geojson'
import type { DistrictPart } from '../lib/districts'
import {
  categoryLegendItems,
  spotCategories,
  type MapSpot,
  type SpotCategoryKey,
} from '../lib/spots'

interface Props {
  slug: string
  name: string
  boundaryToken: string
  coords?: [number, number]
  spots: MapSpot[]
  boundary?: Feature<Polygon>
  districtParts?: DistrictPart[]
}

const { slug, name, boundaryToken, coords, spots, boundary, districtParts } = Astro.props

const legendCategories = (Object.keys(spotCategories) as SpotCategoryKey[]).filter((key) =>
  spots.some((spot) => spot.category === key),
)
---

<div
  class="map-pane"
  data-map-pane
  data-slug={slug}
  data-boundary-token={boundaryToken}
  data-coords={coords?.join(',')}
  role="application"
  aria-label={`Map of the neighborhood and its notable spots`}>
  <MapLegend items={categoryLegendItems(legendCategories)} />
  <SuggestSpot where={name} />
</div>
<BadgeIcons />
<ReadersVerdictTemplate />
<script
  is:inline
  type="application/json"
  data-map-pane-spots
  set:html={JSON.stringify(spots)}
/>
{
  boundary && (
    <script
      is:inline
      type="application/json"
      data-map-pane-boundary
      set:html={JSON.stringify(boundary)}
    />
  )
}
{
  districtParts && districtParts.length > 0 && (
    <script
      is:inline
      type="application/json"
      data-map-pane-district-parts
      set:html={JSON.stringify(districtParts)}
    />
  )
}

<script>
  import { initMapPane } from '../scripts/map-pane'
  initMapPane()
</script>

<style>
  .map-pane {
    height: 100%;
    min-height: 0;
    border-inline-start: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }

  @media (max-width: 700px) {
    .map-pane {
      border-inline: 0;
      border-block-end: 1px solid var(--color-line);
    }

    .map-pane :global(.suggest-spot) {
      position: absolute;
      inset-block-end: var(--spacing-sm);
      inset-inline-end: var(--spacing-sm);
      z-index: 3;
      width: auto;
      padding: 0 var(--spacing-md) 0 var(--spacing-sm);
    }

    .map-pane :global(.suggest-spot-label) {
      display: inline;
    }

    .map-pane :global(.suggest-spot-label-rest) {
      display: none;
    }
  }
</style>
