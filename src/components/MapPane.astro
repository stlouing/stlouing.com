---
// The neighborhood page's map pane: the right half of the split-screen layout,
// an interactive basemap with the neighborhood's boundary (dashed, in its
// region color) and a clickable pin per mapped food spot (hover shows the name,
// click opens a popup). src/scripts/map-pane.ts mounts the MapLibre
// map; the spot list is baked in as JSON so the script needs no fetch. County
// areas without a boundary polygon center on their coords instead. On phones
// the pane stacks on top of the content at a fixed height (no view switcher).
interface HeroSpot {
  title: string
  url: string
  // [lng, lat] — flipped from the food frontmatter's [lat, lng] by the page.
  coords: [number, number]
  cuisine?: string
  verdict?: { key: string; label: string }
  tagline?: string
}

interface Props {
  slug: string
  // The region's map-color token (e.g. --color-map-south) for the boundary.
  boundaryToken: string
  // Fallback center [lat, lng] for areas without a boundary polygon.
  coords?: [number, number]
  spots: HeroSpot[]
}

const { slug, boundaryToken, coords, spots } = Astro.props
---

<div
  class="map-pane"
  data-map-pane
  data-slug={slug}
  data-boundary-token={boundaryToken}
  data-coords={coords?.join(',')}
  role="application"
  aria-label={`Map of the neighborhood and its food spots`}>
</div>
<script
  is:inline
  type="application/json"
  data-map-pane-spots
  set:html={JSON.stringify(spots)}
/>

<script>
  import { initMapPane } from '../scripts/map-pane'
  initMapPane()
</script>

<style>
  /* Fills its grid cell (the right pane of the .map-split layout). */
  .map-pane {
    height: 100%;
    min-height: 0;
    border-inline-start: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }

  @media (max-width: 700px) {
    .map-pane {
      border-inline: 0;
      border-block-end: 1px solid var(--color-line);
    }
  }
</style>
