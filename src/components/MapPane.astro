---
interface HeroSpot {
  title: string
  url: string
  coords: [number, number]
  cuisine?: string
  verdict?: { key: string; label: string }
  tagline?: string
}

interface Props {
  slug: string
  boundaryToken: string
  coords?: [number, number]
  spots: HeroSpot[]
}

const { slug, boundaryToken, coords, spots } = Astro.props
---

<div
  class="map-pane"
  data-map-pane
  data-slug={slug}
  data-boundary-token={boundaryToken}
  data-coords={coords?.join(',')}
  role="application"
  aria-label={`Map of the neighborhood and its food spots`}>
</div>
<script
  is:inline
  type="application/json"
  data-map-pane-spots
  set:html={JSON.stringify(spots)}
/>

<script>
  import { initMapPane } from '../scripts/map-pane'
  initMapPane()
</script>

<style>
  .map-pane {
    height: 100%;
    min-height: 0;
    border-inline-start: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }

  @media (max-width: 700px) {
    .map-pane {
      border-inline: 0;
      border-block-end: 1px solid var(--color-line);
    }
  }
</style>
