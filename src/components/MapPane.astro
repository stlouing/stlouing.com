---
import Icon from './Icon.astro'
import { spotCategories, type MapSpot, type SpotCategoryKey } from '../lib/spots'

interface Props {
  slug: string
  boundaryToken: string
  coords?: [number, number]
  spots: MapSpot[]
}

const { slug, boundaryToken, coords, spots } = Astro.props

const legendCategories = (Object.keys(spotCategories) as SpotCategoryKey[]).filter((key) =>
  spots.some((spot) => spot.category === key),
)
---

<div
  class="map-pane"
  data-map-pane
  data-slug={slug}
  data-boundary-token={boundaryToken}
  data-coords={coords?.join(',')}
  role="application"
  aria-label={`Map of the neighborhood and its notable spots`}>
  {
    legendCategories.length > 0 && (
      <ul class="map-legend" data-map-legend role="list" aria-label="Map legend">
        {legendCategories.map((key) => (
          <li class="map-legend-item" data-legend-category={key}>
            <span
              class="map-legend-swatch"
              style={`--badge-color: var(${spotCategories[key].token})`}
              aria-hidden="true">
              <Icon name={spotCategories[key].icon} />
            </span>
            {spotCategories[key].label}
          </li>
        ))}
      </ul>
    )
  }
</div>
<script
  is:inline
  type="application/json"
  data-map-pane-spots
  set:html={JSON.stringify(spots)}
/>

<script>
  import { initMapPane } from '../scripts/map-pane'
  initMapPane()
</script>

<style>
  .map-pane {
    height: 100%;
    min-height: 0;
    border-inline-start: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }

  @media (max-width: 700px) {
    .map-pane {
      border-inline: 0;
      border-block-end: 1px solid var(--color-line);
    }
  }
</style>
