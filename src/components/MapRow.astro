---
import { href } from '../lib/url'
import Icon from './Icon.astro'
import ActionButtons from './ActionButtons.astro'

interface Props {
  id: string
  title: string
  detailHref?: string
  readMore?: boolean
  viewMore?: boolean
  filterable?: boolean
  search?: string
  attrs?: Record<string, string>
  websiteHref?: string
  directionsHref?: string
  class?: string
}

const {
  id,
  title,
  detailHref,
  readMore = true,
  viewMore = true,
  filterable = true,
  search = '',
  attrs = {},
  websiteHref,
  directionsHref,
  class: className,
} = Astro.props

const filterAttrs = filterable
  ? {
      'data-filter-item': '',
      'data-search': search,
    }
  : {}

const slotHtml = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : ''
const subHtml = Astro.slots.has('sub') ? (await Astro.slots.render('sub')).trim() : ''
const showReadMore = readMore && Boolean(detailHref)
const showActions = Boolean(websiteHref || directionsHref)
const showPanel = slotHtml.length > 0 || showReadMore || showActions
---

<li id={id} class={className} {...filterAttrs} {...attrs}>
  {
    Astro.slots.has('eyebrow') && (
      <div class="list-eyebrow">
        <slot name="eyebrow" />
      </div>
    )
  }
  <div class="list-headline">
    {
      detailHref ? (
        <a class="list-title title-serif title-link" href={href(detailHref)}>
          {title}
        </a>
      ) : (
        <span class="list-title title-serif">{title}</span>
      )
    }
  </div>
  <slot name="rating" />
  {subHtml && <div><Fragment set:html={subHtml} /></div>}
  {
    showPanel && (
      <div class="list-description">
        {slotHtml && <Fragment set:html={slotHtml} />}
        {showReadMore && (
          <a class="more" href={href(detailHref ?? '')} aria-label={`Read more about ${title}`}>
            Read more <Icon name="arrow-right" />
          </a>
        )}
        {showActions && (
          <ActionButtons
            href={viewMore && detailHref ? href(detailHref) : undefined}
            websiteHref={websiteHref}
            directionsHref={directionsHref}
          />
        )}
      </div>
    )
  }
  <slot name="photo" />
</li>
