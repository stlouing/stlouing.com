---
// Light/dark switch. The theme attribute on <html> is set pre-paint by the
// inline script in BaseLayout (so there's no flash); this button flips it and
// persists the choice. The sun shows in dark mode (tap to go light), the moon
// in light mode. It wears the shared Windows 98 chrome (Button's `retro`
// variant), matching the Share / Feedback buttons. SVGs are inlined so the
// scoped show/hide styles below apply (Astro scoping doesn't reach into child
// component output).
import Button from './Button.astro'
---

<Button
  variant="retro"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle dark mode"
  aria-pressed="false">
  {/* Pixelarticons sun + moon (same set as the site's other icons). */}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="icon icon-sun"
    ><path
      d="M13 22h-2v-3h2v3Zm-6-3H5v-2h2v2Zm12 0h-2v-2h2v2Zm-4-2H9v-2h6v2Zm-6-2H7V9h2v6Zm8 0h-2V9h2v6ZM5 13H2v-2h3v2Zm17 0h-3v-2h3v2Zm-7-4H9V7h6v2ZM7 7H5V5h2v2Zm12 0h-2V5h2v2Zm-6-2h-2V2h2v3Z"
    ></path></svg
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="icon icon-moon"
    ><path
      d="M18 22H8v-2h10v2ZM8 20H6v-2h2v2Zm12 0h-2v-2h2v2ZM6 18H4v-2h2v2Zm16 0h-2v-4h-2v-2h2v-2h2v8ZM4 16H2V6h2v10Zm14 0h-6v-2h6v2Zm-6-2h-2v-2h2v2Zm-2-2H8V6h2v6ZM6 6H4V4h2v2Zm8-2h-2v2h-2V4H6V2h8v2Z"
    ></path></svg
  >
</Button>

<style>
  /* A square Win98 button: fixed equal sides, icon centered. :global because
     the <button> is rendered by the Button child, outside this scope. The
     :active padding recreates the retro press-in nudge relative to the zeroed
     padding (the shared .btn-retro:active rule assumes the default 2px). */
  :global(.theme-toggle.btn-retro) {
    /* Sized to visually match the 32px flag tile + its offset shadow. */
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    justify-content: center;
    flex-shrink: 0;

    svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Mobile: track the flag tile's smaller 26px size (+ shadow), like desktop. */
  @media (max-width: 700px) {
    :global(.theme-toggle.btn-retro) {
      width: 30px;
      height: 30px;

      svg {
        width: 18px;
        height: 18px;
      }
    }
  }

  :global(.theme-toggle.btn-retro:active) {
    padding: 2px 0 0 2px;
  }

  /* Light mode shows the moon; dark mode swaps to the sun. */
  .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) {
    .icon-sun {
      display: block;
    }

    .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const root = document.documentElement

  function syncPressed(): void {
    const isDark = root.dataset.theme === 'dark'
    toggle?.setAttribute('aria-pressed', String(isDark))
  }

  toggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark'
    root.dataset.theme = nextTheme
    localStorage.setItem('theme', nextTheme)
    syncPressed()
  })

  syncPressed()
</script>
