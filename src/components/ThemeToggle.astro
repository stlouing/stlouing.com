---
// Light/dark switch. The theme attribute on <html> is set pre-paint by the
// inline script in BaseLayout (so there's no flash); this button flips it and
// persists the choice. The sun shows in dark mode (tap to go light), the moon
// in light mode. It wears the shared Windows 98 chrome (Button's `retro`
// variant), matching the Share / Feedback buttons. SVGs are inlined so the
// scoped show/hide styles below apply (Astro scoping doesn't reach into child
// component output).
import Button from './Button.astro'
---

<Button
  variant="retro"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle dark mode"
  aria-pressed="false">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="icon icon-sun"
    ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path
      d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"
    ></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path
      d="m19.07 4.93-1.41 1.41"></path></svg
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="icon icon-moon"
    ><path
      d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
    ></path></svg
  >
</Button>

<style>
  /* A square Win98 button: fixed equal sides, icon centered. :global because
     the <button> is rendered by the Button child, outside this scope. The
     :active padding recreates the retro press-in nudge relative to the zeroed
     padding (the shared .btn-retro:active rule assumes the default 2px). */
  :global(.theme-toggle.btn-retro) {
    width: 2rem;
    height: 2rem;
    padding: 0;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.theme-toggle.btn-retro:active) {
    padding: 2px 0 0 2px;
  }

  /* Light mode shows the moon; dark mode swaps to the sun. */
  .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) {
    .icon-sun {
      display: block;
    }

    .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const root = document.documentElement

  function syncPressed(): void {
    const isDark = root.dataset.theme === 'dark'
    toggle?.setAttribute('aria-pressed', String(isDark))
  }

  toggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark'
    root.dataset.theme = nextTheme
    localStorage.setItem('theme', nextTheme)
    syncPressed()
  })

  syncPressed()
</script>
