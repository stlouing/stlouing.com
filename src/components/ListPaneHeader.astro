---
interface Props {
  title: string
  count: number | string
  live?: boolean
}

const { title, count, live = false } = Astro.props
---

<div class="list-pane-header">
  <span class="pane-left">
    <h1 class="pane-title">{title}</h1>
    <span class="count">{live ? <span data-filter-count>{count}</span> : count}</span>
  </span>
  <slot />
</div>

<style>
  .pane-title {
    margin: 0;
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-lg);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-heading);
  }
</style>
