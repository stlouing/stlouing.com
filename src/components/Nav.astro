---
import { sections } from '../lib/sections'
import { href } from '../lib/url'
import FleurGlyph from '../assets/FleurGlyph.astro'

const items = sections.filter((section) => section.primary)
const current = Astro.url.pathname

const isActive = (path: string) => {
  const target = href(path)

  return current === target || current.startsWith(target)
}
---

<nav class="site-nav-inline" aria-label="Primary">
  {
    items.map((section, index) => (
      <>
        {index > 0 && <FleurGlyph class="nav-fleur" />}
        <a
          href={href(section.path)}
          class={`nav-section-${section.label.toLowerCase()} title-link`}
          aria-current={isActive(section.path) ? 'page' : undefined}>
          {section.label}
        </a>
      </>
    ))
  }
</nav>

<style>
  .site-nav-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);
  }

  :global(.site-nav-inline a) {
    color: var(--color-text);
    font-weight: 500;
  }

  .site-nav-inline a[aria-current='page'] {
    color: var(--color-text-heading);
    font-weight: 600;
    text-decoration-line: underline;
  }

  .site-nav-inline :global(.nav-fleur) {
    width: 0.6em;
  }

  @media (max-width: 700px) {
    .site-nav-inline {
      column-gap: var(--spacing-md);
      font-size: var(--font-size-xxs);
      padding-block: var(--spacing-sm);
    }

    .site-nav-inline :global(.nav-fleur) {
      display: none;
    }
  }
</style>
