---
import { sections } from '../lib/sections'
import { href } from '../lib/url'

const items = sections.filter((section) => section.primary)
const current = Astro.url.pathname

// `target` already ends in a trailing slash (all section paths do), so a bare
// startsWith cleanly matches both the section index and its child pages.
const isActive = (path: string) => {
  const target = href(path)

  return current === target || current.startsWith(target)
}
---

<nav class="site-nav" aria-label="Primary">
  {
    items.map((section) => (
      <a
        href={href(section.path)}
        class={`nav-section-${section.label.toLowerCase()}`}
        aria-current={isActive(section.path) ? 'page' : undefined}>
        {section.label}
      </a>
    ))
  }
</nav>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-base);
    row-gap: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);

    a {
      display: block;
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-decoration-color: var(--color-muted);
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
      font-weight: 500;

      &:hover {
        color: var(--color-text);
        text-decoration-style: solid;
        text-decoration-color: var(--color-accent);
      }

      &[aria-current='page'] {
        color: var(--color-accent);
        font-weight: 600;
        text-decoration-style: solid;
        text-decoration-color: var(--color-accent);
      }
    }
  }

  /* Mobile: drop the dotted underline (cramped on a phone) for a clean, compact
     text menu — muted labels with the active section in accent. */
  @media (max-width: 700px) {
    .site-nav a {
      color: var(--color-muted-2);
      text-decoration: none;

      &[aria-current='page'] {
        color: var(--color-accent);
      }
    }
  }
</style>
