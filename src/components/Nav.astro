---
import { sections } from '../lib/sections'
import { href } from '../lib/url'
import FleurGlyph from '../assets/FleurGlyph.astro'

// The masthead's newspaper section line — plain labels separated by tiny
// fleurs-de-lis. The nameplate above is the way home, so there's no Home link.
const items = sections.filter((section) => section.primary)
const current = Astro.url.pathname

// `target` already ends in a trailing slash (all section paths do), so a bare
// startsWith cleanly matches both the section index and its child pages.
const isActive = (path: string) => {
  const target = href(path)

  return current === target || current.startsWith(target)
}
---

<nav class="site-nav-inline" aria-label="Primary">
  {
    items.map((section, index) => (
      <>
        {index > 0 && <FleurGlyph class="nav-fleur" />}
        <a
          href={href(section.path)}
          class={`nav-section-${section.label.toLowerCase()}`}
          aria-current={isActive(section.path) ? 'page' : undefined}>
          {section.label}
        </a>
      </>
    ))
  }
</nav>

<style>
  .site-nav-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: var(--spacing-md);
    row-gap: var(--spacing-xs);
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-sm);

    a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 500;

      &:hover {
        color: var(--color-accent-blue);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
      }

      &[aria-current='page'] {
        color: var(--color-text-heading);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
      }
    }
  }

  .site-nav-inline :global(.nav-fleur) {
    width: 0.6em;
    height: auto;
    color: var(--color-accent-gold);
  }

  @media (max-width: 700px) {
    .site-nav-inline {
      column-gap: var(--spacing-md);
      font-size: var(--font-size-xxs);
      padding-block: var(--spacing-sm);
    }

    .site-nav-inline :global(.nav-fleur) {
      display: none;
    }
  }
</style>
