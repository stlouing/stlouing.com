{
  "name": "stlouing.com",
  "version": "0.0.1",
  "private": true,
  "description": "A personal website documenting the food, neighborhoods, and culture of St. Louis.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:basemap": "scripts/build-basemap.sh",
    "build:geo": "node scripts/build-neighborhood-geo.mjs",
    "build:population": "node scripts/build-neighborhood-population.mjs",
    "clean": "rm -f .astro/data-store.json node_modules/.astro/data-store.json",
    "dev": "astro dev",
    "dev:fresh": "pnpm clean && pnpm dev",
    "geocode:spots": "node scripts/geocode-spots.mjs",
    "prettier": "prettier . --write",
    "preview": "astro preview",
    "setup": "node scripts/setup-city.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "astro": "^6.4.8",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.34.5",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/supercluster": "^7.1.3",
    "prettier": "^3.9.10",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
